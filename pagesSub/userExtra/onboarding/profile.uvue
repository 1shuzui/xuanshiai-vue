<template>
	<view class="onboarding-page">
		<view class="topbar">
			<view class="back-button-hit" @tap="handleBack"></view>
			<view class="topbar-space"></view>
			<view class="topbar-space"></view>
		</view>

		<view v-if="step === 0" class="identity-page">
			<view class="hero-copy">
				<text class="hero-title">欢迎加入<text class="hero-emphasis">宣誓爱</text></text>
				<text class="hero-subtitle">请选择您要注册的身份</text>
			</view>
			<view class="role-list">
				<view
					v-for="role in roles"
					:key="role.key"
					class="role-card"
					:class="role.tone"
					@tap="chooseRole(role.key)"
				>
					<view class="role-icon" :class="role.iconTone"><text>{{ role.icon }}</text></view>
					<view class="role-copy">
						<text class="role-title">{{ role.title }}</text>
						<text class="role-subtitle">{{ role.subtitle }}</text>
					</view>
					<text class="role-arrow">›</text>
				</view>
			</view>
		</view>

		<view v-else class="step-page">
			<view class="step-head">
				<text class="step-label">完善资料 {{ step }} / {{ totalSteps }}</text>
				<view class="progress-track">
					<view class="progress-fill" :style="{ width: progressWidth + '%' }"></view>
				</view>
			</view>
			<view class="question-head">
				<text class="question-title">{{ currentTitle }}</text>
				<text class="question-hint">这些信息只用于为你推荐更合适的人</text>
			</view>

			<view v-if="currentType === 'date'" class="onboarding-picker">
				<picker-view class="date-picker-view" :value="datePickerValue" indicator-style="height: 52px; background: transparent;" mask-style="background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 72%, rgba(255,255,255,1) 100%);" @change="onDatePickerChange">
					<picker-view-column><view v-for="year in yearOptions" :key="year" class="picker-column-item"><text>{{ year }}年</text></view></picker-view-column>
					<picker-view-column><view v-for="month in monthOptions" :key="month" class="picker-column-item"><text>{{ month }}月</text></view></picker-view-column>
					<picker-view-column><view v-for="day in dayOptions" :key="day" class="picker-column-item"><text>{{ day }}日</text></view></picker-view-column>
				</picker-view>
				<text class="picker-selected-text">{{ selectedValue || '上下滑动选择出生日期' }}</text>
			</view>
			<view v-if="currentType === 'picker'" class="onboarding-picker">
				<picker-view class="single-picker-view" :value="pickerViewValue" indicator-style="height: 52px; background: transparent;" mask-style="background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 72%, rgba(255,255,255,1) 100%);" @change="onPickerViewChange">
					<picker-view-column><view v-for="option in currentOptions" :key="option" class="picker-column-item"><text>{{ option }}</text></view></picker-view-column>
				</picker-view>
				<text class="picker-selected-text">{{ selectedValue || '上下滑动选择' }}</text>
			</view>
			<view v-if="currentType === 'grid'" class="option-grid">
				<view
					v-for="option in currentOptions"
					:key="option"
					class="option-chip"
					:class="{ selected: selectedValue === option }"
					@click="selectOption(option)"
				>
					<text>{{ option }}</text>
				</view>
			</view>
			<view v-if="currentType !== 'date' && currentType !== 'picker' && currentType !== 'grid'" class="option-list">
				<view
					v-for="option in currentOptions"
					:key="option"
					class="option-row"
					:class="{ selected: selectedValue === option }"
					@click="selectOption(option)"
				>
					<text>{{ option }}</text>
				</view>
			</view>

			<view class="step-footer">
				<button class="previous-button" :disabled="step === 1" @click="previousStep">上一步</button>
				<button class="next-button" @click="nextStep">{{ step === totalSteps ? '完成' : '下一步' }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const step = ref(0)
	const mode = ref('')
	const selections = ref([] as string[])

	const roles = [
		{ key: 'self', title: '自己找对象', subtitle: '我单身，我自己找对象', icon: '♡', tone: 'role-peach', iconTone: 'icon-peach' },
		{ key: 'parent', title: '我是父母', subtitle: '替子女登记信息找对象', icon: '♧', tone: 'role-blue', iconTone: 'icon-blue' },
		{ key: 'buddy', title: '找搭子', subtitle: '认识一群兴趣相投的人', icon: '♧', tone: 'role-lilac', iconTone: 'icon-lilac' },
		{ key: 'matchmaker', title: '当红娘', subtitle: '当红娘，我推荐单身', icon: '♧', tone: 'role-pink', iconTone: 'icon-pink' }
	]

	const numericOptions = (start: number, end: number, suffix: string): string[] => {
		const options = [] as string[]
		for (let value = start; value <= end; value++) options.push('' + value + suffix)
		return options
	}
	const heightOptions = numericOptions(140, 220, 'cm')
	const weightOptions = numericOptions(40, 120, 'kg')
	const yearOptions = numericOptions(1966, 2008, '')
	const monthOptions = numericOptions(1, 12, '')
	const dayOptions = numericOptions(1, 31, '')
	const datePickerValue = ref([34, 0, 0] as number[])
	const pickerIndex = ref(0)
	const pickerViewValue = computed(() => [pickerIndex.value])
	const questions = [
		{ title: '您的出生日期', type: 'date', options: [] as string[] },
		{ title: '您的老家是哪里', type: 'list', options: ['江苏省 南京市 市辖区', '浙江省 杭州市 西湖区', '上海市 上海市 浦东新区', '安徽省 合肥市 蜀山区'] },
		{ title: '您的工作地区', type: 'list', options: ['江苏省 南京市 市辖区', '浙江省 杭州市 西湖区', '上海市 上海市 浦东新区', '广东省 深圳市 南山区'] },
		{ title: '您的身高是多少', type: 'picker', options: heightOptions },
		{ title: '您的体重是多少', type: 'picker', options: weightOptions },
		{ title: '您的最高学历', type: 'picker', options: ['大专', '本科', '硕士', '博士'] },
		{ title: '您从事何种工作', type: 'grid', options: ['不限', '私企员工', '央企/国企', '外企', '事业单位', '公务员', '教师', '医生', '护士', '互联网行业', '自由职业', '军人', '工人', '服务业', '金融', '律师', '求职中', '在校学生'] },
		{ title: '您的婚姻状况', type: 'picker', options: ['未婚', '离异', '丧偶'] },
		{ title: '您的收入状况', type: 'picker', options: ['小于10w', '10-20w', '30-50w', '50-100w', '100w以上', '保密'] }
	]

	const totalSteps = questions.length
	const currentTitle = computed(() => step.value > 0 ? questions[step.value - 1].title : '')
	const currentType = computed(() => step.value > 0 ? questions[step.value - 1].type : 'list')
	const currentOptions = computed((): string[] => step.value > 0 ? questions[step.value - 1].options : [])
	const selectedValue = computed(() => step.value > 0 && selections.value[step.value - 1] != null ? selections.value[step.value - 1] : '')
	const progressWidth = computed(() => Math.round(step.value / totalSteps * 100))

	const chooseRole = (key: string) => {
		if (key === 'parent') {
			uni.setStorageSync('xsa_onboarding_mode', 'parent')
			uni.setStorageSync('xsa_onboarding_completed', true)
			uni.reLaunch({ url: '/pages/parent/parent' })
			return
		}
		if (key === 'matchmaker') {
			uni.showToast({ title: '该身份流程暂未开放', icon: 'none' })
			return
		}
		mode.value = key
		selections.value = questions.map((question: any) => {
			if (question.type === 'date') return '2000-01-01'
			if (question.type === 'picker' && question.options.length > 0) return question.options[0]
			return ''
		})
		step.value = 1
	}

	watch(step, () => {
		if (step.value <= 0 || currentType.value !== 'picker') return
		const options = currentOptions.value
		const selected = selectedValue.value
		const index = options.indexOf(selected)
		pickerIndex.value = index >= 0 ? index : 0
	})

	const selectOption = (option: string) => {
		if (step.value <= 0 || step.value > totalSteps) return
		while (selections.value.length < step.value) selections.value.push('')
		selections.value[step.value - 1] = option
	}
	const selectPicker = (event: any) => {
		const index = Number(event.detail.value)
		const options = currentOptions.value
		if (index >= 0 && index < options.length) selectOption(options[index])
	}
	const selectDate = (event: any) => selectOption('' + event.detail.value)
	const onPickerViewChange = (event: any) => {
		const values = event.detail.value as any[]
		const index = Number(values[0])
		pickerIndex.value = index
		const options = currentOptions.value
		if (index >= 0 && index < options.length) selectOption(options[index])
	}
	const onDatePickerChange = (event: any) => {
		const values = event.detail.value as any[]
		const yearIndex = Number(values[0])
		const monthIndex = Number(values[1])
		const dayIndex = Number(values[2])
		datePickerValue.value = [yearIndex, monthIndex, dayIndex]
		const year = yearOptions[yearIndex]
		const month = monthOptions[monthIndex].length == 1 ? '0' + monthOptions[monthIndex] : monthOptions[monthIndex]
		const day = dayOptions[dayIndex].length == 1 ? '0' + dayOptions[dayIndex] : dayOptions[dayIndex]
		selectDate({ detail: { value: year + '-' + month + '-' + day } })
	}

	const previousStep = () => {
		if (step.value > 1) step.value = step.value - 1
	}

	const nextStep = () => {
		if (selectedValue.value.length === 0) {
			uni.showToast({ title: '请选择一项后继续', icon: 'none' })
			return
		}
		if (step.value < totalSteps) {
			step.value = step.value + 1
			return
		}
		uni.setStorageSync('xsa_onboarding_completed', true)
		uni.setStorageSync('xsa_onboarding_mode', mode.value)
		uni.showToast({ title: '资料已保存', icon: 'success' })
		setTimeout(() => {
			uni.switchTab({ url: '/pages/index/index' })
		}, 500)
	}

	const handleBack = () => {
		if (step.value > 0) {
			step.value = step.value - 1
		} else {
			uni.navigateBack()
		}
	}
</script>

<style scoped>
	.onboarding-page {
		min-height: 100vh;
		background: linear-gradient(180deg, #FAF5FF 0px, #F7FBFF 250px, #FFFFFF 520px);
		color: var(--ink);
	}

	.topbar {
		height: 100px;
		padding: 44px 16px 0;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #FFFFFFCC;
		border-bottom: 1px solid #ECECEC;
	}

	.back-button,
	.back-button-hit,
	.topbar-space,
	.topbar-actions {
		width: 44px;
		height: 44px;
	}

	.topbar-actions {
		width: 78px;
		border: 1px solid #E1E1E1;
		border-radius: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		font-size: 15px;
		color: var(--ink);
	}

	.back-button {
		font-size: 38px;
		line-height: 40px;
		color: var(--ink);
		text-align: left;
	}

	.back-button-hit { flex-shrink: 0; }

	.topbar-title {
		font-size: 19px;
		font-family: var(--serif);
		font-weight: 700;
		text-align: center;
	}

	.identity-page,
	.step-page {
		min-height: calc(100vh - 100px);
		padding: 0 0 104px;
		box-sizing: border-box;
	}

	.identity-page { padding: 48px 36px 24px; }

	.hero-copy {
		margin-bottom: 48px;
		text-align: center;
	}

	.hero-title,
	.question-title {
		display: block;
		font-size: 30px;
		font-family: var(--serif);
		font-weight: 700;
		line-height: 1.35;
	}

	.hero-emphasis {
		padding: 0 3px;
		background: linear-gradient(transparent 58%, #E8D9F4 58%);
	}

	.hero-subtitle,
	.question-hint {
		display: block;
		margin-top: 16px;
		font-size: 16px;
		color: #A0A8A5;
	}

	.question-hint { display: none; }

	.role-list {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.role-card {
		position: relative;
		height: 110px;
		padding: 16px 18px;
		border-radius: 18px;
		box-sizing: border-box;
		transition: transform .18s ease-out;
	}

	.role-card:active,
	.option-chip:active,
	.option-row:active {
		transform: scale(0.98);
	}

	.role-peach { background: #FFF6EC; }
	.role-blue { background: #ECFAFC; }
	.role-lilac { background: #F1F0FF; }
	.role-pink { background: #FCF0FA; }

	.role-icon {
		position: absolute;
		left: 18px;
		top: 19px;
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: var(--surface);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 36px;
		color: var(--ink);
		flex-shrink: 0;
	}

	.icon-peach { background: #FFDAB8; }
	.icon-blue { background: #C8F0F4; }
	.icon-lilac { background: #D5D1FF; }
	.icon-pink { background: #E7B9EF; }

	.role-copy {
		position: absolute;
		left: 108px;
		top: 50%;
		width: calc(100% - 154px);
		transform: translateY(-50%);
	}

	.role-copy text {
		display: block;
	}

	.role-title {
		margin-bottom: 4px;
	}

	.role-title {
		display: block;
		overflow: hidden;
		font-size: 20px;
		font-weight: 800;
		color: #171A19;
		white-space: nowrap;
	}

	.role-subtitle {
		display: block;
		overflow: hidden;
		font-size: 14px;
		color: #A0A8A5;
		white-space: nowrap;
	}

	.role-arrow {
		position: absolute;
		right: 18px;
		top: 50%;
		transform: translateY(-50%);
		width: 22px;
		font-size: 30px;
		font-weight: 300;
		color: #171A19;
	}

	.step-head {
		display: block;
		margin-bottom: 0;
		padding: 24px 36px 0;
	}

	.step-label {
		display: block;
		margin-bottom: 10px;
		font-size: 12px;
		color: var(--muted);
	}

	.progress-track {
		height: 5px;
		border-radius: 3px;
		background: var(--warm);
		overflow: hidden;
	}

	.progress-fill {
		height: 100%;
		border-radius: 3px;
		background: var(--accent);
	}

	.question-head {
		margin-bottom: 0;
		padding: 64px 24px 48px;
		background: linear-gradient(105deg, #FFF0FF 0%, #FFFFFF 56%, #EEFFFF 100%);
		text-align: center;
	}

	.question-title {
		font-family: sans-serif;
		font-weight: 800;
	}

	.onboarding-picker {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 0 auto;
		padding: 0;
		text-align: center;
		color: var(--ink);
	}

	.date-picker-view,
	.single-picker-view {
		width: 100%;
		height: 364px;
		background: transparent;
	}

	.single-picker-view {
		height: 364px;
	}

	.picker-column-item {
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		font-size: 24px;
		font-weight: 800;
		color: var(--ink);
	}

	.picker-selected-text {
		display: none;
	}

	.option-list {
		border-top: 1px solid var(--line);
	}

	.option-row {
		height: 62px;
		border-bottom: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		color: var(--muted);
	}

	.option-row.selected {
		color: var(--ink);
		font-weight: 800;
		background: var(--warm);
	}

	.option-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
	}

	.option-chip {
		min-height: 44px;
		padding: 0 6px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--surface);
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 12px;
		color: var(--ink2);
	}

	.option-chip.selected {
		border-color: var(--accent);
		background: var(--accent-bg);
		color: var(--accent2);
		font-weight: 800;
	}

	.step-footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 12px 24px calc(12px + env(safe-area-inset-bottom));
		background: var(--surface);
		border-top: 1px solid var(--line);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	.previous-button,
	.next-button {
		height: 48px;
		border-radius: 999px;
		font-size: 16px;
		font-weight: 800;
		line-height: 48px;
	}

	.previous-button {
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--muted);
	}

	.next-button {
		background: var(--accent);
		color: var(--text-invert);
	}

	.previous-button[disabled] {
		opacity: 0.5;
	}
</style>
