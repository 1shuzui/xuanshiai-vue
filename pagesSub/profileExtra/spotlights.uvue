<template>
	<view class="empty-page"><view class="empty-nav"><XsaIcon class="ic ic-sys ic-fanhui back" @tap="back" name="sys-fanhui" size="inherit" /><text>宣誓爱</text><view class="placeholder"></view></view><view class="tabs"><view class="tab" :class="{ active: activeTab === 0 }" @tap="activeTab = 0"><text>我给谁爆灯({{ sentSuperlikes.length }})</text><view></view></view><view class="tab" :class="{ active: activeTab === 1 }" @tap="activeTab = 1"><text>谁给我爆灯({{ receivedSuperlikes.length }})</text><view></view></view></view><scroll-view v-if="activeTab === 0 && sentSuperlikes.length > 0" class="spotlight-list" scroll-y><view v-for="item in sentSuperlikes" :key="item.id" class="spotlight-row" @tap="openUser(item.userId)"><image :src="item.avatar" class="spotlight-avatar" mode="aspectFill"></image><view class="spotlight-info"><text class="spotlight-name">{{ item.name }}</text><text class="spotlight-meta">{{ item.createdAt }}</text></view><text class="spotlight-status">{{ item.matched ? '已匹配' : item.status }}</text></view></scroll-view><scroll-view v-else-if="activeTab === 1 && receivedSuperlikes.length > 0" class="spotlight-list" scroll-y><view v-for="item in receivedSuperlikes" :key="item.id" class="spotlight-row" @tap="openUser(item.userId)"><image :src="item.avatar" class="spotlight-avatar" mode="aspectFill"></image><view class="spotlight-info"><text class="spotlight-name">{{ item.name }}</text><text class="spotlight-meta">{{ item.createdAt }}</text></view><text class="spotlight-status">{{ item.matched ? '已匹配' : item.status }}</text></view></scroll-view><view v-else class="empty-content"><XsaIcon class="ic ic-home ic-search empty-icon" name="home-search" size="inherit" /><text class="empty-copy">什么都还没有哦</text></view></view>
</template>
<script setup lang="uts">
import XsaIcon from '@/components/XsaIcon.uvue'
import { getSentSuperlikes, getReceivedSuperlikes } from '@/api'
const back = () => uni.navigateBack({ delta: 1 })
const activeTab = ref(0)
const sentSuperlikes = ref<any[]>([])
const receivedSuperlikes = ref<any[]>([])
const openUser = (userId: number) => { if (userId > 0) uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + userId }) }
onMounted(async () => {
	const sent = await getSentSuperlikes(1, 20)
	const received = await getReceivedSuperlikes(1, 20)
	if (sent.success && sent.data != null) sentSuperlikes.value = (sent.data as any).items as any[]
	if (received.success && received.data != null) receivedSuperlikes.value = (received.data as any).items as any[]
})
</script>
<style scoped>
.empty-page { min-height: 100vh; background: #F5F7FC; color: #20232A; }.empty-nav { height: 100px; padding: 44px 18px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: #FFF; font-size: 20px; font-weight: 800; }.back,.placeholder { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }.back { font-size: 38px; font-weight: 300; }.tabs { height: 56px; display: flex; flex-direction: row; background: #FFF; }.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8px; color: #999DA7; font-size: 16px; }.tab view { width: 28px; height: 5px; border-radius: 3px; background: transparent; }.tab.active { color: #24242A; font-weight: 700; }.tab.active view { background: #D55CEA; }.empty-content { display: flex; flex-direction: column; align-items: center; padding-top: 45px; color: #D9DFEC; }.empty-icon { width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; background: #FFF; font-size: 64px; color: #DDE5F4; }.empty-copy { margin-top: 10px; font-size: 14px; color: #D1D4DC; }
.spotlight-list { height: calc(100vh - 156px); padding: 16px; box-sizing: border-box; }.spotlight-row { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid #E7E3DD; }.spotlight-avatar { width: 52px; height: 52px; border-radius: 26px; background: #EEF1F7; }.spotlight-info { flex: 1; display: flex; flex-direction: column; gap: 5px; }.spotlight-name { font-size: 15px; font-weight: 700; }.spotlight-meta,.spotlight-status { color: #8E8E8A; font-size: 12px; }.spotlight-status { color: #B47770; }
.ic { font-style: normal; }.ic-home { font-family: "iconfont-home" !important; }.ic-sys { font-family: "iconfont-sys" !important; }.back { width: 40px; height: 40px; border-radius: 20px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 16px; color: #2C2C2C; }
</style>
