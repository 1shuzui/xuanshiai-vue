<template>
	<view class="page">
		<!-- Hero 区 -->
		<view class="hero">
			<view class="hero-icon-wrap">
				<text class="hero-icon">❤️</text>
			</view>
			<text class="hero-title">宣誓爱</text>
			<text class="hero-version">V {{ appVersion }}</text>
		</view>

		<!-- 文章列表 -->
		<view class="list-section">
			<view
				class="list-item"
				v-for="(item, index) in articles"
				:key="item.type"
				:class="{ 'list-item-last': index === articles.length - 1 }"
				@click="onItemClick(item)"
			>
				<text class="list-label">{{ item.title }}</text>
				<view class="list-right">
					<text class="list-arrow" v-if="item.clickable">›</text>
				</view>
			</view>
		</view>

		<!-- 页脚 -->
		<view class="footer">
			<text class="footer-tagline">共享相亲资源 加速脱单进程</text>
			<text class="footer-icp">粤ICP备18145793号-4A</text>
			<view class="footer-withdraw" @click="handleWithdraw">
				<text class="withdraw-text">撤回对全部协议的同意</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getArticles, ArticleListItem } from '@/api/about'

let articles = ref([] as ArticleListItem[])
let loading = ref(true)
let error = ref('')

const appVersion = '1.0.0'

onMounted(async () => {
	try {
		const res = await getArticles()
		if (!res.success || res.data == null) throw new Error('数据获取失败')
		articles.value = res.data
	} catch (e) {
		error.value = '加载失败，请重试'
		uni.showToast({ title: '加载失败', icon: 'none' })
	} finally {
		loading.value = false
	}
})

const onItemClick = (item: ArticleListItem) => {
	if (!item.clickable) {
		uni.showToast({ title: '当前已是最新版本', icon: 'none' })
		return
	}
	uni.navigateTo({ url: '/pagesSub/about/article?type=' + item.type })
}

const handleWithdraw = () => {
	uni.showModal({
		title: '撤回协议确认',
		content: '若点击确认撤回《用户服务》及《隐私政策》，将无法正常使用 App 功能并退出',
		confirmText: '确认撤回',
		cancelText: '取消',
		confirmColor: '#79B48C',
		success: (res) => {
			if (res.confirm) {
				uni.showToast({ title: '已提交撤回申请', icon: 'none' })
				// TODO: 调用接口撤回协议同意
			}
		}
	})
}
</script>

<style scoped>
.page {
	min-height: 100vh;
	background-color: #F8F8F8;
}

/* ---- Hero 区 ---- */
.hero {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 24rpx;
	padding: 80rpx 40rpx 60rpx;
	background-color: #FFFFFF;
}

.hero-icon-wrap {
	width: 160rpx;
	height: 160rpx;
	border-radius: 32rpx;
	background-color: #E7F1EA;
	display: flex;
	align-items: center;
	justify-content: center;
}

.hero-icon {
	font-size: 84rpx;
}

.hero-title {
	font-size: 40rpx;
	font-weight: 600;
	color: #1A1A1A;
}

.hero-version {
	font-size: 28rpx;
	color: #9CA3AF;
}

/* ---- 列表 ---- */
.list-section {
	background-color: #FFFFFF;
	margin-top: 20rpx;
}

.list-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 36rpx 40rpx;
	border-bottom: 2rpx solid #F0F0F0;
}

.list-item-last {
	border-bottom: none;
}

.list-label {
	font-size: 30rpx;
	color: #1A1A1A;
	flex: 1;
}

.list-right {
	display: flex;
	align-items: center;
	gap: 12rpx;
	flex-shrink: 0;
}

.list-value {
	font-size: 26rpx;
	color: #9CA3AF;
}

.list-arrow {
	font-size: 40rpx;
	color: #C8C8C8;
	font-weight: 300;
}

/* ---- 页脚 ---- */
.footer {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 24rpx;
	padding: 60rpx 40rpx 80rpx;
}

.footer-tagline {
	font-size: 26rpx;
	color: #9CA3AF;
	text-align: center;
}

.footer-icp {
	font-size: 24rpx;
	color: #B0B0B0;
	text-align: center;
}

.footer-withdraw {
	padding: 20rpx 48rpx;
	border-radius: 40rpx;
	background-color: #F5F5F5;
	margin-top: 16rpx;
}

.withdraw-text {
	font-size: 28rpx;
	color: #1A1A1A;
}
