        { icon: '👤', label: '个人资料' },
        { icon: '🔒', label: '账号安全' },
        { icon: '🔔', label: '消息通知' },
        { icon: '🛡', label: '隐私设置' },
        { icon: 'ℹ', label: '关于我们' }
      ]
    }
  },
  methods: {
    switchTab(index) {
      this.currentTab = index
      this.showProfile = false
    },
    switchVipCat(index) {
      this.vipCatIndex = index
    },
    // 点击查看他人资料 → 锁定模式
    onViewProfile() {
      this.profileMode = 'locked'
      this.showProfile = true
    },
    // 从「我的」页点击头像 → 自己模式
    onViewMyProfile() {
      this.profileMode = 'own'
      this.showProfile = true
    },
    onCloseProfile() {
      this.showProfile = false
    },
    onHistory() {},
    onSearch() {},
    onShare() {},
    onChat() {},
    onLike() {},
    onAI() {},
    // 个人详情页操作
    onProfileBack() {
      this.showProfile = false
    },
    onProfileShare() {
      uni.showToast({ title: '分享给朋友', icon: 'none' })
    },
    onProfileUnlock() {
      uni.showToast({ title: '请先开通VIP会员', icon: 'none' })
    },
    onProfileSpotlight() {
      uni.showToast({ title: '爆灯成功！', icon: 'none' })
    },
    onProfileMatch() {
      uni.showToast({ title: '已发送牵线申请', icon: 'none' })
    },
    onProfileLike() {
      uni.showToast({ title: '已收藏', icon: 'none' })
    },
    // 我的页面操作
    onMineItemClick(label) {
      uni.showToast({ title: label, icon: 'none' })
    },
    onMineSettingClick(label) {
      uni.showToast({ title: label, icon: 'none' })
    }
  }
}
</script>

<style>
/* ==================== 页面容器 ==================== */
