/* ==================== 会员专区页面 ==================== */
/* Hero Banner */
.vip-hero {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  height: 320rpx;
  padding: 40rpx 48rpx;
  background: linear-gradient(135deg, #2D4A3E, #1A3328);
  border-radius: var(--radius-xl);
  margin-bottom: 24rpx;
}

.vip-hero-gold-line {
  width: 120rpx;
  height: 6rpx;
  background-color: var(--gold);
  border-radius: 3rpx;
}

.vip-hero-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vip-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-inverse);
}

.vip-hero-subtitle {
  font-size: 26rpx;
  color: #C9D5CA;
}

.vip-hero-badges {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
  padding-top: 24rpx;
}

.vip-hero-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.vip-hero-badge-icon {
  font-size: 28rpx;
  color: var(--gold);
}

.vip-hero-badge-text {
  font-size: 24rpx;
  color: #C9D5CA;
}

/* 分类Tab栏 */
.vip-cat-tabs {
  display: flex;
  flex-direction: row;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.vip-cat-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0 20rpx 0;
}

.vip-cat-tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.vip-cat-tab-text.active {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vip-cat-indicator {
  width: 48rpx;
  height: 6rpx;
  background-color: var(--accent);
  border-radius: 3rpx;
}

/* 筛选行 */
.vip-filter-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.vip-result-count {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.vip-filter-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.vip-sort-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-card);
}

.vip-sort-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.vip-sort-icon {
  font-size: 20rpx;
  color: var(--text-muted);
}

.vip-accelerate-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  background-color: var(--accent);
}

.vip-accel-icon {
  font-size: 24rpx;
  color: var(--text-inverse);
}

.vip-accel-text {
  font-size: 24rpx;
  color: var(--text-inverse);
  font-weight: 600;
}

/* VIP卡片网格 */
.vip-card-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.vip-card-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.vip-card-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.vip-card-photo {
  width: 100%;
  height: 280rpx;
  position: relative;
  overflow: hidden;
}

.vip-card-photo-img {
  width: 100%;
  height: 100%;
}

.vip-card-crown {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  background-color: #C9A96E;
}

.vip-card-crown-icon {
  font-size: 16rpx;
}

.vip-card-gender {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
}

.vip-card-gender.female {
  background-color: #FFE4E6;
}

.vip-card-gender.male {
  background-color: #DBEAFE;
}

.vip-gender-icon {
  font-size: 20rpx;
  font-weight: 700;
}

.vip-gender-icon.female {
  color: #E11D48;
}

.vip-gender-icon.male {
  color: #2563EB;
}

.vip-card-bottom {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
}

.vip-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.vip-card-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.vip-card-age {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.vip-card-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background-color: var(--text-muted);
}

.vip-card-height {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 特权区 */
.vip-privilege-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 16rpx;
}

.vip-priv-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.vip-priv-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vip-upgrade-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-full);
  background-color: var(--accent);
}

.vip-upgrade-icon {
  font-size: 28rpx;
}

.vip-upgrade-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-inverse);
}

.vip-priv-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.vip-priv-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background-color: var(--bg-card);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.vip-priv-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #FEF9F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-priv-icon-text {
  font-size: 44rpx;
}

.vip-priv-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.vip-priv-card-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

/* 人气爆灯 */
.vip-spotlight {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 16rpx;
}

.vip-spot-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.vip-spot-title-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.vip-spot-icon {
  font-size: 36rpx;
}

.vip-spot-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vip-spot-count {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
}

.vip-spot-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

.vip-spot-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

.vip-spot-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.vip-spot-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.vip-spot-photo {
  width: 100%;
  height: 200rpx;
  background-color: var(--bg-card-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-spot-photo-icon {
  font-size: 64rpx;
  color: var(--text-muted);
}

.vip-spot-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 20rpx;
}

.vip-spot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.vip-spot-age {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 底部CTA */
.vip-bottom-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 32rpx 48rpx 32rpx;
  background: linear-gradient(135deg, #2D4A3E, #C9A96E);
  border-radius: var(--radius-xl);
}

.vip-cta-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.vip-cta-desc {
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
  line-height: 1.5;
}

.vip-price-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  width: 100%;
}

.vip-price-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background-color: rgba(255, 255, 255, 0.1);
  position: relative;
}

.vip-price-opt.recommended {
  background-color: rgba(201, 169, 110, 0.2);
  border: 2rpx solid var(--gold);
}

.vip-price-badge {
  position: absolute;
  top: -20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background-color: var(--gold);
}

.vip-price-badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.vip-price-period {
  font-size: 24rpx;
  color: #CCCCCC;
}

.vip-price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold);
}

.vip-cta-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-cta-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.vip-cta-hint {
  font-size: 22rpx;
  color: #888888;
  text-align: center;
}

/* ==================== 「我的」页面 ==================== */
.mine-profile-card {
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.mine-profile-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 40rpx 40rpx 40rpx;
}

.mine-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  overflow: hidden;
  background-color: var(--bg-card-soft);
}

.mine-avatar-img {
  width: 100%;
  height: 100%;
}

.mine-nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.mine-user-id {
  font-size: 24rpx;
  color: var(--text-muted);
}

.mine-edit-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: var(--radius-full);
  background-color: var(--accent-soft);
  margin-top: 8rpx;
}

.mine-edit-icon {
  font-size: 26rpx;
  color: var(--accent-dark);
}

.mine-edit-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-dark);
}

.mine-vip-card {
  margin-bottom: 24rpx;
  height: 144rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #2D4A3E, #3D5640, #C9A96E);
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.mine-vip-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.mine-vip-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.mine-vip-crown {
  font-size: 56rpx;
}

.mine-vip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-inverse);
}

.mine-vip-arrow {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold);
}

.mine-features-card {
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.mine-feat-row {
  display: flex;
  flex-direction: row;
  padding: 32rpx 24rpx;
}

.mine-feat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.mine-feat-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-feat-icon {
  font-size: 44rpx;
}

.mine-feat-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.mine-settings-card {
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.mine-setting-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.mine-setting-row:last-child {
  border-bottom: none;
}

.mine-setting-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.mine-setting-icon {
  font-size: 36rpx;
}

.mine-setting-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.mine-setting-arrow {
  font-size: 40rpx;
  font-weight: 400;
  color: var(--text-muted);
}

/* ==================== 个人详情页 ==================== */
.profile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background-color: var(--bg-primary);
  overflow: hidden;
}

/* 全页滚动区：绝对定位撑满，底部 pad 避开底栏 */
.pf-page-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 封面区 */
.pf-cover-area {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.pf-cover-img {
  width: 100%;
  height: 100%;
}

.pf-back-btn {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.pf-back-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.pf-share-btn {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.pf-share-icon {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 700;
  transform: rotate(-45deg);
}

.pf-avatar-circle {
  position: absolute;
  left: 32rpx;
  bottom: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 6rpx solid #FFFFFF;
  background-color: var(--bg-card-soft);
  overflow: hidden;
  z-index: 10;
}

.pf-avatar-img {
  width: 100%;
  height: 100%;
}

/* 个人信息头部 */
.pf-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 56rpx 40rpx 24rpx 40rpx;
  background-color: var(--bg-card);
  flex-shrink: 0;
}

.pf-name-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.pf-name-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.pf-user-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.pf-user-age {
  font-size: 32rpx;
  color: var(--text-secondary);
}

.pf-vip-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background-color: #C9A96E;
}

.pf-vip-crown {
  font-size: 26rpx;
}

.pf-vip-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pf-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.pf-meta-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pf-meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: var(--text-muted);
}

.pf-online {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent-dark);
}

.pf-tag-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pf-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-card-soft);
}

.pf-tag-accent {
  background-color: var(--accent-soft);
}

.pf-tag-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.pf-tag-accent .pf-tag-text {
  color: var(--accent-dark);
}

.pf-bio {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 8rpx;
}

/* 详情内容区 padding 直接放在每个 section-card 的父级上，
   .pf-page-scroll 本身不需要额外 padding，由 cover/header/sections 自己控制 */
.pf-gap {
  height: 24rpx;
}

.pf-section-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  background-color: var(--bg-card);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.pf-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 锁定块 */
.pf-locked-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-card-soft);
}

.pf-lock-icon {
  font-size: 64rpx;
}

.pf-locked-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.pf-locked-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

.pf-unlock-btn {
  padding: 20rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #C9A96E, #E8D5A0);
  margin-top: 8rpx;
}

.pf-unlock-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 资料网格 */
.pf-info-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pf-info-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.pf-info-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--radius-sm);
  background-color: var(--bg-primary);
}

.pf-info-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

.pf-info-value {
  font-size: 26rpx;
  font-weight: 600;
