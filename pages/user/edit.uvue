<template>
	<view class="edit-page">
		<scroll-view class="scroll-content" scroll-y>
			<!-- 头像 -->
			<view class="section">
				<text class="section-title">头像</text>
				<view class="avatar-upload" @click="chooseAvatar">
					<image class="avatar" :src="formData.avatar" mode="aspectFill"></image>
					<view class="upload-mask">
						<text class="icon">📷</text>
						<text class="text">更换头像</text>
					</view>
				</view>
			</view>

			<!-- 相册 -->
			<view class="section">
				<text class="section-title">我的相册 ({{ formData.photos.length }}/9)</text>
				<view class="photo-grid">
					<view class="photo-item" v-for="(photo, index) in formData.photos" :key="index">
						<image class="photo" :src="photo" mode="aspectFill"></image>
						<view class="delete-btn" @click="deletePhoto(index)">
							<text class="icon">✕</text>
						</view>
					</view>
					<view class="photo-item add-btn" @click="addPhoto" v-if="formData.photos.length < 9">
						<text class="icon">+</text>
						<text class="text">添加照片</text>
					</view>
				</view>
			</view>

			<!-- 基本信息 -->
			<view class="section">
				<text class="section-title">基本信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('nickname')">
						<text class="label">昵称</text>
						<input class="value" :value="formData.nickname" placeholder="请输入昵称" />
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('gender')">
						<text class="label">性别</text>
						<text class="value">{{ formData.gender === 1 ? '男' : formData.gender === 2 ? '女' : '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('birthday')">
						<text class="label">生日</text>
						<text class="value">{{ formData.birthday || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('height')">
						<text class="label">身高</text>
						<text class="value">{{ formData.height ? formData.height + 'cm' : '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('location')">
						<text class="label">所在地</text>
						<text class="value">{{ formData.location || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 工作信息 -->
			<view class="section">
				<text class="section-title">工作信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('education')">
						<text class="label">学历</text>
						<text class="value">{{ formData.education || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('occupation')">
						<text class="label">职业</text>
						<text class="value">{{ formData.occupation || '请填写' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('income')">
						<text class="label">月收入</text>
						<text class="value">{{ formData.income || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 婚恋信息 -->
			<view class="section">
				<text class="section-title">婚恋信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('maritalStatus')">
						<text class="label">婚姻状况</text>
						<text class="value">{{ formData.maritalStatus || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('housing')">
						<text class="label">购房情况</text>
						<text class="value">{{ formData.housing || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 个人介绍 -->
			<view class="section">
				<text class="section-title">个人介绍</text>
				<textarea
					class="textarea"
					:value="formData.introduction"
					placeholder="介绍一下你自己，让别人更了解你..."
					maxlength="500"
					@input="onIntroInput"
				></textarea>
				<text class="char-count">{{ formData.introduction.length }}/500</text>
			</view>

			<!-- 择偶要求 -->
			<view class="section">
				<text class="section-title">择偶要求</text>
				<textarea
					class="textarea"
					:value="formData.requirement"
					placeholder="描述你的择偶标准..."
					maxlength="500"
					@input="onRequirementInput"
				></textarea>
				<text class="char-count">{{ formData.requirement.length }}/500</text>
			</view>
		</scroll-view>

		<!-- 底部保存按钮 -->
		<view class="footer">
			<button class="save-btn" @click="handleSave">保存</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 表单数据
	let formData = ref({
		avatar: '/static/avatar-placeholder.png',
		photos: [] as string[],
		nickname: '',
		gender: 0, // 0-未选择 1-男 2-女
		birthday: '',
		height: 0,
		location: '',
		education: '',
		occupation: '',
		income: '',
		maritalStatus: '',
		housing: '',
		introduction: '',
		requirement: ''
	})

	// 选择头像
	const chooseAvatar = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.avatar = res.tempFilePaths[0]
				// TODO: 上传图片到服务器
			}
		})
	}

	// 添加照片
	const addPhoto = () => {
		const remaining = 9 - formData.value.photos.length
		uni.chooseImage({
			count: remaining,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.photos.push(...res.tempFilePaths)
				// TODO: 上传图片到服务器
			}
		})
	}

	// 删除照片
	const deletePhoto = (index: number) => {
		uni.showModal({
			title: '提示',
			content: '确定删除这张照片吗？',
			success: (res) => {
				if (res.confirm) {
					formData.value.photos.splice(index, 1)
				}
			}
		})
	}

	// 显示选择器
	const showPicker = (field: string) => {
		// TODO: 根据不同字段显示不同的选择器
		uni.showToast({
			title: '选择器开发中',
			icon: 'none'
		})
	}

	// 输入事件
	const onIntroInput = (e: InputEvent) => {
		formData.value.introduction = e.detail.value
	}

	const onRequirementInput = (e: InputEvent) => {
		formData.value.requirement = e.detail.value
	}

	// 保存
	const handleSave = () => {
		// 验证必填项
		if (!formData.value.nickname) {
			uni.showToast({
				title: '请输入昵称',
				icon: 'none'
			})
			return
		}

		if (formData.value.gender === 0) {
			uni.showToast({
				title: '请选择性别',
				icon: 'none'
			})
			return
		}

		// TODO: 调用保存接口
		uni.showToast({
			title: '保存成功',
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}
</script>

<style scoped>
.edit-page {
	min-height: 100vh;
	background: var(--canvas);
	padding-bottom: 80px;
}

.scroll-content {
	height: calc(100vh - 80px);
}

.section {
	margin-bottom: 12px;
	padding: 20px 24px;
	background: var(--surface);
}

.section-title {
	display: block;
	font-size: 16px;
	font-weight: 500;
	color: var(--ink);
	margin-bottom: 16px;
}

.avatar-upload {
	position: relative;
	width: 100px;
	height: 100px;
	margin: 0 auto;
}

.avatar {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}

.upload-mask {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 32px;
	background: rgba(0, 0, 0, 0.6);
	border-radius: 0 0 50% 50%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.upload-mask .icon {
	font-size: 14px;
	color: #FFFFFF;
}

.upload-mask .text {
	font-size: 10px;
	color: #FFFFFF;
}

.photo-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 12px;
}

.photo-item {
	position: relative;
	aspect-ratio: 1;
	border-radius: 8px;
	overflow: hidden;
}

.photo {
	width: 100%;
	height: 100%;
}

.delete-btn {
	position: absolute;
	top: 4px;
	right: 4px;
	width: 24px;
	height: 24px;
	background: rgba(0, 0, 0, 0.6);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.delete-btn .icon {
	color: #FFFFFF;
	font-size: 16px;
}

.add-btn {
	background: var(--paper);
	border: 1px dashed var(--line);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4px;
}

.add-btn .icon {
	font-size: 32px;
	color: var(--muted);
}

.add-btn .text {
	font-size: 12px;
	color: var(--muted);
}

.form-list {
	border-radius: 8px;
	overflow: hidden;
}

.form-item {
	display: flex;
	align-items: center;
	height: 52px;
	border-bottom: 1px solid var(--line);
}

.form-item:last-child {
	border-bottom: none;
}

.form-item .label {
	width: 80px;
	font-size: 14px;
	color: var(--ink);
	flex-shrink: 0;
}

.form-item .value {
	flex: 1;
	font-size: 14px;
	color: var(--ink2);
	text-align: right;
}

.form-item .arrow {
	width: 20px;
	font-size: 20px;
	color: var(--muted);
	text-align: right;
}

.textarea {
	width: 100%;
	min-height: 120px;
	padding: 12px;
	background: var(--paper);
	border: 1px solid var(--line);
	border-radius: 8px;
	font-size: 14px;
	color: var(--ink);
	line-height: 1.6;
}

.char-count {
	display: block;
	text-align: right;
	font-size: 12px;
	color: var(--muted);
	margin-top: 8px;
}

.footer {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	padding: 12px 24px;
	background: var(--surface);
	border-top: 1px solid var(--line);
}

.save-btn {
	width: 100%;
	height: 48px;
	background: var(--accent);
	color: #FFFFFF;
	border-radius: 999px;
	font-size: 16px;
	font-weight: 500;
}
</style>
