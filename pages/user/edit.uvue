<template>
	<view class="edit-page">
		<!-- 导航栏 -->
		<view class="nav-bar">
			<text class="nav-title active">编辑资料</text>
			<text class="nav-title muted" @tap="onPreview">主页预览</text>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="false">
			<!-- 资料完整度进度条 -->
			<view class="progress-section">
				<view class="progress-header">
					<text class="progress-label">资料完整度</text>
					<text class="progress-pct">{{ completeness }}%</text>
				</view>
				<view class="progress-bar-bg">
					<view class="progress-bar-fill" :style="{ width: completeness + '%' }"></view>
				</view>
				<text class="progress-hint">资料越完整，推荐权重越高，更容易遇见对的人</text>
			</view>

			<!-- 头像区 -->
			<view class="section-card">
				<view class="section-card-header">
					<text class="section-title">头像</text>
					<view class="change-bg-btn" @tap="changeBackground">
						<text class="change-bg-text">更换背景</text>
						<text class="change-bg-arrow">›</text>
					</view>
				</view>
				<view class="avatar-row">
					<view class="avatar-circle" @tap="chooseAvatar">
						<image class="avatar-img" :src="formData.avatar" mode="aspectFill"></image>
						<view class="camera-badge">
							<text class="camera-icon">📷</text>
						</view>
					</view>
					<view class="photo-item add-btn" @click="addPhoto" v-if="formData.photos.length < 9">
						<text class="icon">+</text>
						<text class="text">添加照片</text>
					</view>
				</view>
			</view>

			<!-- 基本信息 -->
			<view class="section">
				<text class="section-title">基本信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('nickname')">
						<text class="label">昵称</text>
						<input class="value" :value="formData.nickname" placeholder="请输入昵称" />
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('gender')">
						<text class="label">性别</text>
						<text class="value">{{ formData.gender === 1 ? '男' : formData.gender === 2 ? '女' : '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('birthday')">
						<text class="label">生日</text>
						<text class="value">{{ formData.birthday || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('height')">
						<text class="label">身高</text>
						<text class="value">{{ formData.height ? formData.height + 'cm' : '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('location')">
						<text class="label">所在地</text>
						<text class="value">{{ formData.location || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 工作信息 -->
			<view class="section">
				<text class="section-title">工作信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('education')">
						<text class="label">学历</text>
						<text class="value">{{ formData.education || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('occupation')">
						<text class="label">职业</text>
						<text class="value">{{ formData.occupation || '请填写' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('income')">
						<text class="label">月收入</text>
						<text class="value">{{ formData.income || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 婚恋信息 -->
			<view class="section">
				<text class="section-title">婚恋信息</text>
				<view class="form-list">
					<view class="form-item" @click="showPicker('maritalStatus')">
						<text class="label">婚姻状况</text>
						<text class="value">{{ formData.maritalStatus || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
					<view class="form-item" @click="showPicker('housing')">
						<text class="label">购房情况</text>
						<text class="value">{{ formData.housing || '请选择' }}</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 个人介绍 -->
			<view class="section">
				<text class="section-title">个人介绍</text>
				<textarea
					class="textarea"
					:value="formData.introduction"
					placeholder="介绍一下你自己，让别人更了解你..."
					maxlength="500"
					@input="onIntroInput"
				></textarea>
				<text class="char-count">{{ formData.introduction.length }}/500</text>
			</view>

			<!-- 择偶要求 -->
			<view class="section">
				<text class="section-title">择偶要求</text>
				<textarea
					class="textarea"
					:value="formData.requirement"
					placeholder="描述你的择偶标准..."
					maxlength="500"
					@input="onRequirementInput"
				></textarea>
				<text class="char-count">{{ formData.requirement.length }}/500</text>
			</view>
		</scroll-view>

		<!-- 底部保存按钮 -->
		<view class="footer">
			<button class="save-btn" @click="handleSave">保存</button>
		</view>
	</view>
</template>

<script setup lang="uts">
		// 表单数据（默认对齐高保真编辑资料演示）
		let formData = ref({
			avatar: '/static/portraits/profile-woman-main.jpg',
			photos: [
				'/static/portraits/profile-woman-main.jpg',
				'/static/portraits/profile-woman-alt.jpg'
			] as string[],
			nickname: '苏晚晴',
			gender: 2, // 0-未选择 1-男 2-女
			birthday: '1998-05-15',
			height: 165,
			location: '杭州',
			education: '本科',
			occupation: '插画师',
			income: '15k—30k',
			maritalStatus: '未婚',
			housing: '',
			introduction: '喜欢画画、猫和下雨天。周末常在西湖边写生，希望找到能一起看展、一起发呆的人。',
			requirement: '愿意把真实想法说清楚，不用猜来猜去。各自有生活，也愿意为共同计划留出时间。把长期关系当作两个人一起完成的作品。'
		})

	// 表单数据
	const formData = ref({
		avatar: '/static/portraits/profile-woman-main.jpg',
		coverBg: '/static/portraits/profile-woman-alt.jpg',
		photos: [
			'/static/portraits/profile-woman-main.jpg',
			'/static/portraits/profile-woman-alt.jpg'
		] as string[],
		nickname: '苏晚晴',
		gender: 2,
		genderLabel: '女',
		birthday: '1998-05-15',
		height: 165,
		weight: 48,
		location: '北京',
		hometown: '杭州',
		education: '本科 · 北京大学',
		occupation: '产品经理',
		company: '字节跳动',
		income: '30-50万',
		maritalStatus: '未婚',
		mbti: 'ENFJ',
		goal: '希望在2年内遇到对的人',
		wechat: '',
		introduction: '',
		requirement: ''
	})

	// 基础信息编辑 sheet 可见性
	const basicInfoEditVisible = ref(false)

	// 资料完整度
	const completeness = computed(() => {
		let score = 0
		let total = 7
		if (formData.value.avatar) score++
		if (formData.value.photos.length >= 1) score++
		if (formData.value.location) score++
		if (formData.value.occupation) score++
		if (formData.value.introduction) score++
		if (selectedTags.value.length >= 3) score++
		if (loveQuestions.value.some(q => q.answer)) score++
		return Math.round((score / total) * 100)
	})

	// 认证数据
	const completedCerts = computed(() => certs.value.filter(c => c.done).length)
	const certs = ref([
		{ key: 'realname', label: '实名认证', desc: '已通过平台实名认证', icon: '🛡', done: true },
		{ key: 'education', label: '学历认证', desc: '学历信息已核验', icon: '🎓', done: true },
		{ key: 'avatar', label: '头像认证', desc: '上传真实本人照片', icon: '📷', done: false },
		{ key: 'marriage', label: '婚况认证', desc: '提交婚况证明材料', icon: '💍', done: false }
	])

	// 标签数据
	const allTags = [
		'文艺青年', '旅行达人', '美食控', '健身',
		'摄影', '音乐', '宠物', '户外',
		'游戏', '宅', '读书', '咖啡控'
	]
	const tagRows = computed(() => {
		const rows: string[][] = []
		for (let i = 0; i < allTags.length; i += 4) {
			rows.push(allTags.slice(i, i + 4))
		}
		return rows
	})
	const selectedTags = ref<string[]>([
		'旅行达人', '文艺青年', '健身', '摄影', '宠物'
	])

	const toggleTag = (tag: string) => {
		const idx = selectedTags.value.indexOf(tag)
		if (idx >= 0) {
			selectedTags.value.splice(idx, 1)
		} else if (selectedTags.value.length < 20) {
			selectedTags.value.push(tag)
		}
	}

	const addCustomTag = () => {
		uni.showToast({ title: '自定义标签功能开发中', icon: 'none' })
	}

	// 关于我 问答
	const loveQuestions = ref([
		{ id: 1, question: '你理想中的另一半是什么样的', answer: '' },
		{ id: 2, question: '喜欢什么运动', answer: '' },
		{ id: 3, question: '你期待的爱情是什么样子的', answer: '' }
	])

	const editQA = (q: any) => {
		uni.showToast({ title: '问答编辑功能开发中', icon: 'none' })
	}

	// 更换背景
	const changeBackground = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.coverBg = res.tempFilePaths[0]
				uni.showToast({ title: '背景已更换', icon: 'success' })
			}
		})
	}

	// 头像
	const chooseAvatar = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.avatar = res.tempFilePaths[0]
				// TODO: 上传图片到服务器
			}
		})
	}

	// 添加照片
	const addPhoto = () => {
		const remaining = 9 - formData.value.photos.length
		uni.chooseImage({
			count: remaining,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.photos.push(...res.tempFilePaths)
				// TODO: 上传图片到服务器
			}
		})
	}

	// 删除照片
	const deletePhoto = (index: number) => {
		uni.showModal({
			title: '提示',
			content: '确定删除这张照片吗？',
			success: (res) => {
				if (res.confirm) {
					formData.value.photos.splice(index, 1)
				}
			}
		})
	}

	// 显示选择器
	const showPicker = (field: string) => {
		// TODO: 根据不同字段显示不同的选择器
		uni.showToast({
			title: '选择器开发中',
			icon: 'none'
		})
	}

	// 输入事件
	const onIntroInput = (e: InputEvent) => {
		formData.value.introduction = e.detail.value
	}

	const onRequirementInput = (e: InputEvent) => {
		formData.value.requirement = e.detail.value
	}

	// 保存
	const handleSave = () => {
		// 验证必填项
		if (!formData.value.nickname) {
			uni.showToast({
				title: '请输入昵称',
				icon: 'none'
			})
			return
		}

		if (formData.value.gender === 0) {
			uni.showToast({
				title: '请选择性别',
				icon: 'none'
			})
			return
		}

		// TODO: 调用保存接口
		uni.showToast({
			title: '保存成功',
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}
</script>

<style scoped>
.edit-page {
	min-height: 100vh;
	background: var(--canvas);
	padding-bottom: 80px;
}

.scroll-content {
	height: calc(100vh - 80px);
}

.section {
	margin-bottom: 12px;
	padding: 20px 24px;
	background: var(--surface);
}

.section-title {
	font-size: 32rpx;
	font-weight: 700;
	color: var(--ink);
}
.section-card-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 4rpx;
}
.change-bg-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4rpx;
	padding: 8rpx 16rpx;
	border-radius: 9999rpx;
	background-color: var(--warm);
}
.change-bg-text {
	font-size: 24rpx;
	color: var(--muted);
}
.change-bg-arrow {
	font-size: 28rpx;
	color: var(--muted);
}
.card-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
.card-count {
	font-size: 26rpx;
	font-weight: 500;
	color: var(--ink);
	margin-bottom: 16px;
}

.avatar-upload {
	position: relative;
	width: 100px;
	height: 100px;
	margin: 0 auto;
}

.avatar {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}

.upload-mask {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 32px;
	background: rgba(0, 0, 0, 0.6);
	border-radius: 0 0 50% 50%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.upload-mask .icon {
	font-size: 14px;
	color: var(--text-invert);
}

.upload-mask .text {
	font-size: 10px;
	color: var(--text-invert);
}

.photo-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 12px;
}

.photo-item {
	position: relative;
	aspect-ratio: 1;
	border-radius: 8px;
	overflow: hidden;
}

.photo {
	width: 100%;
	height: 100%;
}

.delete-btn {
	position: absolute;
	top: 4px;
	right: 4px;
	width: 24px;
	height: 24px;
	background: rgba(0, 0, 0, 0.6);
	border-radius: 50%;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
}

.delete-btn .icon {
	color: var(--text-invert);
	font-size: 16px;
}

.add-btn {
	background: var(--paper);
	border: 1px dashed var(--line);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4px;
}

.add-btn .icon {
	font-size: 32px;
	color: var(--muted);
}

.add-btn .text {
	font-size: 12px;
	color: var(--muted);
}

.form-list {
	border-radius: 8px;
	overflow: hidden;
}

.form-item {
	display: flex;
		flex-direction: row;
	align-items: center;
	height: 52px;
	border-bottom: 1px solid var(--line);
}

.form-item:last-child {
	border-bottom: none;
}

.form-item .label {
	width: 80px;
	font-size: 14px;
	color: var(--ink);
	flex-shrink: 0;
}

.form-item .value {
	flex: 1;
	font-size: 14px;
	color: var(--ink2);
	text-align: right;
}

.form-item .arrow {
	width: 20px;
	font-size: 20px;
	color: var(--muted);
	text-align: right;
}

.textarea {
	width: 100%;
	min-height: 120px;
	padding: 12px;
	background: var(--paper);
	border: 1px solid var(--line);
	border-radius: 8px;
	font-size: 14px;
	color: var(--ink);
	line-height: 1.6;
}

.char-count {
	display: block;
	text-align: right;
	font-size: 12px;
	color: var(--muted);
	margin-top: 8px;
}

.footer {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	padding: 12px 24px;
	background: var(--surface);
	border-top: 1px solid var(--line);
}

.save-btn {
	width: 100%;
	height: 48px;
	background: var(--accent);
	color: var(--text-invert);
	border-radius: 999px;
	font-size: 16px;
	font-weight: 500;
}
</style>
