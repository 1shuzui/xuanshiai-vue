<template>
	<view class="page">
		<view class="profile-content" :class="{ 'profile-locked': isLockedView && !isHomeProfileEntry && !isCommunityProfileEntry }">
		<!-- ==================== 封面区 ==================== -->
		<view class="cover-area">
			<image class="cover-img" :src="user.cover" mode="aspectFill"></image>
			<!-- 返回按钮 -->
			<view class="back-btn" @tap="onBack">
				<text class="back-icon">←</text>
			</view>
			<!-- 分享按钮 -->
			<view class="share-btn" @tap="onShare">
				<text class="share-icon">↗</text>
			</view>
		</view>

		<!-- 头像：独立于 cover-area，不被 profile-header 背景遮挡 -->
		<view class="avatar-circle">
			<image class="avatar-img" :src="user.avatar" mode="aspectFill"></image>
		</view>

		<!-- ==================== 个人信息头部 ==================== -->
		<view class="profile-header">
			<!-- 姓名 + VIP Badge -->
			<view class="name-vip-row">
				<view class="name-group">
					<text class="profile-name">{{ user.name }}</text>
					<text class="profile-age">{{ user.age }}岁</text>
				</view>
				<view class="vip-badge" v-if="user.isVIP">
					<text class="vip-crown">👑</text>
					<text class="vip-badge-text">VIP会员</text>
				</view>
			</view>

			<!-- 元信息行 -->
			<view class="meta-row">
				<text class="meta-text">{{ user.job }} · {{ user.edu }}</text>
				<view class="meta-dot"></view>
				<text class="meta-text">{{ user.city }}</text>
				<view class="meta-dot"></view>
				<text class="online-text">在线</text>
			</view>

			<!-- 标签行 -->
			<view class="tag-row">
				<view class="tag tag-accent" v-for="tag in user.tags" :key="tag">
					<text class="tag-text-accent">{{ tag }}</text>
				</view>
			</view>

			<!-- 个人简介 -->
			<text class="bio-text">{{ user.bio }}</text>
		</view>

		<!-- 头像：独立于 cover-area，不被 profile-header 背景遮挡 -->
		<view class="avatar-circle">
			<image class="avatar-img" :src="user.avatar" mode="aspectFill"></image>
		</view>

		<!-- ==================== 滚动详情内容 ==================== -->
		<scroll-view scroll-y class="detail-scroll" enhanced show-scrollbar="false">
			<!-- ===== 基础资料 ===== -->
			<view class="section-card">
				<text class="section-title">基础资料</text>

				<!-- 非VIP看VIP：锁定状态 -->
				<view class="locked-block" v-if="isLockedView">
					<text class="lock-icon">🔒</text>
					<text class="locked-title">VIP会员专属内容</text>
					<text class="locked-desc">开通VIP会员即可查看Ta的详细资料</text>
					<view class="unlock-btn" @tap="onUnlock">
						<text class="unlock-btn-text">立即解锁</text>
					</view>
				</view>

				<!-- 自己/VIP看：完整资料 -->
				<view class="info-grid" v-else>
					<view class="info-row" v-for="(row, ri) in user.basicInfo" :key="ri">
						<view class="info-cell" v-for="(item, ii) in row" :key="ii">
							<text class="info-label">{{ item.label }}</text>
							<text class="info-value">{{ item.value }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 卡片间距 -->
			<view class="card-gap"></view>

			<!-- ===== 认证信息（始终可见） ===== -->
			<view class="section-card">
				<text class="section-title">认证信息</text>
				<view class="cert-item" v-for="cert in certs" :key="cert.label">
					<view class="cert-icon-wrap">
						<text class="cert-emoji">{{ cert.icon }}</text>
					</view>
					<view class="cert-text-wrap">
						<text class="cert-label">{{ cert.label }}</text>
						<text class="cert-desc">{{ cert.desc }}</text>
					</view>
					<text class="cert-check">✓</text>
				</view>
			</view>

			<!-- 卡片间距 -->
			<view class="card-gap"></view>

			<!-- ===== Ta的语音 ===== -->
			<view class="section-card">
				<text class="section-title">Ta的语音</text>

				<!-- 锁定状态 -->
				<view class="locked-block" v-if="isLockedView">
					<text class="lock-icon">🔒</text>
					<text class="locked-title">VIP会员专属内容</text>
					<text class="locked-desc">开通VIP会员即可解锁Ta的语音介绍</text>
					<view class="unlock-btn" @tap="onUnlock">
						<text class="unlock-btn-text">立即解锁</text>
					</view>
				</view>

				<!-- 解锁状态：语音播放器 -->
				<view class="voice-content" v-else>
					<view class="voice-card">
						<view class="voice-play-btn">
							<text class="voice-play-icon">▶</text>
						</view>
						<view class="voice-info">
							<text class="voice-title">听听Ta的声音</text>
							<text class="voice-duration">00:32</text>
						</view>
						<view class="voice-wave">
							<view class="wave-bar" v-for="i in 7" :key="i" :style="{ height: (15 + Math.sin(i * 0.8) * 12) + 'px' }"></view>
						</view>
					</view>
				</view>
			</view>

			<!-- 卡片间距 -->
			<view class="card-gap"></view>

			<!-- ===== 择偶要求 ===== -->
			<view class="section-card">
				<text class="section-title">理想另一半择偶要求</text>

				<!-- 锁定状态 -->
				<view class="locked-block" v-if="isLockedView">
					<text class="lock-icon">💝</text>
					<text class="locked-title">VIP会员专属内容</text>
					<text class="locked-desc">开通VIP会员即可查看TA的择偶标准与期待</text>
					<view class="unlock-btn" @tap="onUnlock">
						<text class="unlock-btn-text">立即解锁</text>
					</view>
				</view>

				<!-- 解锁状态 -->
				<view class="requirements-content" v-else>
					<view class="req-item">
						<text class="req-label">年龄范围</text>
						<text class="req-value">25-35岁</text>
					</view>
					<view class="req-item">
						<text class="req-label">身高要求</text>
						<text class="req-value">175cm以上</text>
					</view>
					<view class="req-item">
						<text class="req-label">学历要求</text>
						<text class="req-value">本科及以上</text>
					</view>
					<view class="req-item">
						<text class="req-label">性格特点</text>
						<text class="req-value">成熟稳重，有责任心，幽默风趣</text>
					</view>
					<text class="req-note">相信爱情是两个人相互成就的旅程。期待双向奔赴的美好，一起经营温暖的小日子。不需要轰轰烈烈，但求细水长流的陪伴与理解。</text>
				</view>
			</view>

			<!-- 卡片间距 -->
			<view class="card-gap"></view>

			<!-- ===== 人气爆灯 ===== -->
			<view class="section-card">
				<view class="spot-header">
					<view class="spot-title-group">
						<text class="spot-flame">🔥</text>
						<text class="spot-title">人气爆灯</text>
						<text class="spot-count">32人</text>
					</view>
					<text class="spot-more">查看全部 →</text>
				</view>

				<!-- 访客头像行 -->
				<view class="visitor-row">
					<view class="visitor-avatar" v-for="v in visitors" :key="v.name">
						<image class="visitor-img" :src="v.avatar" mode="aspectFill"></image>
					</view>
					<text class="visitor-more">+26人</text>
				</view>

				<text class="spot-desc">非常中意Ta？爆灯后系统将立即短信通知对方，您的头像将显示在此处，让Ta第一时间注意到你！</text>

				<!-- 权益卡片 -->
				<view class="benefits-row">
					<view class="benefit-card">
						<text class="benefit-icon">📱</text>
						<text class="benefit-text">短信通知</text>
					</view>
					<view class="benefit-card">
						<text class="benefit-icon">👤</text>
						<text class="benefit-text">头像展示</text>
					</view>
					<view class="benefit-card">
						<text class="benefit-icon">⭐</text>
						<text class="benefit-text">优先关注</text>
					</view>
				</view>

				<!-- 价格 -->
				<view class="price-row">
					<text class="price-label">单次爆灯</text>
					<text class="price-value">¥9.9</text>
					<text class="price-unit">/次</text>
				</view>

				<!-- CTA按钮 -->
				<view class="spot-cta-btn" @tap="onSpotlight">
					<text class="spot-cta-icon">💡</text>
					<text class="spot-cta-text">我要爆灯</text>
				</view>
			</view>

			<!-- 底部留白 -->
			<view class="scroll-bottom-spacer"></view>
		</scroll-view>

		<!-- ==================== 底部操作栏 ==================== -->
		<view class="bottom-bar">
			<view class="bottom-home" @tap="onBack">
				<text class="bottom-home-icon">←</text>
				<text class="bottom-home-text">返回</text>
			</view>
			<view class="match-btn" @tap="onMatch">
				<text class="match-heart">♥</text>
				<text class="match-text">申请认识</text>
			</view>
			<view class="bottom-like" @tap="onLike">
				<text class="like-heart">♥</text>
			</view>
		</view>

		<!-- 头像：独立于 cover-area，不被 profile-header 背景遮挡 -->
		<view class="avatar-circle">
			<image class="avatar-img" :src="user.avatar" mode="aspectFill"></image>
		</view>

		<!-- 申请认识：与社区同源 XsaApplySheet -->
		</view>

		<view v-if="isLockedView && !isHomeProfileEntry && !isCommunityProfileEntry" class="profile-unlock-mask">
			<view class="profile-unlock-dialog">
				<text class="profile-unlock-icon">🔒</text>
				<text class="profile-unlock-title">50积分解锁全部资料</text>
				<text class="profile-unlock-desc">包含 VIP 专属内容</text>
				<text class="profile-unlock-points">当前积分：{{ profilePoints }}</text>
				<view class="profile-unlock-btn" @tap="onProfileUnlock">
					<text>{{ profileUnlocking ? '解锁中...' : '去解锁' }}</text>
				</view>
			</view>
		</view>

		<XsaApplySheet
			:visible="applyVisible"
			:user-id="applyUserId"
			@close="applyVisible = false"
			@success="onApplySuccess"
		/>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import XsaApplySheet from '@/components/XsaApplySheet.uvue'
import { getUserDetail, getUserProfileUnlockStatus, likeUser, unlockUserProfile } from '@/api'
import { guardRealName } from '@/utils/realNameGate.uts'

const isLockedView = ref(true)
const isHomeProfileEntry = ref(false)
const isCommunityProfileEntry = ref(false)
const isOwnProfile = ref(false)
const viewerIsVIP = ref(false)
const applyVisible = ref(false)
const applyUserId = ref(1)
const profilePoints = ref(0)
const profileUnlocking = ref(false)

const user = ref({
	id: 1,
	name: '林悦',
	age: '26',
	avatar: '/static/portraits/profile-woman-main.jpg',
	cover: '/static/portraits/profile-woman-community.jpg',
	isVIP: true,
	job: '产品经理',
	edu: '本科',
	city: '北京',
	tags: ['积极营业', 'ENFJ', '颜控', '旅行', '摄影'],
	bio: '性格温和，热爱生活～ 平时喜欢旅行探索世界，也享受宅家的宁静时光。希望遇到一个真诚的人，一起经营温暖的小日子。🌿',
	basicInfo: [
		[
			{ label: '年龄', value: '26岁' },
			{ label: '身高', value: '168cm' },
			{ label: '体重', value: '52kg' }
		],
		[
			{ label: '星座', value: '天秤座' },
			{ label: '学历', value: '本科' },
			{ label: '职业', value: '产品经理' }
		],
		[
			{ label: '现居', value: '北京朝阳' },
			{ label: '家乡', value: '浙江杭州' },
			{ label: '收入', value: '30-50万' }
		],
		[
			{ label: '婚姻', value: '未婚' },
			{ label: '房车', value: '有房' },
			{ label: '烟酒', value: '不吸烟' }
		]
	]
})

const certs = ref([
	{ icon: '🛡', label: '实名认证', desc: '已通过身份证实名验证' },
	{ icon: '🎓', label: '学历认证', desc: '本科学历已认证' },
	{ icon: '💍', label: '婚恋状态', desc: '民政局数据核验' },
	{ icon: '📷', label: '真人头像', desc: '已通过AI人脸比对' }
])

const visitors = ref([
	{ name: '张伟', avatar: '/static/portraits/profile-woman-alt.jpg' },
	{ name: '李明', avatar: '/static/portraits/profile-man-light.jpg' },
	{ name: '王强', avatar: '/static/portraits/profile-man-sea.jpg' },
	{ name: '刘洋', avatar: '/static/portraits/profile-woman-community.jpg' },
	{ name: '陈晨', avatar: '/static/portraits/profile-woman-main.jpg' }
])

onMounted(() => {
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options

	// 通过参数判断：自己的主页 or 浏览别人
	if (options.own === 'true') {
		// 看自己的 → 所有内容可见
		isLockedView.value = false
		isOwnProfile.value = true
	} else if (options.viewerVIP === 'true') {
		// 当前用户是VIP → 可以看全部
		isLockedView.value = false
		viewerIsVIP.value = true
	} else {
		// 非VIP看VIP用户 → 锁定敏感内容
		isLockedView.value = true
	}

	// 从路由带入目标用户 id，供申请认识 / 喜欢使用
	if (options.userId != null && options.userId != '') {
		let parsed = Number(options.userId)
		if (!isNaN(parsed) && parsed > 0) {
			user.value.id = parsed
			applyUserId.value = parsed
		}
	}
})

const loadRoutedUserDetail = async (userId: number) => {
	try {
		const res = await getUserDetail(userId)
		if (res == null || !res.success || res.data == null) return
		const data = res.data as any
		const age = data.age != null ? '' + data.age : '未知'
		const education = data.education != null ? '' + data.education : (data.edu != null ? '' + data.edu : '未填写')
		const avatar = data.avatar != null ? '' + data.avatar : user.value.avatar
		const photos = Array.isArray(data.photos) ? data.photos as string[] : []
		const cover = photos.length > 0 && photos[0] != null ? '' + photos[0] : avatar
		const tags = Array.isArray(data.tags) ? data.tags as string[] : []
		user.value = {
			id: data.id != null ? Number(data.id) : userId,
			name: data.name != null ? '' + data.name : user.value.name,
			age,
			avatar,
			cover,
			isVIP: data.isVIP != false,
			job: data.job != null ? '' + data.job : '未填写',
			edu: education,
			city: data.city != null ? '' + data.city : '未填写',
			tags,
			bio: data.introduction != null ? '' + data.introduction : (data.intro != null ? '' + data.intro : '这个人暂未填写个人介绍。'),
			basicInfo: [
				[
					{ label: '年龄', value: age + '岁' },
					{ label: '身高', value: data.height != null ? '' + data.height : '未填写' },
					{ label: '体重', value: data.weight != null ? '' + data.weight : '未填写' }
				],
				[
					{ label: '星座', value: data.constellation != null ? '' + data.constellation : '未填写' },
					{ label: '学历', value: education },
					{ label: '职业', value: data.job != null ? '' + data.job : '未填写' }
				],
				[
					{ label: '现居', value: data.city != null ? '' + data.city : '未填写' },
					{ label: '家乡', value: data.hometown != null ? '' + data.hometown : '未填写' },
					{ label: '收入', value: data.income != null ? '' + data.income : '未填写' }
				],
				[
					{ label: '婚姻', value: data.marriage != null ? '' + data.marriage : '未填写' },
					{ label: 'MBTI', value: data.mbti != null ? '' + data.mbti : '未填写' },
					{ label: '状态', value: data.activeStatus != null ? '' + data.activeStatus : '未填写' }
				]
			]
		}
		applyUserId.value = user.value.id
	} catch (e) {
		console.error('加载用户详情失败', e)
	}
}

const loadProfileUnlockState = async (userId: number) => {
	if (isHomeProfileEntry.value || isCommunityProfileEntry.value) return
	if (isOwnProfile.value || viewerIsVIP.value) {
		isLockedView.value = false
		return
	}
	try {
		const res = await getUserProfileUnlockStatus(userId)
		if (res != null && res.success && res.data != null) {
			const data = res.data as any
			profilePoints.value = data.points != null ? Number(data.points) : 0
			isLockedView.value = data.unlocked != true
		}
	} catch (e) {
		console.error('加载资料解锁状态失败', e)
	}
}

const onProfileUnlock = async () => {
	if (profileUnlocking.value || isOwnProfile.value) return
	profileUnlocking.value = true
	try {
		const res = await unlockUserProfile(user.value.id)
		const data = res != null ? res.data as any : null
		if (res != null && res.success && data != null && data.success == true) {
			profilePoints.value = data.points != null ? Number(data.points) : profilePoints.value
			isLockedView.value = false
			uni.showModal({
				title: '资料已解锁',
				content: '积分 -50，剩余 ' + profilePoints.value + ' 积分',
				showCancel: false,
				confirmText: '知道了'
			})
			return
		}
		uni.showModal({
			title: '暂时无法解锁',
			content: data != null && data.message != null ? '' + data.message : '积分不足，无法解锁全部资料',
			showCancel: false,
			confirmText: '知道了'
		})
	} catch (e) {
		uni.showToast({ title: '解锁失败，请稍后重试', icon: 'none' })
	} finally {
		profileUnlocking.value = false
	}
}

onMounted(async () => {
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	isHomeProfileEntry.value = options.source == 'home'
	isCommunityProfileEntry.value = options.source == 'community'
	const userId = options.userId != null && options.userId != '' && Number(options.userId) > 0 ? Number(options.userId) : 1
	await loadRoutedUserDetail(userId)
	await loadProfileUnlockState(user.value.id)
})

const onBack = () => {
	uni.navigateBack({ delta: 1 })
}
const onShare = () => {
	uni.showToast({ title: '分享给朋友', icon: 'none' })
}
const onUnlock = () => {
	uni.navigateTo({ url: '/pages/profile/vip' })
}
const onSpotlight = () => {
	uni.showToast({ title: '爆灯成功！', icon: 'none' })
}
// 产品约束：先申请认识，双方同意后才能聊天；统一走 XsaApplySheet
const onMatch = () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己申请认识', icon: 'none' })
		return
	}
	const id = user.value.id != null ? Number(user.value.id) : 1
	applyUserId.value = id
	applyVisible.value = true
}
const onApplySuccess = (_payload: any) => {
	applyVisible.value = false
	uni.showToast({ title: '申请已送达，等待对方回应', icon: 'none' })
}
// 用户级喜欢：写入 mockLikedUserIds，与帖子点赞/收藏分离
const onLike = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能喜欢自己', icon: 'none' })
		return
	}
	const ok = await guardRealName('like')
	if (!ok) return
	const id = user.value.id != null ? Number(user.value.id) : 1
	try {
		const res = await likeUser(id)
		if (res.success && res.data != null) {
			const liked = res.data.liked == true
			uni.showToast({
				title: liked ? '已喜欢，仅你自己可见' : '已取消喜欢',
				icon: 'none'
			})
		} else {
			uni.showToast({ title: '操作失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '操作失败，请重试', icon: 'none' })
	}
}
</script>

<style scoped>
/* ==================== 页面容器 ==================== */
.page {
	position: relative;
	width: 100%;
	max-width: 750rpx;
	min-height: 100vh;
	margin: 0 auto;
	background-color: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* ==================== 封面区 ==================== */
.profile-content {
	position: relative;
	min-height: 100vh;
	display: flex;
	flex: 1;
	flex-direction: column;
}

.profile-content.profile-locked {
	filter: blur(12px);
	opacity: 0.58;
	pointer-events: none;
}

.profile-unlock-mask {
	position: fixed;
	top: 0;
