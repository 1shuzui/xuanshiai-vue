		const basicInfo: any[] = []
		if (profile != null && !detailLocked) {
			basicInfo.push({ label: '身高', value: profile.height != null ? profile.height + ' cm' : '未填写' })
			basicInfo.push({ label: '学历', value: educationText(profile.education_level) })
			basicInfo.push({ label: '职业', value: textValue(profile.occupation) })
			basicInfo.push({ label: '婚姻', value: textValue(profile.is_married == 1 ? '未婚' : profile.is_married == 2 ? '离异' : profile.is_married == 3 ? '丧偶' : null) })
			basicInfo.push({ label: '常住地', value: textValue(profile.residence_city_code || profile.residence_province_code) })
			basicInfo.push({ label: 'MBTI', value: textValue(profile.mbti) })
		}
		const selections = profile != null && profile.tag_selections != null ? profile.tag_selections : {}
