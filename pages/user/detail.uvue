	basicInfo: [
		[{ label: '年龄', value: '26岁' }, { label: '身高', value: '168cm' }, { label: '体重', value: '52kg' }],
		[{ label: '星座', value: '天秤座' }, { label: '学历', value: '本科' }, { label: '职业', value: '产品经理' }],
		[{ label: '现居', value: '北京朝阳' }, { label: '家乡', value: '浙江杭州' }, { label: '收入', value: '30-50万' }]
