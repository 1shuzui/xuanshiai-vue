	const weight = textValue(source.weight, '52kg')
	const constellation = textValue(source.constellation, '天秤座')
	const hometown = textValue(source.hometown, '浙江杭州')
	const income = textValue(source.income, textValue(source.salary, '30-50万'))
	const marriage = textValue(source.marriage, '未填写')
	const mbti = textValue(source.mbti, '未填写')
	const activeStatus = textValue(source.activeStatus, '未填写')
	const mappedInfo = [
		[{ label: '年龄', value: age + '岁' }, { label: '身高', value: height }, { label: '体重', value: weight }],
		[{ label: '星座', value: constellation }, { label: '学历', value: edu }, { label: '职业', value: job }],
		[{ label: '现居', value: city }, { label: '家乡', value: hometown }, { label: '收入', value: income }],
		[{ label: '婚姻', value: marriage }, { label: 'MBTI', value: mbti }, { label: '状态', value: activeStatus }]
	]
	user.value = {
		...user.value,
		id: id,
		name: textValue(source.name, user.value.name),
		age: age,
		avatar: textValue(source.avatar, user.value.avatar),
		isVIP: source.isVip === true || source.isVIP === true,
		job: job,
		edu: edu,
		city: city,
		online: textValue(source.online, user.value.online),
		distance: textValue(source.distance, user.value.distance),
		recentActivity: textValue(source.recentActivity, user.value.recentActivity),
		match: source.match != null ? Number(source.match) : user.value.match,
		tags: source.tags != null ? source.tags : user.value.tags,
		bio: textValue(source.intro, textValue(source.introduction, user.value.bio)),
		photos: source.photos != null && source.photos.length > 0 ? source.photos : user.value.photos,
		lifePhotos: source.lifePhotos != null && source.lifePhotos.length >= 3 ? source.lifePhotos : user.value.lifePhotos,
		expect: source.expect != null && source.expect.length > 0 ? source.expect : user.value.expect,
		basicInfo: source.basicInfo != null ? source.basicInfo : mappedInfo
