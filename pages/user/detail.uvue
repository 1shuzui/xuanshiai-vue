	{ name: '李明', avatar: '/static/portraits/profile-man-light.jpg' },
	{ name: '王强', avatar: '/static/portraits/profile-man-sea.jpg' },
	{ name: '刘洋', avatar: '/static/portraits/profile-woman-community.jpg' }
])

const dynamics = ref([
	{ id: 1, time: '2小时前 · 大理', content: '周末和朋友去了趟大理，洱海边的风真的好舒服。停下来拍照的时候，感觉整个世界都慢下来了。', photo: '/static/portraits/profile-woman-community.jpg', topic: '#旅行', likes: 89, comments: 12 },
	{ id: 2, time: '昨天 18:30 · 奥体中心', content: '完成了人生第一个半马！虽然很累，但冲线的那一刻，一切都值得。', photo: '/static/portraits/profile-woman-alt.jpg', topic: '#健身', likes: 156, comments: 28 },
	{ id: 3, time: '3天前 · 蜂巢剧场', content: '新年第一场脱口秀。笑到腹肌疼，才发现快乐原来这么简单。', photo: '/static/portraits/profile-woman-main.jpg', topic: '#生活', likes: 203, comments: 8 }
])

const textValue = (value: any, fallback: string): string => {
	return value != null && value != '' ? '' + value : fallback
}

const mapDetailUser = (raw: any, id: number) => {
	if (raw == null) return
	const source = raw.data != null ? raw.data : raw
	if (source == null) return
	const age = textValue(source.age, user.value.age)
	const edu = textValue(source.education, textValue(source.edu, user.value.edu))
	const job = textValue(source.job, user.value.job)
	const city = textValue(source.city, user.value.city)
