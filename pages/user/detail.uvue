.detail-scroll { flex: 1; height: 0; padding-bottom: 88px; }
.cover-area { height: 196px; position: relative; overflow: hidden; background: var(--warm); }
.cover-image { width: 100%; height: 100%; }
.cover-shade { position: absolute; inset: 0; background: var(--image-hero); }
.profile-card { position: relative; margin: -40px 16px 12px; padding: 52px 16px 16px; background: var(--surface); border-radius: 12px; border: 1px solid var(--line); }
.avatar { position: absolute; top: -36px; left: 16px; width: 72px; height: 72px; border-radius: 50%; border: 4px solid var(--surface); background: var(--warm); }
.profile-main { display: flex; flex-direction: column; gap: 8px; }
.name-row { display: flex; flex-direction: row; align-items: baseline; gap: 8px; }
.profile-name { font-size: 22px; font-weight: 700; font-family: var(--serif); color: var(--ink); }
.profile-age { font-size: 13px; color: var(--muted); }
.profile-meta { font-size: 13px; color: var(--ink2); }
.tag-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; }
.tag, .expectation-item { padding: 4px 8px; border-radius: 999px; background: var(--accent-bg); color: var(--accent2); font-size: 11px; }
.profile-bio, .intro-text { font-size: 14px; line-height: 1.65; color: var(--ink2); }
.section-card { margin: 0 16px 12px; padding: 16px; background: var(--surface); border-radius: 12px; border: 1px solid var(--line); }
.section-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.section-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.section-caption { font-size: 11px; color: var(--muted); }
.info-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px 0; }
.info-item { width: 50%; display: flex; flex-direction: column; gap: 4px; }
.info-label { font-size: 11px; color: var(--muted); }
.info-value { font-size: 14px; color: var(--ink); }
.locked-note { padding: 12px; background: var(--warm); border-radius: 8px; display: flex; flex-direction: column; gap: 6px; }
.locked-note-title { font-size: 14px; font-weight: 700; color: var(--ink); }
.locked-note-description { font-size: 12px; line-height: 1.5; color: var(--muted); }
.cert-list, .expectation-list { display: flex; flex-direction: column; gap: 10px; }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.cert-mark { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--sage-soft); color: var(--sage); font-size: 13px; }
.cert-label { flex: 1; font-size: 13px; color: var(--ink); }
.cert-status { font-size: 11px; color: var(--sage); }
.expectation-list { flex-direction: row; flex-wrap: wrap; }
.scroll-bottom-spacer { height: 20px; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; gap: 10px; background: var(--surface-overlay); border-top: 1px solid var(--line); }
.back-action, .like-action { min-width: 58px; height: 44px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: var(--ink2); font-size: 11px; }
.back-action-icon { font-size: 20px; line-height: 16px; }
.apply-action { flex: 1; height: 44px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--brown); color: var(--text-invert); font-size: 14px; font-weight: 700; }
.like-action { border: 1px solid var(--line); border-radius: 8px; color: var(--accent2); }
.own-bar .apply-action { flex: 1; }
@media (max-width: 350px) { .profile-card, .section-card { margin-left: 12px; margin-right: 12px; } .profile-card { padding-left: 12px; padding-right: 12px; } }
