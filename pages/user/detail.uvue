})

const certs = ref([
	{ icon: '盾', shortLabel: '实名', label: '实名认证', desc: '已通过平台实名认证' },
	{ icon: '学', shortLabel: '学历', label: '学历认证', desc: '学历信息已核验' },
	{ icon: '像', shortLabel: '头像', label: '头像认证', desc: '头像为本人真实照片' },
