<template>
	<view class="page">
		<view class="topbar">
			<view class="topbar-button" @tap="onBack"><text class="topbar-icon">‹</text></view>
			<text class="topbar-title">个人资料</text>
			<view class="topbar-button" @tap="onShare"><text class="topbar-icon">↗</text></view>
		</view>

		<view v-if="detailLoading" class="state-block">
			<text class="state-title">正在加载资料</text>
			<text class="state-description">请稍候，正在读取最新信息</text>
		</view>
		<XsaEmpty
			v-else-if="detailError != ''"
			:text="detailErrorTitle"
			:description="detailError"
			:show-action="true"
			action-text="重试"
			@action="load"
		/>

		<scroll-view v-else-if="user != null" class="detail-scroll" scroll-y enhanced show-scrollbar="false">
			<view class="cover-area">
				<image class="cover-image" :src="user.cover" mode="aspectFill"></image>
				<view class="cover-shade"></view>
			</view>

			<view class="profile-card">
				<image class="avatar" :src="user.avatar" mode="aspectFill"></image>
				<view class="profile-main">
					<view class="name-row">
						<text class="profile-name">{{ user.name }}</text>
						<text class="profile-age" v-if="user.age != ''">{{ user.age }}岁</text>
					</view>
					<text class="profile-meta">{{ user.meta }}</text>
					<view class="tag-row" v-if="user.tags.length > 0">
						<view class="tag" v-for="tag in user.tags" :key="tag"><text>{{ tag }}</text></view>
					</view>
					<text class="profile-bio">{{ user.bio }}</text>
				</view>
			</view>

			<view class="section-card">
				<view class="section-heading"><text class="section-title">基础资料</text><text class="section-caption" v-if="user.detailLocked">部分暂不可见</text></view>
				<view v-if="user.detailLocked" class="locked-note">
					<text class="locked-note-title">详细资料暂不可见</text>
					<text class="locked-note-description">当前仅展示公开摘要，更多信息以对方实际公开范围为准。</text>
				</view>
				<view v-else class="info-grid">
					<view class="info-item" v-for="item in user.basicInfo" :key="item.label">
						<text class="info-label">{{ item.label }}</text>
						<text class="info-value">{{ item.value }}</text>
					</view>
				</view>
			</view>

			<view class="section-card" v-if="user.certifications.length > 0">
				<view class="section-heading"><text class="section-title">认证状态</text><text class="section-caption">以平台审核为准</text></view>
				<view class="cert-list">
					<view class="cert-item" v-for="cert in user.certifications" :key="cert.label">
						<view class="cert-mark"><text>✓</text></view>
						<text class="cert-label">{{ cert.label }}</text>
						<text class="cert-status">{{ cert.status }}</text>
					</view>
				</view>
			</view>

			<view class="section-card">
				<text class="section-title">自我介绍</text>
				<text class="intro-text">{{ user.bio }}</text>
			</view>

			<view class="section-card" v-if="user.expectations.length > 0">
				<text class="section-title">关系期待</text>
				<view class="expectation-list">
					<view class="expectation-item" v-for="item in user.expectations" :key="item"><text>{{ item }}</text></view>
				</view>
			</view>
			<view class="scroll-bottom-spacer"></view>
		</scroll-view>

		<view v-if="user != null && !user.isOwn" class="bottom-bar">
			<view class="back-action" @tap="onBack"><text class="back-action-icon">‹</text><text>返回</text></view>
			<view class="apply-action" @tap="onMatch"><text>申请认识</text></view>
			<view class="like-action" @tap="onLike"><text>{{ user.liked ? '已喜欢' : '喜欢' }}</text></view>
		</view>
		<view v-if="user != null && user.isOwn" class="bottom-bar own-bar">
			<view class="apply-action" @tap="goEdit"><text>编辑资料</text></view>
		</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplySuccess" />
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import { getUserDetail, getOwnProfile, likeUser } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	const DEFAULT_AVATAR = '/static/portraits/profile-woman-main.jpg'
	const DEFAULT_COVER = '/static/portraits/profile-woman-community.jpg'
	const detailLoading = ref(true)
	const detailError = ref('')
	const detailErrorTitle = ref('资料暂时无法打开')
	const routeUserId = ref(0)
	const applyVisible = ref(false)
	const applyUserId = ref(0)
	const user = ref(null as any)
	const isOwnRoute = ref(false)

	const textValue = (value: any, fallback: string = '未填写'): string => {
		if (value == null || ('' + value).trim() == '') return fallback
		return '' + value
	}

	const educationText = (value: any): string => {
		const labels = ['', '高中及以下', '大专', '本科', '硕士', '博士']
		const index = value != null ? Number(value) : 0
		return index > 0 && index < labels.length ? labels[index] : '未填写'
	}

	const mapCertifications = (tags: any): any[] => {
		const list = tags != null && Array.isArray(tags) ? tags as any[] : []
		return list.map((item: any) => ({ label: '' + item, status: '已通过' }))
	}

	const mapProfile = (envelope: any, own: boolean): any => {
		const raw = envelope != null ? envelope : {}
		const card = raw.card != null ? raw.card : raw
		const profile = raw.profile != null ? raw.profile : own ? raw : null
		const tagValues: any[] = []
		const interestTags = card.interest_tags != null ? card.interest_tags : profile != null ? profile.interest_tags : []
		if (interestTags != null && Array.isArray(interestTags)) tagValues.push(...(interestTags as any[]).slice(0, 5))
		const certificationTags = card.certification_tags != null ? card.certification_tags : []
		if (certificationTags != null && Array.isArray(certificationTags)) tagValues.push(...(certificationTags as any[]).slice(0, 3))
		const detailLocked = !own && (card.detail_locked == true || raw.detail_locked == true || profile == null)
		const basicInfo: any[] = []
		if (profile != null && !detailLocked) {
			basicInfo.push({ label: '身高', value: profile.height != null ? profile.height + ' cm' : '未填写' })
			basicInfo.push({ label: '学历', value: educationText(profile.education_level) })
			basicInfo.push({ label: '职业', value: textValue(profile.occupation) })
			basicInfo.push({ label: '婚姻', value: textValue(profile.is_married == 1 ? '未婚' : profile.is_married == 2 ? '离异' : profile.is_married == 3 ? '丧偶' : null) })
			basicInfo.push({ label: '常住地', value: textValue(profile.residence_city_code || profile.residence_province_code) })
			basicInfo.push({ label: 'MBTI', value: textValue(profile.mbti) })
		}
		const selections = profile != null && profile.tag_selections != null ? profile.tag_selections : {}
		const expectations = selections.relationship_expectation != null && Array.isArray(selections.relationship_expectation)
			? selections.relationship_expectation as any[]
			: []
		return {
			id: raw.user_id != null ? Number(raw.user_id) : Number(card.user_id),
			name: textValue(card.nickname, '未设置昵称'),
			age: card.age != null ? '' + card.age : profile != null && profile.age != null ? '' + profile.age : '',
			avatar: textValue(card.avatar || (profile != null ? profile.avatar : null), DEFAULT_AVATAR),
			cover: textValue(profile != null ? profile.background_wall : null, DEFAULT_COVER),
			meta: [textValue(card.occupation || (profile != null ? profile.occupation : null)), textValue(card.city_code || (profile != null ? profile.residence_city_code : null))].join(' · '),
			tags: tagValues,
			bio: textValue(profile != null ? profile.self_intro : null, '这位用户还没有填写自我介绍。'),
			basicInfo,
			certifications: mapCertifications(certificationTags),
			expectations,
			detailLocked,
			liked: card.is_favorite == true,
			canApply: raw.can_apply != false,
			isOwn: own
		}
	}

	const load = async () => {
		detailLoading.value = true
		detailError.value = ''
		try {
			const res = isOwnRoute.value ? await getOwnProfile() : await getUserDetail(routeUserId.value)
			if (res != null && res.success && res.data != null) {
				const raw = res.data as any
				const hasIdentity = raw.user_id != null || (raw.card != null && raw.card.user_id != null)
				if (!hasIdentity) {
					user.value = null
					detailErrorTitle.value = '资料暂时无法打开'
					detailError.value = '服务端没有返回有效用户资料'
					return
				}
				user.value = mapProfile(raw, isOwnRoute.value)
				applyUserId.value = user.value.id
			} else {
				user.value = null
				const code = res != null ? Number(res.code) : 0
				detailErrorTitle.value = code == 404 ? '用户不存在' : code == 403 ? '暂时没有查看权限' : '资料暂时无法打开'
				detailError.value = res != null && res.message != null ? '' + res.message : '请稍后重试'
			}
		} catch (e) {
			user.value = null
			detailErrorTitle.value = '网络连接失败'
			detailError.value = '请检查网络后重试'
		} finally {
			detailLoading.value = false
		}
	}

	onLoad((query: any) => {
		isOwnRoute.value = query != null && query.own == 'true'
		const pages = getCurrentPages()
		const currentPage = pages.length > 0 ? pages[pages.length - 1] : null
		const options: any = currentPage != null ? currentPage.options : {}
		let routeValue: any = query != null && query.userId != null ? query.userId : null
		if (options.userId != null && options.userId != '') routeValue = options.userId
		const parsed = routeValue != null ? Number(routeValue) : 0
		routeUserId.value = parsed > 0 ? parsed : 0
		if (!isOwnRoute.value && routeUserId.value <= 0) {
			detailErrorTitle.value = '用户不存在'
			detailError.value = '缺少有效的用户编号'
			return
		}
		load()
	})

	const onBack = () => uni.navigateBack({ delta: 1 })
	const onShare = () => uni.showToast({ title: '分享功能将在确认后开放', icon: 'none' })
	const goEdit = () => uni.navigateTo({ url: '/pages/user/edit' })

	const onMatch = async () => {
		if (user.value == null || user.value.isOwn) return
		if (user.value.canApply == false) {
			uni.showToast({ title: '请先完成实名认证或完善资料', icon: 'none' })
			return
		}
		const ok = await guardRealName('apply')
		if (!ok) return
		applyUserId.value = user.value.id
		applyVisible.value = true
	}

	const onApplySuccess = (_payload: any) => {
		applyVisible.value = false
		uni.showToast({ title: '申请已送达，等待对方回应', icon: 'none' })
	}

	const onLike = async () => {
		if (user.value == null || user.value.isOwn) return
		const ok = await guardRealName('like')
		if (!ok) return
		try {
			const res = await likeUser(user.value.id)
			if (res.success && res.data != null) {
				user.value.liked = res.data.liked == true
				uni.showToast({ title: user.value.liked ? '已喜欢，仅你自己可见' : '已取消喜欢', icon: 'none' })
			} else {
				uni.showToast({ title: res.message != null ? '' + res.message : '操作失败，请重试', icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		}
	}
</script>

<style scoped>
.page { min-height: 100vh; background: var(--canvas); display: flex; flex-direction: column; }
.topbar { height: 48px; padding: 0 12px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: var(--paper); border-bottom: 1px solid var(--line); }
.topbar-button { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
.topbar-icon { font-size: 28px; line-height: 1; color: var(--ink); }
.topbar-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.state-block { padding: 72px 24px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.state-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.state-description { font-size: 13px; color: var(--muted); }
.detail-scroll { flex: 1; height: 0; padding-bottom: 88px; }
.cover-area { height: 196px; position: relative; overflow: hidden; background: var(--warm); }
.cover-image { width: 100%; height: 100%; }
.cover-shade { position: absolute; inset: 0; background: var(--image-hero); }
.profile-card { position: relative; margin: -40px 16px 12px; padding: 52px 16px 16px; background: var(--surface); border-radius: 12px; border: 1px solid var(--line); }
.avatar { position: absolute; top: -36px; left: 16px; width: 72px; height: 72px; border-radius: 50%; border: 4px solid var(--surface); background: var(--warm); }
.profile-main { display: flex; flex-direction: column; gap: 8px; }
.name-row { display: flex; flex-direction: row; align-items: baseline; gap: 8px; }
.profile-name { font-size: 22px; font-weight: 700; font-family: var(--serif); color: var(--ink); }
.profile-age { font-size: 13px; color: var(--muted); }
.profile-meta { font-size: 13px; color: var(--ink2); }
.tag-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; }
.tag, .expectation-item { padding: 4px 8px; border-radius: 999px; background: var(--accent-bg); color: var(--accent2); font-size: 11px; }
.profile-bio, .intro-text { font-size: 14px; line-height: 1.65; color: var(--ink2); }
.section-card { margin: 0 16px 12px; padding: 16px; background: var(--surface); border-radius: 12px; border: 1px solid var(--line); }
.section-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.section-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.section-caption { font-size: 11px; color: var(--muted); }
.info-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px 0; }
.info-item { width: 50%; display: flex; flex-direction: column; gap: 4px; }
.info-label { font-size: 11px; color: var(--muted); }
.info-value { font-size: 14px; color: var(--ink); }
.locked-note { padding: 12px; background: var(--warm); border-radius: 8px; display: flex; flex-direction: column; gap: 6px; }
.locked-note-title { font-size: 14px; font-weight: 700; color: var(--ink); }
.locked-note-description { font-size: 12px; line-height: 1.5; color: var(--muted); }
.cert-list, .expectation-list { display: flex; flex-direction: column; gap: 10px; }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.cert-mark { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--sage-soft); color: var(--sage); font-size: 13px; }
.cert-label { flex: 1; font-size: 13px; color: var(--ink); }
.cert-status { font-size: 11px; color: var(--sage); }
.expectation-list { flex-direction: row; flex-wrap: wrap; }
.scroll-bottom-spacer { height: 20px; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; gap: 10px; background: var(--surface-overlay); border-top: 1px solid var(--line); }
.back-action, .like-action { min-width: 58px; height: 44px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: var(--ink2); font-size: 11px; }
.back-action-icon { font-size: 20px; line-height: 16px; }
.apply-action { flex: 1; height: 44px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--brown); color: var(--text-invert); font-size: 14px; font-weight: 700; }
.like-action { border: 1px solid var(--line); border-radius: 8px; color: var(--accent2); }
.own-bar .apply-action { flex: 1; }
@media (max-width: 350px) { .profile-card, .section-card { margin-left: 12px; margin-right: 12px; } .profile-card { padding-left: 12px; padding-right: 12px; } }
</style>
