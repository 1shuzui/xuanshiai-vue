const loadDetailUser = async (id: number) => {
	try {
		const res = await getUserDetail(id)
		if (res != null && res.success === true) mapDetailUser(res, id)
	} catch (e) {
		// 接口不可用时保留本地预览数据。
	}
}

const refreshLockedView = () => {
	const viewerIsVip = getCurrentUserVipStatus()
	const targetIsVip = user.value.isVIP === true
	isLockedView.value =
		!isPreview.value &&
		!isOwnProfile.value &&
		viewerIsVip !== true &&
		targetIsVip
}

onMounted(async () => {
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	isOwnProfile.value = options.own === 'true'
	isPreview.value = options.preview === 'true'

	let parsed = 1
	if (options.userId != null && options.userId != '') {
		const candidate = Number(options.userId)
		if (!isNaN(candidate) && candidate > 0) parsed = candidate
	}
	user.value.id = parsed
	applyUserId.value = parsed
	if (!isOwnProfile.value) await loadDetailUser(parsed)
	refreshLockedView()
})

onShow(() => {
	refreshLockedView()
})

