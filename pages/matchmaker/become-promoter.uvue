<template>
	<view class="become-page">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<view class="nav-back-chevron"></view>
			</view>
			<text class="nav-title">申请推广红娘</text>
			<view class="nav-help" @click="showHelp">
				<text class="nav-help-text">帮助</text>
			</view>
		</view>

		<scroll-view scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- Banner 宣传区域 -->
				<view class="banner-card">
					<view class="banner-copy">
						<text class="banner-kicker">推广红娘招募</text>
						<text class="banner-title">让更多人知道认真婚恋的可能，分享即可创造价值</text>
						<text class="banner-desc">平台认证 · 官方审核 · 推广激励</text>
					</view>
					<view class="banner-badges">
						<view class="banner-badge">
							<text class="badge-icon">✓</text>
							<text class="badge-text">平台认证</text>
						</view>
						<view class="banner-badge">
							<text class="badge-icon">✓</text>
							<text class="badge-text">官方审核</text>
						</view>
						<view class="banner-badge">
							<text class="badge-icon">✓</text>
							<text class="badge-text">推广激励</text>
						</view>
					</view>
				</view>

				<!-- 基本信息 -->
				<view class="form-card">
					<text class="section-title">基本信息</text>
					<text class="section-desc">用于身份核验与平台联系，信息不会对外公开。</text>

					<view class="form-field">
						<text class="field-label">真实姓名 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="realName"
							placeholder="请填写真实姓名"
							@input="onRealNameInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">手机号 <text class="required">*</text></text>
						<input
							class="field-input"
							type="number"
							maxlength="11"
							:value="phone"
							placeholder="用于接收审核通知"
							@input="onPhoneInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">微信号 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="wechat"
							placeholder="便于平台工作人员后续沟通"
							@input="onWechatInput"
						/>
					</view>
				</view>

				<!-- 推广红娘资料 -->
				<view class="form-card">
					<text class="section-title">推广资料</text>
					<text class="section-desc">展示给用户的推广形象，建议完整填写。</text>

					<!-- 上传头像 -->
					<view class="form-field">
						<text class="field-label">上传头像 <text class="required">*</text></text>
						<view class="avatar-upload" @click="uploadAvatar">
							<image
								v-if="avatar.length > 0"
								class="avatar-preview"
								:src="avatar"
								mode="aspectFill"
							></image>
							<view v-else class="avatar-placeholder">
								<text class="avatar-plus">+</text>
								<text class="avatar-hint">点击上传头像</text>
							</view>
						</view>
						<text class="field-hint">建议使用真实、清晰的正面照，裁剪比例 1:1</text>
					</view>

					<!-- 个人简介 -->
					<view class="form-field">
						<text class="field-label">个人简介 <text class="required">*</text></text>
						<textarea
							class="field-textarea"
							:value="introduction"
							maxlength="200"
							placeholder="简短介绍你的背景和推广资源，例如：我在本地社群有丰富的推广渠道，希望将认真婚恋理念传递给更多人。"
							@input="onIntroductionInput"
						/>
						<text class="field-counter">{{ introduction.length }}/200</text>
					</view>

					<!-- 擅长领域 -->
					<view class="form-field">
						<text class="field-label">擅长渠道 <text class="required">*</text></text>
						<view class="specialty-grid">
							<view
								v-for="item in specialtyOptions"
								:key="item"
								class="specialty-chip"
								:class="{ selected: specialties.indexOf(item) >= 0 }"
								@click="toggleSpecialty(item)"
							>
								<text>{{ item }}</text>
							</view>
						</view>
					</view>

					<!-- 服务价格 -->
					<view class="form-field">
						<text class="field-label">推广佣金预期 <text class="optional">选填</text></text>
						<view class="price-input-row">
							<text class="price-prefix">¥</text>
							<input
								class="price-input"
								type="digit"
								:value="price"
								placeholder="不填则按平台标准结算"
								@input="onPriceInput"
							/>
							<text class="price-suffix">/人</text>
						</view>
					</view>
				</view>

				<!-- 成功案例 -->
				<view class="form-card">
					<view class="section-title-row">
						<text class="section-title">推广经验</text>
						<text class="optional-label">选填</text>
					</view>
					<text class="section-desc">展示过往推广经历，增强可信度。内容需脱敏处理，避免泄露用户隐私。</text>

					<view
						v-for="(caseItem, index) in successCases"
						:key="index"
						class="case-block"
					>
						<view class="case-block-header">
							<text class="case-block-title">经验 {{ index + 1 }}</text>
							<view class="case-delete" @click="removeCase(index)">
								<text>删除</text>
							</view>
						</view>

						<view class="form-field">
							<text class="field-label">经验描述</text>
							<textarea
								class="field-textarea case-textarea"
								:value="caseItem.description"
								maxlength="200"
								placeholder="例如：曾在本地社群成功推广过婚恋活动，覆盖200+精准用户。"
								@input="(e: any) => onCaseDescriptionInput(index, e)"
							/>
						</view>

						<view class="form-field">
							<text class="field-label">相关图片</text>
							<view class="case-images">
								<view
									v-for="(img, imgIndex) in caseItem.images"
									:key="imgIndex"
									class="case-image-item"
								>
									<image class="case-image-preview" :src="img" mode="aspectFill"></image>
									<view class="case-image-delete" @click="removeCaseImage(index, imgIndex)">
										<text>×</text>
									</view>
								</view>
								<view
									v-if="caseItem.images.length < 3"
									class="case-image-add"
									@click="uploadCaseImage(index)"
								>
									<text class="case-add-plus">+</text>
								</view>
							</view>
						</view>
					</view>

					<view class="add-case-button" @click="addCase" v-if="successCases.length < 3">
						<text>+ 添加经验</text>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="form-card process-card">
					<text class="section-title">审核流程</text>
					<text class="section-desc">提交申请后，预计 1-3 个工作日内完成审核。</text>

					<view class="process-steps">
						<view
							v-for="(step, index) in processSteps"
							:key="step.title"
							class="process-step"
						>
							<view class="step-indicator" :class="{ active: index === 0, done: index < currentStep }">
								<text v-if="index < currentStep">✓</text>
								<text v-else>0{{ index + 1 }}</text>
							</view>
							<view class="step-copy">
								<text class="step-title">{{ step.title }}</text>
								<text class="step-desc">{{ step.desc }}</text>
							</view>
							<view v-if="index < processSteps.length - 1" class="step-line"></view>
						</view>
					</view>

					<!-- 咨询入口 -->
					<view class="consult-icons">
						<view class="consult-icon phone-icon" @click="callConsult">
							<text class="consult-emoji">📞</text>
						</view>
						<view class="consult-icon wechat-icon" @click="wechatConsult">
							<image class="wechat-brand" src="/static/icons/wechat-bubble.svg" mode="aspectFit"></image>
						</view>
					</view>
				</view>

				<!-- 微信二维码弹窗 -->
				<view class="qr-overlay" v-if="qrVisible" @click="qrVisible = false">
					<view class="qr-card" @click.stop>
						<view class="qr-close" @click="qrVisible = false">
							<text>×</text>
						</view>
						<text class="qr-title">微信扫码咨询</text>
						<text class="qr-subtitle">添加客服微信，备注"推广红娘入驻咨询"</text>
						<view class="qr-image-wrap">
							<image class="qr-image" src="/static/qrcodes/kefu-wechat.png" mode="aspectFit"></image>
						</view>
						<text class="qr-tip">长按识别二维码添加</text>
					</view>
				</view>

				<!-- 隐私声明 -->
				<view class="privacy-card">
					<text class="privacy-title">隐私与安全</text>
					<text class="privacy-copy">你所提交的全部资料将受到平台隐私协议保护，仅用于推广红娘资质审核与合作安排。请如实填写，不要提交他人的联系方式或敏感身份信息。审核通过后，你可在个人设置中随时管理展示范围。</text>
				</view>

				<!-- 底部占位 -->
				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<!-- 底部提交按钮 -->
		<view class="footer-safe">
			<view
				class="submit-button"
				:class="{ disabled: !canSubmit || submitting }"
				@click="submitApplication"
			>
				<text>{{ submitting ? '提交中…' : (canSubmit ? '提交申请' : '请补全必填信息') }}</text>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import { submitPromoterApplication } from '@/api'

// ===== 基本信息 =====
const realName = ref('')
const phone = ref('')
const wechat = ref('')

// ===== 推广资料 =====
const avatar = ref('')
const introduction = ref('')
const specialties = ref<string[]>([])
const price = ref('')

// ===== 推广经验 =====
interface CaseItem {
	description: string
	images: string[]
}
const successCases = ref<CaseItem[]>([])

// ===== 状态 =====
const submitting = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')
const qrVisible = ref(false)
const currentStep = ref(0)

const specialtyOptions = [
	'微信社群', '朋友圈推广', '线下活动', '小红书种草',
	'抖音短视频', '知乎内容', '本地社群', '高校渠道',
	'企业联谊', '亲友推荐', '公众号运营', '直播推广'
]

const processSteps = [
	{ title: '填写申请', desc: '填写完整资料并提交' },
	{ title: '平台审核', desc: '运营人员对资料进行审核' },
	{ title: '审核通过', desc: '获得推广红娘身份' },
	{ title: '成为推广红娘', desc: '可正式在平台开展推广服务' }
]

// ===== 计算属性 =====
const canSubmit = computed(() => {
	return realName.value.trim().length > 0
		&& phone.value.trim().length > 0
		&& wechat.value.trim().length > 0
		&& avatar.value.length > 0
		&& introduction.value.trim().length > 0
		&& specialties.value.length > 0
})

// ===== Toast =====
const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}

// ===== 导航 =====
const goBack = () => {
	uni.navigateBack()
}

const showHelp = () => {
	uni.showModal({
		title: '申请说明',
		content: '成为平台推广红娘需要经过实名认证、资料审核和培训流程。审核通常在 1-3 个工作日内完成，审核结果将通过短信通知你。推广红娘通过分享和推荐获得推广激励。如有问题，请联系客服。',
		showCancel: false,
		confirmText: '知道了'
	})
}

const callConsult = () => {
	uni.showModal({
		title: '电话咨询',
		content: '咨询热线：400-XXX-XXXX（工作时间：周一至周五 9:00-18:00）',
		showCancel: false,
		confirmText: '知道了'
	})
}

const wechatConsult = () => {
	qrVisible.value = true
}

// ===== 表单输入 =====
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onWechatInput = (e: any) => { wechat.value = e.detail.value }
const onIntroductionInput = (e: any) => { introduction.value = e.detail.value }
const onPriceInput = (e: any) => { price.value = e.detail.value }

// ===== 头像上传 =====
const uploadAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				avatar.value = res.tempFilePaths[0]
				showToast('头像已上传')
			}
		}
	})
}

// ===== 擅长渠道 =====
const toggleSpecialty = (item: string) => {
	const idx = specialties.value.indexOf(item)
	if (idx >= 0) {
		specialties.value.splice(idx, 1)
	} else {
		if (specialties.value.length >= 5) {
			showToast('最多选择 5 个擅长渠道')
			return
		}
		specialties.value.push(item)
	}
}

// ===== 推广经验 =====
const addCase = () => {
	if (successCases.value.length >= 3) return
	successCases.value.push({ description: '', images: [] })
}

const removeCase = (index: number) => {
	successCases.value.splice(index, 1)
}

const onCaseDescriptionInput = (index: number, e: any) => {
	if (index >= 0 && index < successCases.value.length) {
		successCases.value[index].description = e.detail.value
	}
}

const uploadCaseImage = (index: number) => {
	uni.chooseImage({
		count: 3 - successCases.value[index].images.length,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				const imgs = res.tempFilePaths as string[]
				for (let i = 0; i < imgs.length; i++) {
					successCases.value[index].images.push(imgs[i])
				}
			}
		}
	})
}

const removeCaseImage = (caseIndex: number, imgIndex: number) => {
	if (caseIndex >= 0 && caseIndex < successCases.value.length) {
		successCases.value[caseIndex].images.splice(imgIndex, 1)
	}
}

// ===== 提交申请 =====
const submitApplication = async () => {
	if (submitting.value) return

	// 基本信息校验
	if (realName.value.trim().length === 0) {
		showToast('请填写真实姓名')
		return
	}
	if (!/^1\d{10}$/.test(phone.value)) {
		showToast('请填写正确的 11 位手机号')
		return
	}
	if (wechat.value.trim().length === 0) {
		showToast('请填写微信号')
		return
	}

	// 推广资料校验
	if (avatar.value.length === 0) {
		showToast('请上传头像')
		return
	}
	if (introduction.value.trim().length === 0) {
		showToast('请填写个人简介')
		return
	}
	if (specialties.value.length === 0) {
		showToast('请至少选择一个擅长渠道')
		return
	}

	try {
		submitting.value = true

		const formData = {
			realName: realName.value.trim(),
			phone: phone.value,
			wechat: wechat.value.trim(),
			avatar: avatar.value,
			introduction: introduction.value.trim(),
			specialties: specialties.value,
			price: price.value ? parseFloat(price.value) : undefined,
			cases: successCases.value
				.filter((c: CaseItem) => c.description.trim().length > 0)
				.map((c: CaseItem) => ({
					description: c.description.trim(),
					images: c.images
				}))
		}

		const result = await submitPromoterApplication(formData)

		if (result.success) {
			uni.showModal({
				title: '申请已提交',
				content: '平台将在 1-3 个工作日内完成审核，审核结果将通过短信通知你。请保持手机畅通。',
				showCancel: false,
				confirmText: '知道了',
				success: () => {
					uni.navigateBack()
				}
			})
		}
	} catch (e) {
		showToast('提交失败，请稍后重试')
	} finally {
		submitting.value = false
	}
}
</script>

<style scoped>
.become-page {
	min-height: 100vh;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* ===== 导航栏 ===== */
.nav-bar {
	position: relative;
	height: 88rpx;
	padding: 0 12rpx;
	background: var(--paper);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-bottom: 1px solid var(--line);
	flex-shrink: 0;
}

.nav-back {
	position: absolute;
	left: 12rpx;
	top: 16rpx;
	width: 64rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: flex-start;
}

.nav-back-chevron {
	width: 26rpx;
	height: 26rpx;
	margin-left: 12rpx;
	border-left: 5rpx solid var(--ink);
	border-bottom: 5rpx solid var(--ink);
	transform: rotate(45deg);
}

.nav-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.nav-help {
	position: absolute;
	right: 20rpx;
	top: 22rpx;
	height: 44rpx;
	padding: 0 14rpx;
	border-radius: 999rpx;
	border: 1px solid var(--line);
	display: flex;
	align-items: center;
}

.nav-help-text {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 滚动区域 ===== */
.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 40rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 32rpx 28rpx;
	border-radius: 22rpx;
	background: linear-gradient(135deg, rgba(24, 65, 93, 0.96), rgba(24, 65, 93, 0.88));
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--soft);
}

.banner-title {
	font-size: 42rpx;
	line-height: 1.3;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--paper);
}

.banner-desc {
	font-size: 22rpx;
	line-height: 1.6;
	color: rgba(250, 252, 252, 0.78);
}

.banner-badges {
	display: flex;
	flex-direction: row;
	gap: 14rpx;
}

.banner-badge {
	flex: 1;
	height: 68rpx;
	border-radius: 14rpx;
	background: rgba(250, 252, 252, 0.14);
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 8rpx;
}

.badge-icon {
	font-size: 22rpx;
	font-weight: 900;
	color: var(--soft);
}

.badge-text {
	font-size: 22rpx;
	font-weight: 700;
	color: var(--paper);
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.optional-label {
	font-size: 20rpx;
	color: var(--muted);
	padding: 4rpx 12rpx;
	border-radius: 999rpx;
	background: var(--warm);
}

.section-desc {
	font-size: 22rpx;
	line-height: 1.55;
	color: var(--muted);
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
