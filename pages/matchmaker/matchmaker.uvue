	}

	.case-box {
		padding: 9px 10px;
		background: var(--warm);
		border-radius: 7px;
		font-size: 11px;
		line-height: 1.5;
		color: var(--ink2);
	}

	.contact-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
	}

	.rank-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 2px;
		border-bottom: 1px solid var(--line);
	}

	.rank-no {
		width: 28px;
		font-size: 18px;
		font-family: var(--serif);
		color: var(--accent);
	}

	.rank-avatar {
		width: 48px;
		height: 48px;
		border-radius: 50%;
	}

	.rank-info {
		flex: 1;
		display: flex;
		flex-direction: column;
