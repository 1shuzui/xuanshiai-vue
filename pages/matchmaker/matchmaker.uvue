<template>
	<view class="matchmaker-page">
		<!-- 子 Tab：服务红娘 / 热心红娘 / AI 红娘 -->
		<view class="subtabs">
			<view
				class="subtab"
				:class="{ active: currentTab === 'service' }"
				@click="switchTab('service')"
			>
				<text>服务红娘</text>
			</view>
			<view
				class="subtab"
				:class="{ active: currentTab === 'volunteer' }"
				@click="switchTab('volunteer')"
			>
				<text>热心红娘</text>
			</view>
			<view
				class="subtab"
				:class="{ active: currentTab === 'ai' }"
				@click="switchTab('ai')"
			>
				<text>AI 红娘</text>
			</view>
		</view>

		<scroll-view class="scroller" scroll-y>
			<!-- 服务红娘 -->
			<view v-if="currentTab === 'service'" class="page-pad">
				<!-- 专业牵线服务横幅 -->
				<view class="service-banner">
					<view class="banner-copy">
						<text class="banner-title">专业牵线 · 认真相识</text>
						<text class="banner-subtitle">专人协助梳理期待，安排合适的认识机会</text>
						<view class="banner-tags">
							<text>一对一咨询</text>
							<text>资料澄清</text>
						</view>
					</view>
					<view class="banner-portrait-wrap">
						<image class="banner-portrait" src="/static/portraits/profile-woman-community.jpg" mode="aspectFill"></image>
						<view class="banner-mark"><text>牵线</text></view>
					</view>
				</view>

				<!-- 红娘卡片横向滚动 -->
				<view class="section-header">
					<text class="section-label">服务红娘</text>
					<text class="section-caption">平台认证 · 专业牵线</text>
				</view>
				<view class="card-scroll">
					<view class="card-scroll-inner">
						<view
							class="mm-h-card"
						v-for="item in serviceList"
							:key="item.id"
							@click="handleBook(item)"
						>
							<view class="mm-h-photo-wrap">
								<image class="mm-h-photo" :src="item.avatar" mode="aspectFill" lazy-load></image>
								<view class="mm-h-badge">平台认证</view>
							</view>
							<view class="mm-h-content">
								<text class="mm-h-name">{{ item.name }}</text>
								<text class="mm-h-title">{{ item.title }}</text>
								<text class="mm-h-count">已协助 {{ item.successCount }} 对用户牵线</text>
								<XsaButton variant="primary" size="small" block @click.stop="handleBook(item)">联系她</XsaButton>
							</view>
						</view>
					</view>
				</view>

				<!-- 热心红娘排行榜 -->
				<view class="section-header">
					<text class="section-label">热心红娘排行榜</text>
					<text class="section-caption">按有效协助人数排序</text>
				</view>
				<scroll-view class="rank-scroll" scroll-x :show-scrollbar="false">
					<view class="rank-scroll-inner">
						<view
							class="rank-avatar-item"
							v-for="(item, index) in volunteerList"
							:key="item.id"
							@click="handleVolunteerClick(item)"
						>
							<view class="rank-avatar-no">{{ index + 1 }}</view>
							<image class="rank-avatar-img" :src="item.avatar" mode="aspectFill" lazy-load></image>
							<text class="rank-avatar-name">{{ item.name.length > 4 ? item.name.slice(0, 4) + '…' : item.name }}</text>
							<text class="rank-avatar-count text-muted">{{ item.successCount }} 位</text>
						</view>
					</view>
				</scroll-view>

				<!-- 我要做红娘 CTA 卡片 -->
				<view class="cta-card" @click="goToApply">
					<view class="cta-left">
						<view class="cta-icon"><text>红娘</text></view>
						<view class="cta-text">
							<text class="cta-title">我要做红娘</text>
							<text class="cta-desc">提交认证资料，帮助更多人认真相识</text>
						</view>
					</view>
					<view class="cta-arrow"><text>›</text></view>
				</view>
			</view>

			<!-- 热心红娘 -->
			<view v-else-if="currentTab === 'volunteer'" class="page-pad">
				<view class="hero-block">
					<text class="hero-kicker">COMMUNITY MATCHMAKERS</text>
					<text class="hero-title">把靠谱的朋友介绍给靠谱的人</text>
					<text class="hero-desc text-muted">排行榜只展示真实有效的介绍数量，不承诺匹配结果。</text>
				</view>

				<view
					class="rank-row"
					v-for="(item, index) in volunteerList"
					:key="item.id"
				>
					<text class="rank-no">0{{ index + 1 }}</text>
					<image class="rank-avatar" :src="item.avatar" mode="aspectFill"></image>
					<view class="rank-info">
						<text class="rank-name">{{ item.name }}</text>
						<text class="rank-desc text-muted">{{ item.intro }}</text>
					</view>
					<text class="rank-count text-muted">已介绍 {{ item.successCount }} 位</text>
				</view>
			</view>

			<!-- AI 红娘：情感咨询对话（非直接匹配聊天） -->
			<view v-else class="page-pad">
				<view class="ai-intro">
					<text class="ai-title">AI 红娘小誓</text>
					<text class="ai-desc">帮你梳理择偶偏好、解读合拍线索和准备第一次对话。不会替代真人判断，也不会承诺匹配结果。</text>
				</view>

				<view class="mini-chat">
					<view
						v-for="(msg, idx) in aiMessages"
						:key="idx"
						class="bubble"
						:class="msg.role"
					>
						<text>{{ msg.text }}</text>
					</view>
				</view>

				<scroll-view class="prompts" scroll-x>
					<view
						class="prompt-chip"
						v-for="(p, i) in prompts"
						:key="i"
						@click="usePrompt(p)"
					>
						<text>{{ p }}</text>
					</view>
				</scroll-view>

				<view class="ai-input-row">
					<input
						class="ai-input"
						:value="aiInput"
						placeholder="描述你的困惑…"
						confirm-type="send"
						@input="onAiInput"
						@confirm="sendAi"
					/>
					<view class="ai-send" @click="sendAi">
						<text>发送</text>
					</view>
				</view>

				<view class="section-block">
					<text class="section-title">合拍线索推荐</text>
					<XsaUserCard
						v-for="user in aiRecommendUsers"
						:key="user.id"
						:user="user"
						:show-actions="true"
						@click="handleUserClick"
						@like="handleLike"
						@chat="handleApplyOnly"
					/>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaUserCard from '@/components/XsaUserCard.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaButton from '@/components/XsaButton.uvue'
	import {
		getServiceMatchmakers,
		getVolunteerMatchmakers,
		getAiRecommendations,
		bookMatchmaker
	} from '@/api'

	const currentTab = ref('service')
	const loading = ref(false)
	const serviceList = ref([])
	const volunteerList = ref([])
	const aiRecommendUsers = ref([])
	const aiInput = ref('')
	const prompts = [
		'帮我整理择偶要求',
		'分析合拍度',
		'准备破冰话题'
	]
	const aiMessages = ref([
		{ role: 'ai', text: '你好，我可以先帮你把"想找什么样的人"从模糊感觉整理成可沟通的条件。' },
		{ role: 'me', text: '我希望对方情绪稳定，也愿意认真沟通。' },
		{ role: 'ai', text: '可以进一步拆成：冲突时不冷处理、能表达需求、对长期关系有共同规划。哪一项对你最重要？' }
	])

	onMounted(() => {
		loadService()
		loadVolunteer()
		loadAi()
	})

	const switchTab = (tab: string) => {
		currentTab.value = tab
	}

	const loadService = async () => {
		try {
			loading.value = true
			const res = await getServiceMatchmakers()
			if (res.success) {
				serviceList.value = res.data
			}
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const loadVolunteer = async () => {
		try {
			const res = await getVolunteerMatchmakers()
			if (res.success) {
				volunteerList.value = res.data
			}
		} catch (e) {
			console.error(e)
		}
	}

	const loadAi = async () => {
		try {
			const res = await getAiRecommendations()
			if (res.success) {
				aiRecommendUsers.value = (res.data as any[]).map((item: any) => {
					return {
						id: item.userId != null ? item.userId : item.id,
						name: item.name,
						age: item.age,
						gender: 2,
						avatar: item.avatar,
						online: true,
						certifications: ['实名认证'],
						tags: item.tags != null ? item.tags : [],
						location: item.city,
						introduction: item.aiSuggestion != null ? item.aiSuggestion : ''
					}
				})
			}
		} catch (e) {
			console.error(e)
		}
	}

	const handleCall = (item: any) => {
		uni.showToast({ title: '准备打开系统拨号 · 演示', icon: 'none' })
	}

	const handleBook = async (item: any) => {
		try {
			const res = await bookMatchmaker(item.id)
			if (res.success) {
				uni.showToast({ title: '预约已提交', icon: 'success' })
			}
		} catch (e) {
			uni.showToast({ title: '预约失败', icon: 'none' })
		}
	}

	const handleVolunteerClick = (item: any) => {
		uni.showToast({ title: `查看 ${item.name} 的主页 · 演示`, icon: 'none' })
	}

	const goToApply = () => {
		uni.navigateTo({ url: '/pages/matchmaker/apply' })
	}

	const onAiInput = (e: any) => {
		aiInput.value = e.detail.value
	}

	const usePrompt = (p: string) => {
		aiInput.value = p
	}

	const sendAi = () => {
		const text = aiInput.value.trim()
		if (text.length == 0) return
		aiMessages.value.push({ role: 'me', text: text })
		aiInput.value = ''
		// 本地演示回复，不走即时社交聊天
		setTimeout(() => {
			aiMessages.value.push({
				role: 'ai',
				text: '我会把这个问题拆成可以观察和沟通的具体线索。原型阶段先展示到这里。'
			})
		}, 600)
	}

	const handleUserClick = (user: any) => {
		uni.navigateTo({ url: `/pages/user/detail?userId=${user.id}` })
	}

	const handleLike = (userId: number) => {
		uni.showToast({ title: '已添加到心动列表', icon: 'success' })
	}

	// 产品约束：不能从红娘推荐直接进入聊天，应先申请认识
	const handleApplyOnly = (userId: number) => {
		uni.showToast({ title: '请先通过「申请认识」开启聊天', icon: 'none' })
		uni.switchTab({ url: '/pages/index/index' })
	}
</script>

