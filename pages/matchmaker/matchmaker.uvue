	}

	.rank-name {
		font-size: 13px;
		font-weight: 700;
	}

	.rank-desc {
		font-size: 10px;
	}

	.rank-count {
		font-size: 10px;
	}

	.ai-intro {
		padding: 14px;
		background: var(--navy);
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		gap: 7px;
	}

	.ai-title {
		font-size: 19px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--paper);
	}

	.ai-desc {
		font-size: 11px;
		line-height: 1.6;
		color: rgba(231, 236, 236, 0.8);
	}

	.mini-chat {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.bubble {
		max-width: 82%;
		padding: 10px 12px;
		border-radius: 12px;
		font-size: 12px;
		line-height: 1.6;
		background: var(--surface);
		border: 1px solid var(--line);
	}

	.bubble.ai {
		align-self: flex-start;
		border-radius: 4px 12px 12px 12px;
	}

	.bubble.me {
		align-self: flex-end;
		background: var(--soft);
		border-color: var(--soft);
		border-radius: 12px 4px 12px 12px;
	}

	.prompts {
		white-space: nowrap;
		width: 100%;
	}

	.prompt-chip {
		display: inline-flex;
