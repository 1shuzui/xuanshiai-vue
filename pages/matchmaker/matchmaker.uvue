		padding: 14px 14px 40px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.hero-block {
		padding: 18px;
		background: var(--warm);
		border-left: 3px solid var(--accent);
		border-radius: 0 12px 12px 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.hero-kicker {
		font-size: 10px;
		color: var(--accent2);
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.hero-title {
		font-size: 22px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.hero-desc {
		font-size: 12px;
		line-height: 1.6;
	}

	.mm-card {
		border: 1px solid var(--line);
		background: var(--surface);
		border-radius: 12px;
		padding: 13px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.mm-profile {
		display: flex;
		gap: 12px;
	}

	.mm-avatar {
		width: 72px;
		height: 88px;
		border-radius: 8px;
	}

	.mm-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.mm-name {
		font-size: 17px;
		font-family: var(--serif);
		font-weight: 700;
	}

	.mm-title,
	.mm-intro {
		font-size: 11px;
