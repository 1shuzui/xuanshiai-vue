		height: 48px;
		display: flex;
		align-items: flex-end;
		gap: 18px;
		padding: 0 18px;
		background: rgba(250, 252, 252, 0.96);
		border-bottom: 1px solid var(--line);
	}

	.subtab {
		height: 48px;
		display: flex;
		align-items: center;
		color: var(--muted);
		font-size: 13px;
		position: relative;
	}

	.subtab.active {
		color: var(--ink);
		font-weight: 800;
	}

	.subtab.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 3px;
		background: var(--accent);
		border-radius: 3px 3px 0 0;
	}

	.scroller {
		height: calc(100vh - 48px);
	}

