<template>
	<view class="matchmaker-page">
		<view class="page-shell">
			<view v-if="currentTabValue !== 'ai'" class="page-head">
				<text class="page-kicker">认真牵线</text>
				<text class="page-title">三种方式，帮你更稳地靠近合适的人</text>
				<text class="page-desc">服务红娘负责匹配推进，私人定制负责长期陪跑，AI 红娘负责梳理线索与破冰建议。</text>
			</view>

			<view v-if="currentTabValue !== 'ai'" class="page-tabs">
				<view class="matchmaker-tab-bar">
					<view
						v-for="(tab, index) in tabs"
						:key="tab"
						class="matchmaker-tab"
						:class="{ active: currentTabIndex === index }"
						@click="handleTabChange(index)"
					>
						<text>{{ tab }}</text>
					</view>
				</view>
			</view>

			<scroll-view class="page-scroller" scroll-y enhanced :show-scrollbar="false">
				<view class="page-content" :class="{ 'service-page-content': currentTabValue === 'service', 'ai-page-content': currentTabValue === 'ai' }">
					<view class="error-card" v-if="loadError.length > 0">
						<text class="error-title">部分内容加载失败</text>
						<text class="error-desc">{{ loadError }}</text>
						<view class="error-button" @click="reloadPage">
							<text>重新加载</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'service'" class="tab-panel">
						<view class="section-header">
							<view>
								<text class="section-title">服务红娘</text>
								<text class="section-desc">专业顾问会先理解你的关系目标，再决定如何帮你更稳地认识一个人。</text>
							</view>
							<text class="section-link" @click="showServiceMore">查看更多</text>
						</view>

						<XsaEmpty
							v-if="serviceMatchmakers.length === 0 && !pageLoading"
							text="暂无服务红娘"
							description="稍后再来看看，我们正在整理最新排期。"
							size="small"
						/>

						<scroll-view v-else scroll-x enhanced :enable-flex="true" :show-scrollbar="false" class="horizontal-scroll">
							<view class="horizontal-list">
								<MatchmakerCard
									v-for="item in serviceMatchmakers"
									:key="item.id"
									:data="item"
									actionText="联系她"
									unitText="/次"
									@detail="handleMatchmakerDetail"
									@contact="handleMatchmakerContact"
								/>
							</view>
						</scroll-view>

						<MatchmakerRank :list="rankList" @item-click="handleMatchmakerDetail" />

						<view class="notice-card">
							<text class="notice-title">服务说明</text>
							<text class="notice-text">红娘只帮助你梳理资料、匹配对象与安排节奏，不替双方自动同意，也不会承诺关系结果。</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'custom'" class="tab-panel">
						<view class="custom-home-hero">
							<view class="custom-home-copy">
								<text class="custom-home-kicker">私人定制服务</text>
								<text class="custom-home-title">专属红娘，认真陪你靠近</text>
								<text class="custom-home-desc">从需求梳理、候选筛选到见面反馈，全程跟进每一个关键节点。</text>
							</view>
							<view class="custom-home-portraits">
								<image class="custom-home-portrait front" src="/static/portraits/profile-woman-main.jpg" mode="aspectFill"></image>
								<image class="custom-home-portrait back" src="/static/portraits/profile-man-light.jpg" mode="aspectFill"></image>
							</view>
						</view>

						<view class="section-header">
							<view><text class="section-title">服务套餐</text><text class="section-desc">选择适合自己的服务节奏</text></view>
						</view>

						<XsaEmpty v-if="customPlans.length === 0 && !pageLoading" text="暂无定制方案" description="方案内容整理中。" size="small" />
						<scroll-view v-if="customPlans.length > 0" scroll-x :enable-flex="true" class="custom-home-plan-scroll" :show-scrollbar="false">
							<view class="custom-home-plan-list">
								<view v-for="item in customPlans" :key="item.id" class="custom-home-plan" :class="{ selected: selectedCustomPlanId === item.id }" @click="selectCustomPlan(item)">
									<view v-if="item.tag" class="custom-home-plan-badge"><text>{{ item.tag }}</text></view>
									<text class="custom-home-plan-name">{{ item.name }}</text>
									<view class="custom-home-plan-price"><text>¥{{ item.price }}</text></view>
									<text class="custom-home-plan-duration">{{ item.duration }}</text>
									<text class="custom-home-plan-feature">{{ item.features[0] }}</text>
									<text class="custom-home-plan-copy">{{ item.description }}</text>
								</view>
							</view>
						</scroll-view>
					</view>

					<view v-if="currentTabValue === 'ai'" class="ai-chat-page">
						<view class="ai-chat-nav">
							<view class="ai-back" @click="leaveAiChat"><view class="ai-back-chevron"></view></view>
							<text class="ai-nav-title">AI 红娘</text>
							<text class="ai-clear" @click="clearAiMessages">清除记录</text>
						</view>

						<view class="ai-profile-card">
							<image class="ai-profile-avatar" src="/static/portraits/profile-woman-main.jpg" mode="aspectFill"></image>
							<view class="ai-profile-copy">
								<text class="ai-profile-name">小缘助手</text>
								<text class="ai-profile-subtitle">关系沟通助手</text>
							</view>
							<view class="ai-online"><view class="ai-online-dot"></view><text>在线</text></view>
						</view>

						<view class="ai-message-list">
							<view v-for="item in aiMessages" :key="item.id" class="ai-message" :class="item.role">
								<text>{{ item.text }}</text>
							</view>
						</view>

						<view class="quick-question-panel">
							<view class="quick-question-title"><view></view><text>快捷问题</text><view></view></view>
							<view class="quick-question-grid">
								<view v-for="item in aiQuickQuestions" :key="item" class="quick-question" @click="askAiQuestion(item)"><text>{{ item }}</text></view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<view v-if="currentTabValue === 'service'" class="bottom-bar-safe">
			<view class="bottom-bars">
				<view class="bottom-bar" @click="handleBecomeMatchmaker">
					<view class="bottom-icon">
						<text>缘</text>
					</view>
					<view class="bottom-copy">
						<text class="bottom-title">我要做红娘</text>
						<text class="bottom-desc">加入红娘团队，帮助更多单身朋友</text>
					</view>
					<view class="bottom-action">
						<text>›</text>
					</view>
				</view>
				<view class="bottom-bar partner-bar" @click="handleBecomePartner">
					<view class="bottom-icon partner-icon">
						<text>伴</text>
					</view>
					<view class="bottom-copy">
						<text class="bottom-title">申请成为合伙人</text>
						<text class="bottom-desc">共建认真婚恋社区，与平台一起成长</text>
					</view>
					<view class="bottom-action">
						<text>›</text>
					</view>
				</view>
				<view class="bottom-bar promoter-bar" @click="handleBecomePromoter">
					<view class="bottom-icon promoter-icon">
						<text>推</text>
					</view>
					<view class="bottom-copy">
						<text class="bottom-title">申请推广红娘</text>
						<text class="bottom-desc">分享认真婚恋理念，推广即可创造价值</text>
					</view>
					<view class="bottom-action">
						<text>›</text>
					</view>
				</view>
			</view>
		</view>

		<view v-if="currentTabValue === 'custom'" class="custom-apply-safe">
			<view class="custom-apply-button" @click="applyCustomPlan">
				<text>立即申请私人定制</text>
			</view>
		</view>

		<view v-if="currentTabValue === 'ai'" class="ai-input-safe">
			<view class="ai-input-bar">
				<input class="ai-chat-input" :value="aiInput" placeholder="请输入你的问题" confirm-type="send" @input="onAiInput" @confirm="sendAiMessage" />
				<view class="ai-send-button" @click="sendAiMessage"><text>发送</text></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import MatchmakerCard from '@/components/MatchmakerCard.uvue'
	import MatchmakerRank from '@/components/MatchmakerRank.uvue'
	import {
		getServiceMatchmakers,
		getCustomPlans
	} from '@/api'

	const tabs = ['服务红娘', '私人定制', 'AI红娘']
	const tabValues = ['service', 'custom', 'ai']
	const customHomeValues = [
		{ mark: '准', title: '精准匹配', copy: '根据关系期待筛选候选对象。' },
		{ mark: '专', title: '专属服务', copy: '一位红娘持续跟进反馈。' },
		{ mark: '密', title: '隐私保护', copy: '资料只在必要范围内展示。' }
	]
	const customHomeServices = [
		{ title: '无需注册曝光', copy: '服务期间减少无关曝光。' },
		{ title: '深度了解会员', copy: '梳理目标、方式与边界。' },
		{ title: '开放隐藏会员', copy: '匹配更合适的隐藏资料。' },
		{ title: '红娘精准推荐', copy: '结合资料和反馈推荐。' },
		{ title: '个人形象指导', copy: '优化介绍、沟通与见面状态。' },
		{ title: '安排线下见面', copy: '协助沟通首次见面安排。' },
		{ title: '反馈约见结果', copy: '复盘感受并调整方向。' }
	]
	const customHomeSteps = [
		{ title: '提交申请', copy: '填写期待' },
		{ title: '红娘联系', copy: '确认需求' },
		{ title: '需求分析', copy: '梳理方向' },
		{ title: '精准匹配', copy: '推荐对象' },
		{ title: '安排见面', copy: '双方沟通' },
		{ title: '持续跟进', copy: '反馈复盘' }
	]
	const aiQuickQuestions = [
		'如何提高相亲成功率',
		'怎么写自我介绍',
		'第一次约会注意什么',
		'帮我分析择偶需求'
	]

	const currentTabIndex = ref(0)
	const pageLoading = ref(false)
	const loadError = ref('')
	const aiInput = ref('')
	const aiMessages = ref<any[]>([
		{ id: 1, role: 'assistant', text: '你好，我是你的 AI 红娘。可以告诉我你的择偶需求吗？' },
		{ id: 2, role: 'user', text: '我希望对方性格开朗，有稳定职业。' }
	])
	const nextAiMessageId = ref(3)

	const serviceMatchmakers = ref<any[]>([])
	const customPlans = ref<any[]>([])
	const selectedCustomPlanId = ref(0)

	const currentTabValue = computed(() => {
		return tabValues[currentTabIndex.value]
	})

	const rankList = computed(() => {
		const list = serviceMatchmakers.value.slice()
		list.sort((a : any, b : any) => {
			const aCount = a.serviceCount != null ? a.serviceCount : 0
			const bCount = b.serviceCount != null ? b.serviceCount : 0
			if (bCount != aCount) {
				return bCount - aCount
			}
			const aRate = a.rating != null ? a.rating : 0
			const bRate = b.rating != null ? b.rating : 0
			return bRate - aRate
		})
		return list.slice(0, 4)
	})

	onMounted(() => {
		reloadPage()
	})

	const handleTabChange = (index : number) => {
		if (tabValues[index] === 'custom') {
			uni.navigateTo({
				url: '/pages/matchmaker/custom'
			})
			return
		}
		currentTabIndex.value = index
	}

	const reloadPage = async () => {
		pageLoading.value = true
		loadError.value = ''
		try {
			await loadServiceMatchmakers()
			await loadCustomContent()
		} catch (e) {
			loadError.value = '页面已展示可用内容，但有少量模块暂时未加载完整。'
		} finally {
			pageLoading.value = false
		}
	}

	const loadServiceMatchmakers = async () => {
		try {
			const res = await getServiceMatchmakers()
			if (res.success) {
				serviceMatchmakers.value = res.data as any[]
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '服务红娘数据加载失败。'
			}
		}
	}

	const loadCustomContent = async () => {
		try {
			const planRes = await getCustomPlans()
			if (planRes.success) {
				customPlans.value = planRes.data as any[]
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '私人定制内容加载失败。'
			}
		}
	}

	const showServiceMore = () => {
		uni.showToast({
			title: '已展示全部服务红娘',
			icon: 'none'
		})
	}

	const handleMatchmakerDetail = (item : any) => {
		uni.navigateTo({
			url: '/pages/matchmaker/detail?id=' + item.id
		})
	}

	const handleMatchmakerContact = (item : any) => {
		uni.navigateTo({
			url: '/pages/matchmaker/apply?matchmakerId=' + item.id + '&matchmakerName=' + encodeURIComponent(item.name) + '&type=' + currentTabValue.value
		})
	}

	const handleSelectPlan = (item : any) => {
		uni.navigateTo({
			url: '/pages/matchmaker/custom?id=' + item.id
		})
	}

	const goCustomPlans = () => {
		uni.navigateTo({
			url: '/pages/matchmaker/custom'
		})
	}

	const selectCustomPlan = (item : any) => {
		selectedCustomPlanId.value = item.id
	}

	const applyCustomPlan = () => {
		const plan = customPlans.value.find((p: any) => p.id == selectedCustomPlanId.value)
		const name = plan != null ? plan.name : '私人定制服务'
		uni.navigateTo({
			url: '/pages/matchmaker/apply?type=custom&matchmakerName=' + encodeURIComponent(name)
		})
	}

	const showCustomHomeDetail = (item : any) => {
		uni.showModal({ title: item.title, content: item.copy, showCancel: false, confirmText: '知道了' })
	}

	const handleBecomeMatchmaker = () => {
		uni.navigateTo({
			url: '/pages/matchmaker/become-matchmaker'
		})
	}

	const handleBecomePartner = () => {
		uni.navigateTo({
			url: '/pages/matchmaker/become-partner'
		})
	}

	const handleBecomePromoter = () => {
		uni.navigateTo({
			url: '/pages/matchmaker/become-promoter'
		})
	}

	const applyCustomService = () => {
		uni.navigateTo({
			url: '/pages/matchmaker/apply?type=custom&matchmakerName=' + encodeURIComponent('私人定制服务')
		})
	}

	const onAiInput = (event: any) => {
		aiInput.value = event.detail.value
	}

	const sendAiMessage = () => {
		const text = aiInput.value.trim()
		if (text.length == 0) return
		aiMessages.value.push({ id: nextAiMessageId.value, role: 'user', text: text })
		nextAiMessageId.value = nextAiMessageId.value + 1
		aiInput.value = ''
		aiMessages.value.push({ id: nextAiMessageId.value, role: 'assistant', text: '我先帮你把这个问题拆成可以观察和沟通的具体线索，再一起看看下一步怎么做。' })
		nextAiMessageId.value = nextAiMessageId.value + 1
	}

	const askAiQuestion = (question: string) => {
		aiInput.value = question
		sendAiMessage()
	}

	const clearAiMessages = () => {
		aiMessages.value = [{ id: 1, role: 'assistant', text: '你好，我是你的 AI 红娘。可以告诉我你的择偶需求吗？' }]
		nextAiMessageId.value = 2
	}

	const leaveAiChat = () => {
		currentTabIndex.value = 0
	}
</script>

<style scoped>
	.matchmaker-page {
		height: 100vh;
		background: var(--canvas);
	}

	.page-shell {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.page-head {
		padding: 20rpx 32rpx 12rpx;
		display: flex;
		flex-direction: column;
		gap: 8rpx;
	}

	.page-kicker {
		font-size: 20rpx;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--accent2);
	}

	.page-title {
		font-size: 44rpx;
		line-height: 1.25;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.page-desc {
		font-size: 22rpx;
		line-height: 1.6;
		color: var(--muted);
	}

	.page-tabs {
		padding: 16rpx 32rpx 12rpx;
	}

	.matchmaker-tab-bar {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8rpx;
		padding: 6rpx;
		border-radius: 999rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.matchmaker-tab {
		position: relative;
		flex: 1;
		width: 33.3333%;
		min-width: 0;
		flex-shrink: 1;
		height: 72rpx;
		border-radius: 999rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24rpx;
		font-weight: 700;
		color: var(--muted);
	}

	.matchmaker-tab.active {
		background: var(--accent);
		color: var(--paper);
	}

	.page-scroller {
		flex: 1;
		height: 0;
	}

	.page-content {
		padding: 8rpx 32rpx 188rpx;
		display: flex;
		flex-direction: column;
		gap: 24rpx;
	}

	.service-page-content {
		padding-bottom: calc(env(safe-area-inset-bottom) + 500rpx);
	}

	.error-card {
		padding: 24rpx;
		border-radius: 20rpx;
		background: rgba(194, 224, 207, 0.56);
		display: flex;
		flex-direction: column;
		gap: 10rpx;
	}

	.error-title {
		font-size: 28rpx;
		font-weight: 800;
		color: var(--ink);
	}

	.error-desc {
		font-size: 22rpx;
		line-height: 1.55;
		color: var(--ink2);
	}

	.error-button {
		margin-top: 4rpx;
		align-self: flex-start;
		height: 56rpx;
		padding: 0 18rpx;
		border-radius: 16rpx;
		background: var(--surface);
		display: flex;
		align-items: center;
		font-size: 20rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.summary-card {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12rpx;
	}

	.summary-item {
		padding: 18rpx 16rpx;
		border-radius: 20rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		min-height: 120rpx;
		justify-content: center;
	}

	.summary-value {
		font-size: 30rpx;
		line-height: 1.2;
		font-weight: 800;
		color: var(--ink);
	}

	.summary-label {
		font-size: 18rpx;
		line-height: 1.45;
		color: var(--muted);
	}

	.tab-panel {
		display: flex;
		flex-direction: column;
		gap: 24rpx;
	}

	.custom-home-hero {
		min-height: 300rpx;
		padding: 28rpx;
		border-radius: 20rpx;
		background: var(--navy);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: row;
	}

	.custom-home-copy {
		position: relative;
		z-index: 1;
		width: 62%;
		display: flex;
		flex-direction: column;
		gap: 12rpx;
	}

	.custom-home-kicker { font-size: 20rpx; font-weight: 800; letter-spacing: .08em; color: var(--soft); }
	.custom-home-title { font-size: 40rpx; line-height: 1.3; font-family: var(--serif); font-weight: 700; color: var(--paper); }
	.custom-home-desc { font-size: 22rpx; line-height: 1.6; color: var(--paper); opacity: .82; }
	.custom-home-portraits { position: absolute; right: 0; top: 0; width: 44%; height: 100%; }
	.custom-home-portrait { position: absolute; bottom: 0; width: 68%; height: 74%; border: 4rpx solid var(--paper); object-fit: cover; }
	.custom-home-portrait.front { right: 8rpx; border-radius: 20rpx 20rpx 0 0; z-index: 2; }
	.custom-home-portrait.back { right: 96rpx; height: 62%; opacity: .72; border-radius: 16rpx 16rpx 0 0; }
	.custom-home-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
	.custom-home-value { min-height: 188rpx; padding: 18rpx 14rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 10rpx; }
	.custom-home-mark { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; }
	.custom-home-value-title { font-size: 24rpx; font-weight: 800; color: var(--ink); }.custom-home-value-copy { font-size: 18rpx; line-height: 1.5; color: var(--muted); }
	.custom-home-services { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.custom-home-service { min-height: 144rpx; padding: 18rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 7rpx; }.custom-home-service-index { font-size: 18rpx; color: var(--accent2); font-weight: 800; }.custom-home-service-title { font-size: 25rpx; font-weight: 800; color: var(--ink); }.custom-home-service-copy { font-size: 19rpx; line-height: 1.45; color: var(--muted); }
	.custom-home-process-scroll, .custom-home-plan-scroll { width: 100%; margin: 0 -32rpx; padding: 0 32rpx; }.custom-home-process-list, .custom-home-plan-list { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: flex-start; gap: 14rpx; padding-right: 32rpx; }.custom-home-process { width: 128rpx; flex-shrink: 0; display: flex; flex-direction: column; gap: 8rpx; }.custom-home-process-mark { width: 50rpx; height: 50rpx; border-radius: 50%; background: var(--accent); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; }.custom-home-process-title { font-size: 23rpx; font-weight: 800; color: var(--ink); }.custom-home-process-copy { font-size: 18rpx; color: var(--muted); }
	.custom-home-plan { position: relative; width: 236rpx; min-height: 220rpx; flex-shrink: 0; padding: 22rpx; border-radius: 16rpx; background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 9rpx; }.custom-home-plan.selected { border-color: var(--accent); background: var(--accent-bg); }.custom-home-plan-name { font-size: 28rpx; font-family: var(--serif); font-weight: 700; color: var(--ink); }.custom-home-plan-price { font-size: 40rpx; color: var(--brown); font-weight: 800; }.custom-home-plan-duration { font-size: 18rpx; color: var(--muted); }.custom-home-plan-feature { font-size: 21rpx; color: var(--accent2); font-weight: 800; }.custom-home-plan-copy { font-size: 18rpx; line-height: 1.45; color: var(--muted); }.custom-home-plan-badge { position: absolute; top: 0; right: 0; padding: 6rpx 14rpx; border-radius: 0 16rpx 0 12rpx; background: var(--brown); color: var(--paper); font-size: 18rpx; font-weight: 800; }

