}

.service-icon {
	width: 40px;
	height: 40px;
	background: var(--soft);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 20px;
	flex-shrink: 0;
}

.service-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.service-title {
	font-size: 15px;
	font-weight: 500;
	color: var(--ink);
}

.service-desc {
	font-size: 13px;
	line-height: 1.5;
}
</style>
