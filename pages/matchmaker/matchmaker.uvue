<template>
	<view class="matchmaker-page">
		<!-- 顶部横幅 -->
		<view class="header-banner">
			<view class="banner-content">
				<text class="banner-title">专属红娘服务</text>
				<text class="banner-desc">1对1专业牵线，提升匹配成功率</text>
			</view>
			<view class="banner-icon">
				<text class="icon">💝</text>
			</view>
		</view>

		<!-- 我的红娘 -->
		<view class="section">
			<view class="section-header">
				<text class="section-title">我的红娘</text>
			</view>

			<view class="matchmaker-card" v-if="myMatchmaker" @click="handleChatMatchmaker">
				<image class="matchmaker-avatar" :src="myMatchmaker.avatar" mode="aspectFill"></image>
				<view class="matchmaker-info">
					<text class="matchmaker-name">{{ myMatchmaker.name }}</text>
					<text class="matchmaker-desc text-muted">{{ myMatchmaker.desc }}</text>
					<view class="matchmaker-stats">
						<text class="stat-item">成功牵线 {{ myMatchmaker.successCount }}对</text>
						<text class="stat-divider">·</text>
						<text class="stat-item">服务 {{ myMatchmaker.serviceCount }}人</text>
					</view>
				</view>
				<view class="chat-btn">
					<text class="btn-text">联系TA</text>
				</view>
			</view>

			<view class="no-matchmaker" v-else @click="handleApplyMatchmaker">
				<text class="no-text">还没有专属红娘</text>
				<text class="apply-text">立即申请 ›</text>
			</view>
		</view>

		<!-- 推荐对象 -->
		<view class="section">
			<view class="section-header">
				<text class="section-title">红娘推荐</text>
				<text class="section-more text-muted" @click="handleMoreRecommend">查看更多 ›</text>
			</view>

			<!-- 空状态 -->
			<XsaEmpty
				v-if="recommendList.length === 0"
				icon="💌"
				text="暂无推荐"
				description="红娘正在为你寻找合适的对象"
				size="small"
			/>

			<!-- 推荐列表 -->
			<view class="recommend-list" v-else>
				<XsaUserCard
					v-for="user in recommendList"
					:key="user.id"
					:user="user"
					:show-actions="true"
					@click="handleUserClick"
					@like="handleLike"
					@chat="handleChat"
				/>
			</view>
		</view>

		<!-- 线下活动 -->
		<view class="section">
			<view class="section-header">
				<text class="section-title">线下活动</text>
				<text class="section-more text-muted" @click="handleMoreActivity">查看更多 ›</text>
			</view>

			<view class="activity-list">
				<view class="activity-card" v-for="activity in activityList" :key="activity.id" @click="handleActivityClick(activity)">
					<image class="activity-image" :src="activity.image" mode="aspectFill"></image>
					<view class="activity-info">
						<text class="activity-title">{{ activity.title }}</text>
						<text class="activity-desc text-muted">{{ activity.desc }}</text>
						<view class="activity-meta">
							<text class="meta-item">📅 {{ activity.date }}</text>
							<text class="meta-item">📍 {{ activity.location }}</text>
							<text class="meta-item">👥 {{ activity.participants }}人参加</text>
						</view>
					</view>
					<view class="activity-tag" :class="activity.status">
						<text class="tag-text">{{ activity.statusText }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 服务说明 -->
		<view class="section">
			<view class="section-header">
				<text class="section-title">服务介绍</text>
			</view>

			<view class="service-list">
				<view class="service-item" v-for="(service, index) in serviceList" :key="index">
					<text class="service-icon">{{ service.icon }}</text>
					<view class="service-content">
						<text class="service-title">{{ service.title }}</text>
						<text class="service-desc text-muted">{{ service.desc }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import XsaUserCard from '@/components/XsaUserCard.uvue';
	import XsaEmpty from '@/components/XsaEmpty.uvue';

	// 导入 API
	import { getServiceMatchmakers, getAiRecommendations, getActivities } from '@/api';

	// 我的红娘（改为 null 初始值）
	const myMatchmaker = ref(null);

	// 推荐列表（改为空数组）
	const recommendList = ref([]);

	// 线下活动（改为空数组）
	const activityList = ref([]);

	// 服务介绍
	const serviceList = [
		{
			icon: '👤',
			title: '专属红娘',
			desc: '资深婚恋顾问1对1服务，深度了解你的需求'
		},
		{
			icon: '🎯',
			title: '精准推荐',
			desc: '基于你的条件和偏好，为你筛选合适的对象'
		},
		{
			icon: '💬',
			title: '全程协助',
			desc: '从初次见面到后续跟进，全程陪伴和指导'
		},
		{
			icon: '🎉',
			title: '线下活动',
			desc: '定期组织高质量单身聚会，扩展社交圈'
		}
	];

	// 页面加载时获取数据
	onMounted(() => {
		loadMatchmakerData();
		loadRecommendations();
		loadActivities();
	});

	// 加载红娘数据
	const loadMatchmakerData = async () => {
		try {
			const res = await getServiceMatchmakers();
			if (res.success && res.data.length > 0) {
				// 模拟分配一个红娘作为"我的红娘"
				const matchmaker = res.data[0];
				myMatchmaker.value = {
					id: matchmaker.id,
					name: matchmaker.name,
					avatar: matchmaker.avatar,
					desc: matchmaker.intro,
					successCount: matchmaker.successCount,
					serviceCount: matchmaker.consultCount
				};
			}
		} catch (error) {
			console.error('获取红娘数据失败', error);
		}
	};

	// 加载推荐列表
	const loadRecommendations = async () => {
		try {
			const res = await getAiRecommendations();
			if (res.success && res.data.length > 0) {
				// 将 AI 推荐转换为用户卡片格式
				recommendList.value = res.data.map((item: any) => ({
					id: item.userId,
					name: item.name,
					age: item.age,
					gender: 2,
					avatar: item.avatar,
					online: true,
					certifications: ['实名认证'],
					tags: item.tags || [],
					location: item.city,
					introduction: item.aiSuggestion
				}));
			}
		} catch (error) {
			console.error('获取推荐列表失败', error);
		}
	};

	// 加载活动列表
	const loadActivities = async () => {
		try {
			const res = await getActivities();
			if (res.success) {
				activityList.value = res.data.map((item: any) => ({
					id: item.id,
					title: item.title,
					desc: item.description || item.title,
					image: item.cover,
					date: item.date + ' ' + item.time,
					location: item.location,
					participants: item.participantCount,
					status: item.status === 'recruiting' ? 'hot' : 'normal',
					statusText: item.status === 'recruiting' ? '火热报名中' : item.status === 'full' ? '已满员' : '报名中'
				}));
			}
		} catch (error) {
			console.error('获取活动列表失败', error);
		}
	};

	// 联系红娘
	const handleChatMatchmaker = () => {
		if (myMatchmaker.value) {
			uni.navigateTo({
				url: `/pages/chat/detail?userId=${myMatchmaker.value.id}&userName=${myMatchmaker.value.name}`
			});
		}
	};

	// 申请红娘
	const handleApplyMatchmaker = () => {
		uni.showToast({
			title: '申请红娘功能开发中',
			icon: 'none'
		});
	};

	// 查看更多推荐
	const handleMoreRecommend = () => {
		uni.showToast({
			title: '查看更多推荐',
			icon: 'none'
		});
	};

	// 查看更多活动
	const handleMoreActivity = () => {
		uni.showToast({
			title: '查看更多活动',
			icon: 'none'
		});
	};

	// 点击用户
	const handleUserClick = (user: any) => {
		uni.navigateTo({
			url: `/pages/user/detail?userId=${user.id}`
		});
	};

	// 喜欢
	const handleLike = (userId: number) => {
		uni.showToast({
			title: '已添加到心动列表',
			icon: 'success'
		});
	};

	// 打招呼
	const handleChat = (userId: number) => {
		const user = recommendList.value.find(u => u.id === userId);
		if (user) {
			uni.navigateTo({
				url: `/pages/chat/detail?userId=${user.id}&userName=${user.name}`
			});
		}
	};

	// 点击活动
	const handleActivityClick = (activity: any) => {
		uni.showModal({
			title: activity.title,
			content: `${activity.desc}\n\n时间：${activity.date}\n地点：${activity.location}\n已有${activity.participants}人报名`,
			confirmText: '立即报名',
			success: (res) => {
				if (res.confirm) {
					uni.showToast({
						title: '报名成功',
						icon: 'success'
					});
				}
			}
		});
	};
</script>

<style scoped>
.matchmaker-page {
	min-height: 100vh;
	background: var(--canvas);
	padding-bottom: 20px;
}

/* 顶部横幅 */
.header-banner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 24px 20px;
	background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
	margin-bottom: 12px;
}

.banner-content {
	flex: 1;
}

.banner-title {
	display: block;
	font-size: 22px;
	font-weight: 600;
	color: var(--text-invert);
	margin-bottom: 8px;
}

.banner-desc {
	display: block;
	font-size: 14px;
	color: var(--text-invert);
}

.banner-icon .icon {
	font-size: 48px;
}

/* 区块 */
.section {
	margin-bottom: 12px;
	padding: 16px;
	background: var(--surface);
}

.section-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 16px;
}

.section-title {
	font-size: 18px;
	font-weight: 600;
	color: var(--ink);
}

.section-more {
	font-size: 13px;
}

/* 红娘卡片 */
.matchmaker-card {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 16px;
	background: var(--paper);
	border: 1px solid var(--line);
	border-radius: 12px;
}

.matchmaker-avatar {
	width: 64px;
	height: 64px;
	border-radius: 50%;
	flex-shrink: 0;
}

.matchmaker-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.matchmaker-name {
	font-size: 16px;
	font-weight: 600;
	color: var(--ink);
}

.matchmaker-desc {
	font-size: 13px;
}

.matchmaker-stats {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-top: 4px;
}

.stat-item {
	font-size: 12px;
	color: var(--muted);
}

.stat-divider {
	color: var(--muted);
}

.chat-btn {
	padding: 8px 16px;
	background: var(--accent);
	color: var(--text-invert);
	border-radius: 999px;
	flex-shrink: 0;
}

.btn-text {
	font-size: 13px;
	font-weight: 500;
	color: var(--text-invert);
}

/* 没有红娘 */
.no-matchmaker {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 24px;
	background: var(--paper);
	border: 1px dashed var(--line);
	border-radius: 12px;
}

.no-text {
	font-size: 15px;
	color: var(--muted);
}

.apply-text {
	font-size: 14px;
	color: var(--accent2);
	font-weight: 500;
}

/* 推荐列表 */
.recommend-list {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

/* 活动列表 */
.activity-list {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

.activity-card {
	position: relative;
	display: flex;
	gap: 12px;
	padding: 12px;
	background: var(--paper);
	border: 1px solid var(--line);
	border-radius: 12px;
}

.activity-image {
	width: 80px;
	height: 80px;
	border-radius: 8px;
	flex-shrink: 0;
}

.activity-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.activity-title {
	font-size: 15px;
	font-weight: 600;
	color: var(--ink);
}

.activity-desc {
	font-size: 13px;
}

.activity-meta {
	display: flex;
	flex-direction: column;
	gap: 2px;
	margin-top: 4px;
}

.meta-item {
	font-size: 12px;
	color: var(--muted);
}

.activity-tag {
	position: absolute;
	top: 12px;
	right: 12px;
	padding: 4px 10px;
	border-radius: 999px;
	font-size: 11px;
}

.activity-tag.hot {
	background: var(--accent);
	color: var(--text-invert);
}

.activity-tag.normal {
	background: var(--accent-bg);
	color: var(--accent);
}

.tag-text {
	font-weight: 500;
}

/* 服务列表 */
.service-list {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.service-item {
	display: flex;
