}

.process-list {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: flex-start;
	gap: 0;
	padding-right: 32rpx;
}

.process-item {
	width: 160rpx;
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10rpx;
	position: relative;
}

.process-circle {
	width: 64rpx;
	height: 64rpx;
	border-radius: 50%;
	background: var(--accent);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4rpx 12rpx var(--accent-glow);
}

.process-num {
	font-size: 26rpx;
	font-weight: 800;
	color: var(--paper);
}

.process-line {
	position: absolute;
	top: 32rpx;
	left: calc(50% + 32rpx);
	width: calc(100% - 64rpx);
	height: 2rpx;
	background: var(--line);
}

.process-title {
	font-size: 22rpx;
	font-weight: 800;
	color: var(--ink);
	text-align: center;
}

.process-copy {
	font-size: 18rpx;
	color: var(--muted);
	text-align: center;
	line-height: 1.45;
}

/* ============ 成功案例 ============ */
.case-list {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: flex-start;
	gap: 16rpx;
	padding-right: 32rpx;
}

.case-card {
	width: 260rpx;
	flex-shrink: 0;
	background: var(--surface);
	border-radius: 16rpx;
	box-shadow: var(--shadow-sm);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

.case-image {
	width: 100%;
	height: 180rpx;
}

.case-body {
	padding: 16rpx 18rpx 20rpx;
