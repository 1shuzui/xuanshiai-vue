	min-height: 220rpx;
}

.service-icon {
	width: 76rpx;
	height: 76rpx;
	border-radius: 50%;
	background: var(--accent-bg);
	display: flex;
	align-items: center;
	justify-content: center;
}

.service-icon-text {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--accent2);
}

.service-title {
	font-size: 22rpx;
	font-weight: 800;
	color: var(--ink);
