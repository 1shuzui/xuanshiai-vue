		display: flex;
		align-items: center;
		justify-content: center;
	}

	.photo-shield {
		position: absolute;
		left: 8px;
		right: 8px;
		bottom: 8px;
		min-height: 32px;
		padding: 4px 8px;
		border-radius: 10px;
		background: var(--paper);
		color: var(--ink2);
		display: flex;
		align-items: center;
