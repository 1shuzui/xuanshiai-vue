<template>
	<view class="candidate-card" @click="openDetail">
		<view class="candidate-profile">
			<view class="candidate-copy">
				<text class="candidate-name">{{ candidate.displayName }}</text>
				<text class="candidate-summary">{{ candidate.genderText }} · {{ candidate.birthYear }}年 · {{ candidate.city }}</text>
				<text class="candidate-facts">{{ candidate.height }} · {{ candidate.education }} · {{ candidate.job }}</text>
				<text class="candidate-cert">{{ candidate.certificationText }}</text>
			</view>

			<view class="candidate-photo-wrap">
				<view class="candidate-photo-icon">
					<XsaIcon name="profile" size="large" />
				</view>
				<view class="photo-shield"><text>照片已保护</text></view>
			</view>
		</view>

		<view class="candidate-actions">
			<button class="card-action secondary" @click.stop="toggleLike">
				{{ candidate.liked ? '已喜欢' : '喜欢' }}
			</button>
			<button class="card-action primary" @click.stop="applyToMeet">申请认识</button>
		</view>
	</view>
</template>

	<script setup lang="uts">
		import XsaIcon from '@/components/XsaIcon.uvue'

		interface ParentCandidateView {
			id: number
			displayName: string
			genderText: string
			birthYear: number
			city: string
			height: string
			education: string
			job: string
			certificationText: string
			avatar: string
			liked: boolean
		}

		interface Props {
			candidate: ParentCandidateView
		}

		const props = defineProps<Props>()
		const emit = defineEmits<{
			open: [candidate: ParentCandidateView]
			like: [candidate: ParentCandidateView]
			apply: [candidate: ParentCandidateView]
		}>()

	const openDetail = () => emit('open', props.candidate)
	const toggleLike = () => emit('like', props.candidate)
	const applyToMeet = () => emit('apply', props.candidate)
</script>

