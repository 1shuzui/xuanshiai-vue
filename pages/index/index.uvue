<template>
	<view class="home-page">
		<!-- 顶部 Tab：推荐 / 广场 -->
		<view class="top-tabs">
			<view
				class="tab-item"
				:class="{ active: currentMode === 'recommend' }"
				@click="switchMode('recommend')"
			>
				<text class="tab-text">推荐</text>
			</view>
			<view
				class="tab-item"
				:class="{ active: currentMode === 'square' }"
				@click="switchMode('square')"
			>
				<text class="tab-text">广场</text>
			</view>
			<view class="header-actions">
				<view class="icon-chip" @click="openFilter">
					<text class="chip-text">筛选</text>
				</view>
			</view>
		</view>

		<scroll-view class="scroller" scroll-y @scrolltolower="handleLoadMore">
			<!-- 推荐故事 -->
			<view v-if="currentMode === 'recommend'" class="story-view">
				<view v-if="currentUser == null" class="loading-box">
					<text class="text-muted">{{ loading ? '认真为你匹配中…' : '暂无推荐' }}</text>
				</view>

				<view v-else class="story">
					<view class="hero-photo">
						<image class="photo-img" :src="currentUser.avatar" mode="aspectFill"></image>
						<view class="photo-index">
							<text>01 / 04</text>
						</view>
						<view class="online-badge">
							<view class="online-dot"></view>
							<text>{{ currentUser.online }}</text>
						</view>
						<view class="hero-info">
							<text class="name">{{ currentUser.name }} <text class="age">{{ currentUser.age }}</text></text>
							<text class="location">{{ currentUser.city }} · {{ currentUser.height }} · {{ currentUser.job }}</text>
						</view>
					</view>

					<view class="meta-row">
						<view class="tags">
							<XsaTag variant="default" size="small">{{ currentUser.school }}</XsaTag>
							<XsaTag variant="accent" size="small">{{ currentUser.mbti }}</XsaTag>
							<XsaTag variant="default" size="small">期待长期关系</XsaTag>
						</view>
						<view class="match-stamp">
							<text class="match-value">{{ currentUser.match }}%</text>
							<text class="match-label">匹配</text>
						</view>
					</view>

					<view class="story-section">
						<view class="section-title">
							<text class="title-main">关于我的生活</text>
						</view>
						<view class="intro-box">
							<text class="intro-text">{{ currentUser.intro }}</text>
						</view>
					</view>

					<!-- 语音线索（原型交互：点击提示） -->
					<view class="story-section">
						<view class="section-title">
							<text class="title-main">听见本人</text>
							<text class="title-sub">真实表达线索</text>
						</view>
						<view class="voice-card" @click="playVoice">
							<view class="voice-play">
								<text>▶</text>
							</view>
							<view class="voice-body">
								<text class="voice-title">听听TA怎么介绍自己</text>
								<text class="voice-sub text-muted">00:18 · 仅演示</text>
							</view>
						</view>
					</view>

						<view class="story-section">
							<view class="section-title">
								<text class="title-main">可信档案</text>
								<text class="title-sub">{{ currentUser.updated != null ? currentUser.updated : '资料更新于演示数据' }}</text>
							</view>
							<view class="trust-card">
								<view class="trust-header">
									<text class="trust-title">四类认证</text>
									<text class="trust-status">VERIFIED 4 / 4</text>
								</view>
								<view class="trust-grid">
									<view class="trust-item" v-for="item in trustItems" :key="item.name">
										<text class="trust-icon">✓</text>
										<text class="trust-name">{{ item.name }}</text>
										<text class="trust-desc">{{ item.desc }}</text>
									</view>
								</view>
							</view>
						</view>

						<!-- 生活切片 -->
						<view class="story-section">
							<view class="section-title">
								<text class="title-main">生活切片</text>
								<text class="title-sub">兴趣不是标签墙</text>
							</view>
							<view class="life-grid">
								<image class="life-main" :src="currentUser.avatar" mode="aspectFill"></image>
								<view class="life-slice">
									<text class="slice-kicker">周六下午</text>
									<text class="slice-title">{{ lifeTag(0) }}与一杯{{ lifeTag(2) }}</text>
								</view>
								<view class="life-slice dark">
									<text class="slice-kicker">最近常做</text>
									<text class="slice-title">{{ lifeTag(3) }}</text>
								</view>
							</view>
						</view>

						<!-- 关系期待 -->
						<view class="story-section">
							<view class="section-title">
								<text class="title-main">关系期待</text>
								<text class="title-sub">TA 如何理解长期关系</text>
							</view>
							<text class="expect-heading">靠近之前，先确认彼此要去哪里</text>
							<view class="expect-list">
								<view class="expect-item" v-for="(line, idx) in expectList" :key="idx">
									<view class="expect-no">
										<text>0{{ idx + 1 }}</text>
									</view>
									<text class="expect-text">{{ line }}</text>
								</view>
							</view>
						</view>

						<!-- 合拍度摘要 -->
						<view class="story-section">
							<view class="section-title">
								<text class="title-main">合拍度</text>
								<text class="title-sub">仅供破冰参考</text>
							</view>
							<view class="compat-card" @click="showAiScore">
								<view class="compat-score">
									<text class="compat-num">{{ currentUser.match }}%</text>
								</view>
								<view class="compat-copy">
									<text class="compat-title">长期目标与生活节奏相近</text>
									<text class="compat-desc text-muted">你们有兴趣交集。建议从「{{ lifeTag(0) }}」开始聊。</text>
								</view>
							</view>
						</view>

					<view class="detail-link" @click="openProfileSheet">
						<text>查看完整人物档案</text>
					</view>
				</view>
			</view>

			<!-- 广场 -->
			<view v-else class="square-view">
				<XsaEmpty
					v-if="squareUsers.length === 0 && !loading"
					text="暂无推荐"
					description="试试调整筛选条件"
					:show-action="true"
					action-text="刷新"
					@action="handleRefresh"
				/>
				<view class="user-card-list" v-else>
					<XsaUserCard
						v-for="user in squareUsers"
						:key="user.id"
						:user="user"
						:compact="false"
						:show-actions="true"
						:max-tags="3"
						@click="handleUserCardClick"
						@like="handleUserCardLike"
						@chat="handleUserCardChat"
					/>
				</view>
				<view class="load-more" v-if="squareUsers.length > 0">
					<text class="load-text text-muted" v-if="loading">加载中...</text>
					<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
				</view>
			</view>
		</scroll-view>

		<!-- 底部操作栏：仅推荐模式 -->
		<view v-if="currentMode === 'recommend' && currentUser != null" class="action-dock">
			<XsaButton variant="secondary" size="small" @click="handleSkip">跳过</XsaButton>
			<XsaButton :variant="liked ? 'primary' : 'secondary'" size="small" @click="handleLike">
				{{ liked ? '已喜欢' : '喜欢' }}
			</XsaButton>
			<XsaButton variant="primary" @click="openApplyModal">
				{{ applied ? '已申请' : '申请认识' }}
			</XsaButton>
		</view>

		<!-- AI 合拍 FAB -->
		<view class="ai-fab" :class="{ raised: currentMode === 'recommend' }" @click="showAiScore">
			<text class="ai-text">合拍</text>
		</view>

		<!-- 筛选 Sheet -->
		<XsaSheet :visible="filterVisible" title="筛选认真关系" :tall="true" @close="filterVisible = false">
			<view class="filter-group">
				<view class="filter-label-row">
					<text class="filter-label">性别</text>
					<text class="filter-hint">必选</text>
				</view>
				<view class="choice-row">
					<view
						class="choice-chip"
						:class="{ selected: filterGender === 'female' }"
						@click="filterGender = 'female'"
					>
						<text>女生</text>
					</view>
					<view
						class="choice-chip"
						:class="{ selected: filterGender === 'male' }"
						@click="filterGender = 'male'"
					>
						<text>男生</text>
					</view>
				</view>
			</view>
			<view class="filter-group">
				<view class="filter-label-row">
					<text class="filter-label">常住城市</text>
					<text class="filter-hint">可多选</text>
				</view>
				<view class="choice-row">
					<view
						v-for="city in cityOptions"
						:key="city"
						class="choice-chip"
						:class="{ selected: filterCities.indexOf(city) >= 0 }"
						@click="toggleCity(city)"
					>
						<text>{{ city }}</text>
					</view>
				</view>
			</view>
			<view class="filter-group">
				<view class="filter-label-row">
					<text class="filter-label">学历</text>
					<text class="filter-hint">多选</text>
				</view>
				<view class="choice-row">
					<view
						v-for="edu in eduOptions"
						:key="edu"
						class="choice-chip"
						:class="{ selected: filterEdu.indexOf(edu) >= 0 }"
						@click="toggleEdu(edu)"
					>
						<text>{{ edu }}</text>
					</view>
				</view>
			</view>
			<view class="sheet-actions">
				<XsaButton variant="secondary" @click="resetFilter">重置</XsaButton>
				<XsaButton variant="primary" @click="applyFilter">查看符合条件的人</XsaButton>
			</view>
		</XsaSheet>

		<!-- 完整档案 Sheet -->
		<XsaSheet :visible="profileVisible" title="完整人物档案" :tall="true" @close="profileVisible = false">
			<view v-if="currentUser != null" class="profile-sheet">
				<view class="profile-hero">
					<image class="profile-avatar" :src="currentUser.avatar" mode="aspectFill"></image>
					<view class="profile-meta">
						<text class="profile-name">{{ currentUser.name }} {{ currentUser.age }}</text>
						<text class="profile-line text-muted">{{ currentUser.city }} · {{ currentUser.height }} · {{ currentUser.job }}</text>
						<text class="profile-line text-muted">{{ currentUser.school }}</text>
						<text class="profile-match">AI 合拍度 {{ currentUser.match }}%</text>
					</view>
				</view>
				<view class="profile-row"><text class="k">基本资料</text><text class="v">{{ currentUser.age }} 岁 · {{ currentUser.height }}</text></view>
				<view class="profile-row"><text class="k">工作情况</text><text class="v">{{ currentUser.job }}</text></view>
				<view class="profile-row"><text class="k">教育经历</text><text class="v">{{ currentUser.school }}</text></view>
				<view class="profile-row"><text class="k">MBTI</text><text class="v">{{ currentUser.mbti }}</text></view>
				<view class="profile-copy">
					<text class="profile-copy-title">关于我</text>
					<text class="profile-copy-text">{{ currentUser.intro }}</text>
				</view>
				<view class="safety-box">
					<text>安全提示：认证只能降低虚假资料风险。首次见面请选择公共场所，不转账、不共享验证码。</text>
				</view>
			</view>
		</XsaSheet>

		<!-- AI 合拍度 Sheet -->
		<XsaSheet :visible="aiVisible" title="AI 合拍度解读" @close="aiVisible = false">
			<view v-if="currentUser != null" class="ai-sheet">
				<view class="score-head">
					<view class="score-circle">
						<text class="score-big">{{ currentUser.match }}%</text>
					</view>
					<view class="score-copy">
						<text class="score-title">高匹配，但仍要靠真实交流</text>
						<text class="score-desc text-muted">基于公开资料与兴趣交集生成，不代表平台承诺结果。</text>
					</view>
				</view>
				<view class="bar-item" v-for="bar in aiBars" :key="bar.label">
					<view class="bar-label-row">
						<text>{{ bar.label }}</text>
						<text class="bar-pct">{{ bar.value }}%</text>
					</view>
					<view class="bar-track">
						<view class="bar-fill" :style="{ width: bar.value + '%' }"></view>
					</view>
				</view>
				<view class="ai-advice">
					<text class="advice-title">破冰建议：</text>
					<text class="advice-text">可以从共同兴趣或城市周末安排开始聊，先建立安全、真诚的对话节奏。</text>
				</view>
			</view>
		</XsaSheet>

<!-- 申请认识：统一 XsaApplySheet（与社区同源） -->
			<XsaApplySheet
				:visible="applyVisible"
				:user-id="applyUserId"
				@close="applyVisible = false"
				@success="onApplySheetSuccess"
			/>

			<!-- 申请成功说明 -->
			<XsaModal
				:visible="successVisible"
				title="申请已送达"
				:icon="true"
				icon-type="success"
				cancel-text="查看申请"
				confirm-text="演示对方同意"
				@close="successVisible = false"
				@cancel="goMessages"
				@confirm="simulateMatch"
			>
				<view class="success-body">
					<text>平台已保护双方联系方式。只有双方都愿意，聊天才会开启。</text>
					<view class="timeline">
						<text class="tl-item">1. 申请已通过平台安全检查</text>
						<text class="tl-item">2. 等待对方回应，通常在 24 小时内</text>
						<text class="tl-item">3. 双方同意后开放聊天</text>
					</view>
				</view>
			</XsaModal>

		<!-- 双方同意 -->
		<XsaModal
			:visible="matchedVisible"
			title="你们都愿意认识彼此"
			:icon="true"
			icon-type="success"
			:show-cancel="false"
			confirm-text="开始聊天"
			@close="matchedVisible = false"
			@confirm="startChat"
		>
			<view class="matched-body">
				<text>认真关系从一段真诚对话开始。请注意保护隐私与财产安全。</text>
			</view>
		</XsaModal>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaButton from '@/components/XsaButton.uvue'
		import XsaTag from '@/components/XsaTag.uvue'
		import XsaToast from '@/components/XsaToast.uvue'
		import XsaUserCard from '@/components/XsaUserCard.uvue'
		import XsaEmpty from '@/components/XsaEmpty.uvue'
		import XsaSheet from '@/components/XsaSheet.uvue'
		import XsaModal from '@/components/XsaModal.uvue'
		import XsaApplySheet from '@/components/XsaApplySheet.uvue'
		import { getRecommendUser, getSquareUsers, likeUser } from '@/api'
		import { guardRealName } from '@/utils/realNameGate.uts'

		const currentMode = ref('recommend')
		const liked = ref(false)
		const applied = ref(false)
		const toastVisible = ref(false)
		const toastMessage = ref('')
		const loading = ref(false)
		const hasMore = ref(true)
		const currentUser = ref(null)
		const squareUsers = ref([])
		const recommendIndex = ref(0)

		const filterVisible = ref(false)
		const profileVisible = ref(false)
		const aiVisible = ref(false)
		const applyVisible = ref(false)
		const applyUserId = ref(0)
		const successVisible = ref(false)
		const matchedVisible = ref(false)

	const filterGender = ref('female')
	const filterCities = ref(['杭州', '南京'])
	const filterEdu = ref(['本科', '硕士'])
	const cityOptions = ['杭州', '南京', '上海', '苏州', '宁波']
	const eduOptions = ['本科', '硕士', '博士', '大专']

	const trustItems = [
		{ name: '实名', desc: '身份已核验' },
		{ name: '学历', desc: '学信资料' },
		{ name: '头像', desc: '本人一致' },
		{ name: '单身', desc: '本人声明' }
	]

	const fallbackTags = ['看展', '猫', '咖啡', '城市散步']
	const lifeTag = (index: number): string => {
		const u = currentUser.value as any
		const tags = u != null && u.tags != null && u.tags.length > 0 ? u.tags : fallbackTags
		if (index < tags.length) return tags[index] as string
		return fallbackTags[index % fallbackTags.length]
	}
	const expectList = computed((): string[] => {
		const u = currentUser.value as any
		if (u != null && u.expect != null && u.expect.length > 0) return u.expect as string[]
		return [
			'希望关系是慢慢靠近，而不是情绪消费',
			'更看重日常陪伴与长期规划是否同频',
			'愿意把生活里的真实一面认真介绍给你'
		]
	})

	const aiBars = [
		{ label: '关系目标', value: 96 },
		{ label: '生活节奏', value: 89 },
		{ label: '兴趣交集', value: 86 }
	]

onMounted(() => {
			loadRecommendUser()
			loadSquareUsers()
		})

	const showToast = (msg: string) => {
		toastMessage.value = msg
		toastVisible.value = true
	}

	const mapCardUser = (raw: any) => {
		return {
			id: raw.id,
			avatar: raw.avatar,
			name: raw.name,
			age: raw.age,
			gender: raw.gender != null ? raw.gender : 2,
			online: raw.online === true || (typeof raw.online === 'string' && raw.online.indexOf('在线') >= 0),
			certifications: raw.certifications != null
				? (Array.isArray(raw.certifications) ? raw.certifications : ['实名', '学历'])
				: ['实名'],
			tags: raw.tags != null ? raw.tags : [raw.job, raw.mbti].filter((x: any) => !!x),
			location: raw.location != null ? raw.location : (raw.city != null ? raw.city : ''),
			introduction: raw.introduction != null ? raw.introduction : (raw.intro != null ? raw.intro : '')
		}
	}

	const loadRecommendUser = async () => {
		try {
			loading.value = true
			const res = await getRecommendUser(recommendIndex.value)
			if (res.success) {
				currentUser.value = res.data
				liked.value = false
				applied.value = false
			}
		} catch (e) {
			showToast('加载失败，请稍后重试')
		} finally {
			loading.value = false
		}
	}

	const loadSquareUsers = async () => {
		try {
			const res = await getSquareUsers({ page: 1, limit: 10 })
			if (res.success) {
				const list = res.data as any[]
				squareUsers.value = list.map((u: any) => mapCardUser(u))
			}
		} catch (e) {
			console.error(e)
		}
	}

	const switchMode = (mode: string) => {
		currentMode.value = mode
	}

	const handleSkip = async () => {
		showToast('已跳过 · 为你换一位认真嘉宾')
		recommendIndex.value = recommendIndex.value + 1
		await loadRecommendUser()
	}

	const handleLike = async () => {
		if (currentUser.value == null) return
		try {
			const res = await likeUser(currentUser.value.id)
			if (res.success) {
				liked.value = !liked.value
				showToast(liked.value ? '已收藏，仅你自己可见' : '已取消收藏')
			}
		} catch (e) {
			showToast('操作失败，请重试')
		}
	}

const openApplyModal = async () => {
			if (currentUser.value == null) return
			if (applied.value) {
				showToast('已申请，等待对方回应')
				return
			}
			const ok = await guardRealName('apply')
			if (!ok) return
			applyUserId.value = currentUser.value.id as number
			applyVisible.value = true
		}

		const onApplySheetSuccess = (payload: any) => {
			applied.value = true
			// 产品规则：申请后不直接进入聊天
			successVisible.value = true
			if (payload != null && payload.code == 'ALREADY_PENDING') {
				showToast('申请已发送，请等待对方回应')
			}
		}

	const goMessages = () => {
		successVisible.value = false
		uni.switchTab({ url: '/pages/message/message' })
	}

	const simulateMatch = () => {
		successVisible.value = false
		matchedVisible.value = true
	}

	const startChat = () => {
		if (currentUser.value == null) return
		matchedVisible.value = false
		// 仅在双方同意后允许进入聊天
		uni.navigateTo({
			url: `/pages/chat/detail?userId=${currentUser.value.id}&userName=${currentUser.value.name}`
		})
	}

	const handleUserCardClick = (user: any) => {
		uni.navigateTo({ url: `/pages/user/detail?userId=${user.id}` })
	}

	const handleUserCardLike = async (userId: number) => {
		try {
			const res = await likeUser(userId)
			if (res.success) showToast('已添加到心动列表')
		} catch (e) {
			showToast('操作失败，请重试')
		}
	}

	// 广场「打招呼」仍走申请认识，而不是直接聊天
	const handleUserCardChat = (userId: number) => {
		const user = squareUsers.value.find((u: any) => u.id == userId)
		if (user != null) {
			currentUser.value = {
				id: user.id,
				name: user.name,
				age: user.age,
				city: user.location,
				height: '',
				job: '',
				school: '',
				mbti: '',
				match: 85,
				online: user.online ? '当前在线' : '近期在线',
				avatar: user.avatar,
				intro: user.introduction
			}
			openApplyModal()
		}
	}

	const openFilter = () => {
		filterVisible.value = true
	}

	const toggleCity = (city: string) => {
		const idx = filterCities.value.indexOf(city)
		if (idx >= 0) {
			filterCities.value.splice(idx, 1)
		} else {
			filterCities.value.push(city)
		}
	}

	const toggleEdu = (edu: string) => {
		const idx = filterEdu.value.indexOf(edu)
		if (idx >= 0) {
			filterEdu.value.splice(idx, 1)
		} else {
			filterEdu.value.push(edu)
		}
	}

	const resetFilter = () => {
		filterGender.value = 'female'
		filterCities.value = ['杭州', '南京']
		filterEdu.value = ['本科', '硕士']
		showToast('筛选条件已重置')
	}

	const applyFilter = () => {
		filterVisible.value = false
		showToast('筛选已保存 · 找到符合条件的人')
		loadSquareUsers()
		currentMode.value = 'square'
	}

	const openProfileSheet = () => {
		profileVisible.value = true
	}

	const showAiScore = () => {
		if (currentUser.value == null) {
			showToast('请先浏览推荐嘉宾')
			return
		}
		aiVisible.value = true
	}

const playVoice = () => {
			showToast('语音播放 · 原型演示')
		}

		const handleRefresh = async () => {
		loading.value = true
		await loadSquareUsers()
		loading.value = false
		showToast('刷新成功')
	}

	const handleLoadMore = async () => {
		if (currentMode.value != 'square' || loading.value || !hasMore.value) return
		loading.value = true
		try {
			const page = Math.floor(squareUsers.value.length / 10) + 1
			const res = await getSquareUsers({ page, limit: 10 })
			if (res.success && res.data.length > 0) {
				const list = (res.data as any[]).map((u: any) => mapCardUser(u))
				squareUsers.value = squareUsers.value.concat(list)
			} else {
				hasMore.value = false
			}
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}
</script>

