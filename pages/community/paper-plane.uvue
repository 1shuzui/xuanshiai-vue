<template>
	<view class="page">
		<view class="quota-bar">
			<text class="q-label">今日纸飞机 · 剩余 {{ remain }} / {{ total }}</text>
		</view>
		<scroll-view class="list" scroll-y>
			<view class="intro">
				<text class="intro-title">认真表达，温柔回应</text>
				<text class="intro-desc text-muted">匿名投放一句认真表达。完成实名后可放飞与回复；不承诺匹配结果。</text>
			</view>
			<view class="footer">
				<button class="fab" :disabled="remain <= 0" @click="openComposer">
					{{ remain > 0 ? '放飞纸飞机' : '今日次数已用完' }}
				</button>
			</view>
			<view class="loading-state" v-if="loading">
				<text class="text-muted">正在接收纸飞机...</text>
			</view>
			<XsaEmpty
				v-else-if="loadError"
				type="noNetwork"
				text="纸飞机加载失败"
				description="请检查网络后重试"
				:showAction="true"
				actionText="重新加载"
				@action="load"
			/>
			<XsaEmpty v-else-if="planes.length == 0" text="暂时没有纸飞机" description="成为第一个放飞的人" />
			<view class="plane" v-for="p in planes" :key="p.id">
				<text class="content" v-if="p.content">{{ p.content }}</text>
				<view class="voice-row" v-if="p.voiceUrl">
					<button class="voice-btn" @click="playVoice(p)">
						{{ playingId == p.id ? '播放中…' : '播放语音' }} · {{ p.voiceDurationSec || 0 }}″
					</button>
				</view>
				<view class="meta">
					<text class="meta-text text-muted">{{ p.anonymous ? '匿名' : '' }} · {{ p.gender }} · {{ p.city }} · {{ p.age }}岁 · {{ p.timeText }}</text>
					<view class="plane-actions">
						<button class="reply-btn" :class="{ replied: p.replied }" @click="onPlaneAction(p)">
							{{ p.replied ? '匿名对话' : '回复' }} · {{ p.replyCount }}
						</button>
						<button class="report-btn" @click="openReport(p)">举报</button>
					</view>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>

		<XsaSheet :visible="composerVisible" title="放飞纸飞机" @close="closeComposer">
			<view class="composer">
				<textarea
					class="ta"
					:value="draft"
					@input="onDraft"
					placeholder="写下一句认真的话（可选，120 字内）"
					maxlength="120"
				></textarea>
				<text class="count">{{ draft.length }}/120</text>
				<view class="photo-grid">
					<view class="photo-item" v-for="(item, index) in photoItems" :key="index">
						<image class="photo" :src="item.localPath" mode="aspectFill"></image>
						<view class="media-status" v-if="item.status == 'uploading' || item.status == 'pending'">
							<text class="media-status-text">上传中</text>
						</view>
						<view class="media-status media-failed" v-else-if="item.status == 'failed'" @click="retryPhoto(index)">
							<text class="media-status-text">失败·点重试</text>
						</view>
						<view class="delete-btn" @click="deletePhoto(index)">
							<text class="icon">✕</text>
						</view>
					</view>
					<view class="photo-item add-btn" @click="addPhoto" v-if="photoItems.length < 6">
						<text class="icon">+</text>
						<text class="text">添加图片</text>
					</view>
				</view>
				<text class="photo-tip text-muted">最多 6 张图，选择后自动上传</text>
				<view class="voice-tools">
					<button class="voice-btn" @click="toggleRecord">{{ recording ? '停止录音' : '录制语音' }}</button>
					<text class="voice-tip text-muted" v-if="pendingVoiceDuration > 0">已录 {{ pendingVoiceDuration }}″</text>
					<text class="voice-tip text-muted" v-else-if="recording">录音中…</text>
				</view>
				<button class="send" :disabled="sending || !canSend" @click="send">放飞</button>
			</view>
		</XsaSheet>

		<XsaSheet :visible="replyVisible" title="回复纸飞机" @close="closeReply">
			<view class="composer">
				<textarea
					class="ta"
					:value="replyDraft"
					@input="onReplyDraft"
					placeholder="写一句认真的回复（120 字内）"
					maxlength="120"
				></textarea>
				<text class="count">{{ replyDraft.length }}/120</text>
				<button class="send" :disabled="replying || replyDraft.trim().length == 0" @click="submitReply">
					{{ replying ? '发送中...' : '发送回复' }}
				</button>
			</view>
		</XsaSheet>

		<XsaSheet :visible="chatVisible" title="纸飞机匿名对话" @close="closeChat">
			<view class="chat-box">
				<text class="chat-hint text-muted">这是纸飞机匿名对话，不是双方同意后的真实私信。</text>
				<scroll-view class="chat-list" scroll-y>
					<view class="chat-msg" v-for="m in chatMessages" :key="m.id" :class="{ mine: m.mine }">
						<text class="chat-text">{{ m.content }}</text>
						<text class="chat-time text-muted">{{ m.timeText }}</text>
					</view>
				</scroll-view>
				<view class="chat-composer" v-if="chatStatus == 1">
					<input class="chat-input" :value="chatDraft" @input="onChatDraft" placeholder="继续认真回复" confirm-type="send" @confirm="sendChat" />
					<button class="chat-send" :disabled="chatSending" @click="sendChat">发送</button>
				</view>
				<view class="chat-ended" v-else>
					<text class="text-muted">对话已结束</text>
				</view>
				<button class="end-btn" v-if="chatStatus == 1" @click="endChat">结束对话</button>
			</view>
		</XsaSheet>

		<XsaReportSheet
			:visible="reportVisible"
			target-type="paper_plane"
			:target-id="reportTargetId"
			:user-id="reportUserId"
			@close="reportVisible = false"
			@blocked="onBlocked"
		/>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import { getPaperPlanes, sendPaperPlane, replyPaperPlane, getCommunityQuotas, createCommunityCreateKey, discardCommunityCreateKey, uploadMedia, uploadCommunityMedia, deleteCommunityMedia, getPaperPlaneMessages, sendPaperPlaneMessage, readPaperPlaneConversation, endPaperPlaneConversation } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	type LocalMedia = {
		localPath: string
		mediaId: number
		remoteUrl: string
		status: string // pending | uploading | ready | failed
		mediaType: string // image | video
	}

	const planes = ref([])
	const loading = ref(false)
	const remain = ref(3)
	const total = ref(3)
	const composerVisible = ref(false)
	const draft = ref('')
	const sending = ref(false)
	const sendBound = ref(false)
	const loadError = ref(false)
	const replyVisible = ref(false)
	const replyDraft = ref('')
	const replying = ref(false)
	let replyTarget: any = null
	const reportVisible = ref(false)
	const reportTargetId = ref(0)
	const reportUserId = ref(0)
	const pendingSendKey = ref('')
	const pendingSendFingerprint = ref('')
	const pendingReplyKey = ref('')
	const pendingReplyFingerprint = ref('')
	const photoItems = ref<LocalMedia[]>([])
	const pendingVoicePath = ref('')
	const pendingVoiceDuration = ref(0)
	const recording = ref(false)
	const playingId = ref(0)
	let recorder: any = null
	let recordStartedAt = 0
	let audioPlayer: any = null
	const chatVisible = ref(false)
	const chatMessages = ref([] as any[])
	const chatDraft = ref('')
	const chatSending = ref(false)
	const chatConversationId = ref(0)
	const chatStatus = ref(1)

	onMounted(() => {
		load()
		loadQuota()
	})

	const load = async () => {
		loading.value = true
		loadError.value = false
		try {
			const res = await getPaperPlanes()
			if (res.success) planes.value = res.data as any[]
		} catch (e) {
			console.error(e)
			loadError.value = true
		} finally {
			loading.value = false
		}
	}

	const loadQuota = async () => {
		try {
			const res = await getCommunityQuotas()
			if (res.success && res.data != null && res.data.paperPlaneDaily != null) {
				remain.value = res.data.paperPlaneDaily.remain
				total.value = res.data.paperPlaneDaily.total
			}
		} catch (e) {
			console.error(e)
		}
	}

	const mediaIdsFingerprint = (): string => {
		const ids: string[] = []
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			ids.push('i' + photos[i].mediaId + ':' + photos[i].status)
		}
		return ids.join(',')
	}
	const sendFingerprint = (text: string) => text + '|city|true|' + mediaIdsFingerprint() + '|v' + pendingVoiceDuration.value
	const replyFingerprint = (planeId: number, text: string) => planeId + '|' + text + '|true'
	const discardPendingSendKey = () => {
		if (pendingSendKey.value != '') discardCommunityCreateKey(pendingSendKey.value)
		pendingSendKey.value = ''
		pendingSendFingerprint.value = ''
	}
	const discardPendingReplyKey = () => {
		if (pendingReplyKey.value != '') discardCommunityCreateKey(pendingReplyKey.value)
		pendingReplyKey.value = ''
		pendingReplyFingerprint.value = ''
	}
	const shouldDiscardCreateKey = (res: any): boolean => {
		if (res == null) return false
		if (res.success == false) return res.code != null && res.code != -1
		return res.data != null && res.data.success == false
	}

	const readyImageMediaIds = (): number[] => {
		const out: number[] = []
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'ready' && photos[i].mediaId > 0) {
				out.push(photos[i].mediaId)
			}
		}
		return out
	}

	const canSend = computed(() => {
		if (draft.value.trim().length > 0) return true
		if (pendingVoicePath.value != '') return true
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'ready' && photos[i].mediaId > 0) return true
		}
		return false
	})

	const makeLocalMedia = (localPath: string): LocalMedia => {
		return {
			localPath: localPath,
			mediaId: 0,
			remoteUrl: '',
			status: 'uploading',
			mediaType: 'image'
		}
	}

	const uploadOne = async (item: LocalMedia) => {
		item.status = 'uploading'
		try {
			const res = await uploadCommunityMedia(item.localPath, 'paper_plane')
			if (res != null && res.success && res.data != null) {
				const data = res.data as any
				item.mediaId = data.id != null ? (data.id as number) : 0
				item.remoteUrl = data.url != null ? ('' + data.url) : ''
				item.status = item.mediaId > 0 ? 'ready' : 'failed'
			} else {
				item.status = 'failed'
				item.mediaId = 0
				item.remoteUrl = ''
			}
		} catch (e) {
			item.status = 'failed'
			item.mediaId = 0
			item.remoteUrl = ''
		}
		if (pendingSendFingerprint.value != '' && pendingSendFingerprint.value != sendFingerprint(draft.value.trim())) {
			discardPendingSendKey()
		}
	}

	const cleanupUnboundPhotos = async () => {
		if (sendBound.value) return
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'ready' && photos[i].mediaId > 0) {
				try {
					await deleteCommunityMedia(photos[i].mediaId)
				} catch (e) {}
			}
		}
	}

	const addPhoto = () => {
		const remaining = 6 - photoItems.value.length
		if (remaining <= 0) {
			uni.showToast({ title: '最多添加 6 张图片', icon: 'none' })
			return
		}
		uni.chooseImage({
			count: remaining,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: async (res) => {
				const paths = res.tempFilePaths as string[]
				const start = photoItems.value.length
				for (let i = 0; i < paths.length; i++) {
					const path = paths[i] != null ? ('' + paths[i]) : ''
					if (path == '') continue
					if (photoItems.value.length >= 6) break
					photoItems.value.push(makeLocalMedia(path))
				}
				if (pendingSendFingerprint.value != '' && pendingSendFingerprint.value != sendFingerprint(draft.value.trim())) {
					discardPendingSendKey()
				}
				const list = photoItems.value as LocalMedia[]
				for (let i = start; i < list.length; i++) {
					await uploadOne(list[i])
				}
			}
		})
	}

	const deletePhoto = async (index: number) => {
		const list = photoItems.value as LocalMedia[]
		if (index < 0 || index >= list.length) return
		const item = list[index]
		if (item.status == 'ready' && item.mediaId > 0) {
			try {
				await deleteCommunityMedia(item.mediaId)
			} catch (e) {}
		}
		photoItems.value.splice(index, 1)
		if (pendingSendFingerprint.value != '' && pendingSendFingerprint.value != sendFingerprint(draft.value.trim())) {
			discardPendingSendKey()
		}
	}

	const retryPhoto = async (index: number) => {
		const list = photoItems.value as LocalMedia[]
		if (index < 0 || index >= list.length) return
		if (list[index].status != 'failed') return
		await uploadOne(list[index])
	}

	const openComposer = async () => {
		if (remain.value <= 0) {
			uni.showToast({ title: '今日免费次数已用完，可用积分加次', icon: 'none' })
			return
		}
		const ok = await guardRealName('paperPlane')
		if (!ok) return
		discardPendingSendKey()
		draft.value = ''
		photoItems.value = []
		sendBound.value = false
		clearPendingVoice()
		composerVisible.value = true
	}

	const closeComposer = async () => {
		discardPendingSendKey()
		draft.value = ''
		stopRecordingIfNeeded()
		clearPendingVoice()
		await cleanupUnboundPhotos()
		photoItems.value = []
		sendBound.value = false
		composerVisible.value = false
	}

	const closeReply = () => {
		discardPendingReplyKey()
		replyDraft.value = ''
		replyTarget = null
		replyVisible.value = false
	}

	const onDraft = (e: any) => {
		draft.value = e.detail.value
		if (pendingSendFingerprint.value != '' && pendingSendFingerprint.value != sendFingerprint(draft.value.trim())) {
			discardPendingSendKey()
		}
	}

	const onReplyDraft = (e: any) => {
		replyDraft.value = e.detail.value
		if (replyTarget != null && pendingReplyFingerprint.value != '') {
			const content = replyDraft.value.trim()
			if (pendingReplyFingerprint.value != replyFingerprint(replyTarget.id, content)) {
				discardPendingReplyKey()
			}
		}
	}


	const clearPendingVoice = () => {
		pendingVoicePath.value = ''
		pendingVoiceDuration.value = 0
	}
	const stopRecordingIfNeeded = () => {
		if (recording.value && recorder != null) { try { recorder.stop() } catch (e) {} }
		recording.value = false
	}
	const ensureRecorder = () => {
		if (recorder != null) return recorder
		try {
			recorder = uni.getRecorderManager()
			recorder.onStop((res: any) => {
				recording.value = false
				const path = res != null && res.tempFilePath != null ? ('' + res.tempFilePath) : ''
				let durationSec = 0
				if (res != null && res.duration != null) durationSec = Math.max(1, Math.round((res.duration as number) / 1000))
				else if (recordStartedAt > 0) durationSec = Math.max(1, Math.round((Date.now() - recordStartedAt) / 1000))
				if (durationSec > 60) durationSec = 60
				pendingVoicePath.value = path
				pendingVoiceDuration.value = durationSec
			})
			recorder.onError(() => { recording.value = false; uni.showToast({ title: '录音失败', icon: 'none' }) })
		} catch (e) { recorder = null }
		return recorder
	}
	const toggleRecord = () => {
		const mgr = ensureRecorder()
		if (mgr == null) { uni.showToast({ title: '当前环境不支持录音', icon: 'none' }); return }
		if (recording.value) { try { mgr.stop() } catch (e) {}; return }
		clearPendingVoice(); recording.value = true; recordStartedAt = Date.now()
		try { mgr.start({ duration: 60000, format: 'mp3' }) } catch (e) { recording.value = false; uni.showToast({ title: '无法开始录音', icon: 'none' }) }
	}
	const playVoice = (p: any) => {
		if (p == null || p.voiceUrl == null || p.voiceUrl == '') return
		try {
			if (audioPlayer != null) { try { audioPlayer.stop() } catch (e) {}; try { audioPlayer.destroy() } catch (e) {}; audioPlayer = null }
			audioPlayer = uni.createInnerAudioContext(); audioPlayer.src = p.voiceUrl; playingId.value = p.id
			audioPlayer.onEnded(() => { playingId.value = 0 }); audioPlayer.onStop(() => { playingId.value = 0 })
			audioPlayer.onError(() => { playingId.value = 0; uni.showToast({ title: '播放失败', icon: 'none' }) }); audioPlayer.play()
		} catch (e) { uni.showToast({ title: '播放失败', icon: 'none' }) }
	}
	const onPlaneAction = async (p: any) => {
		if (p.replied == true && p.conversationId != null && p.conversationId > 0) { await openChat(p.conversationId); return }
		if (p.replied) { uni.showToast({ title: '已回复，会话暂不可用', icon: 'none' }); return }
		await reply(p)
	}
	const openChat = async (conversationId: number) => {
		if (conversationId == null || conversationId <= 0) return
		chatConversationId.value = conversationId; chatVisible.value = true; chatDraft.value = ''; chatStatus.value = 1
		try {
			await readPaperPlaneConversation(conversationId)
			const res = await getPaperPlaneMessages(conversationId)
			chatMessages.value = (res.success && res.data != null) ? res.data as any[] : []
		} catch (e) { chatMessages.value = [] }
	}
	const closeChat = () => { chatVisible.value = false; chatDraft.value = ''; chatConversationId.value = 0 }
	const onChatDraft = (e: any) => { chatDraft.value = e.detail.value }
	const sendChat = async () => {
		const content = chatDraft.value.trim()
		if (chatSending.value || content.length == 0 || chatConversationId.value <= 0) return
		chatSending.value = true
		try {
			const res = await sendPaperPlaneMessage(chatConversationId.value, content)
			if (res.success && res.data != null) { (chatMessages.value as any[]).push(res.data); chatDraft.value = '' }
			else uni.showToast({ title: res.message != null ? res.message : '发送失败', icon: 'none' })
		} catch (e) { uni.showToast({ title: '发送失败', icon: 'none' }) }
		finally { chatSending.value = false }
	}
	const endChat = async () => {
		if (chatConversationId.value <= 0) return
		const res = await endPaperPlaneConversation(chatConversationId.value)
		if (res.success) { chatStatus.value = 2; uni.showToast({ title: '已结束对话', icon: 'none' }) }
		else uni.showToast({ title: res.message != null ? res.message : '结束失败', icon: 'none' })
	}

	onUnload(() => {
		discardPendingSendKey()
		discardPendingReplyKey()
		stopRecordingIfNeeded()
		cleanupUnboundPhotos()
		if (audioPlayer != null) {
			try { audioPlayer.stop() } catch (e) {}
			try { audioPlayer.destroy() } catch (e) {}
			audioPlayer = null
		}
	})

	const send = async () => {
		const text = draft.value.trim()
		if (sending.value) return
		if (!canSend.value) return
		if (remain.value <= 0) {
			uni.showToast({ title: '今日免费次数已用完，可用积分加次', icon: 'none' })
			return
		}
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'uploading' || photos[i].status == 'pending') {
				uni.showToast({ title: '图片上传中，请稍候', icon: 'none' })
				return
			}
			if (photos[i].status == 'failed') {
				uni.showToast({ title: '有图片上传失败，请重试或删除', icon: 'none' })
				return
			}
		}
		const imageMediaIds = readyImageMediaIds()
		stopRecordingIfNeeded()
		const fingerprint = sendFingerprint(text)
		if (pendingSendKey.value == '' || pendingSendFingerprint.value != fingerprint) {
			discardPendingSendKey()
			pendingSendKey.value = createCommunityCreateKey('paper-plane')
			pendingSendFingerprint.value = fingerprint
		}
		sending.value = true
		try {
			let voiceUrl = ''
			let voiceDurationSec = 0
			if (pendingVoicePath.value != '') {
				const up = await uploadMedia(pendingVoicePath.value, 'paper_plane_voice')
				if (!up.success || up.data == null || up.data.url == null) {
					uni.showToast({ title: up.message != null ? up.message : '语音上传失败', icon: 'none' })
					return
				}
				voiceUrl = '' + up.data.url
				voiceDurationSec = pendingVoiceDuration.value > 0 ? pendingVoiceDuration.value : 1
			}
			const payload: any = {
				content: text,
				anonymous: true,
				scope: 'city',
				idempotencyKey: pendingSendKey.value,
				voiceUrl: voiceUrl,
				voiceDurationSec: voiceDurationSec
			}
			if (imageMediaIds.length > 0) {
				payload.imageMediaIds = imageMediaIds
			}
			const res = await sendPaperPlane(payload)
			const data = res != null ? res.data : null
			const bizOk = res != null && res.success && data != null && data.success != false
			if (bizOk) {
				sendBound.value = true
				discardPendingSendKey()
				if (data.plane != null) { (planes.value as any[]).unshift(data.plane) } else { await load() }
				if (data.quotas != null && data.quotas.remain != null) {
					remain.value = data.quotas.remain
					if (data.quotas.total != null) total.value = data.quotas.total
				} else if (data.remain != null) { remain.value = data.remain }
				else { remain.value = Math.max(0, remain.value - 1) }
				photoItems.value = []
				composerVisible.value = false
				clearPendingVoice()
				uni.showToast({ title: '已放飞', icon: 'success' })
			} else {
				if (shouldDiscardCreateKey(res)) discardPendingSendKey()
				const msg = data != null && data.message != null ? data.message : (res != null && res.message != null ? res.message : '放飞失败')
				uni.showToast({ title: msg, icon: 'none' })
				if (data != null && data.remain != null) remain.value = data.remain
			}
		} catch (e) { uni.showToast({ title: '网络异常', icon: 'none' }) }
		finally { sending.value = false }
	}

	const reply = async (p: any) => {
		if (p.replied) {
			uni.showToast({ title: '已回复过', icon: 'none' })
			return
		}
		const ok = await guardRealName('paperPlane')
		if (!ok) return
		discardPendingReplyKey()
		replyTarget = p
		replyDraft.value = ''
		replyVisible.value = true
	}

	const submitReply = async () => {
		const content = replyDraft.value.trim()
		if (replying.value || content.length == 0 || replyTarget == null) return
		const p = replyTarget
		const fingerprint = replyFingerprint(p.id, content)
		if (pendingReplyKey.value == '' || pendingReplyFingerprint.value != fingerprint) {
			discardPendingReplyKey()
			pendingReplyKey.value = createCommunityCreateKey('paper-plane-reply')
			pendingReplyFingerprint.value = fingerprint
		}
		replying.value = true
		try {
			const res = await replyPaperPlane(p.id, content, pendingReplyKey.value)
			const data = res != null ? res.data : null
			const replyOk = res != null && res.success && (res.data == null || res.data.success != false)
			if (replyOk) {
				discardPendingReplyKey()
				p.replied = true
				p.replyCount += 1
				if (data != null && data.replyCount != null) {
					p.replyCount = data.replyCount
				}
				const convId = data != null && data.conversationId != null ? data.conversationId : (data != null && data.conversation_id != null ? data.conversation_id : 0)
				if (convId != null && convId > 0) p.conversationId = convId
				replyVisible.value = false
				replyTarget = null
				uni.showToast({ title: '已回复，进入匿名对话', icon: 'none' })
				if (p.conversationId != null && p.conversationId > 0) {
					await openChat(p.conversationId)
				}
			} else {
				if (shouldDiscardCreateKey(res)) discardPendingReplyKey()
				const message =
					data != null && data.message != null
						? data.message
						: res != null && res.message != null
							? res.message
							: '回复失败'
				uni.showToast({ title: message, icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '回复失败，请稍后重试', icon: 'none' })
		} finally {
			replying.value = false
		}
	}

	const openReport = (p: any) => {
		reportTargetId.value = p.id
		reportUserId.value = p.userId != null ? p.userId : 0
		reportVisible.value = true
	}

	const onBlocked = (userId: number) => {
		planes.value = (planes.value as any[]).filter((p: any) => p.userId != userId)
	}
</script>

