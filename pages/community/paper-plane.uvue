<template>
	<view class="page">
		<view class="quota-bar">
			<text class="q-label">今日纸飞机</text>
			<text class="q-value">剩余 {{ remain }} / {{ total }}</text>
		</view>
		<scroll-view class="list" scroll-y>
			<view class="intro">
				<text class="intro-title">纸飞机</text>
				<text class="intro-desc text-muted">匿名投放一句认真表达。完成实名后可放飞与回复；不承诺匹配结果。</text>
			</view>
			<XsaEmpty v-if="!loading && planes.length == 0" text="暂时没有纸飞机" description="成为第一个放飞的人" />
			<view class="plane" v-for="p in planes" :key="p.id">
				<text class="content">{{ p.content }}</text>
				<view class="meta">
					<text class="text-muted">{{ p.anonymous ? '匿名' : '' }} · {{ p.city }} · {{ p.age }}岁 · {{ p.timeText }}</text>
					<text class="reply text-accent" @click="reply(p)">{{ p.replied ? '已回复' : '回复' }} · {{ p.replyCount }}</text>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>
		<view class="footer">
			<button class="fab" @click="openComposer">放飞纸飞机</button>
		</view>

		<XsaSheet :visible="composerVisible" title="放飞纸飞机" @close="closeComposer">
			<view class="composer">
				<textarea
					class="ta"
					:value="draft"
					@input="onDraft"
					placeholder="写下一句认真的话（120 字内）"
					maxlength="120"
				></textarea>
				<text class="count">{{ draft.length }}/120</text>
				<button class="send" :disabled="sending || draft.trim().length == 0" @click="send">放飞</button>
			</view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import { getPaperPlanes, sendPaperPlane, replyPaperPlane, getCommunityQuotas, createCommunityCreateKey, discardCommunityCreateKey } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	const planes = ref([])
	const loading = ref(false)
	const remain = ref(3)
	const total = ref(3)
	const composerVisible = ref(false)
	const draft = ref('')
	const sending = ref(false)
	const pendingSendKey = ref('')
	const pendingSendFingerprint = ref('')
	const pendingReplyKey = ref('')
	const pendingReplyFingerprint = ref('')

	onMounted(() => {
		load()
		loadQuota()
	})

	const load = async () => {
		loading.value = true
		try {
			const res = await getPaperPlanes()
			if (res.success) planes.value = res.data as any[]
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const loadQuota = async () => {
		try {
			const res = await getCommunityQuotas()
			if (res.success && res.data != null && res.data.paperPlaneDaily != null) {
				remain.value = res.data.paperPlaneDaily.remain
				total.value = res.data.paperPlaneDaily.total
			}
		} catch (e) {
			console.error(e)
		}
	}

	const openComposer = async () => {
		const ok = await guardRealName('paperPlane')
		if (!ok) return
		discardPendingSendKey()
		draft.value = ''
		composerVisible.value = true
	}

	const sendFingerprint = (text: string) => text + '|city|true'
	const replyFingerprint = (planeId: number, text: string) => planeId + '|' + text + '|true'
	const discardPendingSendKey = () => {
		if (pendingSendKey.value != '') discardCommunityCreateKey(pendingSendKey.value)
		pendingSendKey.value = ''
		pendingSendFingerprint.value = ''
	}
	const discardPendingReplyKey = () => {
		if (pendingReplyKey.value != '') discardCommunityCreateKey(pendingReplyKey.value)
		pendingReplyKey.value = ''
		pendingReplyFingerprint.value = ''
	}
	const shouldDiscardCreateKey = (res: any): boolean => {
		if (res == null) return false
		if (res.success == false) return res.code != null && res.code != -1
		return res.data != null && res.data.success == false
	}
	const closeComposer = () => {
		discardPendingSendKey()
		draft.value = ''
		composerVisible.value = false
	}

	const onDraft = (e: any) => {
		draft.value = e.detail.value
		if (pendingSendFingerprint.value != '' && pendingSendFingerprint.value != sendFingerprint(draft.value.trim())) {
			discardPendingSendKey()
		}
	}

	onUnload(() => {
		discardPendingSendKey()
		discardPendingReplyKey()
	})

const send = async () => {
			const text = draft.value.trim()
			if (text.length == 0 || sending.value) return
			if (remain.value <= 0) {
				uni.showToast({ title: '今日免费次数已用完，可用积分加次', icon: 'none' })
				return
			}
			const fingerprint = sendFingerprint(text)
			if (pendingSendKey.value == '' || pendingSendFingerprint.value != fingerprint) {
				discardPendingSendKey()
				pendingSendKey.value = createCommunityCreateKey('paper-plane')
				pendingSendFingerprint.value = fingerprint
			}
			sending.value = true
			try {
				const res = await sendPaperPlane({
					content: text,
					scope: 'city',
					anonymous: true,
					idempotencyKey: pendingSendKey.value
				})
				const data = res != null ? res.data : null
				const bizOk = res != null && res.success && data != null && data.success != false
				if (bizOk) {
					if (data.plane != null) {
						planes.value.unshift(data.plane)
					}
					if (data.quotas != null) {
						remain.value = data.quotas.remain
					} else {
						remain.value = Math.max(0, remain.value - 1)
					}
					closeComposer()
					uni.showToast({ title: '已放飞', icon: 'success' })
				} else {
					if (shouldDiscardCreateKey(res)) discardPendingSendKey()
					const msg = data != null && data.message != null ? data.message : '放飞失败'
					uni.showToast({ title: msg, icon: 'none' })
					if (data != null && data.remain != null) {
						remain.value = data.remain
					}
				}
			} catch (e) {
				uni.showToast({ title: '网络异常', icon: 'none' })
			} finally {
				sending.value = false
			}
		}

	const reply = async (p: any) => {
		if (p.replied) {
			uni.showToast({ title: '已回复过', icon: 'none' })
			return
		}
		const ok = await guardRealName('paperPlane')
		if (!ok) return
		uni.showModal({
			title: '回复纸飞机',
			editable: true,
			placeholderText: '写一句认真的回复',
			success: async (r) => {
				if (!r.confirm) {
					discardPendingReplyKey()
					return
				}
				const content = r.content != null ? ('' + r.content).trim() : '你好，看到你的纸飞机了。'
				if (content.length == 0) {
					discardPendingReplyKey()
					return
				}
				const fingerprint = replyFingerprint(p.id, content)
				if (pendingReplyKey.value == '' || pendingReplyFingerprint.value != fingerprint) {
					discardPendingReplyKey()
					pendingReplyKey.value = createCommunityCreateKey('paper-plane-reply')
					pendingReplyFingerprint.value = fingerprint
				}
				const res = await replyPaperPlane(p.id, content, pendingReplyKey.value)
					const replyOk = res != null && res.success && (res.data == null || res.data.success != false)
					if (replyOk) {
						discardPendingReplyKey()
						p.replied = true
						p.replyCount += 1
						uni.showToast({ title: '已回复', icon: 'success' })
					} else {
						if (shouldDiscardCreateKey(res)) discardPendingReplyKey()
						const msg =
							res.data != null && res.data.message != null
								? res.data.message
								: res.message != null
									? res.message
									: '回复失败，请重试'
						uni.showToast({ title: msg, icon: 'none' })
					}
				}
			})
		}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}
	.quota-bar {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		padding: 10px 16px;
		background: var(--soft);
		border-bottom: 1px solid var(--line);
	}
	.q-label,
	.q-value {
		font-size: 12px;
		font-weight: 700;
		color: var(--accent);
	}
	.list {
		flex: 1;
		height: 0;
		padding: 12px 14px;
	}
	.intro {
		margin-bottom: 12px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.intro-title {
		font-size: 22px;
		font-family: var(--serif);
		font-weight: 700;
	}
	.intro-desc {
		font-size: 12px;
		line-height: 1.55;
	}
	.plane {
		padding: 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		margin-bottom: 10px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.content {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink);
	}
	.meta {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
	}
	.meta text {
		font-size: 11px;
	}
	.reply {
		font-weight: 700;
		flex-shrink: 0;
	}
	.footer {
		padding: 12px 16px;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
		background: var(--surface);
		border-top: 1px solid var(--line);
	}
	.fab {
		height: 46px;
		background: var(--sage);
		color: var(--paper);
		border-radius: 999px;
		font-size: 15px;
		font-weight: 700;
		border: none;
	}
	.composer {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.ta {
		min-height: 100px;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		font-size: 14px;
	}
	.count {
		align-self: flex-end;
		font-size: 11px;
		color: var(--muted);
	}
	.send {
		height: 44px;
		background: var(--accent);
		color: var(--text-invert);
		border-radius: 999px;
		font-weight: 700;
		border: none;
	}
	.send[disabled] {
		opacity: 0.5;
	}
	.pad {
		height: 24px;
	}
</style>
