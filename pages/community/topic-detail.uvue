<template>
	<view class="page">
		<scroll-view class="scroll" scroll-y @scrolltolower="loadMore">
			<view class="hero" v-if="topic != null">
				<view class="hero-card">
					<image v-if="topic.cover != null" class="hero-cover" :src="topic.cover" mode="aspectFill"></image>
					<view class="hero-body">
						<text class="hero-tag" v-if="topic.tag != null">{{ topic.tag }}</text>
						<text class="title">{{ topic.title }}</text>
						<text class="desc">{{ topic.description }}</text>
						<text class="meta">{{ formatViews(topic.viewCount) }} 浏览 · {{ topic.participantCount }} 人参与</text>
					</view>
				</view>
			</view>

			<XsaEmpty v-if="!loading && topicError" text="话题暂时无法打开" description="请稍后重试" :show-action="true" action-text="重试" @action="load" />
			<view v-if="!topicError" class="sort-row">
				<view class="chip" :class="{ active: sort == 'hot' }" @click="changeSort('hot')"><text>热门</text></view>
				<view class="chip" :class="{ active: sort == 'latest' }" @click="changeSort('latest')"><text>最新</text></view>
			</view>

			<XsaEmpty v-if="!loading && !topicError && posts.length == 0" text="还没有帖子" description="成为第一个认真发言的人" :show-action="true" action-text="参与话题" @action="goPublish" />
			<XsaDynamicCard
				v-for="item in posts"
				:key="item.id"
				:dynamic="normalize(item)"
				@user-click="goUser"
				@like="onLike"
				@comment="goPost"
				@collect="onCollect"
				@follow="onFollow"
				@apply="onApply"
				@more="onMore"
				@open="goPost"
			/>
			<view v-if="posts.length > 0" class="load-more">
				<text class="text-muted" v-if="loadingMore">加载中...</text>
				<text class="text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
			<view class="pad"></view>
		</scroll-view>

		<view v-if="topic != null && !topicError" class="join-bar">
			<button class="join-btn" @click="goPublish">+ 参与话题</button>
		</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplyOk" />
		<XsaReportSheet
			:visible="reportVisible"
			target-type="post"
			:target-id="reportTargetId"
			:user-id="reportUserId"
			@close="reportVisible = false"
			@blocked="onBlocked"
		/>
	</view>
</template>

<script setup lang="uts">
	import XsaDynamicCard from '@/components/XsaDynamicCard.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import {
		getTopicDetail,
		likeDynamic,
		collectDynamic,
		followUserFromCommunity
	} from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	const topicId = ref(0)
	const topic = ref(null)
	const posts = ref([])
	const loading = ref(false)
	const loadingMore = ref(false)
	const topicError = ref(false)
	const sort = ref('hot')
	const page = ref(1)
	const pageSize = 20
	const hasMore = ref(true)
	const topicLoadSeq = ref(0)
	const applyVisible = ref(false)
	const applyUserId = ref(0)
	const reportVisible = ref(false)
	const reportTargetId = ref(0)
	const reportUserId = ref(0)

	const formatViews = (n: any) => {
		const v = n != null ? Number(n) : 0
		if (v >= 100000000) {
			const y = Math.round((v / 100000000) * 10) / 10
			return '' + y + '亿'
		}
		if (v >= 10000) {
			const w = Math.round((v / 10000) * 10) / 10
			return '' + w + '万'
		}
		return '' + v
	}

	onLoad((q: any) => {
		topicId.value = q != null && q.id != null ? parseInt('' + q.id) : 0
		load()
	})

const normalize = (item: any) => {
			return {
				id: item.id,
				user: item.user,
				content: item.content,
				photos: item.photos,
				location: item.location,
				time: item.timeText != null ? item.timeText : '',
				timeText: item.timeText,
				likeCount: item.likeCount,
				commentCount: item.commentCount,
				collectCount: item.collectCount,
				liked: item.liked,
				collected: item.collected,
				followed: item.followed,
				applyStatus: item.applyStatus,
				topicId: item.topicId,
				tags: item.tags,
				declaration: item.declaration,
				cityTag: item.cityTag === true,
				relationTags: item.relationTags != null ? item.relationTags : [],
				topicTitle: item.topicTitle != null ? item.topicTitle : '',
				videos: item.videos != null ? item.videos : [],
				mediaType: item.mediaType != null ? item.mediaType : ''
			}
		}

	const load = async () => {
		if (topicId.value <= 0) {
			topicError.value = true
			return
		}
		const requestedTopicId = topicId.value
		const requestedSort = sort.value
		const requestedPage = 1
		const seq = topicLoadSeq.value + 1
		topicLoadSeq.value = seq
		loading.value = true
		loadingMore.value = false
		topicError.value = false
		page.value = requestedPage
		hasMore.value = true
		try {
			const res = await getTopicDetail(requestedTopicId, requestedSort, requestedPage, pageSize)
			if (seq != topicLoadSeq.value || requestedTopicId != topicId.value || requestedSort != sort.value) return
			if (res.success && res.data != null && res.data.topic != null) {
				topic.value = res.data.topic
				posts.value = res.data.posts != null ? res.data.posts : []
				hasMore.value = res.data.hasMore === true
			} else {
				topic.value = null
				posts.value = []
				topicError.value = true
			}
		} catch (e) {
			if (seq != topicLoadSeq.value || requestedTopicId != topicId.value || requestedSort != sort.value) return
			console.error(e)
			topic.value = null
			posts.value = []
			topicError.value = true
		} finally {
			if (seq == topicLoadSeq.value) loading.value = false
		}
	}

	const loadMore = async () => {
		if (loading.value || loadingMore.value || !hasMore.value || topicId.value <= 0 || topicError.value) return
		const nextPage = page.value + 1
		const requestedTopicId = topicId.value
		const requestedSort = sort.value
		const requestedPage = nextPage
		const seq = topicLoadSeq.value + 1
		topicLoadSeq.value = seq
		loadingMore.value = true
		try {
			const res = await getTopicDetail(requestedTopicId, requestedSort, requestedPage, pageSize)
			if (seq != topicLoadSeq.value || requestedTopicId != topicId.value || requestedSort != sort.value || requestedPage != page.value + 1) return
			if (!res.success || res.data == null) {
				uni.showToast({ title: '加载更多失败，请重试', icon: 'none' })
				return
			}
			const next = res.data.posts != null ? (res.data.posts as any[]) : []
			const current = posts.value as any[]
			for (let i = 0; i < next.length; i++) {
				const item = next[i]
				if (current.findIndex((p: any) => p.id == item.id) < 0) current.push(item)
			}
			page.value = requestedPage
			hasMore.value = res.data.hasMore === true
		} catch (e) {
			if (seq != topicLoadSeq.value) return
			uni.showToast({ title: '加载更多失败，请重试', icon: 'none' })
		} finally {
			if (seq == topicLoadSeq.value) loadingMore.value = false
		}
	}

	const changeSort = async (s: string) => {
		if (sort.value === s) return
		sort.value = s
		page.value = 1
		hasMore.value = true
		await load()
	}

	const goPublish = async () => {
		if (topicId.value <= 0 || topic.value == null || topicError.value) return
		const ok = await guardRealName('topicJoin')
		if (!ok) return
		uni.navigateTo({ url: `/pages/community/publish?topicId=${topicId.value}` })
	}

	const goUser = (id: number) => {
		uni.navigateTo({ url: `/pages/user/detail?userId=${id}` })
	}

	const goPost = (id: number) => {
		uni.navigateTo({ url: `/pages/community/post-detail?id=${id}` })
	}

	const onLike = async (id: number) => {
		const ok = await guardRealName('like')
		if (!ok) return
		const res = await likeDynamic(id)
		if (res.success) {
			const p = posts.value.find((d: any) => d.id == id)
			if (p != null) {
				p.liked = res.data.liked
				p.likeCount = res.data.likeCount
			}
		} else {
			uni.showToast({ title: '点赞失败，请重试', icon: 'none' })
		}
	}

	const onCollect = async (id: number) => {
		const ok = await guardRealName('collect')
		if (!ok) return
		const res = await collectDynamic(id)
		if (res.success) {
			const p = posts.value.find((d: any) => d.id == id)
			if (p != null) {
				p.collected = res.data.collected
				if (res.data.collectCount != null) {
					p.collectCount = res.data.collectCount
				}
			}
		} else {
			uni.showToast({ title: '收藏失败，请重试', icon: 'none' })
		}
	}

	const onFollow = async (userId: number) => {
		const ok = await guardRealName('follow')
		if (!ok) return
		const res = await followUserFromCommunity(userId)
		if (res.success) {
			posts.value.forEach((p: any) => {
				if (p.user != null && p.user.id == userId) p.followed = true
			})
			uni.showToast({ title: '已关注', icon: 'none' })
		} else {
			uni.showToast({ title: '关注失败，请重试', icon: 'none' })
		}
	}

	const onApply = (userId: number, _dynamicId: number) => {
		applyUserId.value = userId
		applyVisible.value = true
	}

	const onApplyOk = () => {}

	const onMore = (dynamicId: number, userId: number) => {
		reportTargetId.value = dynamicId
		reportUserId.value = userId
		reportVisible.value = true
	}

	const onBlocked = (userId: number) => {
		posts.value = posts.value.filter((p: any) => p.user == null || p.user.id != userId)
	}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}
	.scroll {
		flex: 1;
		height: 0;
	}
	.hero {
		margin: 12px 14px 0;
		padding: 0;
		box-sizing: border-box;
	}
	.hero-card {
		display: flex;
		flex-direction: row;
		gap: 12px;
		padding: 14px;
		background: var(--accent-bg);
		border-radius: 14px;
	}
	.hero-cover {
		width: 84px;
		height: 84px;
		border-radius: 12px;
		flex-shrink: 0;
		background: var(--warm);
	}
	.hero-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		justify-content: center;
	}
	.hero-tag {
		font-size: 11px;
		font-weight: 700;
		color: var(--sage);
	}
	.title {
		font-size: 16px;
		font-weight: 800;
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.desc {
		font-size: 12px;
		line-height: 1.4;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		lines: 2;
	}
	.meta {
		font-size: 11px;
		color: var(--muted);
	}
	.sort-row {
		display: flex;
		flex-direction: row;
		gap: 8px;
		padding: 12px 14px 6px;
	}
	.chip {
		height: 30px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--surface);
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.chip text {
		font-size: 12px;
		color: var(--muted);
	}
	.chip.active {
		background: var(--soft);
		border-color: var(--accent);
	}
	.chip.active text {
		color: var(--accent);
		font-weight: 700;
	}
	.pad {
		height: calc(72px + env(safe-area-inset-bottom));
	}
	.join-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
		background: var(--surface-overlay);
		border-top: 1px solid var(--line);
		z-index: 30;
	}
	.join-btn {
		height: 44px;
		background: var(--sage);
		color: var(--paper);
		border-radius: 10px;
		font-size: 14px;
		font-weight: 800;
		border: none;
	}
</style>
