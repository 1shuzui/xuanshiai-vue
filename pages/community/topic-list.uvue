<template>
	<view class="page">
		<scroll-view class="list" scroll-y @scrolltolower="loadMore">
			<view class="section">
				<text class="section-title">近期热门</text>
				<view class="hot-card" v-for="(t, idx) in hotList" :key="'h-' + t.id" @click="openTopic(t.id)">
					<text class="rank">{{ idx + 1 }}</text>
					<view class="body">
						<text class="title">{{ t.title }}</text>
						<text class="desc text-muted">{{ t.description }}</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section-title">更多话题</text>
				<XsaEmpty v-if="!loading && moreList.length == 0" text="暂无更多话题" description="热门话题已经看完了" />
				<view class="topic-card" v-for="t in moreList" :key="'m-' + t.id" @click="openTopic(t.id)">
					<image class="cover" :src="t.cover" mode="aspectFill"></image>
					<view class="body">
						<text class="tag">{{ t.tag }}</text>
						<text class="title">{{ t.title }}</text>
						<text class="desc text-muted">{{ t.description }}</text>
						<text class="meta text-muted">{{ t.participantCount }} 人 · {{ t.postCount }} 帖</text>
					</view>
				</view>
				<view class="load-more" v-if="moreList.length > 0 || loading">
					<text class="load-text text-muted" v-if="loading">加载中...</text>
					<text class="load-text text-muted" v-else-if="!hasMore">没有更多话题了</text>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import { getTopicList } from '@/api'

	const loading = ref(false)
	const hotList = ref([])
	const moreList = ref([])
	const page = ref(1)
	const pageSize = 10
	const hasMore = ref(true)
	const excludeIds = ref([])

	onMounted(() => {
		init()
	})

	const init = async () => {
		loading.value = true
		try {
			const hotRes = await getTopicList({ sort: 'hot', page: 1, pageSize: 10 })
			if (hotRes.success && hotRes.data != null) {
				const list = hotRes.data.list != null ? (hotRes.data.list as any[]) : []
				hotList.value = list
				const ids: number[] = []
				for (let i = 0; i < list.length; i++) {
					ids.push(list[i].id as number)
				}
				excludeIds.value = ids
			}
			page.value = 1
			hasMore.value = true
			moreList.value = []
			await loadMoreInternal(true)
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const loadMoreInternal = async (reset: boolean = false) => {
		if (!hasMore.value && !reset) return
		const res = await getTopicList({
			sort: 'latest',
			page: page.value,
			pageSize,
			excludeIds: excludeIds.value
		})
		if (res.success && res.data != null) {
			const list = res.data.list != null ? (res.data.list as any[]) : []
			if (reset) {
				moreList.value = list
			} else {
				moreList.value = (moreList.value as any[]).concat(list)
			}
			hasMore.value = res.data.hasMore == true
			if (list.length > 0) {
				page.value = page.value + 1
			}
		}
	}

	const loadMore = async () => {
		if (loading.value || !hasMore.value) return
		loading.value = true
		try {
			await loadMoreInternal(false)
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const openTopic = (id: number) => {
		uni.navigateTo({ url: `/pages/community/topic-detail?id=${id}` })
	}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
	}
	.list {
		height: 100%;
		padding: 12px 14px;
		box-sizing: border-box;
	}
	.section {
		margin-bottom: 18px;
	}
	.section-title {
		display: block;
		font-size: 18px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
		margin-bottom: 10px;
	}
	.hot-card {
		display: flex;
		flex-direction: row;
		gap: 10px;
		padding: 12px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		margin-bottom: 8px;
		align-items: flex-start;
	}
	.rank {
		width: 22px;
		height: 22px;
		border-radius: 6px;
		background: var(--soft);
		color: var(--accent2);
		font-size: 12px;
		font-weight: 800;
		text-align: center;
		line-height: 22px;
		flex-shrink: 0;
	}
	.topic-card {
		display: flex;
		flex-direction: row;
		gap: 12px;
		padding: 12px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		margin-bottom: 10px;
	}
	.cover {
		width: 72px;
		height: 72px;
		border-radius: 10px;
		flex-shrink: 0;
	}
	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}
	.tag {
		font-size: 11px;
		font-weight: 800;
		color: var(--accent);
	}
	.title {
		font-size: 15px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}
	.desc {
		font-size: 12px;
		line-height: 1.45;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.meta {
		font-size: 11px;
	}
	.load-more {
		text-align: center;
		padding: 12px 0 8px;
	}
	.load-text {
		font-size: 12px;
	}
	.pad {
		height: 24px;
	}
</style>
