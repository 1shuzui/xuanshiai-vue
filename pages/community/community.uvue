<template>
	<view class="community-page">
		<!-- 高保真子 Tab：喜欢 / 同城 / 发现 -->
		<view class="subtabs">
			<view class="subtab" :class="{ active: currentTab === 1 }" @click="switchTab(1)">
				<text>喜欢</text>
			</view>
			<view class="subtab" :class="{ active: currentTab === 2 }" @click="switchTab(2)">
				<text>同城</text>
			</view>
			<view class="subtab" :class="{ active: currentTab === 0 }" @click="switchTab(0)">
				<text>发现</text>
			</view>
		</view>

		<scroll-view class="dynamic-list" scroll-y @scrolltolower="handleLoadMore">
			<!-- 发现：活动 Banner + 话题 -->
			<view v-if="currentTab === 0" class="discover-head">
				<view class="feature" v-if="activity != null" @click="openActivity">
					<text class="feature-kicker">{{ activity.kicker != null ? activity.kicker : 'OFFLINE' }}</text>
					<text class="feature-title">{{ activity.title }}</text>
					<text class="feature-desc">{{ activity.description }}</text>
					<view class="feature-btn">
						<text>查看活动</text>
					</view>
				</view>

				<view class="section-head">
					<text class="section-title">正在发生的话题</text>
					<text class="section-more text-accent" @click="openTopics">全部话题</text>
				</view>
				<view class="topic-row">
					<view class="topic" v-for="t in topics" :key="t.id" @click="openTopic(t)">
						<text class="topic-tag">{{ t.tag != null ? t.tag : t.title }}</text>
						<text class="topic-title">{{ t.title }}</text>
						<text class="topic-meta text-muted">{{ t.participantCount }} 人正在讨论</text>
					</view>
				</view>
			</view>

			<!-- 同城提示 -->
			<view v-if="currentTab === 2" class="city-bar">
				<text class="city-name">南京</text>
				<text class="city-switch text-accent">切换城市</text>
			</view>

			<XsaEmpty
				v-if="dynamicList.length === 0 && !loading"
				text="暂无动态"
				description="快来发布第一条动态吧"
				:show-action="true"
				action-text="发布动态"
				@action="handlePublish"
			/>

			<view v-else class="feed">
				<XsaDynamicCard
					v-for="item in dynamicList"
					:key="item.id"
					:dynamic="normalizeDynamic(item)"
					@user-click="handleUserClick"
					@like="handleLike"
					@comment="handleComment"
					@share="handleShare"
					@more="handleMore"
				/>
			</view>

			<view class="load-more" v-if="dynamicList.length > 0">
				<text class="load-text text-muted" v-if="loading">加载中...</text>
				<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
		</scroll-view>

		<view class="publish-fab" @click="handlePublish">
			<text class="fab-icon">+</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import XsaDynamicCard from '@/components/XsaDynamicCard.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import {
		getDynamicList,
		getTopics,
		getActivities,
		likeDynamic
	} from '@/api'

	// 0 发现 / 1 喜欢 / 2 同城
	const currentTab = ref(0)
	const loading = ref(false)
	const hasMore = ref(true)
	const dynamicList = ref([])
	const topics = ref([])
	const activity = ref(null)

	onMounted(() => {
		loadDynamics()
		loadTopics()
		loadActivity()
	})

	const formatTime = (t: any) => {
		if (t == null) return ''
		if (typeof t === 'string') return t
		const diff = Date.now() - (t as number)
		if (diff < 60 * 1000) return '刚刚'
		if (diff < 60 * 60 * 1000) return Math.floor(diff / 60000) + ' 分钟前'
		if (diff < 24 * 60 * 60 * 1000) return Math.floor(diff / 3600000) + ' 小时前'
		return '昨天'
	}

	const normalizeDynamic = (item: any) => {
		return {
			id: item.id,
			user: item.user,
			content: item.content,
			photos: item.photos,
			location: item.location,
			time: item.timeText != null ? item.timeText : formatTime(item.time),
			likeCount: item.likeCount,
			commentCount: item.commentCount,
			liked: item.liked
		}
	}

	const loadDynamics = async () => {
		try {
			loading.value = true
			const res = await getDynamicList(currentTab.value, 1)
			if (res.success) {
				dynamicList.value = res.data
				hasMore.value = true
			}
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const loadTopics = async () => {
		try {
			const res = await getTopics()
			if (res.success) {
				topics.value = (res.data as any[]).slice(0, 2)
			}
		} catch (e) {
			console.error(e)
		}
	}

	const loadActivity = async () => {
		try {
			const res = await getActivities()
			if (res.success && (res.data as any[]).length > 0) {
				activity.value = (res.data as any[])[0]
			}
		} catch (e) {
			console.error(e)
		}
	}

	const switchTab = async (index: number) => {
		currentTab.value = index
		await loadDynamics()
	}

	const handleUserClick = (userId: number) => {
		uni.navigateTo({ url: `/pages/user/detail?userId=${userId}` })
	}

	const handleLike = async (dynamicId: number) => {
		try {
			const res = await likeDynamic(dynamicId)
			if (res.success) {
				const dynamic = dynamicList.value.find((d: any) => d.id == dynamicId)
				if (dynamic != null) {
					dynamic.liked = !dynamic.liked
					dynamic.likeCount += dynamic.liked ? 1 : -1
				}
			}
		} catch (e) {
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}

	const handleComment = (dynamicId: number) => {
		uni.showToast({ title: '评论 · 原型演示', icon: 'none' })
	}

	const handleShare = (dynamicId: number) => {
		uni.showToast({ title: '分享 · 原型演示', icon: 'none' })
	}

	const handleMore = (dynamicId: number) => {
		uni.showActionSheet({
			itemList: ['举报', '不感兴趣'],
			success: () => {
				uni.showToast({ title: '已记录', icon: 'none' })
			}
		})
	}

	const handlePublish = () => {
		uni.navigateTo({ url: '/pages/community/publish' })
	}

	const openActivity = () => {
		if (activity.value == null) return
		uni.showModal({
			title: activity.value.title,
			content: activity.value.description + '\n费用 ' + activity.value.price + ' 元 · 完成实名后可报名',
			confirmText: '我要报名',
			success: (res) => {
				if (res.confirm) {
					uni.showToast({ title: '报名信息已提交', icon: 'success' })
				}
			}
		})
	}

	const openTopics = () => {
		uni.showToast({ title: '全部话题 · 原型入口', icon: 'none' })
	}

	const openTopic = (t: any) => {
		uni.showToast({ title: t.title, icon: 'none' })
	}

	const handleLoadMore = async () => {
		if (loading.value || !hasMore.value) return
		loading.value = true
		try {
			const page = Math.floor(dynamicList.value.length / 10) + 1
			const res = await getDynamicList(currentTab.value, page)
			if (res.success && (res.data as any[]).length > 0) {
				dynamicList.value = dynamicList.value.concat(res.data)
			} else {
				hasMore.value = false
			}
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}
</script>

<style scoped>
	.community-page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}

	.subtabs {
		height: 48px;
		display: flex;
		align-items: flex-end;
		gap: 22px;
		padding: 0 18px;
		background: rgba(250, 252, 252, 0.96);
		border-bottom: 1px solid var(--line);
	}

	.subtab {
		height: 48px;
		display: flex;
		align-items: center;
		color: var(--muted);
		font-size: 13px;
		position: relative;
	}

	.subtab.active {
		color: var(--ink);
		font-weight: 800;
	}

	.subtab.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 3px;
		background: var(--accent);
		border-radius: 3px 3px 0 0;
	}

	.dynamic-list {
		flex: 1;
		height: 0;
	}

	.discover-head {
		padding: 14px 14px 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.feature {
		min-height: 148px;
		background: var(--navy);
		border-radius: 12px 28px 12px 12px;
		padding: 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.feature-kicker {
		color: var(--soft);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.feature-title {
		font-size: 22px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--paper);
	}

	.feature-desc {
		font-size: 12px;
		line-height: 1.55;
		color: rgba(231, 236, 236, 0.78);
		max-width: 250px;
	}

	.feature-btn {
		margin-top: 8px;
		align-self: flex-start;
		height: 38px;
		padding: 0 13px;
		background: var(--soft);
		border-radius: 7px;
		display: flex;
		align-items: center;
	}

	.feature-btn text {
		font-size: 11px;
		font-weight: 800;
		color: var(--brown);
	}

	.section-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 4px;
	}

	.section-title {
		font-size: 18px;
		font-family: var(--serif);
		font-weight: 700;
	}

	.section-more {
		font-size: 11px;
		font-weight: 700;
	}

	.topic-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin-bottom: 8px;
	}

	.topic {
		min-height: 88px;
		border: 1px solid var(--line);
		background: var(--surface);
		border-radius: 10px;
		padding: 12px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.topic-tag {
		color: var(--accent);
		font-size: 11px;
		font-weight: 800;
	}

	.topic-title {
		font-size: 15px;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.topic-meta {
		font-size: 10px;
	}

	.city-bar {
		margin: 12px 14px 0;
		height: 46px;
		border: 1px solid var(--line);
		background: var(--surface);
		border-radius: 10px;
		padding: 0 12px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.city-name {
		font-size: 13px;
		font-weight: 700;
	}

	.city-switch {
		font-size: 12px;
		font-weight: 700;
	}

	.feed {
		padding-bottom: 24px;
	}

	.load-more {
		text-align: center;
		padding: 16px 0 32px;
	}

	.load-text {
		font-size: 13px;
	}

	.publish-fab {
		position: fixed;
		right: 16px;
		bottom: 84px;
		width: 48px;
		height: 48px;
		background: var(--sage);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 8px 20px rgba(17, 23, 24, 0.16);
	}

	.fab-icon {
		font-size: 28px;
		color: var(--paper);
		font-weight: 300;
		line-height: 1;
	}
</style>
