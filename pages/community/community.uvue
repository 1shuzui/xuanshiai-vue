<template>
	<view class="community-page">
		<!-- 顶部 Tab 切换 -->
		<view class="top-tabs">
			<view
				class="tab-item"
				:class="{ active: currentTab === 0 }"
				@click="switchTab(0)"
			>
				<text class="tab-text">推荐</text>
			</view>
			<view
				class="tab-item"
				:class="{ active: currentTab === 1 }"
				@click="switchTab(1)"
			>
				<text class="tab-text">关注</text>
			</view>
			<view
				class="tab-item"
				:class="{ active: currentTab === 2 }"
				@click="switchTab(2)"
			>
				<text class="tab-text">同城</text>
			</view>
		</view>

		<!-- 动态列表 -->
		<scroll-view class="dynamic-list" scroll-y @scrolltolower="handleLoadMore">
			<!-- 空状态 -->
			<XsaEmpty
				v-if="dynamicList.length === 0 && !loading"
				text="暂无动态"
				description="快来发布第一条动态吧"
				:show-action="true"
				action-text="发布动态"
				@action="handlePublish"
			/>

			<!-- 动态列表 -->
			<view v-else>
				<XsaDynamicCard
					v-for="item in dynamicList"
					:key="item.id"
					:dynamic="item"
					@user-click="handleUserClick"
					@like="handleLike"
					@comment="handleComment"
					@share="handleShare"
					@more="handleMore"
				/>
			</view>

			<!-- 加载更多 -->
			<view class="load-more" v-if="dynamicList.length > 0">
				<text class="load-text text-muted" v-if="loading">加载中...</text>
				<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
		</scroll-view>

		<!-- 发布按钮 -->
		<view class="publish-fab" @click="handlePublish">
			<text class="fab-icon">✏️</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import XsaDynamicCard from '@/components/XsaDynamicCard.uvue';
	import XsaEmpty from '@/components/XsaEmpty.uvue';

	// 导入 API
	import { getDynamicList, likeDynamic } from '@/api';

	const currentTab = ref(0);
	const loading = ref(false);
	const hasMore = ref(true);

	// 动态列表（改为空数组）
	const dynamicList = ref([]);

	// 页面加载时获取数据
	onMounted(() => {
		loadDynamics();
	});

	// 加载动态列表
	const loadDynamics = async () => {
		try {
			loading.value = true;
			const res = await getDynamicList(currentTab.value, 1);
			if (res.success) {
				dynamicList.value = res.data;
			}
		} catch (error) {
			console.error('获取动态列表失败', error);
		} finally {
			loading.value = false;
		}
	};

	// 切换 Tab
	const switchTab = async (index: number) => {
		currentTab.value = index;
		await loadDynamics();
	};

	// 点击用户
	const handleUserClick = (userId: number) => {
		uni.navigateTo({
			url: `/pages/user/detail?userId=${userId}`
		});
	};

	// 点赞
	const handleLike = async (dynamicId: number) => {
		try {
			const res = await likeDynamic(dynamicId);
			if (res.success) {
				// 更新本地状态
				const dynamic = dynamicList.value.find(d => d.id === dynamicId);
				if (dynamic) {
					dynamic.liked = !dynamic.liked;
					dynamic.likeCount += dynamic.liked ? 1 : -1;
					uni.showToast({
						title: dynamic.liked ? '点赞成功' : '取消点赞',
						icon: 'none'
					});
				}
			}
		} catch (error) {
			console.error('点赞失败', error);
			uni.showToast({
				title: '操作失败',
				icon: 'none'
			});
		}
	};

	// 评论
	const handleComment = (dynamicId: number) => {
		uni.showToast({
			title: '评论功能开发中',
			icon: 'none'
		});
		// TODO: 跳转到评论页
	};

	// 分享
	const handleShare = (dynamicId: number) => {
		uni.showActionSheet({
			itemList: ['分享到微信', '分享到朋友圈', '复制链接'],
			success: (res) => {
				// TODO: 处理分享
				uni.showToast({
					title: '分享成功',
					icon: 'success'
				});
			}
		});
	};

	// 更多操作
	const handleMore = (dynamicId: number) => {
		uni.showActionSheet({
			itemList: ['举报', '不感兴趣', '取消'],
			success: (res) => {
				// TODO: 处理更多操作
			}
		});
	};

	// 发布动态
	const handlePublish = () => {
		uni.navigateTo({
			url: '/pages/community/publish'
		});
	};

	// 加载更多
	const handleLoadMore = async () => {
		if (loading.value || !hasMore.value) return;

		loading.value = true;
		try {
			const page = Math.floor(dynamicList.value.length / 10) + 1;
			const res = await getDynamicList(currentTab.value, page);
			if (res.success && res.data.length > 0) {
				dynamicList.value.push(...res.data);
			} else {
				hasMore.value = false;
			}
		} catch (error) {
			console.error('加载更多失败', error);
		} finally {
			loading.value = false;
		}
	};
</script>

<style scoped>
.community-page {
	height: 100vh;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* 顶部 Tab */
.top-tabs {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
	height: 52px;
	padding: 0 16px;
	background: var(--surface);
	border-bottom: 1px solid var(--line);
}

.tab-item {
	flex: 1;
	max-width: 100px;
	height: 36px;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 999px;
	transition: all 0.22s;
}

.tab-item.active {
	background: var(--soft);
}

.tab-text {
	font-size: 14px;
	font-weight: 500;
	color: var(--muted);
	transition: all 0.22s;
}

.tab-item.active .tab-text {
	color: var(--accent2);
	font-weight: 600;
}

/* 动态列表 */
.dynamic-list {
	flex: 1;
	overflow-y: auto;
}

.load-more {
	text-align: center;
	padding: 16px 0;
}

.load-text {
	font-size: 13px;
}

/* 发布按钮 */
.publish-fab {
	position: fixed;
	right: 16px;
	bottom: 84px;
	width: 56px;
	height: 56px;
	background: var(--accent);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8px 24px oklch(0.35 0.04 45 / 0.18);
	transition: all 0.22s;
}

.publish-fab:active {
	transform: scale(0.92);
}

.fab-icon {
	font-size: 24px;
}
</style>
