				<text class="logout-text">退出登录</text>
			</view>
		</view>

		<text class="footer-tip">宣誓爱 v1.0.0 — 为每一份真心寻找归宿</text>
	</view>
</template>

<script setup lang="uts">
import { logout } from '@/api'

// 设置项状态
let showOnlineStatus = ref(true)
let receiveMessage = ref(true)
let receiveMatch = ref(true)
let receiveActivity = ref(false)

// 隐私设置选项
let profilePrivacy = ref('all')   // all | friends | only_me
let messagePrivacy = ref('all')   // all | friends | certified

const profilePrivacyLabel = computed(() => {
	const map: Record<string, string> = { all: '所有人', friends: '仅好友', only_me: '仅自己' }
	return map[profilePrivacy.value] ?? '所有人'
})
const messagePrivacyLabel = computed(() => {
	const map: Record<string, string> = { all: '所有人', friends: '仅好友', certified: '认证用户' }
	return map[messagePrivacy.value] ?? '所有人'
})

const appVersion = computed(() => 'v1.0.0')

// 在线状态开关
const onOnlineStatusChange = (e: SwitchChangeEvent) => {
	showOnlineStatus.value = e.detail.value
	// TODO: 调用接口保存设置
	uni.showToast({
		title: e.detail.value ? '已显示在线' : '已隐藏在线',
		icon: 'none'
	})
}

// 消息通知开关
const onMessageNotifyChange = (e: SwitchChangeEvent) => {
	receiveMessage.value = e.detail.value
	// TODO: 调用接口保存设置
}

// 匹配通知开关
const onMatchNotifyChange = (e: SwitchChangeEvent) => {
	receiveMatch.value = e.detail.value
	// TODO: 调用接口保存设置
}

// 活动通知开关
const onActivityNotifyChange = (e: SwitchChangeEvent) => {
	receiveActivity.value = e.detail.value
	// TODO: 调用接口保存设置
}

// 导航到指定页面
const navigateTo = (url: string) => {
	uni.navigateTo({ url })
}

// 隐私设置选择
const handlePrivacy = (type: 'profile' | 'message') => {
	const field = type === 'profile' ? '资料可见性' : '消息权限'
	// TODO: 调用接口弹出选择器（如 Picker / ActionSheet）
	uni.showToast({ title: field + '设置开发中', icon: 'none' })
}

// 修改手机号
const handleChangePhone = () => {
	// TODO: 实现手机号修改流程
	uni.showToast({ title: '功能开发中', icon: 'none' })
}

// 清除缓存
const clearCache = () => {
	uni.showModal({
		title: '提示',
		content: '确定要清除缓存吗？',
		success: (res) => {
			if (res.confirm) {
				uni.showToast({ title: '清除成功', icon: 'success' })
			}
		}
	})
}

// 检查更新
const checkUpdate = () => {
	uni.showLoading({ title: '检查中...' })
	setTimeout(() => {
		uni.hideLoading()
		uni.showToast({ title: '已是最新版本', icon: 'none' })
	}, 1500)
}

// 关于我们
const showAbout = () => {
	uni.showModal({
		title: '关于宣誓爱',
		content: '宣誓爱 v1.0.0\n真诚婚恋交友平台\n为每一份真心寻找归宿',
		showCancel: false
	})
}

// 帮助中心
const showHelp = () => {
	// TODO: 跳转帮助中心页面
	uni.showToast({ title: '功能开发中', icon: 'none' })
}

// 意见反馈
const showFeedback = () => {
	// TODO: 跳转意见反馈页面
	uni.showToast({ title: '功能开发中', icon: 'none' })
}

// 退出登录
const handleLogout = () => {
	uni.showModal({
		title: '提示',
		content: '确定要退出登录吗？',
		success: async (res) => {
			if (res.confirm) {
				await logout()
				uni.reLaunch({ url: '/pages/auth/login' })
			}
		}
	})
}
</script>

