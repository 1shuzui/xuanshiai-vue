				<view class="icon-wrap">
					<text class="icon-text">🔄</text>
				</view>
				<view class="text-wrap">
					<text class="label">检查更新</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ appVersion }}</text>
					<text class="arrow">‹</text>
