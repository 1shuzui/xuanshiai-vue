<template>
	<view class="settings-page">
		<view class="settings-list">
			<!-- 账号信息 -->
			<view class="section">
				<view class="section-title">账号信息</view>
				<view class="item" @click="navigateTo('/pages/user/edit')">
					<text class="label">编辑资料</text>
					<text class="arrow">›</text>
				</view>
				<view class="item" @click="navigateTo('/pages/profile/certification')">
					<text class="label">身份认证</text>
					<view class="value-wrapper">
						<text class="badge certified">已认证</text>
						<text class="arrow">›</text>
					</view>
				</view>
				<view class="item" @click="handleChangePhone">
					<text class="label">手机号</text>
					<view class="value-wrapper">
						<text class="value text-muted">138****8888</text>
						<text class="arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 隐私设置 -->
			<view class="section">
				<view class="section-title">隐私设置</view>
				<view class="item">
					<text class="label">谁可以查看我的资料</text>
					<view class="value-wrapper">
						<text class="value text-muted">所有人</text>
						<text class="arrow">›</text>
					</view>
				</view>
				<view class="item">
					<text class="label">谁可以给我发消息</text>
					<view class="value-wrapper">
						<text class="value text-muted">所有人</text>
						<text class="arrow">›</text>
					</view>
				</view>
				<view class="item">
					<text class="label">显示在线状态</text>
					<switch :checked="showOnlineStatus" @change="onOnlineStatusChange" />
				</view>
			</view>

			<!-- 通知设置 -->
			<view class="section">
				<view class="section-title">通知设置</view>
				<view class="item">
					<text class="label">接收新消息通知</text>
					<switch :checked="receiveMessage" @change="onMessageNotifyChange" />
				</view>
				<view class="item">
					<text class="label">接收匹配通知</text>
					<switch :checked="receiveMatch" @change="onMatchNotifyChange" />
				</view>
				<view class="item">
					<text class="label">接收活动通知</text>
					<switch :checked="receiveActivity" @change="onActivityNotifyChange" />
				</view>
			</view>

			<!-- 通用设置 -->
			<view class="section">
				<view class="section-title">通用</view>
				<view class="item" @click="clearCache">
					<text class="label">清除缓存</text>
					<view class="value-wrapper">
						<text class="value text-muted">128.5MB</text>
						<text class="arrow">›</text>
					</view>
				</view>
				<view class="item" @click="checkUpdate">
					<text class="label">检查更新</text>
					<view class="value-wrapper">
						<text class="value text-muted">v1.0.0</text>
						<text class="arrow">›</text>
					</view>
				</view>
				<view class="item" @click="showAbout">
					<text class="label">关于我们</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 帮助与反馈 -->
			<view class="section">
				<view class="item" @click="showHelp">
					<text class="label">帮助中心</text>
					<text class="arrow">›</text>
				</view>
				<view class="item" @click="showFeedback">
					<text class="label">意见反馈</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 退出登录 -->
			<view class="section">
				<button class="logout-btn" @click="handleLogout">退出登录</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 设置项状态
	let showOnlineStatus = ref(true)
	let receiveMessage = ref(true)
	let receiveMatch = ref(true)
	let receiveActivity = ref(false)

	// 在线状态开关
	const onOnlineStatusChange = (e: SwitchChangeEvent) => {
		showOnlineStatus.value = e.detail.value
		// TODO: 调用接口保存设置
		uni.showToast({
			title: e.detail.value ? '已显示在线' : '已隐藏在线',
			icon: 'none'
		})
	}

	// 消息通知开关
	const onMessageNotifyChange = (e: SwitchChangeEvent) => {
		receiveMessage.value = e.detail.value
		// TODO: 调用接口保存设置
	}

	// 匹配通知开关
	const onMatchNotifyChange = (e: SwitchChangeEvent) => {
		receiveMatch.value = e.detail.value
		// TODO: 调用接口保存设置
	}

	// 活动通知开关
	const onActivityNotifyChange = (e: SwitchChangeEvent) => {
		receiveActivity.value = e.detail.value
		// TODO: 调用接口保存设置
	}

	// 导航到指定页面
	const navigateTo = (url: string) => {
		uni.navigateTo({ url })
	}

	// 修改手机号
	const handleChangePhone = () => {
		uni.showToast({
			title: '功能开发中',
			icon: 'none'
		})
	}

	// 清除缓存
	const clearCache = () => {
		uni.showModal({
			title: '提示',
			content: '确定要清除缓存吗？',
			success: (res) => {
				if (res.confirm) {
					uni.showToast({
						title: '清除成功',
						icon: 'success'
					})
				}
			}
		})
	}

	// 检查更新
	const checkUpdate = () => {
		uni.showLoading({
			title: '检查中...'
		})
		setTimeout(() => {
			uni.hideLoading()
			uni.showToast({
				title: '已是最新版本',
				icon: 'none'
			})
		}, 1500)
	}

	// 关于我们
	const showAbout = () => {
		uni.showModal({
			title: '关于宣誓爱',
			content: '宣誓爱 v1.0.0\n真诚婚恋交友平台\n为每一份真心寻找归宿',
			showCancel: false
		})
	}

	// 帮助中心
	const showHelp = () => {
		uni.showToast({
			title: '功能开发中',
			icon: 'none'
		})
	}

	// 意见反馈
	const showFeedback = () => {
		uni.showToast({
			title: '功能开发中',
			icon: 'none'
		})
	}

	// 退出登录
	const handleLogout = () => {
		uni.showModal({
			title: '提示',
			content: '确定要退出登录吗？',
			success: (res) => {
				if (res.confirm) {
					// TODO: 清除登录状态
					uni.reLaunch({
						url: '/pages/auth/login'
					})
				}
			}
		})
	}
</script>

<style scoped>
.settings-page {
	min-height: 100vh;
	background: var(--canvas);
}

.settings-list {
	padding: 12px 0;
}

.section {
	margin-bottom: 12px;
	background: var(--surface);
}

.section-title {
	padding: 16px 24px 8px;
	font-size: 13px;
	color: var(--muted);
}

.item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	height: 52px;
	padding: 0 24px;
	border-bottom: 1px solid var(--line);
}

.section .item:last-child {
	border-bottom: none;
}

.label {
	font-size: 15px;
	color: var(--ink);
}

.value-wrapper {
	display: flex;
	align-items: center;
	gap: 8px;
}

.value {
	font-size: 14px;
}

.badge {
	padding: 2px 8px;
	border-radius: 999px;
	font-size: 12px;
}

.badge.certified {
	background: var(--sage-soft);
	color: var(--sage);
}

.arrow {
	font-size: 20px;
	color: var(--muted);
}

.logout-btn {
	width: calc(100% - 48px);
	height: 48px;
	margin: 24px;
	background: var(--surface);
	color: #FF4444;
	border: 1px solid var(--line);
	border-radius: 8px;
	font-size: 16px;
}
</style>
