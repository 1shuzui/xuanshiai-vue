	font-size: 32rpx;
	font-weight: 700;
	color: #1A1A1A;
}

.card-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}

.progress-wrap {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.progress-text {
	font-size: 26rpx;
	font-weight: 500;
	color: #7EC8A0;
}

.dots {
	display: flex;
	flex-direction: row;
	gap: 8rpx;
	align-items: center;
}

.dot {
	width: 12rpx;
	height: 12rpx;
	border-radius: 6rpx;
}

.dot-on {
	background-color: #7EC8A0;
}

.dot-off {
	background-color: #E0DFD8;
}

/* ---- 认证行（与 edit.uvue 完全一致） ---- */
.cert-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 24rpx;
	padding: 8rpx 0;
}

.cert-icon-wrap {
	width: 80rpx;
	height: 80rpx;
	border-radius: 40rpx;
	background-color: #F5F9F2;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.cert-icon-wrap.cert-done {
	background-color: #E8F5EE;
}

.cert-icon-text {
	font-size: 36rpx;
}

.cert-text-wrap {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4rpx;
}

.cert-label {
	font-size: 28rpx;
	font-weight: 600;
	color: #1A1A1A;
}

.cert-desc {
	font-size: 22rpx;
	color: #A0B0A2;
}

.cert-check {
	width: 40rpx;
	height: 40rpx;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
}

.check-icon {
	font-size: 36rpx;
