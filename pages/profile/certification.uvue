<template>
	<view class="page">
		<!-- 四重认证 -->
		<view class="section-card">
			<view class="card-header">
				<text class="section-title">四重认证</text>
				<view class="progress-wrap">
					<text class="progress-text">已完成 {{ completed }}/4</text>
					<view class="dots">
						<view v-for="i in 4" :key="i" class="dot" :class="i <= completed ? 'dot-on' : 'dot-off'" />
					</view>
				</view>
			</view>
			<view class="cert-item" v-for="c in mainList" :key="c.key">
				<view class="cert-icon-wrap" :class="{ 'cert-done': c.done }">
					<text class="cert-icon-text">{{ c.icon }}</text>
				</view>
				<view class="cert-text-wrap">
					<text class="cert-label">{{ c.label }}</text>
					<text class="cert-desc">{{ c.desc }}</text>
				</view>
				<view v-if="c.done" class="cert-check">
					<text class="check-icon">✓</text>
				</view>
				<view v-else class="cert-pending" @tap="onCert(c.key)">
					<text class="pending-text">去认证</text>
				</view>
			</view>
		</view>

		<!-- 更多认证 -->
		<view class="section-card">
			<text class="section-title">更多认证</text>
			<view class="cert-item" v-for="c in moreList" :key="c.key">
				<view class="cert-icon-wrap">
					<text class="cert-icon-text">{{ c.icon }}</text>
				</view>
				<view class="cert-text-wrap">
					<text class="cert-label">{{ c.label }}</text>
					<text class="cert-desc">{{ c.desc }}</text>
				</view>
				<view v-if="c.done" class="cert-check">
					<text class="check-icon">✓</text>
				</view>
				<view v-else class="cert-pending" @tap="onUpload(c.key)">
					<text class="pending-text">去认证</text>
				</view>
			</view>
		</view>

		<!-- 认证特权 -->
		<view class="section-card">
			<text class="section-title">认证特权</text>
			<view class="cert-item" v-for="p in privList" :key="p.title">
				<view class="cert-icon-wrap">
					<text class="cert-icon-text">{{ p.icon }}</text>
				</view>
				<view class="cert-text-wrap">
					<text class="cert-label">{{ p.title }}</text>
					<text class="cert-desc">{{ p.desc }}</text>
				</view>
			</view>
		</view>

		<text class="footer-tip">认证越多，信任度越高，匹配更精准</text>
	</view>
</template>

<script setup lang="uts">
	const mainList = ref([
		{ key: 'realname',  label: '实名认证', desc: '已通过平台实名认证', icon: '🛡', done: true },
		{ key: 'education', label: '学历认证', desc: '学历信息已核验',       icon: '🎓', done: true },
		{ key: 'avatar',    label: '头像认证', desc: '上传真实本人照片',     icon: '📷', done: false },
		{ key: 'marriage',  label: '婚况认证', desc: '提交婚况证明材料',     icon: '💍', done: false }
	])

	const moreList = ref([
		{ key: 'occupation', label: '职业认证', desc: '上传工牌/在职证明',      icon: '💼', done: false },
		{ key: 'housing',    label: '房产认证', desc: '上传房产证或购房合同',   icon: '🏠', done: false },
		{ key: 'vehicle',    label: '车辆认证', desc: '上传行驶证或购车发票',   icon: '🚗', done: false },
		{ key: 'income',     label: '收入认证', desc: '上传收入证明或银行流水', icon: '💰', done: false }
	])

	const privList = ref([
		{ icon: '✨', title: '专属标识', desc: '个人主页展示金色认证徽章' },
		{ icon: '📈', title: '优先推荐', desc: '首页推荐排名提升30%' },
		{ icon: '💬', title: '无限畅聊', desc: '认证后可解锁无限畅聊特权' },
		{ icon: '🛡', title: '安全保障', desc: '平台权益保障，投诉优先处理' }
	])

	const completed = computed(() => mainList.value.filter(c => c.done).length)

	const onCert = (key: string) => {
		uni.navigateTo({ url: '/pages/profile/certification?type=' + key })
	}

	const onUpload = (type: string) => {
		uni.chooseImage({
			count: 3,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				uni.showLoading({ title: '上传中...' })
				setTimeout(() => {
					uni.hideLoading()
					uni.showToast({ title: '已提交审核', icon: 'success' })
				}, 1500)
			}
		})
	}
</script>

<style scoped>
