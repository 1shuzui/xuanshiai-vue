	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.avatar-emoji {
	font-size: 28px;
	color: var(--profile-text-inverse);
}

.profile-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.nickname {
	font-size: 20px;
	font-weight: 600;
	color: var(--profile-text);
	line-height: 1.3;
}

.vip-tag-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6px;
}

.vip-tag {
	background-color: var(--profile-accent);
	border-radius: 10px;
	padding: 2px 8px;
	display: flex;
	align-items: center;
	height: 22px;
}

.vip-tag-text {
	font-size: 11px;
	font-weight: 600;
	color: var(--profile-text-inverse);
}

.vip-tag-desc {
	font-size: 12px;
	color: var(--profile-text-secondary);
}

.progress-row {
	display: flex;
