}

.nav-icon {
	font-size: 16px;
}

/* ==================== 滚动内容区 ==================== */
.content-scroll {
	flex: 1;
}

.content-inner {
	display: flex;
	flex-direction: column;
	gap: 24px;
	padding: 0 24px;
}

/* ==================== 个人资料头部 ==================== */
.profile-header {
