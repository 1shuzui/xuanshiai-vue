	align-items: center;
	justify-content: center;
	padding: 12px 16px 16px 16px;
	position: relative;
}

.nav-title {
	font-size: 17px;
	font-weight: 600;
	color: var(--profile-text);
}

.nav-right {
	position: absolute;
