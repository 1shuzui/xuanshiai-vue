	align-items: center;
	gap: 8px;
	width: 100%;
}

.progress-bar {
	flex: 1;
	height: 6px;
	border-radius: 3px;
	background-color: var(--profile-bg);
	overflow: hidden;
	position: relative;
}

.progress-fill {
	height: 6px;
	border-radius: 3px;
	background-color: var(--profile-accent);
	position: absolute;
	left: 0;
	top: 0;
}

.progress-percent {
	font-size: 12px;
	font-weight: 600;
	color: var(--profile-accent);
}

/* ==================== 统计数据卡 ==================== */
.stats-card {
