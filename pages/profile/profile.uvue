}

/* ==================== 页面容器 ==================== */
.page {
	position: relative;
	width: 100%;
	min-height: 100vh;
	background-color: var(--profile-bg);
	display: flex;
	flex-direction: column;
}

/* ==================== 状态栏 ==================== */
.status-bar {
	display: flex;
