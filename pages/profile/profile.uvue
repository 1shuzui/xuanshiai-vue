	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>

<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

const user = ref({
	nickname: '张小姐',
	vipProgress: 75,
})

const stats = [
	{ value: '56', label: '我的申请' },
	{ value: '128', label: '我看过谁/看过我' },
	{ value: '12', label: '我的收藏' },
	{ value: '3', label: '我的爆灯' },
]

const onMessages = () => {
	uni.showToast({ title: '消息中心', icon: 'none' })
}

const onSettings = () => {
	uni.navigateTo({ url: '/pages/profile/settings' })
}

const onViewMyProfile = () => {
	uni.navigateTo({ url: '/pages/user/edit' })
}

const onOpenVIP = () => {
	uni.navigateTo({ url: '/pages/profile/vip' })
}

const onMyTasks = () => {
	uni.showToast({ title: '我的任务', icon: 'none' })
}

const onMyMoments = () => {
	uni.navigateTo({ url: '/pages/profile/my-moments' })
}

const onMyPoster = () => {
	uni.showToast({ title: '我的海报', icon: 'none' })
}

const onMyRegistration = () => {
	uni.showToast({ title: '我的报名', icon: 'none' })
}

const onCertification = () => {
	uni.navigateTo({ url: '/pages/profile/certification' })
}

const onInviteFriend = () => {
	uni.showToast({ title: '推荐给好友', icon: 'none' })
}

const onMenuSettings = () => {
	uni.navigateTo({ url: '/pages/profile/settings' })
}

const onHelp = () => {
	uni.showToast({ title: '客服与帮助', icon: 'none' })
}

const onAbout = () => {
	uni.showToast({ title: '关于我们', icon: 'none' })
}

const onSecurity = () => {
	uni.showToast({ title: '安全中心', icon: 'none' })
}

const mainMenuItems = [
	{ iconClass: 'ic ic-vip ic-renwu', iconBg: '#EDE4F0', label: '我的任务', badge: 'NEW', action: onMyTasks },
	{ iconClass: 'ic ic-me ic-dongtai', iconBg: '#E4EDE8', label: '我的动态', action: onMyMoments },
	{ iconClass: 'ic ic-home ic-heart', iconBg: '#FDE8EC', label: '我的海报', action: onMyPoster },
	{ iconClass: 'ic ic-social ic-huodong', iconBg: '#FEF3E4', label: '我的报名', action: onMyRegistration },
	{ iconClass: 'ic ic-sys ic-shiming', iconBg: '#FEF3E4', label: '诚信认证', action: onCertification },
	{ iconClass: 'ic ic-sys ic-fenxiang', iconBg: '#FEF3E4', label: '推荐给好友', action: onInviteFriend },
	{ iconClass: 'ic ic-me ic-shezhi', iconBg: '#FEF3E4', label: '设置', action: onMenuSettings },
]

const bottomMenuItems = [
	{ iconClass: 'ic ic-me ic-kefu', iconBg: '#F7F4F0', label: '客服与帮助', subtitle: 'AI客服 . 意见反馈', action: onHelp },
	{ iconClass: 'ic ic-me ic-bangzhu', iconBg: '#F7F4F0', label: '关于我们', subtitle: '版本 1.0.0', action: onAbout },
	{ iconClass: 'ic ic-sys ic-shiming', iconBg: '#FEF3E4', label: '安全中心', action: onSecurity },
]
</script>

<style>
/* ==================== 页面级 CSS 变量 & 基础样式 ==================== */
/* 注意：此块不加 scoped，让 CSS 变量能在整页生效 */

page {
	--profile-bg: #F7F4F0;
	--profile-card: #FFFFFF;
	--profile-dark: #3A3A3A;
	--profile-accent: #8FA88A;
	--profile-rose: #D4A89E;
	--profile-text: #2C2C2C;
	--profile-text-secondary: #8E8E8A;
	--profile-text-muted: #C5C3BE;
	--profile-text-inverse: #FFFFFF;
	--profile-vip-sub: #B0B0B0;
	background-color: var(--profile-bg);
}

/* ==================== 页面容器 ==================== */
.page {
	position: relative;
	width: 100%;
	min-height: 100vh;
	background-color: var(--profile-bg);
	display: flex;
	flex-direction: column;
}

/* ==================== 状态栏 ==================== */
.status-bar {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	height: 44px;
	padding-left: 16px;
	padding-right: 16px;
	box-sizing: border-box;
}

.time-text {
	font-size: 14px;
	font-weight: 600;
	color: var(--profile-text);
}

.status-icons {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.battery-icon {
	font-size: 12px;
	color: var(--profile-text);
	letter-spacing: 1px;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 12px 16px 16px 16px;
	position: relative;
}

.nav-title {
	font-size: 17px;
	font-weight: 600;
	color: var(--profile-text);
}

.nav-right {
	position: absolute;
	right: 16px;
	top: 12px;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
}

.nav-icon-btn {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: var(--profile-bg);
	display: flex;
	align-items: center;
	justify-content: center;
}

.nav-icon {
	font-size: 16px;
}

/* ==================== 滚动内容区 ==================== */
.content-scroll {
	flex: 1;
}

.content-inner {
	display: flex;
	flex-direction: column;
	gap: 24px;
	padding: 0 24px;
}

/* ==================== 个人资料头部 ==================== */
.profile-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14px;
	width: 100%;
	padding-top: 8px;
}

.avatar-wrap {
	width: 64px;
	height: 64px;
	border-radius: 32px;
	background-color: var(--profile-rose);
