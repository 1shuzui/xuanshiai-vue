}

.badge-text {
	font-size: 11px;
	font-weight: 600;
	color: var(--text-invert);
}

.vip-tag {
	padding: 3px 8px;
	background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
	border-radius: 999px;
	margin-right: 8px;
}

.vip-text {
	font-size: 11px;
	font-weight: 600;
