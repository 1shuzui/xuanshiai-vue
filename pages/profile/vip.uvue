	display: flex;
	flex-direction: column;
	gap: 12px;
}

.plan-item {
	position: relative;
	background: var(--surface);
	border: 2px solid var(--line);
	border-radius: 12px;
	padding: 20px;
	display: flex;
	align-items: center;
	transition: all 0.3s;
}

