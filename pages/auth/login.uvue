<template>
	<view class="login-page">
		<view class="brand-block">
			<view class="brand-mark">
				<image src="/static/logo.png" mode="aspectFit"></image>
			</view>
			<text class="brand-name text-serif">宣誓爱</text>
			<text class="brand-subtitle">高学历实名制的恋爱平台</text>
		</view>

		<view class="login-content">
			<!-- #ifdef MP-WEIXIN -->
			<button
				class="phone-auth-button"
				open-type="getPhoneNumber"
				:disabled="authLoading"
				@getphonenumber="handlePhoneNumber"
			>
				{{ authLoading ? '正在登录' : '微信一键登录' }}
			</button>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<button class="phone-auth-button" :disabled="authLoading" @click="handleNonWechatLogin">
				{{ authLoading ? '正在登录' : '模拟微信一键登录' }}
			</button>
			<!-- #endif -->

			<button class="debug-login-button" @click="handleDebugLogin">调试登录，直接进入首页</button>
			<button class="first-login-button" @click="handleFirstLogin">首次登录</button>

			<view class="login-note">
				<text>微信授权仅用于完成身份登录和手机号验证</text>
			</view>
		</view>

		<view class="login-footer">
			<view class="footer-line"></view>
			<text class="footer-text">真实相遇，不负期待</text>
			<view class="footer-line"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const authLoading = ref(false)

	const goHome = () => {
		uni.switchTab({
			url: '/pages/index/index'
		})
	}

	const finishLogin = () => {
		uni.setStorageSync('xsa_login_agreed', true)
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			uni.navigateTo({ url: '/pages/onboarding/profile' })
		}, 700)
	}

	const handlePhoneNumber = (e: any) => {
		const detail = e.detail
		const authCode = detail != null && detail.code != null ? String(detail.code) : ''
		const errMsg = detail != null && detail.errMsg != null ? String(detail.errMsg) : ''
		if (authCode.length == 0 && errMsg.indexOf('ok') < 0) {
			console.error('微信手机号授权失败', detail)
			const userDenied = errMsg.indexOf('user deny') >= 0 || errMsg.indexOf('cancel') >= 0
			uni.showToast({
				title: userDenied ? '你已取消手机号授权' : '微信手机号授权失败，请检查小程序权限',
				icon: 'none'
			})
			return
		}
		authLoading.value = true
		// Mock 阶段只验证授权结果，真实环境需把 code 交给服务端换取手机号。
		setTimeout(() => {
			authLoading.value = false
			finishLogin()
		}, 500)
	}

	const handleNonWechatLogin = () => {
		authLoading.value = true
		setTimeout(() => {
			authLoading.value = false
			finishLogin()
		}, 500)
	}

	const handleDebugLogin = async () => {
		if (authLoading.value) return
		authLoading.value = true
		const ok = await loginWithMockSms('17870810285')
		authLoading.value = false
		if (ok) {
			uni.showToast({ title: '本地测试登录成功', icon: 'success' })
			setTimeout(() => {
				goHome()
			}, 400)
			return
		}
		uni.showToast({ title: '本地登录失败，请检查后端', icon: 'none' })
	}

	const handleFirstLogin = () => {
		uni.navigateTo({ url: '/pages/onboarding/profile' })
	}

</script>

<style scoped>
	.login-page {
		min-height: 100vh;
		padding: 76px 24px calc(32px + env(safe-area-inset-bottom));
		background: var(--canvas);
