	display: block;
	font-size: 36px;
	font-weight: 500;
	color: var(--accent2);
	margin-bottom: 12px;
	letter-spacing: 2px;
}

.slogan {
	font-size: 14px;
}

.login-form {
	margin-bottom: 60px;
}

.form-item {
	margin-bottom: 24px;
}

.label {
	display: block;
	font-size: 14px;
	color: var(--ink);
	margin-bottom: 8px;
}

.input {
	width: 100%;
	height: 48px;
	background: var(--surface);
	border: 1px solid var(--line);
	border-radius: 8px;
	padding: 0 16px;
	font-size: 15px;
	color: var(--ink);
}

.code-input-wrapper {
	display: flex;
	gap: 12px;
}

.code-input-wrapper .input {
	flex: 1;
}

.code-btn {
	width: 110px;
	height: 48px;
	background: var(--soft);
	color: var(--accent2);
	border-radius: 8px;
	font-size: 14px;
	flex-shrink: 0;
}

.code-btn[disabled] {
	opacity: 0.5;
	color: var(--muted);
}

.login-btn {
	width: 100%;
	height: 48px;
	background: var(--accent);
	color: #FFFFFF;
	border-radius: 999px;
	font-size: 16px;
	font-weight: 500;
	margin-top: 32px;
	margin-bottom: 16px;
}

.tips {
	text-align: center;
}

.tip-text {
	font-size: 12px;
	color: var(--muted);
}

.link {
	font-size: 12px;
	color: var(--accent2);
}

.other-login {
	margin-top: 80px;
}

.divider {
	display: flex;
	align-items: center;
	gap: 12px;
	margin-bottom: 24px;
}

.divider .line {
	flex: 1;
	height: 1px;
	background: var(--line);
}

.divider .text {
	font-size: 13px;
	white-space: nowrap;
}

.social-btns {
	display: flex;
	justify-content: center;
	gap: 40px;
}

.social-btn {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
}

.social-btn .icon {
	font-size: 32px;
}

.social-btn .text-muted {
	font-size: 12px;
}
</style>
