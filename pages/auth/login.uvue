<template>
	<view class="login-page">
		<view class="brand-block">
			<view class="brand-mark">
				<image src="/static/logo.png" mode="aspectFit"></image>
			</view>
			<text class="brand-name text-serif">宣誓爱</text>
			<text class="brand-subtitle">高学历实名制的恋爱平台</text>
		</view>

		<view class="login-content">
			<button class="phone-auth-button" :disabled="authLoading" @click="handleLocalLogin">
				{{ authLoading ? '正在进入社区' : '本地登录进入社区' }}
			</button>

			<button class="debug-login-button" @click="handleLocalLogin">调试登录，直接进入社区</button>
			<button class="first-login-button" @click="handleFirstLogin">首次登录</button>

			<view class="login-note">
				<text>本地演示登录使用内置数据，无需微信授权或后端服务</text>
			</view>
		</view>

		<view class="login-footer">
			<view class="footer-line"></view>
			<text class="footer-text">真实相遇，不负期待</text>
			<view class="footer-line"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { setAuthTokens } from '@/api/config.uts'

	const authLoading = ref(false)

	const startLocalDemoSession = (): boolean => {
		try {
			setAuthTokens('local_demo_access_token', 'local_demo_refresh_token')
			uni.setStorageSync('xsa_login_agreed', true)
			uni.setStorageSync('xsa_user_id', 1)
			return true
		} catch (error) {
			console.error('local demo login failed', error)
			return false
		}
	}

	const handleLocalLogin = () => {
		if (authLoading.value) return
		authLoading.value = true
		const ok = startLocalDemoSession()
		authLoading.value = false
		if (!ok) {
			uni.showToast({ title: '本地登录失败，请重试', icon: 'none' })
			return
		}
		uni.showToast({ title: '本地登录成功', icon: 'success' })
		uni.switchTab({ url: '/pages/community/community' })
	}

	const handleFirstLogin = () => {
		uni.navigateTo({ url: '/pages/onboarding/profile' })
	}

</script>

<style scoped>
