	const authLoading = ref(false)
	const agreementChecked = ref(uni.getStorageSync('xsa_login_agreed') == true)

	const goHome = () => {
		uni.switchTab({
			url: '/pages/index/index'
		})
	}

	const finishLogin = (data: any = null) => {
		uni.setStorageSync('xsa_login_agreed', true)
		if (data != null && data.user_id != null) {
			uni.setStorageSync('xsa_user_id', data.user_id)
		}
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			if (data != null && data.need_bind_phone === true) {
				uni.navigateTo({ url: '/pagesSub/userExtra/onboarding/profile' })
				return
			}
			goHome()
		}, 500)
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		if (res != null && res.message != null && res.message != '') return '' + res.message
		return fallback
	}

	const handleAgreementChange = (e: any) => {
		const values = e.detail != null && e.detail.value != null ? (e.detail.value as string[]) : []
		agreementChecked.value = values.indexOf('agreed') >= 0
	}

	const openAgreement = (type: string) => {
		let url = '/pagesSub/about/article?type=terms'
		if (type == 'privacy') {
			url = '/pagesSub/about/article?type=privacy'
		}
		uni.navigateTo({ url })
	}

	const getWechatLoginCode = (): Promise<string> => {
		return new Promise((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res: any) => {
					resolve(res.code != null ? String(res.code) : '')
				},
				fail: (error: any) => {
					console.error('wechat login failed', error)
					resolve('')
				}
			})
		})
	}

	const handleWechatLogin = async () => {
		if (authLoading.value || !agreementChecked.value) return
		authLoading.value = true
		try {
			const code = await getWechatLoginCode()
			if (code == '') {
				uni.showToast({ title: '无法获取微信登录凭证', icon: 'none' })
				return
			}
			const res = await loginByWechat(code)
			if (!res.success || res.data == null || res.data.access_token == null) {
				uni.showToast({ title: responseMessage(res, '微信登录失败，请重试'), icon: 'none' })
				return
			}
			finishLogin(res.data)
		} catch (error) {
			console.error('wechat login request failed', error)
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		} finally {
			authLoading.value = false
		}
	}

	const handleNonWechatLogin = () => {
