	import { USE_MOCK, API_BASE_URL, API_PREFIX, setAuthTokens } from '@/api/config.uts'
	import { loginByPhone } from '@/api/auth.uts'

	const authLoading = ref(false)

	const goHome = () => {
		uni.switchTab({
			url: '/pages/index/index'
		})
	}

	const routeAfterLogin = (requireProfile: boolean = false) => {
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode != null && String(storedMode) == 'parent') {
			uni.reLaunch({ url: '/pages/parent/parent' })
			return
		}
		const completed = uni.getStorageSync('xsa_onboarding_completed') == true
		if (requireProfile && !completed) {
			uni.navigateTo({ url: '/pages/onboarding/profile' })
			return
		}
		goHome()
	}

	const finishLogin = () => {
		uni.setStorageSync('xsa_login_agreed', true)
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			routeAfterLogin(true)
		}, 700)
	}

	/** 关 Mock 联调：仅调试入口使用 mock 短信登录，写入 Bearer token */
	const loginWithMockSms = (phone: string): Promise<boolean> => {
		return new Promise((resolve) => {
			const base = API_BASE_URL + API_PREFIX
			uni.request({
				url: base + '/auth/sms/send',
				method: 'POST',
				header: { 'Content-Type': 'application/json' },
				data: { phone: phone, purpose: 'login' },
				success: (_sendRes: any) => {
					uni.request({
						url: base + '/auth/phone/login',
						method: 'POST',
						header: { 'Content-Type': 'application/json' },
						data: {
							phone: phone,
							purpose: 'login',
							code: '123456',
							platform: 'mp-weixin',
							device_id: 'hx-debug'
						},
						success: (loginRes: any) => {
							const status = loginRes.statusCode != null ? (loginRes.statusCode as number) : 0
							const body = loginRes.data
							if (status >= 200 && status < 300 && body != null && body.access_token != null) {
								const access = '' + body.access_token
								const refresh = body.refresh_token != null ? ('' + body.refresh_token) : ''
								setAuthTokens(access, refresh)
								uni.setStorageSync('xsa_login_agreed', true)
								if (body.user_id != null) {
									uni.setStorageSync('xsa_user_id', body.user_id)
								}
								resolve(true)
							} else {
								console.error('phone login failed', status, body)
								resolve(false)
							}
						},
						fail: (err: any) => {
							console.error('phone login network fail', err)
							resolve(false)
						}
					})
				},
				fail: (err: any) => {
					console.error('sms send network fail', err)
					resolve(false)
				}
			})
		})
	}

