		line-height: 1.6;
		color: var(--muted);
	}

	.login-footer {
		width: 100%;
		max-width: 390px;
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.footer-line {
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.footer-text {
		font-size: 12px;
		color: var(--muted);
		white-space: nowrap;
	}

	/* 入口页保持安静，把正式授权和调试入口分开。 */
	.login-page {
		padding: 64px 20px calc(28px + env(safe-area-inset-bottom));
		background: var(--paper);
	}

	.brand-block {
		margin-bottom: 48px;
	}

	.brand-mark {
		width: 64px;
		height: 64px;
		margin-bottom: 14px;
		border-radius: 18px;
		box-shadow: var(--shadow-sm);
	}

	.brand-name {
		font-size: 30px;
		letter-spacing: 0.12em;
	}

	.brand-subtitle {
		margin-top: 8px;
		letter-spacing: 0.1em;
	}

	.login-content {
		max-width: 360px;
	}

	.phone-auth-button {
		margin-top: 0;
		height: 52px;
		border-radius: 10px;
		box-shadow: var(--shadow-sm);
	}

	.debug-login-button,
	.first-login-button {
		border-radius: 9px;
	}

	.debug-login-button {
		margin-top: 18px;
