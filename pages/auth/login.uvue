<template>
	<view class="login-page">
		<view class="brand-block">
			<view class="brand-mark">
				<image src="/static/logo.png" mode="aspectFit"></image>
			</view>
			<text class="brand-name text-serif">宣誓爱</text>
			<text class="brand-subtitle">认真、真实、有边界的婚恋平台</text>
		</view>

		<view class="login-content">
			<!-- #ifdef MP-WEIXIN -->
			<button
				class="phone-auth-button"
				:disabled="authLoading || !agreementChecked"
				@click="handleWechatLogin"
			>
				{{ authLoading ? '正在登录' : '微信一键登录' }}
			</button>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<button class="phone-auth-button" :disabled="authLoading || !agreementChecked" @click="handleNonWechatLogin">
				手机号验证码登录
			</button>
			<!-- #endif -->

			<button class="debug-login-button" :disabled="authLoading" @click="handleDebugLogin">调试登录，选择身份</button>
			<button class="first-login-button" :disabled="authLoading || !agreementChecked" @click="handleFirstLogin">首次登录</button>

			<view class="agreement-row">
				<checkbox-group @change="handleAgreementChange">
					<label class="agreement-check">
						<checkbox value="agreed" :checked="agreementChecked" />
						<text>我已阅读并同意</text>
					</label>
				</checkbox-group>
				<view class="agreement-links">
					<text class="agreement-link" @click="openAgreement('terms')">《用户协议》</text>
					<text class="agreement-copy">和</text>
					<text class="agreement-link" @click="openAgreement('privacy')">《隐私政策》</text>
				</view>
			</view>

			<view class="login-note">
				<text>微信授权仅用于完成身份登录和手机号验证</text>
			</view>
		</view>

		<view class="login-footer">
			<view class="footer-line"></view>
			<text class="footer-text">真实相遇，不负期待</text>
			<view class="footer-line"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { loginByPhone, loginByWechat } from '@/api'
	import { CURRENT_USER_ID_KEY, setAuthTokens } from '@/api/config.uts'

	const authLoading = ref(false)
	const agreementChecked = ref(uni.getStorageSync('xsa_login_agreed') == true)

	const goHome = () => {
		uni.switchTab({
			url: '/pages/index/index'
		})
	}

	const routeAfterLogin = (forceRoleSelection: boolean = false) => {
		if (forceRoleSelection) {
			uni.removeStorageSync('xsa_onboarding_mode')
			uni.removeStorageSync('xsa_onboarding_completed')
			uni.reLaunch({ url: '/pagesSub/userExtra/onboarding/profile' })
			return
		}
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode != null && String(storedMode) == 'parent') {
			uni.reLaunch({ url: '/pages/parent/parent' })
			return
		}
		if (uni.getStorageSync('xsa_onboarding_completed') != true) {
			uni.navigateTo({ url: '/pagesSub/userExtra/onboarding/profile' })
			return
		}
		goHome()
	}

	const finishLogin = (data: any = null) => {
		uni.setStorageSync('xsa_login_agreed', true)
		if (data != null && data.user_id != null) {
			uni.setStorageSync('xsa_user_id', data.user_id)
		}
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			if (data != null && data.need_bind_phone === true) {
				uni.navigateTo({ url: '/pagesSub/userExtra/onboarding/profile' })
				return
			}
			routeAfterLogin(false)
		}, 500)
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		if (res != null && res.message != null && res.message != '') return '' + res.message
		return fallback
	}

	const handleAgreementChange = (e: any) => {
		const values = e.detail != null && e.detail.value != null ? (e.detail.value as string[]) : []
		agreementChecked.value = values.indexOf('agreed') >= 0
	}

	const openAgreement = (type: string) => {
		let url = '/pagesSub/about/article?type=terms'
		if (type == 'privacy') {
			url = '/pagesSub/about/article?type=privacy'
		}
		uni.navigateTo({ url })
	}

	const getWechatLoginCode = (): Promise<string> => {
		return new Promise((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res: any) => {
					resolve(res.code != null ? String(res.code) : '')
				},
				fail: (error: any) => {
					console.error('wechat login failed', error)
					resolve('')
				}
			})
		})
	}

	const handleWechatLogin = async () => {
		if (authLoading.value || !agreementChecked.value) return
		authLoading.value = true
		try {
			const code = await getWechatLoginCode()
			if (code == '') {
				uni.showToast({ title: '无法获取微信登录凭证', icon: 'none' })
				return
			}
			const res = await loginByWechat(code)
			if (!res.success || res.data == null || res.data.access_token == null) {
				uni.showToast({ title: responseMessage(res, '微信登录失败，请重试'), icon: 'none' })
				return
			}
			finishLogin(res.data)
		} catch (error) {
			console.error('wechat login request failed', error)
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		} finally {
			authLoading.value = false
		}
	}

	const handleNonWechatLogin = () => {
		if (!agreementChecked.value) return
		uni.navigateTo({ url: '/pages/auth/register' })
	}

	const startLocalDemoSession = (): boolean => {
		try {
			setAuthTokens('local_demo_access_token', 'local_demo_refresh_token')
			uni.setStorageSync(CURRENT_USER_ID_KEY, 1)
			uni.setStorageSync('xsa_login_agreed', true)
			return true
		} catch (error) {
			console.error('debug login session setup failed', error)
			return false
		}
	}

	const handleDebugLogin = async () => {
		if (authLoading.value) return
		authLoading.value = true
		try {
			if (!startLocalDemoSession()) {
				uni.showToast({ title: '调试登录失败，请重试', icon: 'none' })
				return
			}
			uni.showToast({ title: '登录成功，请选择身份', icon: 'success' })
			setTimeout(() => {
				routeAfterLogin(true)
			}, 300)
		} finally {
			authLoading.value = false
		}
	}

	const handleLocalLogin = () => {
		handleDebugLogin()
	}

	const handleFirstLogin = () => {
		if (!agreementChecked.value) return
		uni.navigateTo({ url: '/pagesSub/userExtra/onboarding/profile' })
	}

</script>

<style scoped>
	.login-page {
		min-height: 100vh;
		padding: 64px 20px calc(28px + env(safe-area-inset-bottom));
		background: var(--paper);
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}

	.brand-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 48px;
	}

	.brand-mark {
		width: 64px;
		height: 64px;
		padding: 8px;
		margin-bottom: 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 18px;
		box-shadow: var(--shadow-sm);
		box-sizing: border-box;
	}

	.brand-mark image {
		width: 100%;
		height: 100%;
	}

	.brand-name {
		font-size: 30px;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0;
		color: var(--accent2);
	}

	.brand-subtitle {
		margin-top: 8px;
		font-size: 13px;
		letter-spacing: 0;
		color: var(--muted);
	}

	.login-content {
		width: 100%;
		max-width: 360px;
	}

	.phone-auth-button {
		width: 100%;
		height: 52px;
		margin-top: 0;
		border-radius: 10px;
		background: var(--accent);
		color: var(--text-invert);
		font-size: 17px;
		font-weight: 800;
		line-height: 52px;
		box-shadow: var(--shadow-sm);
	}

	.phone-auth-button[disabled] {
		opacity: 0.55;
	}

	.phone-auth-button:active {
		transform: scale(0.98);
	}

	.debug-login-button {
		width: 100%;
		height: 44px;
		margin-top: 18px;
		border: 1px solid var(--line);
		border-radius: 9px;
		background: transparent;
		color: var(--muted);
		font-size: 13px;
		line-height: 44px;
	}

	.debug-login-button:active {
		background: var(--warm);
	}

	.first-login-button {
		width: 100%;
		height: 44px;
		margin-top: 8px;
		border: 1px solid var(--line);
		border-radius: 9px;
		background: var(--surface);
		color: var(--accent2);
		font-size: 13px;
		line-height: 44px;
	}

	.first-login-button:active {
		transform: scale(0.98);
	}

	.debug-login-button[disabled],
	.first-login-button[disabled] {
		opacity: 0.5;
	}

	.agreement-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 2px;
		margin-top: 16px;
		font-size: 12px;
		line-height: 1.6;
		color: var(--muted);
	}

	.agreement-check,
	.agreement-links {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.agreement-check checkbox {
		transform: scale(0.76);
	}

	.agreement-link {
		color: var(--accent2);
	}

	.agreement-copy {
		color: var(--muted);
	}

	.login-note {
		margin-top: 16px;
		text-align: center;
	}

	.login-note text {
		font-size: 11px;
		line-height: 1.6;
		color: var(--muted);
	}

	.login-footer {
		width: 100%;
		max-width: 360px;
		margin-top: 52px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.footer-line {
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.footer-text {
		font-size: 12px;
		color: var(--muted);
		white-space: nowrap;
	}

</style>
