<template>
	<view class="chat-page">
		<!-- 消息列表 -->
		<scroll-view
			class="message-list"
			scroll-y
			:scroll-into-view="scrollToView"
			scroll-with-animation
		>
			<view class="message-item" v-for="(msg, index) in messages" :key="index" :id="'msg-' + index">
				<!-- 时间线 -->
				<view class="time-divider" v-if="msg.showTime">
					<text class="time-text">{{ msg.time }}</text>
				</view>

				<!-- 消息内容 -->
				<view class="message-wrapper" :class="msg.isMine ? 'mine' : 'other'">
					<!-- 对方头像 -->
					<image
						class="avatar"
						:src="msg.avatar"
						mode="aspectFill"
						v-if="!msg.isMine"
						@click="openPeerProfile"
					></image>

					<!-- 消息气泡 -->
					<view class="message-bubble" :class="msg.type">
						<!-- 文本消息 -->
						<text class="text-content" v-if="msg.type === 'text'">{{ msg.content }}</text>

						<!-- 图片消息 -->
						<image
							class="image-content"
							:src="msg.content"
							mode="aspectFill"
							@click="previewImage(msg.content)"
							v-if="msg.type === 'image'"
						></image>

						<!-- 语音消息 -->
						<view class="voice-content" v-if="msg.type === 'voice'">
							<text class="icon">🔊</text>
							<text class="duration">{{ msg.duration }}''</text>
						</view>
					</view>

					<!-- 我的头像 -->
					<image
						class="avatar"
						:src="msg.avatar"
						mode="aspectFill"
						v-if="msg.isMine"
					></image>
				</view>
			</view>
		</scroll-view>

		<!-- 输入栏与展开功能区：展开后输入栏上移，功能区显示在其下方。 -->
		<view class="input-bar" :class="{ expanded: showMore }">
			<view class="input-wrapper">
				<button class="tool-btn" @click="sendVoice" v-if="!inputText">
					<text class="icon">🎤</text>
				</button>
				<button class="send-btn" @click="sendMessage" v-else>发送</button>
				<input
					class="input"
					type="text"
					:value="inputText"
					@input="onInput"
					placeholder="说点什么..."
					confirm-type="send"
					@confirm="sendMessage"
				/>
				<button class="tool-btn more-toggle" @click="toggleMoreMenu">
					<text class="icon">{{ showMore ? '×' : '+' }}</text>
				</button>
			</view>

			<view class="more-actions" v-if="showMore">
				<view class="menu-grid">
					<view class="menu-item" @click="chooseImage">
						<view class="menu-icon">📷</view>
						<text class="menu-text">相册</text>
					</view>
					<view class="menu-item" @click="takePhoto">
						<view class="menu-icon">📸</view>
						<text class="menu-text">拍摄</text>
					</view>
					<view class="menu-item" @click="sendGift">
						<view class="menu-icon">🎁</view>
						<text class="menu-text">礼物</text>
					</view>
					<view class="menu-item" @click="openChatReport">
						<view class="menu-icon">⚑</view>
						<text class="menu-text">举报</text>
					</view>
				</view>
			</view>
		</view>

		<XsaReportSheet
			:visible="reportVisible"
			target-type="chatUser"
			:target-id="userId"
			:user-id="userId"
			@close="reportVisible = false"
			@reported="reportVisible = false"
		/>
	</view>
</template>

<script setup lang="uts">
	// 导入 API
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import { getChatMessages, sendMessage as sendMessageApi, getChatFeatureUnlocks, unlockChatFeature } from '@/api';

	// 消息列表（改为空数组）
		let messages = ref([])

		let inputText = ref('')
		let showMore = ref(false)
		let scrollToView = ref('')
		let loading = ref(false)
		let userId = ref(0)
		let peerAvatar = ref('/static/portraits/profile-woman-main.jpg')
		let reportVisible = ref(false)
		let chatFeatureUnlocks = ref({ album: false, camera: false, profile: false } as any)

	// 页面加载时获取数据
	onMounted(() => {
		loadChatFeatureUnlocks()
		// 获取 URL 参数中的 userId
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		if (options && options.userId) {
			userId.value = parseInt(options.userId)
			loadChatMessages()
		}
	})

	const loadChatFeatureUnlocks = async () => {
		try {
			const res = await getChatFeatureUnlocks()
			if (res != null && res.success && res.data != null) {
				chatFeatureUnlocks.value = res.data as any
			}
		} catch (error) {
			console.error('获取聊天功能解锁状态失败', error)
		}
	}

		// 加载聊天记录
		const loadChatMessages = async () => {
			try {
				loading.value = true
				const res = await getChatMessages(userId.value)
				if (res.success) {
					const list = res.data as any[]
					if (list.length > 0) {
						const firstOther = list.find((m: any) => m.isMine != true)
						if (firstOther != null && firstOther.senderAvatar != null) {
							peerAvatar.value = firstOther.senderAvatar
						}
					}
					messages.value = list.map((msg: any, idx: number) => ({
						id: msg.id,
						type: msg.type,
						content: msg.content,
						time: msg.timeLabel != null ? msg.timeLabel : formatTime(msg.time),
						showTime: msg.showTime == true || idx == 0,
						isMine: msg.isMine,
						avatar: msg.senderAvatar
					}))
					scrollToBottom()
				}
			} catch (error) {
				console.error('获取聊天记录失败', error)
			} finally {
				loading.value = false
			}
		}

	// 格式化时间
	const formatTime = (timestamp: number): string => {
		const date = new Date(timestamp)
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}

	// 输入事件
	const onInput = (e: InputEvent) => {
		inputText.value = e.detail.value
	}

	// 发送消息
	const sendMessage = async () => {
		if (!inputText.value.trim()) {
			return
		}

		const content = inputText.value
			const newMsg = {
				id: Date.now(),
				type: 'text',
				content: content,
				time: getCurrentTime(),
				showTime: false,
				isMine: true,
				avatar: '/static/portraits/profile-man-light.jpg'
			}

			// 立即添加到界面
			messages.value.push(newMsg)
			inputText.value = ''
			scrollToBottom()

			// 调用发送消息接口
			try {
				const res = await sendMessageApi(userId.value, content, 'text')
				if (res.success) {
					if (res.data != null && res.data.messageId != null) {
						newMsg.id = res.data.messageId
					}
					// 高保真演示：自动回复
					setTimeout(() => {
						const replies = ['听起来不错！', '我也这么觉得。', '有道理，我们可以约个时间详细聊聊。', '好的，期待和你见面。', '这个想法很棒！']
						const i = Math.floor(Math.random() * replies.length)
						messages.value.push({
							id: Date.now() + 1,
							type: 'text',
							content: replies[i],
							time: getCurrentTime(),
							showTime: false,
							isMine: false,
							avatar: peerAvatar.value
						})
						scrollToBottom()
					}, 1600)
				}
			} catch (error) {
				console.error('发送消息失败', error)
				uni.showToast({
					title: '发送失败',
					icon: 'none'
				})
			}
		}

	// 预览图片
	const previewImage = (url: string) => {
		const images = messages.value
			.filter(msg => msg.type === 'image')
			.map(msg => msg.content)

		uni.previewImage({
			current: url,
			urls: images
		})
	}

	// 展开/收起输入栏下方的功能区
	const toggleMoreMenu = () => {
		showMore.value = !showMore.value
	}

	// 关闭更多菜单
	const closeMoreMenu = () => {
		showMore.value = false
	}

	const openImagePicker = (sourceType: string) => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: [sourceType],
			success: (res) => {
				const newMsg = {
					id: messages.value.length + 1,
					type: 'image',
					content: res.tempFilePaths[0],
					time: getCurrentTime(),
					showTime: false,
					isMine: true,
					avatar: '/static/portraits/profile-man-light.jpg'
				}
				messages.value.push(newMsg)
				scrollToBottom()
				closeMoreMenu()
			}
		})
	}

	const ensureChatFeatureUnlocked = (feature: string, label: string, action: () => void) => {
		if (chatFeatureUnlocks.value[feature] == true) {
			action()
			return
		}
		uni.showModal({
			title: '解锁' + label,
			content: '使用' + label + '需要消耗80积分，确认解锁吗？',
			confirmText: '80积分解锁',
			success: async (modalRes: any) => {
				if (modalRes == null || modalRes.confirm != true) return
				try {
					const res = await unlockChatFeature(feature)
					const data = res != null ? res.data : null
					if (res != null && res.success && data != null && data.success == true) {
						chatFeatureUnlocks.value[feature] = true
						uni.showToast({ title: '已消耗80积分解锁', icon: 'success' })
						action()
						return
					}
					const message = data != null && data.message != null ? data.message : '解锁失败，请稍后再试'
					uni.showToast({ title: message, icon: 'none' })
				} catch (error) {
					uni.showToast({ title: '网络异常，请稍后再试', icon: 'none' })
				}
			}
		})
	}

	// 选择图片：首次使用需消耗 80 积分解锁。
	const chooseImage = () => {
		ensureChatFeatureUnlocked('album', '相册', () => openImagePicker('album'))
	}

	// 拍摄：首次使用需消耗 80 积分解锁。
	const takePhoto = () => {
		ensureChatFeatureUnlocked('camera', '拍摄', () => openImagePicker('camera'))
	}

	// 发送语音
	const sendVoice = () => {
		uni.showToast({
			title: '长按录音',
			icon: 'none'
		})
	}

	// 发送礼物
	const sendGift = () => {
		uni.showToast({
			title: '礼物功能开发中',
			icon: 'none'
		})
		closeMoreMenu()
	}

	// 点击对方头像：首次查看主页需消耗 80 积分解锁。
	const openPeerProfile = () => {
		if (userId.value <= 0) {
			uni.showToast({ title: '暂时无法获取对方资料', icon: 'none' })
			return
		}
		ensureChatFeatureUnlocked('profile', '查看对方主页', () => {
			uni.navigateTo({
				url: '/pages/user/detail?userId=' + userId.value
			})
		})
	}

	const openChatReport = () => {
		closeMoreMenu()
		reportVisible.value = true
	}

	// 滚动到底部
	const scrollToBottom = () => {
		setTimeout(() => {
			scrollToView.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	// 获取当前时间
	const getCurrentTime = (): string => {
		const now = new Date()
		const hours = now.getHours().toString().padStart(2, '0')
		const minutes = now.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}
</script>

<style scoped>
.chat-page {
	height: 100vh;
	display: flex;
	flex-direction: column;
	background: var(--canvas);
}

.message-list {
	flex: 1;
	padding: 16px;
	overflow-y: auto;
}

.message-item {
	margin-bottom: 16px;
}

.time-divider {
	text-align: center;
	margin-bottom: 16px;
}

.time-text {
	display: inline-block;
	padding: 4px 12px;
	background: var(--line);
	color: var(--muted);
	border-radius: 999px;
	font-size: 12px;
}

.message-wrapper {
	display: flex;
		flex-direction: row;
	gap: 8px;
}

.message-wrapper.mine {
	justify-content: flex-end;
}

.avatar {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	flex-shrink: 0;
	cursor: pointer;
}

.message-bubble {
	max-width: 240px;
	padding: 12px 16px;
	border-radius: 12px;
	word-break: break-all;
}

.message-wrapper.other .message-bubble {
	background: var(--surface);
	color: var(--ink);
}

.message-wrapper.mine .message-bubble {
	background: var(--accent);
	color: var(--text-invert);
}

.text-content {
	font-size: 15px;
	line-height: 1.4;
}

.image-content {
	display: block;
	max-width: 200px;
	max-height: 200px;
	border-radius: 8px;
}

.voice-content {
	display: flex;
		flex-direction: row;
	align-items: center;
	gap: 8px;
	min-width: 80px;
}

.voice-content .icon {
	font-size: 18px;
}

.voice-content .duration {
	font-size: 14px;
}

.input-bar {
	background: var(--surface);
	border-top: 1px solid var(--line);
	padding: 8px 16px;
	padding-bottom: calc(8px + env(safe-area-inset-bottom));
	display: flex;
	flex-direction: column;
	gap: 12px;
}

.input-bar.expanded {
	padding-top: 12px;
}

.input-wrapper {
	display: flex;
		flex-direction: row;
	align-items: center;
	gap: 8px;
}

.tool-btn {
	width: 36px;
	height: 36px;
	background: var(--paper);
	border-radius: 50%;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.tool-btn .icon {
	font-size: 20px;
	color: var(--ink2);
}

.more-toggle {
	background: var(--accent);
}

.more-toggle .icon {
	color: var(--text-invert);
	font-size: 24px;
	line-height: 1;
}

.input {
	flex: 1;
	height: 36px;
	background: var(--paper);
	border-radius: 18px;
	padding: 0 16px;
	font-size: 14px;
	color: var(--ink);
}

.send-btn {
	padding: 0 20px;
	height: 36px;
	background: var(--accent);
	color: var(--text-invert);
	border-radius: 18px;
	font-size: 14px;
	flex-shrink: 0;
}

.more-actions {
	width: 100%;
	padding: 4px 0 2px;
}

.menu-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 10px;
}

.menu-item {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
	padding: 4px 0;
}

.menu-icon {
	width: 56px;
	height: 56px;
	background: var(--paper);
	border-radius: 12px;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
	font-size: 28px;
}

.menu-text {
	font-size: 12px;
	color: var(--ink2);
}
</style>
