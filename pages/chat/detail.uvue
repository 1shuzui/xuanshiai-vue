<template>
	<view class="chat-page">
		<!-- 消息列表 -->
		<scroll-view
			class="message-list"
			scroll-y
			:scroll-into-view="scrollToView"
			scroll-with-animation
		>
			<view class="message-item" v-for="(msg, index) in messages" :key="index" :id="'msg-' + index">
				<!-- 时间线 -->
				<view class="time-divider" v-if="msg.showTime">
					<text class="time-text">{{ msg.time }}</text>
				</view>

				<!-- 消息内容 -->
				<view
					class="message-wrapper"
					:class="msg.isMine ? 'mine' : 'other'"
				>
					<!-- 对方头像 -->
					<image
						class="avatar"
						:src="msg.avatar"
						mode="aspectFill"
						v-if="!msg.isMine"
					></image>

					<!-- 消息气泡 -->
					<view class="message-bubble" :class="msg.type" @longpress.stop="handleChatMessageLongPress(msg)">
						<!-- 文本消息 -->
						<text class="text-content" v-if="msg.type === 'text'">{{ msg.content }}</text>

						<!-- 图片消息 -->
						<image
							class="image-content"
							:src="msg.content"
							mode="aspectFill"
							@click="previewImage(msg.content)"
							v-if="msg.type === 'image'"
						></image>

						<!-- 语音消息 -->
						<view class="voice-content" v-if="msg.type === 'voice'">
							<text class="icon">🔊</text>
							<text class="duration">{{ msg.duration }}''</text>
						</view>

						<!-- 联系方式交换申请 -->
						<view
							class="wechat-request-card"
							:class="msg.requestStatus"
							v-if="isContactRequestType(msg.type)"
						>
							<view class="wechat-request-head">
								<view class="wechat-request-mark">
									<view class="request-bubble request-bubble-main"></view>
									<view class="request-bubble request-bubble-small"></view>
								</view>
								<text class="wechat-request-title">{{ getContactRequestTitle(msg) }}</text>
							</view>
							<text class="wechat-request-copy">{{ getContactRequestCopy(msg) }}</text>
							<view class="wechat-contact" v-if="msg.requestStatus === 'accepted'">
								<text class="wechat-contact-label">{{ getContactLabel(msg) }}</text>
								<text class="wechat-contact-value">{{ formatContactValue(msg) }}</text>
							</view>
							<view class="wechat-request-footer">
								<view
									class="wechat-request-actions"
									v-if="!msg.isMine && msg.requestStatus === 'pending'"
								>
									<button class="request-action request-reject" @click.stop="respondContactRequest(msg, 'reject')">拒绝</button>
									<button class="request-action request-accept" @click.stop="respondContactRequest(msg, 'accept')">同意</button>
								</view>
								<button
									class="request-action request-copy"
									v-else-if="msg.requestStatus === 'accepted'"
									@click.stop="copyContactValue(msg)"
								>{{ getCopyButtonText(msg) }}</button>
								<view class="wechat-request-status" v-else>
									<view class="request-status-dot" :class="msg.requestStatus"></view>
									<text>{{ getContactRequestStatusText(msg) }}</text>
								</view>
							</view>
						</view>
					</view>

					<!-- 我的头像 -->
					<image
						class="avatar"
						:src="msg.avatar"
						mode="aspectFill"
						v-if="msg.isMine"
					></image>
				</view>
			</view>
		</scroll-view>

		<!-- 输入栏 -->
		<view class="input-bar">
			<view class="input-wrapper">
				<button class="tool-btn voice-tool-btn" @click="sendVoice">
					<view class="voice-mic">
						<view class="voice-mic-head"></view>
						<view class="voice-mic-bracket"></view>
						<view class="voice-mic-stem"></view>
						<view class="voice-mic-base"></view>
					</view>
				</button>
				<input
					class="input"
					type="text"
					:value="inputText"
					@input="onInput"
					placeholder="说点什么..."
					confirm-type="send"
					@confirm="sendMessage"
				/>
				<button class="tool-btn" @click="showMoreMenu">
					<text class="icon">+</text>
				</button>
				<button class="send-btn" @click="sendMessage">发送</button>
			</view>
		</view>

		<!-- 更多功能菜单 -->
		<XsaSheet :visible="revokeVisible" :show-handle="false" @close="closeRevokeSheet">
			<view class="chat-message-actions">
				<XsaButton variant="primary" size="medium" @click="revokeSelectedMessage">撤回</XsaButton>
				<XsaButton variant="secondary" size="medium" @click="closeRevokeSheet">取消</XsaButton>
			</view>
		</XsaSheet>

		<view class="more-menu" v-if="showMore" @click="closeMoreMenu">
			<view class="menu-content" @click.stop>
				<view class="menu-grid">
					<view class="menu-item" @click="chooseImage">
						<view class="menu-icon menu-icon-album">
							<view class="album-card album-card-back"></view>
							<view class="album-card album-card-front">
								<view class="album-sun"></view>
								<view class="album-hill"></view>
							</view>
						</view>
						<text class="menu-text">相册</text>
					</view>
					<view class="menu-item" @click="takePhoto">
						<view class="menu-icon menu-icon-camera">
							<view class="camera-top"></view>
							<view class="camera-body">
								<view class="camera-lens"></view>
							</view>
						</view>
						<text class="menu-text">拍照</text>
					</view>
					<view
						class="menu-item"
						:class="{ disabled: wechatExchangeDisabled }"
						@click="requestWechatExchange"
					>
						<view class="menu-icon menu-icon-wechat">
							<view class="chat-bubble chat-bubble-main">
								<view class="chat-dot"></view>
								<view class="chat-dot"></view>
								<view class="chat-dot"></view>
							</view>
							<view class="chat-bubble chat-bubble-small"></view>
						</view>
						<text class="menu-text">交换微信</text>
					</view>
					<view
						class="menu-item"
						:class="{ disabled: phoneExchangeDisabled }"
						@click="requestPhoneExchange"
					>
						<view class="menu-icon menu-icon-phone">
							<view class="mobile-phone">
								<view class="mobile-speaker"></view>
								<view class="mobile-screen"></view>
								<view class="mobile-home"></view>
							</view>
						</view>
						<text class="menu-text">交换电话</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 导入 API
	import {
		getChatMessages,
		sendMessage as sendMessageApi,
		handleContactExchangeRequest
	} from '@/api';
	import XsaButton from '@/components/XsaButton.uvue';
	import XsaSheet from '@/components/XsaSheet.uvue';

	const CONTACT_EXCHANGE_RECORDS_KEY = 'xsa-contact-exchange-records'
	const CONTACT_EXCHANGE_DAILY_KEY = 'xsa-contact-exchange-daily'

	// 消息列表（改为空数组）
		let messages = ref([])

		let inputText = ref('')
		let showMore = ref(false)
		let revokeVisible = ref(false)
		let selectedChatMessage = ref<any>(null)
		let scrollToView = ref('')
		let loading = ref(false)
		let userId = ref(0)
		let peerAvatar = ref('/static/portraits/profile-woman-main.jpg')
		let contactExchangeRecords = ref([] as any[])
		let contactExchangeDailyKeys = ref([] as any[])

		const wechatExchangeDisabled = computed(() => {
			return isContactExchangeDisabled('wechat')
		})

		const phoneExchangeDisabled = computed(() => {
			return isContactExchangeDisabled('phone')
		})

		const isContactExchangeDisabled = (contactType: string): boolean => {
			const dailyKey = `${contactType}:${userId.value}:${getDateKey()}`
			if (contactExchangeDailyKeys.value.indexOf(dailyKey) >= 0) return true
			const list = messages.value as any[]
			for (let index = 0; index < list.length; index++) {
				const message = list[index]
				if (
					isContactRequestType(message.type) &&
					message.contactType === contactType &&
					message.isMine === true &&
					message.requestDate === getDateKey()
				) return true
			}
			return false
		};

	// 页面加载时获取数据
	onMounted(() => {
		// 获取 URL 参数中的 userId
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		if (options && options.userName) {
			uni.setNavigationBarTitle({
				title: decodeURIComponent(options.userName)
			})
		}
		if (options && options.userId) {
			userId.value = parseInt(options.userId)
			loadContactExchangeState()
			loadChatMessages()
		}
	})

		// 加载聊天记录
		const loadChatMessages = async () => {
			try {
				loading.value = true
				const res = await getChatMessages(userId.value)
				if (res.success) {
					const list = res.data as any[]
					if (list.length > 0) {
						const firstOther = list.find((m: any) => m.isMine != true)
						if (firstOther != null && firstOther.senderAvatar != null) {
							peerAvatar.value = firstOther.senderAvatar
						}
					}
					const mapped = list.map((msg: any, idx: number) => ({
						id: msg.id,
						type: msg.type,
						content: msg.content,
						time: msg.timeLabel != null ? msg.timeLabel : formatTime(msg.time),
						showTime: msg.showTime == true || idx == 0,
						isMine: msg.isMine,
						avatar: msg.senderAvatar,
						requestStatus: msg.requestStatus != null ? msg.requestStatus : 'pending',
						contactType: msg.contactType != null ? msg.contactType : (msg.type === 'phone-request' ? 'phone' : 'wechat'),
						contactValue: msg.contactValue != null ? msg.contactValue : '',
						requestDate: msg.requestDate != null ? msg.requestDate : getDateKey(msg.time)
					}))
					const records = contactExchangeRecords.value as any[]
					records.forEach((record: any) => {
						if (record.userId != userId.value) return
						const existing = mapped.find((item: any) => item.id == record.id && isContactRequestType(item.type))
						if (existing != null) {
							if (existing.requestStatus === 'pending' && record.requestStatus !== 'pending') {
								existing.requestStatus = record.requestStatus
							}
							if ((existing.contactValue == null || existing.contactValue.length == 0) && record.contactValue != null) {
								existing.contactValue = record.contactValue
							}
						} else {
							mapped.push({
								id: record.id,
								type: record.type,
								content: record.content,
								time: record.time,
								showTime: false,
								isMine: record.isMine,
								avatar: record.avatar,
								requestStatus: record.requestStatus,
								contactType: record.contactType,
								contactValue: record.contactValue,
								requestDate: record.requestDate
							})
						}
					})
					messages.value = mapped
					scrollToBottom()
				}
			} catch (error) {
				console.error('获取聊天记录失败', error)
			} finally {
				loading.value = false
			}
		}

	// 格式化时间
	const formatTime = (timestamp: number): string => {
		const date = new Date(timestamp)
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}

	const getDateKey = (timestamp: number = Date.now()): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		return `${year}-${month}-${day}`
	}

	const isContactRequestType = (type: string): boolean => {
		return type === 'wechat-request' || type === 'phone-request'
	}

	const loadContactExchangeState = () => {
		try {
			const records = uni.getStorageSync(CONTACT_EXCHANGE_RECORDS_KEY)
			if (Array.isArray(records)) contactExchangeRecords.value = records as any[]
			const dailyKeys = uni.getStorageSync(CONTACT_EXCHANGE_DAILY_KEY)
			if (Array.isArray(dailyKeys)) contactExchangeDailyKeys.value = dailyKeys as any[]
		} catch (error) {
			contactExchangeRecords.value = []
			contactExchangeDailyKeys.value = []
		}
	}

	const persistContactRequest = (message: any) => {
		const records = contactExchangeRecords.value as any[]
		const index = records.findIndex((item: any) => item.userId == userId.value && item.id == message.id)
		const record = {
			userId: userId.value,
			id: message.id,
			type: message.type,
			content: message.content,
			time: message.time,
			isMine: message.isMine,
			avatar: message.avatar,
			requestStatus: message.requestStatus,
			contactType: message.contactType,
			contactValue: message.contactValue,
			requestDate: message.requestDate
		}
		if (index >= 0) {
			records[index] = record
		} else {
			records.push(record)
		}
		contactExchangeRecords.value = records.slice()
		try {
			uni.setStorageSync(CONTACT_EXCHANGE_RECORDS_KEY, contactExchangeRecords.value)
		} catch (error) {
			console.error(error)
		}
	}

	const markContactRequestSentToday = (contactType: string) => {
		const key = `${contactType}:${userId.value}:${getDateKey()}`
		if (contactExchangeDailyKeys.value.indexOf(key) < 0) {
			contactExchangeDailyKeys.value.push(key)
			contactExchangeDailyKeys.value = contactExchangeDailyKeys.value.slice()
			try {
				uni.setStorageSync(CONTACT_EXCHANGE_DAILY_KEY, contactExchangeDailyKeys.value)
			} catch (error) {
				console.error(error)
			}
		}
	}

	const releaseContactRequestAfterRevoke = (message: any) => {
		if (!isContactRequestType(message.type) || message.isMine !== true) return
		contactExchangeRecords.value = (contactExchangeRecords.value as any[]).filter((record: any) => {
			return record.userId != userId.value || record.id != message.id
		})
		const contactType = message.contactType != null
			? message.contactType.toString()
			: (message.type === 'phone-request' ? 'phone' : 'wechat')
		const requestDate = message.requestDate != null ? message.requestDate.toString() : getDateKey()
		const dailyKey = `${contactType}:${userId.value}:${requestDate}`
		contactExchangeDailyKeys.value = (contactExchangeDailyKeys.value as any[]).filter((key: any) => key != dailyKey)
		try {
			uni.setStorageSync(CONTACT_EXCHANGE_RECORDS_KEY, contactExchangeRecords.value)
			uni.setStorageSync(CONTACT_EXCHANGE_DAILY_KEY, contactExchangeDailyKeys.value)
		} catch (error) {
			console.error(error)
		}
	}

	// 输入事件
	const onInput = (e: InputEvent) => {
		inputText.value = e.detail.value
	}

	// 发送消息
	const sendMessage = async () => {
		if (!inputText.value.trim()) {
			return
		}

		const content = inputText.value
			const newMsg = {
				id: Date.now(),
				type: 'text',
				content: content,
				time: getCurrentTime(),
				showTime: false,
				isMine: true,
				avatar: '/static/portraits/profile-man-light.jpg'
			}

			// 立即添加到界面
			messages.value.push(newMsg)
			inputText.value = ''
			scrollToBottom()

			// 调用发送消息接口
			try {
				const res = await sendMessageApi(userId.value, content, 'text')
				if (res.success) {
					if (res.data != null && res.data.messageId != null) {
						newMsg.id = res.data.messageId
					}
					// 高保真演示：自动回复
					setTimeout(() => {
						const replies = ['听起来不错！', '我也这么觉得。', '有道理，我们可以约个时间详细聊聊。', '好的，期待和你见面。', '这个想法很棒！']
						const i = Math.floor(Math.random() * replies.length)
						messages.value.push({
							id: Date.now() + 1,
							type: 'text',
							content: replies[i],
							time: getCurrentTime(),
							showTime: false,
							isMine: false,
							avatar: peerAvatar.value
						})
						scrollToBottom()
					}, 1600)
				}
			} catch (error) {
				console.error('发送消息失败', error)
				uni.showToast({
					title: '发送失败',
					icon: 'none'
				})
			}
		}

	// 预览图片
	const previewImage = (url: string) => {
		const images = messages.value
			.filter(msg => msg.type === 'image')
			.map(msg => msg.content)

		uni.previewImage({
			current: url,
			urls: images
		})
	}

	// 显示更多菜单
	const showMoreMenu = () => {
		showMore.value = true
	}

	// 关闭更多菜单
	const closeMoreMenu = () => {
		showMore.value = false
	}

	const handleChatMessageLongPress = (message: any) => {
		if (message == null || message.isMine !== true) return
		selectedChatMessage.value = message
		revokeVisible.value = true
	}

	const closeRevokeSheet = () => {
		revokeVisible.value = false
		selectedChatMessage.value = null
	}

	const revokeSelectedMessage = () => {
		if (selectedChatMessage.value == null) return
		const selectedMessage = selectedChatMessage.value
		const messageId = selectedMessage.id
		const isContactRequest = isContactRequestType(selectedMessage.type)
		releaseContactRequestAfterRevoke(selectedMessage)
		messages.value = (messages.value as any[]).filter((message: any) => message.id != messageId)
		closeRevokeSheet()
		uni.showToast({
			title: isContactRequest ? '申请已撤回，可重新发送' : '消息已撤回',
			icon: 'none'
		})
	}

	// 选择图片
	const chooseImage = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album'],
			success: (res) => {
				const newMsg = {
					id: messages.value.length + 1,
					type: 'image',
					content: res.tempFilePaths[0],
					time: getCurrentTime(),
					showTime: false,
					isMine: true,
					avatar: '/static/portraits/profile-man-light.jpg'
				}
				messages.value.push(newMsg)
				scrollToBottom()
				closeMoreMenu()
				// TODO: 上传图片并发送
			}
		})
	}

	// 拍照
	const takePhoto = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['camera'],
			success: (res) => {
				const newMsg = {
					id: messages.value.length + 1,
					type: 'image',
					content: res.tempFilePaths[0],
					time: getCurrentTime(),
					showTime: false,
					isMine: true,
					avatar: '/static/portraits/profile-man-light.jpg'
				}
				messages.value.push(newMsg)
				scrollToBottom()
				closeMoreMenu()
			}
		})
	}

	// 发送语音
	const sendVoice = () => {
		uni.showToast({
			title: '长按录音',
			icon: 'none'
		})
	}

	const requestContactExchange = async (contactType: string) => {
		if (isContactExchangeDisabled(contactType)) return
		const contactName = contactType === 'phone' ? '电话' : '微信'
		const requestMessage: any = {
			id: Date.now(),
			type: `${contactType}-request`,
			content: `您已向对方发起交换${contactName}申请，等待对方确认…`,
			requestStatus: 'pending',
			contactType: contactType,
			contactValue: '',
			requestDate: getDateKey(),
			time: getCurrentTime(),
			showTime: false,
			isMine: true,
			avatar: '/static/portraits/profile-man-light.jpg'
		}
		messages.value.push(requestMessage)
		closeMoreMenu()
		scrollToBottom()
		try {
			const res = await sendMessageApi(userId.value, requestMessage.content, `${contactType}-request`)
			if (!res.success) {
				messages.value = (messages.value as any[]).filter((item: any) => item.id != requestMessage.id)
				uni.showToast({ title: '申请发送失败，请重试', icon: 'none' })
				return
			}
			if (res.data != null && res.data.messageId != null) {
				requestMessage.id = res.data.messageId
			}
			markContactRequestSentToday(contactType)
			persistContactRequest(requestMessage)
		} catch (error) {
			messages.value = (messages.value as any[]).filter((item: any) => item.id != requestMessage.id)
			uni.showToast({ title: '申请发送失败，请重试', icon: 'none' })
		}
	}

	const requestWechatExchange = () => {
		requestContactExchange('wechat')
	}

	const requestPhoneExchange = () => {
		requestContactExchange('phone')
	}

	const getContactRequestTitle = (message: any): string => {
		return message.contactType === 'phone' ? '交换电话申请' : '交换微信申请'
	}

	const getContactRequestCopy = (message: any): string => {
		const contactName = message.contactType === 'phone' ? '电话' : '微信'
		if (message.requestStatus === 'accepted') return `已成功交换${contactName}`
		if (message.requestStatus === 'rejected') {
			return message.isMine ? `对方已拒绝交换${contactName}申请` : `已拒绝交换${contactName}申请`
		}
		return message.isMine
			? `您已向对方发起交换${contactName}申请，等待对方确认…`
			: `对方申请与您交换${contactName}`
	}

	const getContactRequestStatusText = (message: any): string => {
		if (message.requestStatus === 'rejected') return message.isMine ? '对方已拒绝' : '已拒绝'
		return '等待确认'
	}

	const formatContactValue = (message: any): string => {
		const value = message.contactValue != null ? message.contactValue.toString() : ''
		if (message.contactType === 'phone' && value.length >= 7) {
			return `${value.slice(0, 3)}****${value.slice(value.length - 4)}`
		}
		return value
	}

	const getContactLabel = (message: any): string => {
		return message.contactType === 'phone' ? '对方电话' : '对方微信号'
	}

	const getCopyButtonText = (message: any): string => {
		return message.contactType === 'phone' ? '复制电话' : '复制微信号'
	}

	const copyContactValue = (message: any) => {
		if (message.requestStatus !== 'accepted' || message.contactValue == null || message.contactValue.length == 0) return
		uni.setClipboardData({
			data: message.contactValue,
			success: () => {
				uni.showToast({ title: `${message.contactType === 'phone' ? '电话' : '微信号'}已复制`, icon: 'none' })
			}
		})
	}

	const respondContactRequest = async (message: any, action: string) => {
		if (message.requestStatus !== 'pending') return
		const previousStatus = message.requestStatus
		const previousContactValue = message.contactValue
		message.requestStatus = action === 'accept' ? 'accepted' : 'rejected'
		messages.value = (messages.value as any[]).slice()
		try {
			const res = await handleContactExchangeRequest(message.id, action, message.contactType)
			if (!res.success) {
				message.requestStatus = previousStatus
				messages.value = (messages.value as any[]).slice()
				uni.showToast({ title: '操作失败，请重试', icon: 'none' })
				return
			}
			if (action === 'accept') {
				if (res.data != null && res.data.contactValue != null) {
					message.contactValue = res.data.contactValue
				} else if (message.contactValue == null || message.contactValue.length == 0) {
					message.contactValue = message.contactType === 'phone' ? '13812341234' : 'wanqing_art'
				}
			}
			persistContactRequest(message)
			uni.showToast({
				title: action === 'accept' ? '已同意交换申请' : '已拒绝交换申请',
				icon: 'none'
			})
		} catch (error) {
			message.requestStatus = previousStatus
			message.contactValue = previousContactValue
			messages.value = (messages.value as any[]).slice()
			uni.showToast({ title: '操作失败，请重试', icon: 'none' })
		}
	}

	// 滚动到底部
	const scrollToBottom = () => {
		setTimeout(() => {
			scrollToView.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	// 获取当前时间
	const getCurrentTime = (): string => {
		const now = new Date()
		const hours = now.getHours().toString().padStart(2, '0')
		const minutes = now.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}
</script>

