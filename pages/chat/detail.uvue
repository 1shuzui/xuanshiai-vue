		flex-shrink: 0;
	}

	.tool-btn .icon { font-size: 20px; color: var(--ink2); }
	.more-toggle { background: var(--accent); }
	.more-toggle .icon { color: var(--text-invert); font-size: 24px; line-height: 1; }

	.input {
		flex: 1;
		height: 36px;
		background: var(--paper);
		border-radius: 18px;
		padding: 0 16px;
		font-size: 14px;
		color: var(--ink);
	}

	.send-btn {
		padding: 0 20px;
		height: 36px;
		background: var(--accent);
		color: var(--text-invert);
		border-radius: 18px;
		font-size: 14px;
		flex-shrink: 0;
	}

	.send-btn[disabled] { opacity: 0.5; }
	.more-actions { width: 100%; padding: 4px 0 2px; }
	.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
	.menu-item { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 4px 0; }

	.menu-icon {
		width: 56px;
		height: 56px;
		background: var(--paper);
		border-radius: 8px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		font-size: 28px;
	}

		.menu-text { font-size: 12px; color: var(--ink2); }

		.chat-page.parent-mode .state-title { font-size: 20px; }

		.chat-page.parent-mode .state-desc,
		.chat-page.parent-mode .time-text,
		.chat-page.parent-mode .message-status,
		.chat-page.parent-mode .protected-avatar-text,
		.chat-page.parent-mode .protected-content-text,
		.chat-page.parent-mode .menu-text {
			font-size: 14px;
