	onShow(() => {
		if (!isPaperPlaneConversation.value && userId.value > 0) verifyChatPermission()
	})

	onUnmounted(() => {
		if (voiceRecorder != null && voiceRecording.value) {
			discardVoiceRecording = true
			voiceRecorder.stop()
		}
		voiceRecording.value = false
	})

	const loadPaperPlaneMessages = async () => {
		if (!isPaperPlaneConversation.value) return
		loading.value = true
		chatError.value = ''
		try {
			await readPaperPlaneConversation(paperPlaneConversationId.value)
			const res = await getPaperPlaneMessages(paperPlaneConversationId.value)
			if (res == null || res.success != true || !Array.isArray(res.data)) {
				chatError.value = responseMessage(res, '纸飞机会话加载失败')
				return
			}
			messages.value = (res.data as any[]).map((item: any, index: number) => ({
				id: item.id,
				type: item.type == 3 ? 'voice' : 'text',
				content: item.type == 3 && item.mediaUrl != null ? '' + item.mediaUrl : '' + item.content,
				time: item.timeText != null ? '' + item.timeText : '',
				showTime: index == 0,
				isMine: item.mine == true,
				avatar: item.mine == true ? '/static/portraits/profile-man-light.jpg' : '/static/portraits/profile-woman-main.jpg',
				status: 'sent',
				isPaperPlane: true
			}))
			scrollToBottom()
		} catch (error) {
			chatError.value = '纸飞机会话加载失败'
		} finally {
			loading.value = false
		}
	}

	const retryHistory = () => {
		if (isPaperPlaneConversation.value) {
			loadPaperPlaneMessages()
			return
		}
		loadChatMessages()
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.message != null && res.message != 'success') return '' + res.message
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		return fallback
	}

	const subjectKey = (subject: MessageSubject | null): string => {
		if (subject == null) return ''
		if (subject.mode == 'parent') return 'parent-' + (subject.childId != null ? subject.childId : 0)
		return 'self'
	}

	const clearChatSensitiveState = (
		message: string = '',
		clearSubject: boolean = true,
		preservePermissionRequest: boolean = false
	) => {
		roleAccessEpoch += 1
		roleAccessRequest = null
		roleAccessRequestEpoch = -1
		chatMutationVersion.value += 1
		historyRequestSequence += 1
		if (!preservePermissionRequest) permissionRequestSequence += 1
		messages.value = []
		inputText.value = ''
		showMore.value = false
		scrollToView.value = ''
		loading.value = false
		chatError.value = ''
		chatAllowed.value = false
			reportVisible.value = false
			contactVisible.value = false
			contactLoading.value = false
			contactSubmitting.value = false
			contactError.value = ''
			contactValue.value = ''
			contactExchanges.value = []
			sendingText.value = false
		activeTextSendAttempt = 0
		permissionLoading.value = false
		if (clearSubject) {
			activeMessageSubject.value = null
			activeParentContext.value = null
		}
		if (message != '') permissionError.value = message
	}

	const activateMessageSubject = (subject: MessageSubject) => {
		const previousKey = subjectKey(activeMessageSubject.value)
		const nextKey = subjectKey(subject)
		if (previousKey != '' && previousKey != nextKey) clearChatSensitiveState('', true, true)
		activeMessageSubject.value = subject
	}

	const isUnauthorizedResponse = (res: any): boolean => {
		if (res == null) return false
		if (res.code != null && String(res.code) == '401') return true
		return res.data != null && res.data.code != null && String(res.data.code) == '401'
	}

	const handleSubjectUnauthorizedResponse = (res: any, requestSubjectKey: string): boolean => {
		if (!isUnauthorizedResponse(res)) return false
		if (requestSubjectKey != subjectKey(activeMessageSubject.value)) return false
		clearChatSensitiveState(responseMessage(res, '登录状态已失效，请重新登录'), true)
		return true
	}

	const fetchParentRoleAccess = async (requestEpoch: number): Promise<boolean> => {
		try {
			const contextRes = await getParentContext()
			if (requestEpoch != roleAccessEpoch) return false
			const latestStoredMode = uni.getStorageSync('xsa_onboarding_mode')
			if (latestStoredMode == null || String(latestStoredMode) != 'parent') {
				clearChatSensitiveState('当前账号已切换身份，请重新进入会话', true)
				return false
			}
			if (contextRes == null || contextRes.success != true || contextRes.data == null) {
				clearChatSensitiveState(responseMessage(contextRes, '暂时无法确认父母端访问权限'), true)
				return false
			}
			const context = contextRes.data as ParentContext
			const gate = getParentAccessGate(context)
			if (gate == null || gate.allowed != true) {
				const message = gate != null && gate.message != null
					? '' + gate.message
					: '父母端访问条件已失效'
				clearChatSensitiveState(message, true)
				return false
			}
			if (context.child == null) {
				clearChatSensitiveState('请先取得子女授权', true)
				return false
			}
			const childId = Number(context.child.id)
			if (!Number.isFinite(childId) || Math.floor(childId) != childId || childId <= 0) {
				clearChatSensitiveState('授权子女主体无效', true)
				return false
			}
			activateMessageSubject({ mode: 'parent', childId: childId } as MessageSubject)
			activeParentContext.value = context
			return true
		} catch (error) {
			if (requestEpoch != roleAccessEpoch) return false
			clearChatSensitiveState('暂时无法确认父母端访问权限', true)
			return false
		}
	}

	const confirmRoleAccess = async (): Promise<boolean> => {
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode == null || String(storedMode) != 'parent') {
			roleMode.value = 'self'
			activateMessageSubject({ mode: 'self' } as MessageSubject)
			activeParentContext.value = null
			return true
		}
		roleMode.value = 'parent'
		const requestEpoch = roleAccessEpoch
		const existingRequest = roleAccessRequest
		if (existingRequest != null && roleAccessRequestEpoch == requestEpoch) {
			return await existingRequest
		}
		const request = fetchParentRoleAccess(requestEpoch)
		roleAccessRequest = request
		roleAccessRequestEpoch = requestEpoch
		try {
			return await request
		} finally {
			if (roleAccessRequest == request) {
				roleAccessRequest = null
				roleAccessRequestEpoch = -1
			}
		}
	}

