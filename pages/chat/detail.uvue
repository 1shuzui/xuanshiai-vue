			// #ifdef MP-WEIXIN
			if (voiceRecorder == null) {
				uni.showToast({ title: '录音功能暂不可用', icon: 'none' })
				return
			}
			if (voiceRecording.value) {
				voiceRecorder.stop()
			} else {
				discardVoiceRecording = false
				voiceRecording.value = true
				voiceRecorder.start({ duration: 60000, format: 'mp3' })
