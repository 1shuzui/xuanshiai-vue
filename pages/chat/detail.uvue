		}

		const resolveCurrentMessageSubject = async (): Promise<MessageSubject | null> => {
			const storedMode = uni.getStorageSync('xsa_onboarding_mode')
			if (storedMode == null || String(storedMode) != 'parent') {
				isParentMode.value = false
				activeParentContext.value = null
				activeMessageSubject.value = { mode: 'self' } as MessageSubject
				return activeMessageSubject.value
			}

