	const isProtectedMediaMessage = (message: any): boolean => {
		if (!isParentMode.value || message == null) return false
		if (message.protectedContent == true) return true
		const type = message.type != null ? String(message.type).toLowerCase() : ''
		if (type != '' && type != 'text') return true
		if (message.content != null && typeof message.content != 'string') return true
		if (typeof message.content == 'string') {
			const content = message.content.trim().toLowerCase()
			if (
				content.indexOf('://') >= 0 ||
				content.indexOf('data:') == 0 ||
				content.indexOf('blob:') == 0 ||
				content.indexOf('file:') == 0 ||
				content.indexOf('wxfile:') == 0 ||
				content.indexOf('/') == 0 ||
				content.indexOf('./') == 0 ||
				content.indexOf('../') == 0 ||
				content.indexOf('private/') == 0 ||
				content.indexOf('media/') == 0 ||
				content.indexOf('images/') == 0 ||
				content.indexOf('photos/') == 0 ||
				content.indexOf('uploads/') == 0 ||
				content.indexOf('assets/') == 0 ||
				content.indexOf('static/') == 0
			) return true
		}
		return message.imageUrl != null ||
			message.fileUrl != null ||
			message.attachmentUrl != null ||
			message.mediaUrl != null ||
			message.preview != null ||
			message.previewUrl != null ||
			message.cover != null ||
			message.coverUrl != null ||
			message.poster != null ||
			message.posterUrl != null ||
			message.attachment != null ||
			message.attachments != null ||
			message.media != null
	}

	const isHistoryRequestCurrent = (
		requestId: number,
		requestVersion: number,
		requestSubjectKey: string
	): boolean => {
		return requestId == historyRequestSequence &&
			requestVersion == chatMutationVersion.value &&
			requestSubjectKey == subjectKey(activeMessageSubject.value)
	}

	const loadChatMessages = async (force: boolean = false): Promise<boolean> => {
		if (!chatAllowed.value || (!force && loading.value)) return false
		if (force) loading.value = false
		const requestId = historyRequestSequence + 1
		historyRequestSequence = requestId
		if (!await confirmRoleAccess()) {
			if (requestId == historyRequestSequence) chatAllowed.value = false
			return false
		}
		if (requestId != historyRequestSequence || !chatAllowed.value) return false
		const subject = activeMessageSubject.value
		if (subject == null) {
			clearChatSensitiveState('暂时无法确认聊天主体', true)
			return false
		}
		const requestVersion = chatMutationVersion.value
		const requestSubjectKey = subjectKey(subject)
		loading.value = true
		chatError.value = ''
		try {
			const res = await getChatMessages(
				userId.value,
				isParentMode.value ? 'protected' : 'standard',
				subject
			)
			if (handleSubjectUnauthorizedResponse(res, requestSubjectKey)) return false
			if (!isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) return false
			if (res == null || res.success != true || res.data == null) {
				const message = responseMessage(res, '聊天记录加载失败')
				if (res != null && res.code == 'CHAT_NOT_ALLOWED') {
					clearChatSensitiveState(message, false)
					return false
				}
				throw new Error(message)
			}
			const list = res.data as any[]
			const serverMessages = list.map((message: any, index: number) => {
				const protectedContent = isProtectedMediaMessage(message)
				return {
					id: message.id,
					clientMessageId: message.clientMessageId,
					type: message.type,
					content: protectedContent ? '' : message.content,
					time: message.timeLabel != null ? message.timeLabel : formatTime(message.time),
					showTime: message.showTime == true || index == 0,
					isMine: message.isMine,
					avatar: isParentMode.value ? '' : (message.senderAvatar != null ? message.senderAvatar : message.avatar),
					protectedContent: protectedContent,
					revoked: message.revoked == true,
					status: message.isMine == true ? 'sent' : '',
					subjectKey: requestSubjectKey
				}
			})
			const unsentLocal = messages.value.filter((message: any) => {
				return message.isMine == true &&
					message.clientMessageId != null &&
					message.clientMessageId != '' &&
					message.status != 'sent' &&
					message.subjectKey == requestSubjectKey
			})
			unsentLocal.forEach((message: any) => {
				const exists = serverMessages.some((serverMessage: any) => {
					return serverMessage.clientMessageId == message.clientMessageId
				})
				if (!exists) {
					serverMessages.push(isParentMode.value
						? { ...message, avatar: '', protectedAvatar: true }
						: message)
				}
			})
			messages.value = serverMessages
			scrollToBottom()
			return true
		} catch (error: any) {
			if (isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) {
				chatError.value = error != null && error.message != null ? '' + error.message : '聊天记录加载失败，请重试'
			}
			return false
		} finally {
			if (isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) loading.value = false
		}
	}

	const formatTime = (timestamp: number): string => {
		const date = new Date(timestamp)
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}

	const onInput = (event: InputEvent) => {
		inputText.value = event.detail.value
	}

	const createClientMessageId = (): string => {
		clientMessageSequence += 1
		return 'chat-' + userId.value + '-' + Date.now() + '-' + clientMessageSequence
	}

	const isDeliveryAttemptCurrent = (
		message: any,
		attemptId: number,
		expectedVersion: number,
		expectedSubjectKey: string
	): boolean => {
		return message.deliveryAttemptId == attemptId &&
			expectedVersion == chatMutationVersion.value &&
			expectedSubjectKey == subjectKey(activeMessageSubject.value)
	}

	const confirmPermissionForSend = async (
		message: any,
		attemptId: number,
		expectedVersion: number,
		expectedSubjectKey: string
	): Promise<boolean> => {
		try {
			if (!await confirmRoleAccess()) {
				if (isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) {
					chatAllowed.value = false
				}
				return false
			}
			if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return false
			const subject = activeMessageSubject.value
			if (subject == null || subjectKey(subject) != expectedSubjectKey) {
				chatAllowed.value = false
				permissionError.value = '聊天主体已变更，请重新进入会话'
				return false
			}
			const res = await getChatPermission(userId.value, subject)
			if (handleSubjectUnauthorizedResponse(res, expectedSubjectKey)) return false
			if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return false
			const permission = res != null ? res.data : null
			if (res != null && res.success == true && permission != null && permission.canChat == true) {
				return true
			}
			chatAllowed.value = false
			permissionError.value = permission != null && permission.reason != null
				? '' + permission.reason
				: '聊天权限已变更，请重新确认'
			clearChatSensitiveState(permissionError.value, false)
			return false
		} catch (error) {
			if (isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) {
				clearChatSensitiveState('暂时无法确认聊天权限，请重新确认', false)
			}
			return false
		}
	}

