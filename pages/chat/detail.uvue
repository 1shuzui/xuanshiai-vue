	const quoteSelectedMessage = () => {
		if (selectedChatMessage.value == null) return
		const message = selectedChatMessage.value
		quotedMessage.value = {
			id: message.id,
			name: message.isMine === true ? '我' : peerName.value,
			text: getMessageSummary(message)
		}
		closeMessageActionMenu()
	}

	const clearQuote = () => {
		quotedMessage.value = null
	}

	const startMultiSelect = () => {
		if (selectedChatMessage.value == null) return
		const messageId = selectedChatMessage.value.id
		multiSelectMode.value = true
		selectedMessageIds.value = [messageId]
		closeMessageActionMenu()
	}

	const exitMultiSelect = () => {
		multiSelectMode.value = false
		selectedMessageIds.value = []
	}

	const isMessageSelected = (message: any): boolean => {
		return selectedMessageIds.value.indexOf(message.id) >= 0
	}

	const toggleMessageSelection = (message: any) => {
		const index = selectedMessageIds.value.indexOf(message.id)
		if (index >= 0) {
			selectedMessageIds.value.splice(index, 1)
		} else {
			selectedMessageIds.value.push(message.id)
		}
		selectedMessageIds.value = selectedMessageIds.value.slice()
	}

	const handleMessageBubbleClick = (message: any) => {
		if (multiSelectMode.value) toggleMessageSelection(message)
	}

	const handleImageClick = (message: any) => {
		if (multiSelectMode.value) {
			toggleMessageSelection(message)
			return
		}
		previewImage(message.content)
	}

	const preserveContactRequestLimitAfterDelete = (message: any) => {
		if (!isContactRequestType(message.type) || message.isMine !== true) return
		const contactType = message.contactType != null
			? message.contactType.toString()
			: (message.type === 'phone-request' ? 'phone' : 'wechat')
		const requestDate = message.requestDate != null ? message.requestDate.toString() : getDateKey()
		const dailyKey = `${contactType}:${userId.value}:${requestDate}`
		if (contactExchangeDailyKeys.value.indexOf(dailyKey) < 0) {
			contactExchangeDailyKeys.value.push(dailyKey)
		}
	}

	const deleteMessagesByIds = (messageIds: any[]) => {
		const currentMessages = messages.value as any[]
		const removedMessages = currentMessages.filter((message: any) => messageIds.indexOf(message.id) >= 0)
		removedMessages.forEach((message: any) => preserveContactRequestLimitAfterDelete(message))
		contactExchangeRecords.value = (contactExchangeRecords.value as any[]).filter((record: any) => {
			return record.userId != userId.value || messageIds.indexOf(record.id) < 0
		})
		try {
			uni.setStorageSync(CONTACT_EXCHANGE_RECORDS_KEY, contactExchangeRecords.value)
			uni.setStorageSync(CONTACT_EXCHANGE_DAILY_KEY, contactExchangeDailyKeys.value)
		} catch (error) {
			console.error(error)
		}
		messages.value = currentMessages.filter((message: any) => messageIds.indexOf(message.id) < 0)
		if (quotedMessage.value != null && messageIds.indexOf(quotedMessage.value.id) >= 0) {
			quotedMessage.value = null
		}
	}

	const deleteSelectedChatMessage = () => {
		if (selectedChatMessage.value == null) return
		const messageId = selectedChatMessage.value.id
		closeMessageActionMenu()
		deleteMessagesByIds([messageId])
		uni.showToast({ title: '消息已删除', icon: 'none' })
	}

	const deleteMultiSelectedMessages = () => {
		if (selectedMessageIds.value.length == 0) return
		const messageIds = selectedMessageIds.value.slice()
		deleteMessagesByIds(messageIds)
		exitMultiSelect()
		uni.showToast({ title: '已删除选中消息', icon: 'none' })
	}

	const revokeSelectedMessage = () => {
		if (selectedChatMessage.value == null) return
		const selectedMessage = selectedChatMessage.value
		if (!canRevokeMessage(selectedMessage)) return
		const messageId = selectedMessage.id
		releaseContactRequestAfterRevoke(selectedMessage)
		const currentMessages = messages.value as any[]
		const messageIndex = currentMessages.findIndex((message: any) => message.id == messageId)
		if (messageIndex >= 0) {
			currentMessages.splice(messageIndex, 1, {
				id: Date.now(),
				type: 'revoke-notice',
				content: '',
				time: selectedMessage.time,
				showTime: false,
				isMine: true,
				avatar: '',
				editableContent: selectedMessage.content != null ? selectedMessage.content.toString() : '',
				originalQuoteName: selectedMessage.quoteName != null ? selectedMessage.quoteName : '',
				originalQuoteText: selectedMessage.quoteText != null ? selectedMessage.quoteText : ''
			})
			messages.value = currentMessages.slice()
		}
		closeMessageActionMenu()
	}

	const reeditRevokedMessage = (message: any) => {
		if (message == null || message.isMine !== true) return
		inputText.value = message.editableContent != null ? message.editableContent.toString() : ''
		if (message.originalQuoteText != null && message.originalQuoteText.length > 0) {
			quotedMessage.value = {
				id: message.id,
				name: message.originalQuoteName != null ? message.originalQuoteName : '',
				text: message.originalQuoteText
			}
		} else {
			quotedMessage.value = null
		}
		if (multiSelectMode.value) exitMultiSelect()
	}

// 发送语音
	const sendVoice = () => {
		uni.showToast({
			title: '长按录音',
			icon: 'none'
		})
	}

		const requestContactExchange = async (contactType: string) => {
			if (isParentMode.value) return
		if (isContactExchangeDisabled(contactType)) return
		const contactName = contactType === 'phone' ? '电话' : '微信'
		const requestMessage: any = {
			id: Date.now(),
			type: `${contactType}-request`,
			content: `您已向对方发起交换${contactName}申请，等待对方确认…`,
			requestStatus: 'pending',
			contactType: contactType,
			contactValue: '',
			requestDate: getDateKey(),
			time: getCurrentTime(),
			showTime: false,
			isMine: true,
			avatar: '/static/portraits/profile-man-light.jpg'
		}
		messages.value.push(requestMessage)
		updateConversationPreview(userId.value, requestMessage.content, Date.now(), requestMessage.type)
		closeMoreMenu()
		scrollToBottom()
		try {
			const res = await sendMessageApi(
				userId.value,
				requestMessage.content,
				`${contactType}-request`,
				newClientCommandId('contact-request'),
				{ mode: 'self' } as MessageSubject
			)
			if (!res.success) {
				messages.value = (messages.value as any[]).filter((item: any) => item.id != requestMessage.id)
				uni.showToast({ title: '申请发送失败，请重试', icon: 'none' })
				return
			}
			if (res.data != null && res.data.messageId != null) {
				requestMessage.id = res.data.messageId
			}
			markContactRequestSentToday(contactType)
			persistContactRequest(requestMessage)
		} catch (error) {
			messages.value = (messages.value as any[]).filter((item: any) => item.id != requestMessage.id)
			uni.showToast({ title: '申请发送失败，请重试', icon: 'none' })
		}
	}

	const requestWechatExchange = () => {
		requestContactExchange('wechat')
	}

	const requestPhoneExchange = () => {
		requestContactExchange('phone')
	}

	const getContactRequestTitle = (message: any): string => {
		return message.contactType === 'phone' ? '交换电话申请' : '交换微信申请'
	}

	const getContactRequestCopy = (message: any): string => {
		const contactName = message.contactType === 'phone' ? '电话' : '微信'
		if (message.requestStatus === 'accepted') return `已成功交换${contactName}`
		if (message.requestStatus === 'rejected') {
			return message.isMine ? `对方已拒绝交换${contactName}申请` : `已拒绝交换${contactName}申请`
		}
		return message.isMine
			? `您已向对方发起交换${contactName}申请，等待对方确认…`
			: `对方申请与您交换${contactName}`
	}

	const getContactRequestStatusText = (message: any): string => {
		if (message.requestStatus === 'rejected') return message.isMine ? '对方已拒绝' : '已拒绝'
		return '等待确认'
	}

	const formatContactValue = (message: any): string => {
		const value = message.contactValue != null ? message.contactValue.toString() : ''
		if (message.contactType === 'phone' && value.length >= 7) {
			return `${value.slice(0, 3)}****${value.slice(value.length - 4)}`
		}
		return value
	}

	const getContactLabel = (message: any): string => {
		return message.contactType === 'phone' ? '对方电话' : '对方微信号'
	}

	const getCopyButtonText = (message: any): string => {
		return message.contactType === 'phone' ? '复制电话' : '复制微信号'
	}

	const copyContactValue = (message: any) => {
		if (multiSelectMode.value) {
			toggleMessageSelection(message)
			return
		}
		if (message.requestStatus !== 'accepted' || message.contactValue == null || message.contactValue.length == 0) return
		uni.setClipboardData({
			data: message.contactValue,
			success: () => {
				uni.showToast({ title: `${message.contactType === 'phone' ? '电话' : '微信号'}已复制`, icon: 'none' })
			}
		})
	}

	const ensureMatchedConversationAfterExchange = (message: any) => {
		if (message.contactType !== 'wechat') return
		const currentMessages = messages.value as any[]
		const hasConversationContent = currentMessages.some((item: any) => {
					return item.type === 'text' || item.type === 'image' || item.type === 'voice'
		})
		if (hasConversationContent) return
		const result = createMatchedConversation(
			userId.value,
			peerName.value,
			peerAvatar.value,
			'contact-exchange',
			false,
			peerAvatar.value
		)
		if (result.created !== true || result.conversation == null) return
		const greeting = result.conversation.greetingMessage
		messages.value = [{
			id: greeting.id,
			type: 'text',
			content: MATCH_GREETING,
			time: formatTime(greeting.time),
			showTime: false,
			isMine: greeting.isMine === true,
			avatar: greeting.avatar != null && greeting.avatar.length > 0 ? greeting.avatar : peerAvatar.value
		}].concat(currentMessages)
		scrollToBottom()
	}

	const respondContactRequest = async (message: any, action: string) => {
		if (multiSelectMode.value) {
			toggleMessageSelection(message)
			return
		}
		if (message.requestStatus !== 'pending') return
		const previousStatus = message.requestStatus
		const previousContactValue = message.contactValue
		message.requestStatus = action === 'accept' ? 'accepted' : 'rejected'
		messages.value = (messages.value as any[]).slice()
		try {
			const res = await handleContactExchangeRequest(
				message.id,
				action,
				newClientCommandId('contact-response'),
				{ mode: 'self' } as MessageSubject
			)
			if (!res.success) {
				message.requestStatus = previousStatus
				messages.value = (messages.value as any[]).slice()
				uni.showToast({ title: '操作失败，请重试', icon: 'none' })
				return
			}
			if (action === 'accept') {
				if (res.data != null && res.data.contactValue != null) {
					message.contactValue = res.data.contactValue
				} else if (message.contactValue == null || message.contactValue.length == 0) {
					message.contactValue = message.contactType === 'phone' ? '13812341234' : 'wanqing_art'
>>>>>>> sync/upstream-main-751a9f4
				}
				contactValue.value = ''
				await loadContactExchanges()
			} finally {
				contactSubmitting.value = false
			}
		}

		const respondToContactExchange = async (exchange: any, action: string) => {
			if (contactSubmitting.value || exchange == null || isParentMode.value) return
			const subject = activeMessageSubject.value
			if (subject == null) return
			contactSubmitting.value = true
			contactError.value = ''
			try {
				const res = await respondContactExchange(Number(exchange.id), action, contactCommandId(action, Number(exchange.id)), subject)
				if (res == null || res.success != true) {
					contactError.value = responseMessage(res, '联系方式请求处理失败')
					return
				}
				await loadContactExchanges()
			} finally {
				contactSubmitting.value = false
			}
		}

		const copyContactValue = (value: string) => {
			uni.setClipboardData({ data: value, success: () => uni.showToast({ title: '已复制', icon: 'success' }) })
		}

		const requestRevokeMessage = (message: any) => {
			if (isParentMode.value || message == null || message.id <= 0 || message.revoked == true) return
			uni.showModal({
				title: '撤回消息',
				content: '撤回后对方将看到“消息已撤回”。',
				confirmText: '确认撤回',
				success: async (result: any) => {
					if (result == null || result.confirm != true) return
					const subject = activeMessageSubject.value
					if (subject == null) return
					const res = await revokeMessage(Number(message.id), 'revoke-' + message.id + '-' + Date.now(), subject)
					if (res != null && res.success == true) {
						message.revoked = true
						message.type = 'text'
						message.content = '消息已撤回'
						return
					}
					uni.showToast({ title: responseMessage(res, '撤回失败，请重试'), icon: 'none' })
				}
			})
		}

		const previewImage = (url: string) => {
		const images = messages.value
			.filter((message: any) => message.type === 'image')
			.map((message: any) => message.content)
		uni.previewImage({ current: url, urls: images })
	}

	const toggleMoreMenu = () => {
		showMore.value = !showMore.value
	}

	const closeMoreMenu = () => {
		showMore.value = false
	}

	const openPeerProfile = () => {
		if (userId.value <= 0) {
			uni.showToast({ title: '暂时无法获取对方资料', icon: 'none' })
			return
		}
		if (isParentMode.value) {
			uni.navigateTo({ url: '/pages/parent/user-detail?id=' + userId.value })
			return
		}
			uni.navigateTo({ url: '/pages/user/detail?userId=' + userId.value })
	}

	const openChatReport = () => {
		closeMoreMenu()
		reportVisible.value = true
	}

	const scrollToBottom = () => {
		if (messages.value.length === 0) return
		setTimeout(() => {
			scrollToView.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	const getCurrentTime = (): string => {
		const now = new Date()
		const hours = now.getHours().toString().padStart(2, '0')
		const minutes = now.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}
</script>

