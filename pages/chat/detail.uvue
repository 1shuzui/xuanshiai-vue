		const setupVoiceRecorder = () => {
			// #ifdef MP-WEIXIN
			voiceRecorder = uni.getRecorderManager()
			voiceRecorder.onStop((res: any) => {
				voiceRecording.value = false
				if (discardVoiceRecording) {
					discardVoiceRecording = false
					return
				}
				const path = res != null && res.tempFilePath != null ? '' + res.tempFilePath : ''
				if (path != '') sendMediaFile(path, 'voice')
			})
			voiceRecorder.onError(() => {
