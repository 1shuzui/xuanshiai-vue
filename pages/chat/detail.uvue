	onMounted(() => {
		setupVoiceRecorder()
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		if (options != null && options.paperPlaneConversationId != null) {
			const conversationId = Number(options.paperPlaneConversationId)
			if (Number.isFinite(conversationId) && Math.floor(conversationId) == conversationId && conversationId > 0) {
				if (isParentMode.value) {
					permissionLoading.value = false
					permissionError.value = '父母端不支持纸飞机匿名会话'
					return
				}
				paperPlaneConversationId.value = conversationId
				chatAllowed.value = true
				permissionLoading.value = false
				if (options.paperPlaneLabel != null) {
					uni.setNavigationBarTitle({ title: decodeURIComponent('' + options.paperPlaneLabel) })
				}
				loadPaperPlaneMessages()
				return
			}
		}
		if (options != null && options.userId != null) {
			const parsedUserId = Number(options.userId)
			if (Number.isFinite(parsedUserId) && Math.floor(parsedUserId) == parsedUserId && parsedUserId > 0) {
				userId.value = parsedUserId
			}
		}
		verifyChatPermission()
	})
