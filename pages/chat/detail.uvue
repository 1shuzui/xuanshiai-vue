	const sendMessage = async () => {
		const content = inputText.value.trim()
		if (content == '' || sendingText.value || !chatAllowed.value) return
		if (isPaperPlaneConversation.value) {
			await sendPaperPlaneText(content)
			return
		}
		const subject = activeMessageSubject.value
		if (subject == null) return
		const textAttemptId = textSendAttemptSequence + 1
		textSendAttemptSequence = textAttemptId
		activeTextSendAttempt = textAttemptId
		sendingText.value = true
		const message = {
			id: 0,
			clientMessageId: createClientMessageId(),
			type: 'text',
			content: content,
			time: getCurrentTime(),
			showTime: false,
			isMine: true,
			avatar: isParentMode.value ? '' : '/static/portraits/profile-man-light.jpg',
			status: 'queued',
			errorMessage: '',
			subjectKey: subjectKey(subject)
		}
		messages.value.push(message)
		inputText.value = ''
		scrollToBottom()
		try {
			await deliverMessage(message)
		} finally {
			if (activeTextSendAttempt == textAttemptId) {
				activeTextSendAttempt = 0
				sendingText.value = false
			}
		}
	}

	const sendPaperPlaneText = async (content: string, existingMessage: any = null) => {
		if (!isPaperPlaneConversation.value || content == '') return
		sendingText.value = true
		const message = existingMessage != null ? existingMessage : {
			id: 0,
			clientMessageId: createClientMessageId(),
			type: 'text',
			content: content,
			time: getCurrentTime(),
			showTime: false,
			isMine: true,
			avatar: '/static/portraits/profile-man-light.jpg',
			status: 'sending',
			errorMessage: '',
			isPaperPlane: true
		}
		if (existingMessage == null) {
			messages.value.push(message)
			inputText.value = ''
			scrollToBottom()
		} else {
			message.status = 'sending'
			message.errorMessage = ''
		}
		try {
			const res = await sendPaperPlaneMessage(paperPlaneConversationId.value, content, message.clientMessageId)
			if (res == null || res.success != true || res.data == null) {
				message.status = 'failed'
				message.errorMessage = responseMessage(res, '发送失败')
				return
			}
			if (res.data.id != null) message.id = res.data.id
			message.status = 'sent'
		} catch (error) {
			message.status = 'failed'
			message.errorMessage = '网络异常，发送失败'
		} finally {
			sendingText.value = false
		}
	}

