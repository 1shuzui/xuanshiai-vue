<template>
	<view class="parent-bottom-nav">
		<button
			v-for="item in navItems"
			:key="item.key"
			class="nav-item"
			:class="{ active: active === item.key }"
			@click="selectPanel(item.key)"
		>
			<XsaIcon :name="item.icon" size="medium" />
			<text class="nav-label">{{ item.label }}</text>
		</button>
	</view>
</template>

	<script setup lang="uts">
		type ParentPanel = 'home' | 'matchmaker' | 'message' | 'profile'
		import XsaIcon from '@/components/XsaIcon.uvue'

		type ParentNavItem = {
			key: ParentPanel
			label: string
			icon: 'home' | 'matchmaker' | 'message' | 'profile'
		}

		interface Props {
			active: ParentPanel
	}

	const props = withDefaults(defineProps<Props>(), {
		active: 'home'
	})

		const emit = defineEmits<{
			change: [panel: ParentPanel]
	}>()

		const navItems: ParentNavItem[] = [
		{ key: 'home', label: '首页', icon: 'home' },
		{ key: 'matchmaker', label: '牵线', icon: 'matchmaker' },
		{ key: 'message', label: '消息', icon: 'message' },
		{ key: 'profile', label: '我的', icon: 'profile' }
	]

		const selectPanel = (panel: ParentPanel) => {
		if (panel == props.active) return
		emit('change', panel)
	}
</script>

<style scoped>
	.parent-bottom-nav {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
		background: var(--surface);
		border-top: 1px solid var(--line);
	}

	.nav-item {
		min-height: 48px;
		margin: 0;
		padding: 4px 0;
		border-radius: 8px;
		background: transparent;
		color: var(--muted);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
	}

	.nav-item.active {
		color: var(--accent);
	}

	.nav-label {
		font-size: 14px;
		font-weight: 700;
		line-height: 1.2;
	}
</style>
