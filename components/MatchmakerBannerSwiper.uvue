<template>
	<swiper
		class="banner-swiper"
		:indicator-dots="banners.length > 1"
		indicator-color="rgba(250, 252, 252, 0.48)"
		indicator-active-color="var(--accent2)"
		autoplay
		circular
		:interval="4200"
	>
		<swiper-item v-for="item in banners" :key="item.id">
			<view class="banner-item" @click="handleClick(item)">
				<image class="banner-image" :src="item.image" mode="aspectFill"></image>
				<view class="banner-overlay"></view>
				<view class="banner-copy">
					<text class="banner-kicker">红娘服务</text>
					<text class="banner-title">{{ item.title }}</text>
					<text class="banner-subtitle">{{ item.subtitle }}</text>
					<view class="banner-footer">
						<view class="banner-stat">
							<text class="banner-stat-value">{{ item.statValue }}</text>
							<text class="banner-stat-label">{{ item.statLabel }}</text>
						</view>
						<view class="banner-button">
							<text>{{ item.buttonText }}</text>
						</view>
					</view>
				</view>
			</view>
		</swiper-item>
	</swiper>
</template>

<script setup lang="uts">
interface Props {
	banners: any[];
}

const props = defineProps<Props>();

const emit = defineEmits<{
	select: [item: any];
}>();

const handleClick = (item: any) => {
	emit('select', item);
};
</script>

