<template>
	<view class="xsa-sheet-overlay" :class="{ open: visible }" @click="handleOverlayClick">
		<view class="xsa-sheet" :class="{ tall: tall }" @click.stop>
			<view class="handle"></view>
			<view class="sheet-header" v-if="title">
				<text class="sheet-title">{{ title }}</text>
				<view class="close-btn" @click="handleClose">
					<text>✕</text>
				</view>
			</view>
			<view class="sheet-body">
				<slot></slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaSheet - 宣誓爱底部滑出面板组件
 * 遵循 DESIGN.md 设计规范
 */

interface Props {
	visible: boolean;
	title?: string;
	tall?: boolean;
	closeOnOverlay?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
	visible: false,
	tall: false,
	closeOnOverlay: true
});

const emit = defineEmits<{
	close: []
}>();

const handleClose = () => {
	emit('close');
};

const handleOverlayClick = () => {
	if (props.closeOnOverlay) {
		emit('close');
	}
};
</script>

<style scoped>
/* 遮罩层 - 遵循 DESIGN.md */
.xsa-sheet-overlay {
	position: fixed;
	z-index: 10050;
	inset: 0;
	background: rgba(12, 19, 19, 0.36);
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.22s;
}

.xsa-sheet-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

/* Sheet 面板 */
.xsa-sheet {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	max-height: 88%;
	background: var(--paper);
	border-radius: 24px 24px 0 0;
	transform: translateY(104%);
	transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.25, 1);
	overflow: hidden;
}

.xsa-sheet-overlay.open .xsa-sheet {
	transform: translateY(0);
}

.xsa-sheet.tall {
	height: 94%;
	max-height: 94%;
}

/* 顶部把手 */
.handle {
	width: 38px;
	height: 4px;
	background: var(--line);
	border-radius: 2px;
	margin: 9px auto 5px;
}

/* Sheet 头部 */
.sheet-header {
	height: 54px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 0 18px;
	border-bottom: 1px solid var(--line);
}

.sheet-title {
	font-size: 19px;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

	.close-btn {
		width: 40px;
	height: 40px;
	border-radius: 50%;
	background: transparent;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
		cursor: pointer;
		font-size: 20px;
		color: var(--muted);
}

/* Sheet 内容区域 */
.sheet-body {
	max-height: calc(100% - 64px);
	overflow-y: auto;
	padding: 16px 18px calc(24px + env(safe-area-inset-bottom));
	-webkit-overflow-scrolling: touch;
}

.sheet-body::-webkit-scrollbar {
	display: none;
}
</style>
