<template>
	<view
		class="xsa-user-card"
		:class="{ compact: compact }"
		@click="handleCardClick"
	>
		<!-- 用户头像 -->
		<view class="card-header">
			<image class="avatar" :src="user.avatar" mode="aspectFill"></image>
			<view class="online-badge" v-if="user.online"></view>
		</view>

		<!-- 用户信息 -->
		<view class="card-body">
			<!-- 基本信息 -->
			<view class="user-basic">
				<text class="name">{{ user.name }}</text>
				<text class="age">{{ user.age }}</text>
				<text class="gender-icon">{{ user.gender === 1 ? '♂' : '♀' }}</text>
			</view>

			<!-- 认证标识 -->
			<view class="cert-badges" v-if="user.certifications && user.certifications.length > 0">
				<view class="cert-badge" v-for="(cert, index) in user.certifications" :key="index">
					<text class="cert-icon">✓</text>
				</view>
			</view>

			<!-- 标签 -->
			<view class="tags" v-if="user.tags && user.tags.length > 0 && !compact">
				<text class="tag" v-for="(tag, index) in displayTags" :key="index">{{ tag }}</text>
			</view>

			<!-- 位置信息 -->
			<view class="location" v-if="user.location">
				<text class="icon">📍</text>
				<text class="text text-muted">{{ user.location }}</text>
			</view>

			<!-- 个人介绍 -->
			<text class="intro text-muted" v-if="user.introduction && !compact">{{ user.introduction }}</text>
		</view>

		<!-- 操作按钮 -->
		<view class="card-footer" v-if="showActions">
			<button class="action-btn like-btn" @click.stop="handleLike">
				<text class="icon">{{ liked ? '❤️' : '🤍' }}</text>
			</button>
			<button class="action-btn chat-btn" @click.stop="handleChat">
				<text class="icon">💬</text>
				<text class="text">申请认识</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaUserCard - 用户卡片组件
 * 用于首页推荐、搜索结果、访客记录等场景
 */

interface User {
	id: number;
	avatar: string;
	name: string;
	age: number;
	gender: number; // 1-男 2-女
	online?: boolean;
	certifications?: string[];
	tags?: string[];
	location?: string;
	introduction?: string;
}

interface Props {
	user: User;
	compact?: boolean; // 紧凑模式（不显示标签和介绍）
	showActions?: boolean; // 是否显示操作按钮
	maxTags?: number; // 最多显示多少个标签
}

const props = withDefaults(defineProps<Props>(), {
	compact: false,
	showActions: true,
	maxTags: 3
});

const emit = defineEmits<{
	click: [user: User];
	like: [userId: number];
	chat: [userId: number];
}>();

// 内部状态
let liked = ref(false);

// 显示的标签（限制数量）
const displayTags = computed(() => {
	if (!props.user.tags) return [];
	return props.user.tags.slice(0, props.maxTags);
});

// 点击卡片
const handleCardClick = () => {
	emit('click', props.user);
};

// 点击喜欢
const handleLike = () => {
	liked.value = !liked.value;
	emit('like', props.user.id);
};

	// 申请认识（产品约束：不可直接聊天）
	const handleChat = () => {
		emit('chat', props.user.id);
	};
</script>

<style scoped>
.xsa-user-card {
	background: var(--surface);
	border-radius: 16px;
	overflow: hidden;
	box-shadow: 0 2px 8px rgba(17, 23, 24, 0.06);
	transition: all 0.22s;
}

.xsa-user-card:active {
	transform: scale(0.98);
}

/* 头像区域 */
.card-header {
	position: relative;
	width: 100%;
	aspect-ratio: 3 / 4;
	overflow: hidden;
}

.avatar {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

	.online-badge {
		position: absolute;
		bottom: 12px;
		right: 12px;
		width: 12px;
		height: 12px;
		background: var(--sage);
		border: 2px solid var(--surface);
		border-radius: 50%;
		box-shadow: 0 0 0 3px var(--sage-soft);
	}

/* 信息区域 */
.card-body {
	padding: 16px;
}

.user-basic {
	display: flex;
		flex-direction: row;
	align-items: center;
	gap: 6px;
	margin-bottom: 8px;
}

.name {
	font-size: 18px;
	font-weight: 500;
	color: var(--ink);
}

.age {
	font-size: 15px;
	color: var(--ink2);
}

.gender-icon {
	font-size: 16px;
	color: var(--accent);
}

/* 认证徽章 */
.cert-badges {
	display: flex;
		flex-direction: row;
	gap: 4px;
	margin-bottom: 8px;
}

.cert-badge {
	width: 18px;
	height: 18px;
	background: var(--sage-soft);
	border-radius: 50%;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
}

.cert-icon {
	font-size: 12px;
	color: var(--sage);
}

/* 标签 */
.tags {
	display: flex;
		flex-direction: row;
	flex-wrap: wrap;
	gap: 6px;
	margin-bottom: 8px;
}

.tag {
	padding: 4px 10px;
	background: var(--soft);
	color: var(--accent2);
	border-radius: 999px;
	font-size: 12px;
}

/* 位置 */
.location {
	display: flex;
		flex-direction: row;
	align-items: center;
	gap: 4px;
	margin-bottom: 8px;
}

.location .icon {
	font-size: 13px;
}

.location .text {
	font-size: 13px;
}

/* 个人介绍 */
.intro {
	font-size: 13px;
	line-height: 1.5;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* 操作按钮 */
.card-footer {
	display: flex;
		flex-direction: row;
	gap: 8px;
	padding: 0 16px 16px;
}

.action-btn {
	flex: 1;
	height: 40px;
	border-radius: 999px;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 4px;
	font-size: 14px;
	transition: all 0.18s;
}

.like-btn {
	background: var(--paper);
	border: 1px solid var(--line);
	color: var(--ink);
}

.like-btn .icon {
	font-size: 18px;
}

.chat-btn {
	background: var(--accent);
	color: #FFFFFF;
}

.chat-btn .icon {
	font-size: 16px;
}

/* 紧凑模式 */
.xsa-user-card.compact .card-header {
	aspect-ratio: 1;
}

.xsa-user-card.compact .card-body {
	padding: 12px;
}

.xsa-user-card.compact .name {
	font-size: 15px;
}

.xsa-user-card.compact .age {
	font-size: 14px;
}
</style>
