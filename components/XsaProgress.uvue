<template>
	<view class="xsa-progress-wrapper">
		<view v-if="showLabel" class="progress-label">
			<text class="label-text">{{ label }}</text>
			<text class="label-value">{{ value }}%</text>
		</view>
		<view class="xsa-progress" :class="{ animated: animated }">
			<view class="progress-track">
				<view
					class="progress-fill"
					:style="{ width: value + '%' }"
				></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaProgress - 宣誓爱进度条组件
 * 遵循 DESIGN.md 设计规范
 */

interface Props {
	value: number;
	label?: string;
	showLabel?: boolean;
	animated?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
	showLabel: false,
	animated: true
});
</script>

<style scoped>
/* 进度条容器 - 遵循 DESIGN.md */
.xsa-progress-wrapper {
	display: flex;
	flex-direction: column;
	gap: 7px;
}

.progress-label {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.label-text {
	font-size: 10px;
	color: var(--muted);
}

.label-value {
	font-size: 10px;
	font-weight: 800;
	color: var(--ink);
}

.xsa-progress {
	width: 100%;
}

.progress-track {
	height: 6px;
	background: oklch(0.94 0.03 50 / 0.22);
	border-radius: 4px;
	overflow: hidden;
}

.progress-fill {
	height: 100%;
	background: var(--soft);
	border-radius: 4px;
	transition: width 0.3s ease;
}

.xsa-progress.animated .progress-fill {
	animation: progressFill 0.6s ease-out;
}

@keyframes progressFill {
	from {
		width: 0;
	}
}
</style>
