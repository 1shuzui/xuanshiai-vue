				<text class="price-symbol">¥</text>
				<text class="price-value">{{ data.price }}</text>
			</view>
		</view>

		<view class="plan-original" v-if="data.originalPrice != null">
			<text>原价 ¥{{ data.originalPrice }}</text>
		</view>

		<text class="plan-description">{{ data.description }}</text>

		<view class="plan-section">
			<text class="section-title">包含服务</text>
