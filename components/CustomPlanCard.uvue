		</view>

		<view class="plan-action">
			<text>选择这套方案</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import XsaTag from '@/components/XsaTag.uvue'

interface Props {
	data: any;
}

const props = defineProps<Props>();

const emit = defineEmits<{
	select: [item: any];
}>();

const handleSelect = () => {
	emit('select', props.data);
};
</script>

