<template>
	<view class="xsa-avatar" :class="[size, shape]" @click="handleClick">
		<image
			v-if="src"
			class="avatar-img"
			:src="src"
			mode="aspectFill"
		></image>
		<view v-else class="avatar-placeholder">
			<text class="placeholder-text">{{ initials }}</text>
		</view>
		<view v-if="badge" class="avatar-badge" :class="badgeType">
			<text v-if="badgeType === 'count'" class="badge-text">{{ badge }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaAvatar - 宣誓爱头像组件
 * 遵循 DESIGN.md 设计规范
 */

interface Props {
	src?: string;
	name?: string;
	size?: 'small' | 'medium' | 'large';
	shape?: 'circle' | 'rounded';
	badge?: string | number;
	badgeType?: 'online' | 'offline' | 'count';
	clickable?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
	size: 'medium',
	shape: 'circle',
	badgeType: 'count',
	clickable: false
});

const emit = defineEmits<{
	click: []
}>();

const initials = computed(() => {
	if (!props.name) return '?';
	const names = props.name.trim().split(' ');
	if (names.length >= 2) {
		return names[0][0] + names[names.length - 1][0];
	}
	return props.name[0] || '?';
});

const handleClick = () => {
	if (props.clickable) {
		emit('click');
	}
};
</script>

<style scoped>
/* 头像容器 - 遵循 DESIGN.md */
.xsa-avatar {
	position: relative;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
	background: var(--warm);
	overflow: hidden;
}

/* 尺寸变体 */
.xsa-avatar.small {
	width: 32px;
	height: 32px;
}

.xsa-avatar.medium {
	width: 52px;
	height: 52px;
}

.xsa-avatar.large {
	width: 88px;
	height: 88px;
}

/* 形状变体 */
.xsa-avatar.circle {
	border-radius: 50%;
}

.xsa-avatar.rounded {
	border-radius: 8px;
}

/* 头像图片 */
.avatar-img {
	width: 100%;
	height: 100%;
}

/* 占位符 */
.avatar-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
	background: var(--soft);
	color: var(--accent2);
}

.placeholder-text {
	font-size: 16px;
	font-weight: 700;
	text-transform: uppercase;
}

.xsa-avatar.small .placeholder-text {
	font-size: 12px;
}

.xsa-avatar.large .placeholder-text {
	font-size: 28px;
}

/* 徽章 */
.avatar-badge {
	position: absolute;
	right: 0;
	bottom: 0;
	min-width: 18px;
	height: 18px;
	border-radius: 50%;
	border: 2px solid var(--paper);
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
}

.avatar-badge.online {
	width: 10px;
	height: 10px;
	background: var(--sage);
	box-shadow: 0 0 0 3px var(--sage-soft);
}

.avatar-badge.offline {
	width: 10px;
	height: 10px;
	background: var(--muted);
}

.avatar-badge.count {
	background: var(--accent);
	padding: 0 4px;
}

.badge-text {
	font-size: 9px;
	font-weight: 800;
	color: var(--paper);
}

.xsa-avatar.small .avatar-badge {
	min-width: 14px;
	height: 14px;
	border-width: 1.5px;
}

.xsa-avatar.small .badge-text {
	font-size: 8px;
}
</style>
