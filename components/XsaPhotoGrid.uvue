<template>
	<view class="xsa-photo-grid">
		<!-- 图片列表 -->
		<view class="photo-item" v-for="(photo, index) in photos" :key="index">
			<image class="photo" :src="photo" mode="aspectFill" @click="handlePreview(index)"></image>
			<view class="delete-btn" v-if="editable" @click.stop="handleDelete(index)">
				<text class="icon">✕</text>
			</view>
		</view>

		<!-- 添加按钮 -->
		<view class="photo-item add-btn" v-if="editable && photos.length < maxCount" @click="handleAdd">
			<text class="icon">+</text>
			<text class="text">{{ addText }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaPhotoGrid - 相册网格组件
 * 用于用户详情、编辑资料、发布动态等场景
 */

interface Props {
	photos: string[]; // 图片URL数组
	editable?: boolean; // 是否可编辑（显示删除按钮和添加按钮）
	maxCount?: number; // 最多可上传数量
	columns?: number; // 每行显示列数
	addText?: string; // 添加按钮文字
}

const props = withDefaults(defineProps<Props>(), {
	editable: false,
	maxCount: 9,
	columns: 3,
	addText: '添加图片'
});

const emit = defineEmits<{
	add: [];
	delete: [index: number];
	preview: [index: number];
}>();

// 预览图片
const handlePreview = (index: number) => {
	emit('preview', index);

	// 如果不在编辑模式，使用系统预览
	if (!props.editable) {
		uni.previewImage({
			current: index,
			urls: props.photos
		});
	}
};

// 删除图片
const handleDelete = (index: number) => {
	emit('delete', index);
};

// 添加图片
const handleAdd = () => {
	emit('add');
};
</script>

<style scoped>
.xsa-photo-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 8px;
}

.photo-item {
	position: relative;
	aspect-ratio: 1;
	border-radius: 8px;
	overflow: hidden;
}

.photo {
	width: 100%;
	height: 100%;
}

.delete-btn {
	position: absolute;
	top: 4px;
	right: 4px;
	width: 24px;
	height: 24px;
	background: rgba(0, 0, 0, 0.6);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.delete-btn .icon {
	color: #FFFFFF;
	font-size: 16px;
}

.add-btn {
	background: var(--paper);
	border: 1px dashed var(--line);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4px;
	cursor: pointer;
	transition: all 0.18s;
}

.add-btn:active {
	background: var(--canvas);
}

.add-btn .icon {
	font-size: 32px;
	color: var(--muted);
}

.add-btn .text {
	font-size: 12px;
	color: var(--muted);
}
</style>
