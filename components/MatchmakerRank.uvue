	}

	.rank-mark {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 52rpx;
		height: 52rpx;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18rpx;
		font-weight: 800;
		background: var(--warm);
		color: var(--accent2);
