	}

	.rank-mark.first {
		background: rgba(44, 128, 124, 0.18);
		border-color: rgba(44, 128, 124, 0.22);
	}

	.rank-mark.second {
		background: rgba(56, 152, 141, 0.12);
	}

	.rank-mark.third {
		background: rgba(194, 224, 207, 0.64);
	}

	.rank-name {
