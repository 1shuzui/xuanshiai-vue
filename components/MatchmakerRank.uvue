<template>
	<view class="rank-wrap">
		<view class="rank-header">
			<view>
				<text class="rank-title">红娘排行榜</text>
				<text class="rank-subtitle">按累计服务与近期反馈综合排序</text>
			</view>
		</view>

		<view class="rank-list">
				<view class="rank-item" v-for="(item, index) in list" :key="item.id" @click="handleClick(item)">
					<view class="rank-mark" :class="rankClass(index)">
						<text>{{ rankLabel(index) }}</text>
					</view>
					<MatchmakerAvatar :src="item.avatar" :name="item.name" variant="rank" />
					<text class="rank-name">{{ item.name }}</text>
					<text class="rank-meta">服务 {{ item.serviceCount }} 人</text>
					<text class="rank-meta">成功 {{ item.successCount }} 约</text>
					<text class="rank-rate">★ {{ formatRating(item.rating) }}</text>
				</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import MatchmakerAvatar from '@/components/MatchmakerAvatar.uvue';

interface Props {
	list: any[];
}

const props = defineProps<Props>();

const emit = defineEmits<{
	'item-click': [item: any];
}>();

const rankLabel = (index: number) => {
	if (index == 0) return '冠';
	if (index == 1) return '亚';
	if (index == 2) return '季';
	return String(index + 1);
};

const rankClass = (index: number) => {
	if (index == 0) return 'first';
	if (index == 1) return 'second';
	if (index == 2) return 'third';
	return 'normal';
};

const formatRating = (value: any): string => {
	const rating = Number(value);
	return isNaN(rating) ? '0.0' : rating.toFixed(1);
};

const handleClick = (item: any) => {
	emit('item-click', item);
};
</script>

<style scoped>
