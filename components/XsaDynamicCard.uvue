<template>
	<view class="xsa-dynamic-card" @click="handleOpen">
		<!-- 用户信息栏 -->
		<view class="card-header" @click.stop="handleUserClick">
			<image class="avatar" :src="dynamic.user.avatar" mode="aspectFill"></image>
			<view class="user-info">
				<view class="name-row">
					<text class="name">{{ dynamic.user.name }}</text>
					<text class="time text-muted">{{ timeText }}</text>
				</view>
				<view class="tag-row" v-if="tagList.length > 0">
					<text class="mini-tag" v-for="(tag, i) in tagList" :key="i">{{ tag }}</text>
				</view>
			</view>
			<button
				v-if="showFollow"
				class="follow-btn"
				:class="{ done: followed }"
				@click.stop="handleFollow"
			>
				{{ followed ? '已关注' : '关注' }}
			</button>
			<view class="more-btn" @click.stop="handleMore">
				<text class="icon">⋯</text>
			</view>
		</view>

		<!-- 动态内容 -->
		<view class="card-body">
			<text class="content-text" v-if="dynamic.content">{{ dynamic.content }}</text>

			<view class="photo-grid" :class="gridClass" v-if="dynamic.photos && dynamic.photos.length > 0">
				<image
					class="photo-item"
					:class="gridClass"
					v-for="(photo, index) in dynamic.photos"
					:key="index"
					:src="photo"
					mode="aspectFill"
					@click.stop="handlePhotoClick(index)"
				></image>
			</view>

			<view class="topic-chip" v-if="dynamic.topicId != null && dynamic.topicId > 0" @click.stop="handleTopic">
				<text class="topic-hash">#</text>
				<text class="topic-label">相关话题</text>
			</view>

			<view class="location" v-if="dynamic.location">
				<text class="icon">📍</text>
				<text class="text text-muted">{{ dynamic.location }}</text>
			</view>
		</view>

		<!-- 互动栏 -->
		<view class="card-footer" @click.stop>
			<view class="action-item" @click="handleLike">
				<text class="icon" :class="{ liked: liked }">{{ liked ? '❤️' : '🤍' }}</text>
				<text class="text text-muted" v-if="likeCount > 0">{{ likeCount }}</text>
			</view>
			<view class="action-item" @click="handleComment">
				<text class="icon">💬</text>
				<text class="text text-muted" v-if="commentCount > 0">{{ commentCount }}</text>
			</view>
			<view class="action-item" @click="handleCollect">
				<text class="icon">{{ collected ? '⭐' : '☆' }}</text>
				<text class="text text-muted" v-if="collectCount > 0">{{ collectCount }}</text>
			</view>
			<button
				class="apply-btn"
				:class="{ pending: applyStatus === 'pending', done: applyStatus === 'accepted' }"
				@click="handleApply"
			>
				{{ applyLabel }}
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaDynamicCard - 社区动态卡片
 * 横排布局需显式 flex-direction:row（UniApp view 默认 column）
 */

interface DynamicUser {
		id: number
		avatar: string
		name: string
		age?: number
		city?: string
		height?: string
		job?: string
		education?: string
		verified?: boolean
		realNameStatus?: string
		educationStatus?: string
	}

	interface Dynamic {
		id: number
		user: DynamicUser
		content?: string
		photos?: string[]
		location?: string
		time?: string
		timeText?: string
		likeCount?: number
		commentCount?: number
		collectCount?: number
		liked?: boolean
		collected?: boolean
		followed?: boolean
		applyStatus?: string
		topicId?: number
		tags?: string[]
		declaration?: string
	}

interface Props {
	dynamic: Dynamic
	showFollow?: boolean
}

const props = withDefaults(defineProps<Props>(), {
	showFollow: true
})

const emit = defineEmits<{
	userClick: [userId: number]
	photoClick: [index: number]
	like: [dynamicId: number]
	comment: [dynamicId: number]
	share: [dynamicId: number]
	collect: [dynamicId: number]
	follow: [userId: number]
	apply: [userId: number]
	more: [dynamicId: number, userId: number]
	topic: [topicId: number]
	open: [dynamicId: number]
}>()

const liked = ref(props.dynamic.liked === true)
const likeCount = ref(props.dynamic.likeCount != null ? props.dynamic.likeCount : 0)
const collected = ref(props.dynamic.collected === true)
const collectCount = ref(props.dynamic.collectCount != null ? props.dynamic.collectCount : 0)
const followed = ref(props.dynamic.followed === true)
const applyStatus = ref(props.dynamic.applyStatus != null ? props.dynamic.applyStatus : 'none')

watch(
	() => props.dynamic,
	(d: Dynamic) => {
		liked.value = d.liked === true
		likeCount.value = d.likeCount != null ? d.likeCount : 0
		collected.value = d.collected === true
		collectCount.value = d.collectCount != null ? d.collectCount : 0
		followed.value = d.followed === true
		applyStatus.value = d.applyStatus != null ? d.applyStatus : 'none'
	},
	{ deep: true }
)

const timeText = computed((): string => {
	if (props.dynamic.timeText != null && props.dynamic.timeText !== '') return props.dynamic.timeText as string
	if (props.dynamic.time != null) return props.dynamic.time as string
	return ''
})

const commentCount = computed((): number => {
	return props.dynamic.commentCount != null ? props.dynamic.commentCount : 0
})

const tagList = computed((): string[] => {
		const out: string[] = []
		const u = props.dynamic.user
		if (u != null) {
			if (u.age != null) out.push(u.age + '岁')
			if (u.city != null && u.city !== '') out.push(u.city as string)
			if (u.job != null && u.job !== '') out.push(u.job as string)
			if (u.height != null && u.height !== '') out.push(u.height as string)
			if (u.education != null && u.education !== '') out.push(u.education as string)
			if (u.realNameStatus == 'passed' || u.verified == true) out.push('已实名')
		}
		if (props.dynamic.declaration != null && props.dynamic.declaration !== '') {
			out.push(props.dynamic.declaration as string)
		}
		if (props.dynamic.tags != null) {
			const tags = props.dynamic.tags as string[]
			for (let i = 0; i < tags.length; i++) {
				const t = tags[i]
				if (t != null && t !== '' && out.indexOf(t) < 0) out.push(t)
			}
		}
		// 控制展示密度，避免小屏溢出
		if (out.length > 6) return out.slice(0, 6)
		return out
	})

const applyLabel = computed((): string => {
		if (applyStatus.value === 'pending') return '已申请'
		if (applyStatus.value === 'accepted') return '已通过'
		if (applyStatus.value === 'rejected') return '再次申请'
		return '申请认识'
	})

const gridClass = computed(() => {
	const count = props.dynamic.photos != null ? props.dynamic.photos.length : 0
	if (count === 1) return 'single'
	if (count === 2) return 'double'
	if (count === 4) return 'quad'
	return 'grid'
})

const handleUserClick = () => {
	emit('userClick', props.dynamic.user.id)
}

const handlePhotoClick = (index: number) => {
	emit('photoClick', index)
	uni.previewImage({
		current: index,
		urls: props.dynamic.photos != null ? props.dynamic.photos : []
	})
}

const handleLike = () => {
	liked.value = !liked.value
	likeCount.value += liked.value ? 1 : -1
	emit('like', props.dynamic.id)
}

const handleComment = () => {
	emit('comment', props.dynamic.id)
}

const handleCollect = () => {
	collected.value = !collected.value
	collectCount.value += collected.value ? 1 : -1
	emit('collect', props.dynamic.id)
}

const handleFollow = () => {
	if (followed.value) return
	followed.value = true
	emit('follow', props.dynamic.user.id)
}

const handleApply = () => {
		if (applyStatus.value === 'pending') {
			uni.showToast({ title: '已申请，等待对方回应', icon: 'none' })
			return
		}
		if (applyStatus.value === 'accepted') {
			uni.showToast({ title: '双方已同意，可在消息中沟通', icon: 'none' })
			return
		}
		// none / rejected 可发起或再次申请
		emit('apply', props.dynamic.user.id)
	}

const handleMore = () => {
	emit('more', props.dynamic.id, props.dynamic.user.id)
}

const handleTopic = () => {
	if (props.dynamic.topicId != null) {
		emit('topic', props.dynamic.topicId)
	}
}

const handleOpen = () => {
	emit('open', props.dynamic.id)
}
</script>

<style scoped>
.xsa-dynamic-card {
	background: var(--surface);
	margin-bottom: 8px;
}

.card-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12px;
	padding: 12px 16px;
}

.avatar {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	flex-shrink: 0;
}

.user-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
	min-width: 0;
}

.name-row {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 8px;
}

.name {
	font-size: 15px;
	font-weight: 600;
	color: var(--ink);
}

.time {
	font-size: 12px;
}

.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 4px;
}

.mini-tag {
	font-size: 10px;
	padding: 2px 6px;
	border-radius: 4px;
	background: var(--soft);
	color: var(--accent2);
}

.follow-btn {
	height: 28px;
	padding: 0 10px;
	border-radius: 999px;
	border: 1px solid var(--accent);
	background: var(--paper);
	color: var(--accent2);
	font-size: 11px;
	font-weight: 700;
	line-height: 26px;
	flex-shrink: 0;
}

.follow-btn.done {
	border-color: var(--line);
	color: var(--muted);
	background: var(--surface);
}

.more-btn {
	width: 32px;
	height: 32px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.more-btn .icon {
	font-size: 20px;
	color: var(--muted);
}

.card-body {
	padding: 0 16px 12px;
}

.content-text {
	font-size: 15px;
	color: var(--ink);
	line-height: 1.6;
	display: block;
	margin-bottom: 12px;
}

.photo-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 4px;
	margin-bottom: 8px;
}

.photo-item {
	border-radius: 8px;
	overflow: hidden;
}

.photo-item.single {
	max-width: 280px;
	max-height: 280px;
	width: 100%;
}

.photo-item.double {
	width: calc(50% - 2px);
	height: 160px;
}

.photo-item.quad {
	width: calc(50% - 2px);
	height: 160px;
}

.photo-item.grid {
	width: calc(33.33% - 3px);
	height: 110px;
}

.topic-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
	align-self: flex-start;
	margin-bottom: 8px;
	padding: 4px 8px;
	border-radius: 6px;
	background: var(--soft);
}

.topic-hash {
	color: var(--accent);
	font-weight: 800;
	font-size: 12px;
}

.topic-label {
	font-size: 12px;
	color: var(--accent2);
	font-weight: 600;
}

.location {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
}

.location .icon {
	font-size: 13px;
}

.location .text {
	font-size: 13px;
}

.card-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16px;
	padding: 12px 16px;
	border-top: 1px solid var(--line);
}

.action-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
}

.action-item .icon {
	font-size: 18px;
}

.action-item .icon.liked {
	animation: heartBeat 0.3s ease;
}

.action-item .text {
	font-size: 13px;
}

.apply-btn {
	margin-left: auto;
	height: 32px;
	padding: 0 12px;
	border-radius: 999px;
	border: none;
	background: var(--accent);
	color: var(--paper);
	font-size: 12px;
	font-weight: 700;
	line-height: 32px;
}

.apply-btn.pending,
.apply-btn.done {
	background: var(--surface);
	color: var(--muted);
	border: 1px solid var(--line);
}

@keyframes heartBeat {
	0%,
	100% {
		transform: scale(1);
	}
	50% {
		transform: scale(1.3);
	}
}
</style>
