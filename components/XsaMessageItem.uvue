<template>
	<view
		class="xsa-message-item"
		:class="{ pinned: message.pinned === true }"
		@click="handleClick"
		@longpress.stop="handleLongPress"
	>
		<!-- 头像 -->
		<view class="avatar-wrapper">
			<image class="avatar" :src="message.avatar" mode="aspectFill"></image>
		</view>

		<!-- 消息内容 -->
		<view class="message-content">
			<view class="message-top">
				<view class="name-row">
					<text class="name">{{ message.name }}</text>
				</view>
				<text class="time text-muted">{{ formatTime }}</text>
			</view>
			<view class="message-bottom">
				<text class="last-message text-muted" :class="{ unread: message.unreadCount > 0 }">
					{{ lastMessageText }}
				</text>
				<view class="unread-badge" v-if="message.unreadCount > 0">
					<text class="badge-text">{{ badgeText }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaMessageItem - 消息列表项组件
 * 用于消息列表页面
 */

interface Message {
	id: number;
	avatar: string;
	name: string;
	lastMessage: string;
	time: string | number; // 时间戳或字符串
	unreadCount?: number;
	online?: boolean;
	type?: string;
	messageType?: 'text' | 'image' | 'voice' | 'wechat-request' | 'phone-request'; // 消息类型
	pinned?: boolean;
}

interface Props {
	message: Message;
}

const props = defineProps<Props>();

const emit = defineEmits<{
	click: [message: Message];
	longpress: [message: Message];
}>();

let suppressClick = false;

// 未读数显示文本（超过99显示99+）
const badgeText = computed(() => {
	const count = props.message.unreadCount || 0;
	return count > 99 ? '99+' : count.toString();
});

// 最后一条消息显示
const lastMessageText = computed(() => {
	const msg = props.message;

	// 根据消息类型显示不同内容
	if (msg.messageType === 'image') {
		return '[图片]';
	} else if (msg.messageType === 'voice') {
		return '[语音]';
	} else if (msg.messageType === 'wechat-request') {
		return '[微信申请]';
	} else if (msg.messageType === 'phone-request') {
		return '[电话申请]';
	}

	return msg.lastMessage;
});

// 时间格式化
const formatTime = computed(() => {
	const time = props.message.time;

	// 如果已经是格式化的字符串，直接返回
	if (typeof time === 'string') {
		return time;
	}

	// 最近一天显示相对时间，更早消息使用紧凑日期
	const date = new Date(time);
	const elapsed = Math.max(0, Date.now() - time);
	const minute = 60 * 1000;
	const hour = 60 * minute;
	const day = 24 * hour;

	if (elapsed < minute) {
		return '刚刚';
	}
	if (elapsed < hour) {
		return `${Math.floor(elapsed / minute)}分钟前`;
	}
	if (elapsed < day) {
		return `${Math.floor(elapsed / hour)}小时前`;
	}

	const now = new Date();
	const month = (date.getMonth() + 1).toString().padStart(2, '0');
	const dateDay = date.getDate().toString().padStart(2, '0');
	if (elapsed < 2 * day) {
		return '昨天';
	}
	if (date.getFullYear() === now.getFullYear()) {
		return `${month}/${dateDay}`;
	}
	return `${date.getFullYear()}/${month}/${dateDay}`;
});

// 点击消息项
const handleClick = () => {
	if (suppressClick) return;
	emit('click', props.message);
};

const handleLongPress = () => {
	suppressClick = true;
	emit('longpress', props.message);
	setTimeout(() => {
		suppressClick = false;
	}, 500);
};
</script>

<style scoped>
.xsa-message-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10px;
	width: 100%;
	height: 60px;
	margin: 0;
	padding: 2px 20px 2px 16px;
	box-sizing: border-box;
	border-bottom: 1px solid var(--line);
	background: transparent;
	transition: background 0.18s;
}

.xsa-message-item.pinned {
	background: var(--canvas);
}

.xsa-message-item:active {
	background: var(--canvas);
}

/* 头像 */
.avatar-wrapper {
	position: relative;
	flex-shrink: 0;
	width: 50px;
	height: 50px;
}

.avatar {
	width: 50px;
	height: 50px;
	border-radius: 50%;
}

.unread-badge {
	min-width: 18px;
	height: 18px;
	padding: 0 5px;
	background: var(--accent);
	border-radius: 999px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.badge-text {
	font-size: 11px;
	font-weight: 600;
	color: var(--text-invert);
	line-height: 1;
}

/* 消息内容 */
.message-content {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
	gap: 1px;
}

.message-top,
.message-bottom {
	display: flex;
	flex-direction: row;
	align-items: center;
	min-width: 0;
}

.message-top {
	justify-content: space-between;
	gap: 8px;
}

.message-bottom {
	gap: 8px;
}

.name-row {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6px;
	min-width: 0;
}

.name {
	font-size: 15px;
	font-family: var(--sans);
	font-weight: 700;
	color: var(--ink);
	line-height: 20px;
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.time {
	max-width: 82px;
	flex-shrink: 0;
	font-size: 11px;
	line-height: 16px;
	text-align: right;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.last-message {
	font-size: 12px;
	line-height: 17px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	flex: 1;
}

.last-message.unread {
	color: var(--ink2);
	font-weight: 500;
}

/* 在线状态 */
</style>
