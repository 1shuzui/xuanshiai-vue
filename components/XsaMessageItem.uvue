<template>
	<view class="xsa-message-item" @click="handleClick">
		<!-- 头像 -->
		<view class="avatar-wrapper">
			<image class="avatar" :src="message.avatar" mode="aspectFill"></image>
			<view class="unread-badge" v-if="message.unreadCount > 0">
				<text class="badge-text">{{ badgeText }}</text>
			</view>
		</view>

		<!-- 消息内容 -->
		<view class="message-content">
			<view class="content-top">
				<text class="name">{{ message.name }}</text>
				<text class="time text-muted">{{ formatTime }}</text>
			</view>
			<view class="content-bottom">
				<text class="last-message text-muted" :class="{ unread: message.unreadCount > 0 }">
					{{ lastMessageText }}
				</text>
			</view>
		</view>

		<!-- 在线状态 -->
		<view class="online-dot" v-if="message.online"></view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaMessageItem - 消息列表项组件
 * 用于消息列表页面
 */

interface Message {
	id: number;
	avatar: string;
	name: string;
	lastMessage: string;
	time: string | number; // 时间戳或字符串
	unreadCount?: number;
	online?: boolean;
	messageType?: 'text' | 'image' | 'voice'; // 消息类型
}

interface Props {
	message: Message;
}

const props = defineProps<Props>();

const emit = defineEmits<{
	click: [message: Message];
}>();

// 未读数显示文本（超过99显示99+）
const badgeText = computed(() => {
	const count = props.message.unreadCount || 0;
	return count > 99 ? '99+' : count.toString();
});

// 最后一条消息显示
const lastMessageText = computed(() => {
	const msg = props.message;

	// 根据消息类型显示不同内容
	if (msg.messageType === 'image') {
		return '[图片]';
	} else if (msg.messageType === 'voice') {
		return '[语音]';
	}

	return msg.lastMessage;
});

// 时间格式化
const formatTime = computed(() => {
	const time = props.message.time;

	// 如果已经是格式化的字符串，直接返回
	if (typeof time === 'string') {
		return time;
	}

	// 时间戳格式化
	const now = Date.now();
	const diff = now - time;
	const oneDay = 24 * 60 * 60 * 1000;

	if (diff < 60 * 1000) {
		return '刚刚';
	} else if (diff < 60 * 60 * 1000) {
		return `${Math.floor(diff / (60 * 1000))}分钟前`;
	} else if (diff < oneDay) {
		const date = new Date(time);
		const hours = date.getHours().toString().padStart(2, '0');
		const minutes = date.getMinutes().toString().padStart(2, '0');
		return `${hours}:${minutes}`;
	} else if (diff < 2 * oneDay) {
		return '昨天';
	} else {
		const date = new Date(time);
		const month = (date.getMonth() + 1).toString();
		const day = date.getDate().toString();
		return `${month}月${day}日`;
	}
});

// 点击消息项
const handleClick = () => {
	emit('click', props.message);
};
</script>

<style scoped>
.xsa-message-item {
	display: flex;
		flex-direction: row;
	align-items: center;
	gap: 12px;
	padding: 12px 16px;
	background: var(--surface);
	border-bottom: 1px solid var(--line);
	transition: background 0.18s;
}

.xsa-message-item:active {
	background: var(--canvas);
}

/* 头像 */
.avatar-wrapper {
	position: relative;
	flex-shrink: 0;
}

.avatar {
	width: 52px;
	height: 52px;
	border-radius: 50%;
}

.unread-badge {
	position: absolute;
	top: -4px;
	right: -4px;
	min-width: 18px;
	height: 18px;
	padding: 0 5px;
	background: #FF4444;
	border: 2px solid var(--surface);
	border-radius: 999px;
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: center;
}

.badge-text {
	font-size: 11px;
	font-weight: 600;
	color: #FFFFFF;
	line-height: 1;
}

/* 消息内容 */
.message-content {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 6px;
}

.content-top {
	display: flex;
		flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
}

.name {
	font-size: 15px;
	font-weight: 500;
	color: var(--ink);
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.time {
	font-size: 12px;
	flex-shrink: 0;
}

.content-bottom {
	display: flex;
		flex-direction: row;
	align-items: center;
}

.last-message {
	font-size: 13px;
	line-height: 1.4;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	flex: 1;
}

.last-message.unread {
	color: var(--ink2);
	font-weight: 500;
}

/* 在线状态 */
.online-dot {
	width: 8px;
	height: 8px;
	background: #4CAF50;
	border-radius: 50%;
	flex-shrink: 0;
	margin-left: -4px;
}
</style>
