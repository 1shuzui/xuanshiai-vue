{
  "name": "xuanshiai",
  "version": "1.0.0",
  "description": "宣誓爱婚恋小程序",
  "scripts": {
    "test:source": "node scripts/test-frontend.cjs",
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "node scripts/build-mp-weixin.cjs --mode development",
    "build:mp-weixin": "node scripts/build-mp-weixin.cjs",
    "verify:mp": "node scripts/verify-mp-weixin.cjs --require-build --report unpackage/build-reports/mp-weixin-quality.json",
    "verify:mp:dev": "node scripts/verify-mp-weixin.cjs --mode development --require-build --main-limit 3145728 --sub-limit 3145728 --media-limit 307200 --report unpackage/build-reports/mp-weixin-quality-dev.json",
    "build:mp-weixin:dev": "node scripts/build-mp-weixin.cjs --mode development"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-plus": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "@dcloudio/types": "^3.4.8",
    "vite": "5.2.8",
    "sass": "^1.77.0"
  }
}
