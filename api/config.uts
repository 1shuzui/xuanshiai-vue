/** API 配置文件 */

// 默认使用真实 FastAPI；单独保留的 Mock 开关见下方角色申请配置。
export const USE_MOCK = false

// FastAPI 服务根地址（不含 /api/v1）。
export const API_BASE_URL = 'http://127.0.0.1:8000'
export const LAN_API_BASE_URL = 'http://192.168.112.247:8000'
export const API_PREFIX = '/api/v1'

// 牵线角色申请维持本地模拟，避免调试申请依赖后端登录会话。
export const ROLE_APPLICATION_USE_MOCK = true

export const ACCESS_TOKEN_KEY = 'xsa_access_token'
export const REFRESH_TOKEN_KEY = 'xsa_refresh_token'

export const API_CONFIG = {
  cloudFunction: {
    timeout: 60000,
    spaceId: 'your-space-id'
  },
  timeout: 10000,
  showLoading: true,
  loadingText: '加载中...'
}

export const MOCK_DELAY = 300

export function getAccessToken(): string {
  try {
    const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
    if (token != null && token !== '') return '' + token
  } catch (e) {}
  return ''
}

export function setAuthTokens(accessToken: string, refreshToken: string = '') {
  try {
    if (accessToken != null && accessToken !== '') uni.setStorageSync(ACCESS_TOKEN_KEY, accessToken)
    if (refreshToken != null && refreshToken !== '') uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
    else uni.removeStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
}

export function clearAuthTokens() {
  try {
    uni.removeStorageSync(ACCESS_TOKEN_KEY)
    uni.removeStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
}

export function buildApiUrl(path: string): string {
  let normalized = path != null ? '' + path : ''
  if (normalized.indexOf('http://') == 0 || normalized.indexOf('https://') == 0) return normalized
  if (normalized.indexOf('/api/') == 0) return API_BASE_URL + normalized
  if (normalized.charAt(0) != '/') normalized = '/' + normalized
  return API_BASE_URL + API_PREFIX + normalized
}

/** 将后端返回的公开媒体路径转换为小程序可加载的绝对地址。 */
export function resolveMediaUrl(value: any): string {
  if (value == null) return ''
  const path = '' + value
  if (path == '') return ''
  if (
    path.indexOf('http://') == 0 ||
    path.indexOf('https://') == 0 ||
    path.indexOf('data:') == 0 ||
    path.indexOf('blob:') == 0 ||
    path.indexOf('wxfile://') == 0 ||
    path.indexOf('/static/') == 0 ||
    path.indexOf('mock://') == 0
  ) return path
  if (path.charAt(0) == '/') return API_BASE_URL + path
  return path
}
