// 真机联调时将 API_BASE_URL 改为此局域网地址，并确认 8001 已向本地子网放行。
export const LAN_API_BASE_URL = 'http://192.168.112.247:8001'

// API 统一前缀
export const API_PREFIX = '/api/v1'

// 本地 Token 存储 key
export const ACCESS_TOKEN_KEY = 'xsa_access_token'
export const REFRESH_TOKEN_KEY = 'xsa_refresh_token'
export const CURRENT_USER_ID_KEY = 'xsa_user_id'
export const ONBOARDING_MODE_KEY = 'xsa_onboarding_mode'
export const ONBOARDING_COMPLETED_KEY = 'xsa_onboarding_completed'

// API 基础配置
export const API_CONFIG = {
  // 旧云函数链路配置；当前请求默认走 FastAPI HTTP。
  cloudFunction: {
    timeout: 60000,
    spaceId: 'your-space-id'
  },

  useHttp: true,

  // 请求超时配置
  timeout: 15000,

  // 是否显示加载提示
  showLoading: true,

  // 加载提示文案
  loadingText: '加载中...'
}

// Mock 延迟配置（模拟网络延迟，单位：毫秒）
export const MOCK_DELAY = 300

/** 读取本地 access token */
export function getAccessToken(): string {
  try {
    const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
    if (token != null && token !== '') return '' + token
  } catch (e) {}
  return ''
}

/** 写入 access / refresh token */
export function setAuthTokens(accessToken: string, refreshToken: string = '') {
  try {
    if (accessToken != null && accessToken !== '') {
      uni.setStorageSync(ACCESS_TOKEN_KEY, accessToken)
    }
    if (refreshToken != null && refreshToken !== '') {
      uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
    }
  } catch (e) {}
}

/** 清理认证主体及其角色选择，避免下一账号继承上一账号状态。 */
export function clearAuthTokens() {
  try {
    uni.removeStorageSync(ACCESS_TOKEN_KEY)
    uni.removeStorageSync(REFRESH_TOKEN_KEY)
    uni.removeStorageSync(CURRENT_USER_ID_KEY)
    uni.removeStorageSync(ONBOARDING_MODE_KEY)
    uni.removeStorageSync(ONBOARDING_COMPLETED_KEY)
  } catch (e) {}
}

/** 拼接完整 HTTP URL */
export function buildApiUrl(path: string): string {
  let p = path != null ? ('' + path) : ''
  if (p.indexOf('http://') == 0 || p.indexOf('https://') == 0) return p
  if (p.indexOf('/api/') == 0) return API_BASE_URL + p
  if (p.charAt(0) != '/') p = '/' + p
  return API_BASE_URL + API_PREFIX + p
}

/** 将后端返回的公开媒体路径转换为小程序可加载的绝对地址。 */
export function resolveMediaUrl(value: any): string {
  if (value == null) return ''
  const p = '' + value
  if (p == '') return ''
  if (
    p.indexOf('http://') == 0 ||
    p.indexOf('https://') == 0 ||
    p.indexOf('data:') == 0 ||
    p.indexOf('blob:') == 0 ||
    p.indexOf('wxfile://') == 0 ||
    p.indexOf('/static/') == 0 ||
    p.indexOf('mock://') == 0
  ) return p
  if (p.charAt(0) == '/') return API_BASE_URL + p
  return p
}
