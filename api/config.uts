export function clearAuthTokens() {
  try {
    uni.removeStorageSync(ACCESS_TOKEN_KEY)
    uni.removeStorageSync(REFRESH_TOKEN_KEY)
    uni.removeStorageSync(CURRENT_USER_ID_KEY)
    uni.removeStorageSync(ONBOARDING_MODE_KEY)
    uni.removeStorageSync(ONBOARDING_COMPLETED_KEY)
  } catch (e) {}
}

export function buildApiUrl(path: string): string {
  let normalized = path != null ? '' + path : ''
  if (normalized.indexOf('http://') == 0 || normalized.indexOf('https://') == 0) return normalized
  if (normalized.indexOf('/api/') == 0) return API_BASE_URL + normalized
  if (normalized.charAt(0) != '/') normalized = '/' + normalized
  return API_BASE_URL + API_PREFIX + normalized
}

/** 将后端返回的公开媒体路径转换为小程序可加载的绝对地址。 */
export function resolveMediaUrl(value: any): string {
  if (value == null) return ''
  const path = '' + value
  if (path == '') return ''
  if (
    path.indexOf('http://') == 0 ||
    path.indexOf('https://') == 0 ||
    path.indexOf('data:') == 0 ||
    path.indexOf('blob:') == 0 ||
    path.indexOf('wxfile://') == 0 ||
    path.indexOf('/static/') == 0 ||
    path.indexOf('mock://') == 0
  ) return path
  if (path.charAt(0) == '/') return API_BASE_URL + path
  return path
}
