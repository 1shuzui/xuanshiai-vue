/**
 * 牵线/红娘相关 API
 * 包含：服务红娘、热心红娘、AI 红娘、私人定制
 */

import { request } from './request.uts'
import {
  mockMatchmakerBanners,
  mockServiceMatchmakers,
  mockCustomMatchmakers,
  mockCustomPlans,
  mockVolunteerMatchmakers,
  mockAiRecommendations
} from '@/mock'

function toMatchmakerCard(item: any) {
  const successCount = item.success_count != null ? Number(item.success_count) : 0
  return {
    id: item.user_id != null ? Number(item.user_id) : Number(item.id),
    name: item.nickname != null && String(item.nickname).length > 0 ? String(item.nickname) : '服务红娘',
    avatar: item.avatar != null ? String(item.avatar) : '',
    city: '',
    title: '平台认证服务红娘',
    introduction: item.intro != null ? String(item.intro) : '',
    description: item.intro != null ? String(item.intro) : '',
    serviceCount: successCount,
    successCount,
    successRate: 0,
    rating: item.rating_score != null ? Number(item.rating_score) : 0,
    ratingCount: item.rating_count != null ? Number(item.rating_count) : 0,
    tags: item.certification_tags != null ? item.certification_tags : [],
    badge: '平台认证',
    price: null,
    priceUnit: '',
    status: item.is_available === true ? 'online' : 'busy',
    certification: item.certification_tags != null && item.certification_tags.length > 0,
    isOnline: item.is_available === true,
    caseRecord: successCount > 0 ? '累计促成 ' + successCount + ' 次有效牵线。' : ''
  }
}

function toCustomPlan(item: any) {
  const serviceType = Number(item.service_type)
  return {
    id: Number(item.id),
    name: String(item.name),
    price: Number(item.price),
    originalPrice: Number(item.price),
    duration: serviceType == 3 ? '私人定制服务' : '牵线服务',
    services: [String(item.description)],
    features: [String(item.description)],
    matchmakerCount: 1,
    description: String(item.description),
    isHot: false,
    tag: serviceType == 3 ? '私人定制' : '服务红娘'
  }
}

function toRoleApplication(applicationType: string, data: any) {
  const images: string[] = []
  if (data.avatar != null && String(data.avatar).length > 0) images.push(String(data.avatar))
  if (data.cases != null) {
    const cases = data.cases as any[]
    for (let i = 0; i < cases.length; i++) {
      const caseImages = cases[i].images as string[]
      if (caseImages != null) {
        for (let j = 0; j < caseImages.length; j++) {
          if (images.length >= 6) break
          images.push(caseImages[j])
        }
      }
    }
  }
  return {
    application_type: applicationType,
    real_name: String(data.realName),
    phone: String(data.phone),
    intro: String(data.introduction),
    cert_images: images
  }
}

/**
 * 获取牵线首页 Banner 列表
 */
export async function getMatchmakerBanners() {
  return request({
    url: '/matchmaker/banners',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    cloudFunctionName: 'matchmaker',
    action: 'getBanners',
    method: 'GET',
    mockData: mockMatchmakerBanners
  })
}

/**
 * 获取红娘详情
 */
export async function getMatchmakerDetail(id: number) {
  const result = await request({
    url: '/matchmakers/' + id,
    forceHttp: true,
    skipAuth: true,
    method: 'GET',
    mockData: null
  })
  if (result.success && result.data != null) result.data = toMatchmakerCard(result.data)
  return result
}

/**
 * 获取服务红娘列表
 */
export async function getServiceMatchmakers() {
  const result = await request({
    url: '/matchmakers',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockServiceMatchmakers
  })
  if (result.success && result.data != null && result.data.items != null) {
    result.data = (result.data.items as any[]).map((item: any) => toMatchmakerCard(item))
  }
  return result
}

/**
 * 获取私人定制专属红娘列表
 */
export async function getCustomMatchmakers() {
  const result = await request({
    url: '/matchmakers',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockCustomMatchmakers
  })
  if (result.success && result.data != null && result.data.items != null) {
    result.data = (result.data.items as any[]).map((item: any) => toMatchmakerCard(item))
  }
  return result
}

/**
 * 获取热心红娘列表（兼容旧命名）
 */
export async function getVolunteerMatchmakers() {
