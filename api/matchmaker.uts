/**
 * 获取 AI 红娘推荐
 */
export async function getAiRecommendations() {
  return request({
    url: '/matchmaker/ai/recommend',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    cloudFunctionName: 'matchmaker',
    action: 'getAiRecommendations',
    method: 'GET',
    mockData: mockAiRecommendations // Mock 数据
  })
}

/**
 * 获取私人定制方案
 */
export async function getCustomPlans() {
  const result = await request({
    url: '/matchmaker/service-products',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockCustomPlans
  })
  if (result.success && result.data != null && Array.isArray(result.data)) {
    result.data = (result.data as any[]).map((item: any) => toCustomPlan(item))
  }
  return result
}

/**
 * 获取私人定制套餐（兼容旧命名）
 */
export async function getCustomPackages() {
  return getCustomPlans()
}

/**
 * 提交红娘入驻申请（我要做红娘）
 */
export async function submitMatchmakerApplication(data: any) {
  return request({
    url: '/matchmaker/applications',
    forceHttp: true,
    method: 'POST',
    data: toRoleApplication('service_matchmaker', data)
  })
}

/**
 * 提交合伙人入驻申请
 */
export async function submitPartnerApplication(data: any) {
  return request({
    url: '/matchmaker/applications',
    forceHttp: true,
    method: 'POST',
    data: toRoleApplication('partner', data)
  })
