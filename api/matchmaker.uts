/**
 * 提交红娘入驻申请（我要做红娘）
 */
export async function submitMatchmakerApplication(data: any) {
  return request({
    url: '/matchmaker/become/apply',
    cloudFunctionName: 'matchmaker',
    action: 'becomeApply',
    method: 'POST',
    data,
    mockData: { success: true, applicationId: 'app_' + Date.now(), status: 'pending' }
  })
}

/**
 * 提交合伙人入驻申请
 */
export async function submitPartnerApplication(data: any) {
  return request({
