/**
 * 认证相关 API
 * 优先走 FastAPI，失败时回退到本地演示数据。
 */

import { request } from './request.uts'
import { setAuthTokens, clearAuthTokens, REFRESH_TOKEN_KEY, API_BASE_URL, API_PREFIX } from './config.uts'

export async function sendSms(phone: string, purpose: string = 'login') {
  return request({
    url: '/auth/sms/send',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, purpose },
    mockData: { message: '验证码已发送' }
  })
}

export async function loginByPhone(phone: string, code: string) {
  const res = await request({
    url: '/auth/phone/login',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, code, purpose: 'login' },
    mockData: {
      access_token: 'mock_access_token_xsa',
      refresh_token: 'mock_refresh_token_xsa',
      token_type: 'bearer',
      expires_in: 3600,
      need_bind_phone: false,
      user_id: 1
    }
  })
  if (res.success && res.data != null && res.data.access_token != null) {
    setAuthTokens(String(res.data.access_token), res.data.refresh_token != null ? String(res.data.refresh_token) : '')
  }
  return res
}

export async function logout() {
  try {
    await request({
      url: '/auth/logout',
      forceHttp: true,
      mockFallback: true,
      method: 'POST',
      mockData: { success: true }
    })
  } finally {
    clearAuthTokens()
  }
}

/**
 * 使用 Refresh Token 刷新 Access Token
 * 返回新的 token 信息，并自动写入本地存储
 */
export async function refreshToken(): Promise<boolean> {
  let refreshTokenValue = ''
  try {
    refreshTokenValue = uni.getStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
  if (refreshTokenValue == null || refreshTokenValue === '') return false

  try {
    const url = buildRefreshUrl()
    console.log('🔄 [Token Refresh] 尝试刷新令牌')
    const res = await new Promise<any>((resolve) => {
      uni.request({
        url: url,
        method: 'POST',
        data: { refresh_token: refreshTokenValue },
        header: { 'Content-Type': 'application/json' },
        timeout: 10000,
        success: (resp: any) => {
          const status = resp.statusCode != null ? resp.statusCode : 0
          if (status >= 200 && status < 300) {
            resolve({ success: true, data: resp.data })
          } else {
            resolve({ success: false, data: resp.data, code: status })
          }
        },
        fail: (err: any) => {
          resolve({ success: false, data: null, code: -1, message: err?.errMsg })
        }
      })
    })

    if (res.success && res.data != null && res.data.access_token != null) {
      const newRefresh = res.data.refresh_token != null ? String(res.data.refresh_token) : refreshTokenValue
      setAuthTokens(String(res.data.access_token), newRefresh)
      console.log('✅ [Token Refresh] 刷新成功')
      return true
    }
  } catch (e) {
    console.error('❌ [Token Refresh] 刷新异常:', e)
  }
  return false
}

function buildRefreshUrl(): string {
  return API_BASE_URL + API_PREFIX + '/auth/refresh'
}
