/**
 * 统一请求封装
 * 自动根据 USE_MOCK 配置决定返回 Mock 数据还是真实 API
 */

import { USE_MOCK, API_CONFIG, MOCK_DELAY } from './config.uts'

// 兼容项目里旧的 API 调用约定，避免 HBuilderX 增量编译时仍引用历史类型名。
export class RequestOptions {
  url : string = ''
  method ?: 'GET' | 'POST' | 'PATCH' | 'DELETE'
  data ?: any
  skipAuth ?: boolean
  mockData ?: any
  forceHttp ?: boolean
  mockFallback ?: boolean
  cloudFunctionName ?: string
  action ?: string
}

export class RequestResult {
  ok : boolean = false
  success : boolean = false
  data ?: any
  error ?: string
  message ?: string
  code ?: number
}

export function getAccessToken() {
  const token = uni.getStorageSync('access_token')
  return token != null ? String(token) : ''
}

export function getRefreshToken() {
  const token = uni.getStorageSync('refresh_token')
  return token != null ? String(token) : ''
}

export function setTokens(accessToken : string, refreshToken : string) {
  uni.setStorageSync('access_token', accessToken)
  uni.setStorageSync('refresh_token', refreshToken)
}

export function clearTokens() {
  uni.removeStorageSync('access_token')
  uni.removeStorageSync('refresh_token')
}

/**
 * 统一请求方法
 * @param options 请求配置
 * @returns Promise
 */
export async function request(options: any) {
  if (options.forceHttp === true) {
    try {
      return await httpRequest(options)
    } catch (err) {
      if (options.mockFallback === true && options.mockData !== null && options.mockData !== undefined) {
        console.warn('⚠️ [HTTP Request Fallback To Mock]', options.url)
        return mockRequest(options)
      }
      throw err
    }
  }

  // 开发模式：返回 Mock 数据
  if (USE_MOCK) {
    return mockRequest(options)
  }

  // 生产模式：调用真实 uniCloud 云函数
  return realRequest(options)
}

/**
 * Mock 请求（开发阶段）
 */
async function mockRequest(options: any) {
  console.log('📦 [Mock Request]', options.url, options.data)

  // 模拟网络延迟
  await sleep(MOCK_DELAY)

  // 返回 Mock 数据
  return {
    success: true,
    data: options.mockData,
    code: 0,
    message: 'success'
  }
}

/**
 * 真实请求（生产阶段）
 */
async function realRequest(options: any) {
  console.log('🌐 [Real Request]', options.url, options.data)

  return new Promise((resolve, reject) => {
    uniCloud.callFunction({
      name: options.cloudFunctionName,
      data: {
        action: options.action,
        ...options.data
      },
      success: (res: any) => {
        resolve({
          success: true,
          data: res.result,
          code: 0,
          message: 'success'
        })
      },
      fail: (err: any) => {
        console.error('❌ [Request Error]', err)
        reject({
          success: false,
          data: null,
          code: err.code || -1,
          message: err.message || '请求失败'
        })
      }
    })
  })
}

/**
 * 直连 FastAPI HTTP 请求
 */
async function httpRequest(options: any) {
  const requestUrl = buildHttpUrl(options.url)
  const requestHeader: any = {
    'Content-Type': 'application/json'
  }

  if (options.skipAuth !== true) {
    const accessToken = getAccessToken()
    if (accessToken.length > 0) {
      requestHeader['Authorization'] = 'Bearer ' + accessToken
    }
  }

  console.log('🌐 [HTTP Request]', requestUrl, options.data)

  return new Promise((resolve, reject) => {
    uni.request({
      url: requestUrl,
      method: options.method || 'GET',
      data: options.data,
      timeout: API_CONFIG.timeout,
      header: requestHeader,
      success: (res: any) => {
        const statusCode = res.statusCode || 0
        if (statusCode >= 200 && statusCode < 300) {
          resolve({
            success: true,
            data: res.data,
            code: statusCode,
            message: extractResponseMessage(res.data, 'success')
          })
          return
        }

        const errorMessage = extractResponseMessage(res.data, '请求失败')
        console.error('❌ [HTTP Response Error]', statusCode, res.data)
        reject({
          success: false,
          data: res.data,
          code: statusCode,
          message: errorMessage
        })
      },
      fail: (err: any) => {
        console.error('❌ [HTTP Request Error]', err)
        reject({
          success: false,
          data: null,
          code: err.errCode || -1,
          message: err.errMsg || err.message || '请求失败'
        })
      }
    })
  })
}

function buildHttpUrl(path: string) {
  const base = API_CONFIG.httpBaseUrl
  if (base.endsWith('/') && path.startsWith('/')) {
    return base + path.slice(1)
  }
  if (!base.endsWith('/') && !path.startsWith('/')) {
    return base + '/' + path
  }
  return base + path
}

function extractResponseMessage(data: any, fallback: string) {
  if (data == null) return fallback
  if (data.message != null) return String(data.message)
  if (data.detail != null) return String(data.detail)
  return fallback
}

/**
 * 延迟函数
 */
function sleep(ms: number) {
  return new Promise(resolve => setTimeout(resolve, ms))
}
