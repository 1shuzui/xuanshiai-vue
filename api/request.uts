/**
 * 统一请求封装
 * - USE_MOCK=true：返回 mockData
 * - 默认：通过 HTTP 调用 FastAPI，并自动附加 Bearer token
 */

import {
  USE_MOCK,
  API_CONFIG,
  MOCK_DELAY,
  getAccessToken,
  setAuthTokens,
  clearAuthTokens,
  REFRESH_TOKEN_KEY,
  API_BASE_URL,
  API_PREFIX
} from './config.uts'

/**
 * 统一请求方法。
 * GET / DELETE 的 data 自动编码为查询参数；其余方法作为 JSON 请求体发送。
 */
export async function request(options: any) {
  if (USE_MOCK) return mockRequest(options)
  return httpRequest(options)
}

async function mockRequest(options: any) {
  console.log('📦 [Mock Request]', options.url, options.data)
  await sleep(MOCK_DELAY)

  if (
    options.mockData != null &&
    typeof options.mockData === 'object' &&
    options.mockData.success === false
  ) {
    return {
      success: false,
      data: options.mockData,
      code: options.mockData.code != null ? options.mockData.code : -1,
      message: options.mockData.message != null ? options.mockData.message : 'error'
    }
  }

  return { success: true, data: options.mockData, code: 0, message: 'success' }
}

function resolveApiUrl(path: string): string {
  let normalized = path != null ? '' + path : ''
  if (normalized.indexOf('http://') == 0 || normalized.indexOf('https://') == 0) return normalized
  if (normalized.indexOf('/api/') == 0) return API_BASE_URL + normalized
  if (normalized.charAt(0) != '/') normalized = '/' + normalized
  return API_BASE_URL + API_PREFIX + normalized
}

function extractDetail(data: any): string {
  if (data == null) return '请求失败'
  if (typeof data === 'string') return data
  if (data.detail != null) {
    if (typeof data.detail === 'string') return data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) {
      const first = data.detail[0]
      if (first != null && first.msg != null) return '' + first.msg
      return JSON.stringify(data.detail)
    }
  }
  if (data.message != null) return '' + data.message
  return '请求失败'
}

async function httpRequest(options: any) {
  const result = await doHttpRequest(options, false)
  if (result.code == 401 && options.skipAuth !== true && options._retryAfterRefresh !== false) {
    const refreshed = await tryRefreshToken()
    if (refreshed) {
      console.log('🔄 [HTTP Retry] 使用新 token 重试请求')
      const retryOptions: any = {}
      const keys = Object.keys(options)
      for (let i = 0; i < keys.length; i++) retryOptions[keys[i]] = options[keys[i]]
      retryOptions._retryAfterRefresh = false
      return doHttpRequest(retryOptions, true)
    }
    clearAuthTokens()
  }
  return result
}

function doHttpRequest(options: any, isRetry: boolean): Promise<any> {
  const method = options.method != null ? ('' + options.method).toUpperCase() : 'GET'
  let url = resolveApiUrl(options.url != null ? '' + options.url : '')
  const headers: any = { 'Content-Type': 'application/json' }

  if (options.headers != null) {
    const keys = Object.keys(options.headers)
    for (let i = 0; i < keys.length; i++) headers[keys[i]] = options.headers[keys[i]]
  }

  if (options.skipAuth != true) {
    const token = getAccessToken()
    if (token != '') headers['Authorization'] = 'Bearer ' + token
  }

  let body: any = null
  const data = options.data
  if (method == 'GET' || method == 'DELETE') {
    if (data != null && typeof data === 'object') {
      const parts: string[] = []
      const keys = Object.keys(data)
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i]
        const value = data[key]
        if (value == null) continue
        if (Array.isArray(value)) {
          for (let j = 0; j < value.length; j++) {
            parts.push(encodeURIComponent(key) + '=' + encodeURIComponent('' + value[j]))
          }
        } else {
          parts.push(encodeURIComponent(key) + '=' + encodeURIComponent('' + value))
        }
      }
      if (parts.length > 0) url = url + (url.indexOf('?') >= 0 ? '&' : '?') + parts.join('&')
    }
  } else {
    body = data != null ? data : {}
  }

  console.log(isRetry ? '🌐 [HTTP Retry]' : '🌐 [HTTP Request]', method, url)

  return new Promise((resolve) => {
    uni.request({
      url: url,
      method: method as any,
      data: body,
      header: headers,
      timeout: API_CONFIG.timeout,
      success: (res: any) => {
        const status = res.statusCode != null ? (res.statusCode as number) : 0
        const raw = res.data
        if (status == 204 || (status >= 200 && status < 300)) {
          resolve({ success: true, data: status == 204 ? null : raw, code: 0, message: 'success' })
          return
        }
        resolve({ success: false, data: raw, code: status, message: extractDetail(raw) })
      },
      fail: (err: any) => {
        console.error('❌ [HTTP Error]', err)
        resolve({
          success: false,
          data: null,
          code: -1,
          message: err != null && err.errMsg != null ? err.errMsg : '网络请求失败'
        })
      }
    })
  })
}

async function tryRefreshToken(): Promise<boolean> {
  let refreshToken = ''
  try {
    refreshToken = uni.getStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
  if (refreshToken == null || refreshToken === '') return false

  console.log('🔄 [Token Refresh] 尝试刷新令牌')
  return new Promise((resolve) => {
    uni.request({
      url: resolveApiUrl('/auth/refresh'),
      method: 'POST',
      data: { refresh_token: refreshToken },
      header: { 'Content-Type': 'application/json' },
      timeout: API_CONFIG.timeout,
      success: (res: any) => {
        const status = res.statusCode != null ? res.statusCode : 0
        const data = res.data
        if (status >= 200 && status < 300 && data != null && data.access_token != null) {
          const nextRefresh = data.refresh_token != null ? '' + data.refresh_token : '' + refreshToken
          setAuthTokens('' + data.access_token, nextRefresh)
          console.log('✅ [Token Refresh] 刷新成功')
          resolve(true)
          return
        }
        resolve(false)
      },
      fail: () => resolve(false)
    })
  })
}

function sleep(ms: number) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}
