/**
 * 统一请求封装
 * 自动根据 USE_MOCK 配置决定返回 Mock 数据还是真实 API
 */

import { USE_MOCK, API_BASE_URL, API_CONFIG, API_PREFIX, ACCESS_TOKEN_KEY, MOCK_DELAY } from './config.uts'

/**
 * 统一请求方法
 * @param options 请求配置
 * @returns Promise
 */
export async function request(options: any) {
  // 开发模式：返回 Mock 数据
  if (USE_MOCK) {
    return mockRequest(options)
  }

  // 生产模式：调用真实 uniCloud 云函数
  return realRequest(options)
}

/**
 * Mock 请求（开发阶段）
 */
async function mockRequest(options: any) {
  console.log('📦 [Mock Request]', options.url, options.data)

  // 模拟网络延迟
  await sleep(MOCK_DELAY)

  // 返回 Mock 数据
  return {
    success: true,
    data: options.mockData,
    code: 0,
    message: 'success'
  }
}

function resolveApiUrl(path: string): string {
  if (path.indexOf('http://') == 0 || path.indexOf('https://') == 0) return path
  const normalizedPath = path.indexOf('/') == 0 ? path : '/' + path
  return API_BASE_URL + API_PREFIX + normalizedPath
}

function responseMessage(data: any, fallback: string): string {
  if (data != null && data.detail != null) {
    if (typeof data.detail == 'string') return data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) return '' + data.detail[0].msg
  }
  if (data != null && data.message != null) return '' + data.message
  return fallback
}

/**
 * 真实请求（FastAPI HTTP）
 */
async function realRequest(options: any) {
  const url = resolveApiUrl(options.url != null ? '' + options.url : '')
  const method = options.method != null ? ('' + options.method).toUpperCase() : 'GET'
  const headers: any = {}
  headers['Content-Type'] = 'application/json'
  if (options.headers != null) {
    const optionHeaderKeys = Object.keys(options.headers)
    for (let i = 0; i < optionHeaderKeys.length; i++) {
      const key = optionHeaderKeys[i]
      headers[key] = options.headers[key]
    }
  }
  const rawToken = uni.getStorageSync(ACCESS_TOKEN_KEY)
  const token = rawToken != null ? '' + rawToken : ''
  if (token != '') headers['Authorization'] = 'Bearer ' + token

  console.log('🌐 [Real Request]', method, url, options.data)

  return new Promise((resolve, reject) => {
    uni.request({
      url,
      method,
      data: options.data != null ? options.data : null,
      header: headers,
      timeout: API_CONFIG.timeout,
      success: (res: any) => {
        const statusCode = res.statusCode != null ? res.statusCode : 200
        const ok = statusCode >= 200 && statusCode < 300
        resolve({
          success: ok,
          data: res.data,
          code: ok ? 0 : statusCode,
          message: ok ? 'success' : responseMessage(res.data, '请求失败')
        })
      },
      fail: (err: any) => {
        console.error('❌ [Request Error]', err)
        reject({
          success: false,
          data: null,
          code: err.code || -1,
          message: err.message || '请求失败'
        })
      }
    })
  })
}

/**
 * 延迟函数
 */
function sleep(ms: number) {
  return new Promise(resolve => setTimeout(resolve, ms))
}
