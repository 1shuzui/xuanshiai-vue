/**
 * 消息相关 API
 * 包含：聊天列表、消息详情、申请消息
 */

import { request } from './request.uts'
import { mockMessageList, mockChatMessages, mockApplications } from '@/mock'

/**
 * 获取聊天列表
 */
export async function getMessageList() {
  return request({
    url: '/message/list',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockMessageList // Mock 数据
  })
}

/**
 * 获取聊天详情
 * @param userId 对方用户 ID
 */
export async function getChatMessages(userId: number) {
  return request({
    url: '/message/chat',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    data: { userId },
    mockData: mockChatMessages // Mock 数据
  })
}

/**
 * 发送消息
 * @param userId 对方用户 ID
 * @param content 消息内容
 * @param type 消息类型（text/image/voice/wechat-request/phone-request）
 */
export async function sendMessage(userId: number, content: string, type: string = 'text') {
  return request({
    url: '/message/send',
    forceHttp: true,
    mockFallback: true,
    method: 'POST',
    data: { userId, content, type },
    mockData: { success: true, messageId: Date.now() } // Mock 数据
  })
}

/**
 * 处理联系方式交换申请
 * @param requestId 交换申请消息 ID
 * @param action accept / reject
 * @param contactType wechat / phone
 */
export async function handleContactExchangeRequest(
  requestId: number,
  action: string,
  contactType: string = 'wechat'
) {
  return request({
    url: '/message/contact-exchange/handle',
    cloudFunctionName: 'message',
    action: 'handleContactExchangeRequest',
    method: 'POST',
    data: { requestId, action, contactType },
    mockData: {
      status: action == 'accept' ? 'accepted' : 'rejected',
      contactType: contactType,
      contactValue: action == 'accept'
        ? (contactType == 'phone' ? '13812341234' : 'wanqing_art')
        : ''
    }
  })
}

/**
 * 获取申请消息列表
 */
export async function getApplications() {
  return request({
    url: '/message/applications',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    mockData: mockApplications // Mock 数据
  })
}

/**
 * 处理申请（同意/拒绝）
 * @param applicationId 申请 ID
 * @param action 操作（accept/reject）
 */
export async function handleApplication(applicationId: number, action: string) {
  return request({
    url: '/message/application/handle',
    forceHttp: true,
    mockFallback: true,
    method: 'POST',
    data: { applicationId, action },
    mockData: { success: true } // Mock 数据
  })
}
