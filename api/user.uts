/**
 * 用户相关 API
 * Mock 来源：design-demos/final 高保真嘉宾数据
 */

import { request } from './request.uts'
import {
  mockRecommendUsers,
  mockSquareUsers,
  mockUserDetail,
  mockPaperPlanePeerProfile,
  mockMeProfile,
  mockCommunityQuotas,
  mockApplyStates,
  mockLikedUserIds
} from '@/mock'
import { __syncApplyStatus } from './community.uts'

const CHAT_FEATURE_UNLOCK_STORAGE_KEY = 'xsa_chat_feature_unlocks_v1'
const PROFILE_UNLOCK_STORAGE_KEY = 'xsa_profile_unlocks_v1'
export const CHAT_FEATURE_UNLOCK_COST = 80
export const PROFILE_UNLOCK_COST = 50
let chatFeatureUnlocksLoaded = false
let profileUnlocksLoaded = false
const chatFeatureUnlocks: any = {
  album: false,
  camera: false,
  profile: false
}
const profileUnlocks: any = {}

function restoreChatFeatureUnlocks() {
  if (chatFeatureUnlocksLoaded) return
  chatFeatureUnlocksLoaded = true
  try {
    const saved = uni.getStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY) as any
    if (saved == null || typeof saved !== 'object') return
    chatFeatureUnlocks.album = saved.album == true
    chatFeatureUnlocks.camera = saved.camera == true
    chatFeatureUnlocks.profile = saved.profile == true
    if (saved.points != null && Number(saved.points) >= 0) {
      mockMeProfile.points = Number(saved.points)
    }
  } catch (e) {
    console.error('恢复聊天功能解锁状态失败', e)
  }
}

function saveChatFeatureUnlocks() {
  uni.setStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY, {
    album: chatFeatureUnlocks.album == true,
    camera: chatFeatureUnlocks.camera == true,
    profile: chatFeatureUnlocks.profile == true,
    points: mockMeProfile.points
  })
  try {
    const profileSaved = uni.getStorageSync(PROFILE_UNLOCK_STORAGE_KEY) as any
    if (profileSaved != null && typeof profileSaved === 'object') {
      profileSaved.points = mockMeProfile.points
      uni.setStorageSync(PROFILE_UNLOCK_STORAGE_KEY, profileSaved)
    }
  } catch (e) {}
}

function restoreProfileUnlocks() {
  if (profileUnlocksLoaded) return
  profileUnlocksLoaded = true
  try {
    const saved = uni.getStorageSync(PROFILE_UNLOCK_STORAGE_KEY) as any
    if (saved == null || typeof saved !== 'object') return
    const unlockedUserIds = saved.unlockedUserIds as any
    if (unlockedUserIds != null && typeof unlockedUserIds === 'object') {
      const keys = Object.keys(unlockedUserIds)
      keys.forEach((key: string) => {
        profileUnlocks[key] = unlockedUserIds[key] == true
      })
    }
    if (saved.points != null && Number(saved.points) >= 0) {
      mockMeProfile.points = Number(saved.points)
    }
  } catch (e) {
    console.error('恢复资料解锁状态失败', e)
  }
}

function saveProfileUnlocks() {
  uni.setStorageSync(PROFILE_UNLOCK_STORAGE_KEY, {
    unlockedUserIds: profileUnlocks,
    points: mockMeProfile.points
  })
  try {
    const chatSaved = uni.getStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY) as any
    if (chatSaved != null && typeof chatSaved === 'object') {
      chatSaved.points = mockMeProfile.points
      uni.setStorageSync(CHAT_FEATURE_UNLOCK_STORAGE_KEY, chatSaved)
    }
  } catch (e) {}
}

/** 获取聊天页的付费功能解锁状态及当前积分余额。 */
export async function getChatFeatureUnlocks() {
  restoreChatFeatureUnlocks()
  return request({
    url: '/user/chat-feature-unlocks',
    cloudFunctionName: 'user',
    action: 'getChatFeatureUnlocks',
    method: 'GET',
    mockData: {
      album: chatFeatureUnlocks.album == true,
      camera: chatFeatureUnlocks.camera == true,
      profile: chatFeatureUnlocks.profile == true,
      points: mockMeProfile.points,
      cost: CHAT_FEATURE_UNLOCK_COST
    }
  })
}

/** 首次使用聊天相册、拍摄或查看主页时扣除 80 积分，后续使用不再扣费。 */
export async function unlockChatFeature(feature: string) {
  restoreChatFeatureUnlocks()
  const supported = feature == 'album' || feature == 'camera' || feature == 'profile'
  if (!supported) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: false, message: '暂不支持该解锁功能' }
    })
  }

  if (chatFeatureUnlocks[feature] == true) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: true, alreadyUnlocked: true, feature, points: mockMeProfile.points }
    })
  }

  if (mockMeProfile.points < CHAT_FEATURE_UNLOCK_COST) {
    return request({
      url: '/user/chat-feature-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockChatFeature',
      method: 'POST',
      data: { feature },
      mockData: { success: false, code: 'INSUFFICIENT_POINTS', message: '积分不足，无法解锁该功能', points: mockMeProfile.points }
    })
  }

  mockMeProfile.points -= CHAT_FEATURE_UNLOCK_COST
  chatFeatureUnlocks[feature] = true
  saveChatFeatureUnlocks()
  return request({
    url: '/user/chat-feature-unlocks',
    cloudFunctionName: 'user',
    action: 'unlockChatFeature',
    method: 'POST',
    data: { feature },
    mockData: { success: true, feature, points: mockMeProfile.points, cost: CHAT_FEATURE_UNLOCK_COST }
  })
}

/** 获取某位用户资料的解锁状态。资料解锁按目标用户单独保存。 */
export async function getUserProfileUnlockStatus(userId: number) {
  restoreProfileUnlocks()
  const key = '' + userId
  return request({
    url: '/user/profile-unlocks',
    cloudFunctionName: 'user',
    action: 'getProfileUnlockStatus',
    method: 'GET',
    data: { userId },
    mockData: {
      unlocked: profileUnlocks[key] == true,
      points: mockMeProfile.points,
      cost: PROFILE_UNLOCK_COST
    }
  })
}

/** 消耗 50 积分解锁一位用户的全部资料，包括 VIP 专属内容。 */
export async function unlockUserProfile(userId: number) {
  restoreProfileUnlocks()
  const key = '' + userId
  if (profileUnlocks[key] == true) {
    return request({
      url: '/user/profile-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockProfile',
      method: 'POST',
      data: { userId },
      mockData: { success: true, alreadyUnlocked: true, userId, points: mockMeProfile.points, cost: PROFILE_UNLOCK_COST }
    })
  }

  if (mockMeProfile.points < PROFILE_UNLOCK_COST) {
    return request({
      url: '/user/profile-unlocks',
      cloudFunctionName: 'user',
      action: 'unlockProfile',
      method: 'POST',
      data: { userId },
      mockData: { success: false, code: 'INSUFFICIENT_POINTS', message: '积分不足，无法解锁全部资料', points: mockMeProfile.points, cost: PROFILE_UNLOCK_COST }
    })
  }

  mockMeProfile.points -= PROFILE_UNLOCK_COST
  profileUnlocks[key] = true
  saveProfileUnlocks()
  return request({
    url: '/user/profile-unlocks',
    cloudFunctionName: 'user',
    action: 'unlockProfile',
    method: 'POST',
    data: { userId },
    mockData: { success: true, userId, points: mockMeProfile.points, cost: PROFILE_UNLOCK_COST }
  })
}

/**
 * 获取推荐用户（支持轮换 index）
 */
export async function getRecommendUser(index: number = 0) {
  const list = mockRecommendUsers as any[]
  const i = list.length > 0 ? (index % list.length) : 0
  const user = list.length > 0 ? list[i] : mockUserDetail
  return request({
    url: '/user/recommend',
    cloudFunctionName: 'user',
    action: 'getRecommend',
    method: 'GET',
    data: { index: i },
    mockData: user
  })
}

/**
 * 获取推荐用户列表（全量）
 */
export async function getRecommendUsers() {
  return request({
    url: '/user/recommend/list',
    cloudFunctionName: 'user',
    action: 'getRecommendList',
    method: 'GET',
    mockData: mockRecommendUsers
  })
}

/**
 * 获取广场用户列表
 */
export async function getSquareUsers(params: any) {
  return request({
    url: '/user/square',
    cloudFunctionName: 'user',
    action: 'getSquareList',
    method: 'GET',
    data: params,
    mockData: mockSquareUsers
  })
}

/**
 * 获取用户详情（优先从高保真嘉宾列表查找）
 */
export async function getUserDetail(userId: number) {
  const list = mockRecommendUsers as any[]
  let found: any = null
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == userId) {
      found = list[i]
      break
    }
  }
  if (found == null && mockPaperPlanePeerProfile.id == userId) {
    found = mockPaperPlanePeerProfile as any
  }
  if (found == null) {
    const squareUsers = mockSquareUsers as any[]
    for (let i = 0; i < squareUsers.length; i++) {
      if (squareUsers[i].id == userId) {
        found = squareUsers[i]
        break
      }
    }
  }
  const detail = found != null
    ? {
        ...mockUserDetail,
        ...found,
        introduction: found.intro != null ? found.intro : (found.introduction != null ? found.introduction : mockUserDetail.introduction),
        genderText: found.gender == 1 ? '男' : '女',
        certList: ['实名', '学历', '头像', '单身']
      }
    : mockUserDetail

  return request({
    url: '/user/detail',
    cloudFunctionName: 'user',
    action: 'getDetail',
    method: 'GET',
    data: { userId },
    mockData: detail
  })
}

/**
 * 当前登录用户资料（我的）
 */
export async function getMeProfile() {
  return request({
    url: '/user/me',
    cloudFunctionName: 'user',
    action: 'getMe',
    method: 'GET',
    mockData: mockMeProfile
  })
}

/**
 * 申请认识用户
 * 门槛：仅实名（页面 guardRealName）；每日免费 3 次 + 积分加次说明
 * pending/accepted 幂等，不重复扣次；rejected 可再申请
 * 聊天仍须双方同意后开启；会员不可绕过同意门槛
 * 注意：request 外层 success 恒为 true，业务成败看 data.success / data.code
 */
export async function applyToMeet(userId: number, message: string) {
  const key = '' + userId
  const states = mockApplyStates as any
  const current = states[key] != null ? (states[key] as string) : 'none'

  if (current == 'pending') {
    return request({
      url: '/user/apply',
      cloudFunctionName: 'user',
      action: 'apply',
      method: 'POST',
      data: { userId, message },
      mockData: {
        success: true,
        code: 'ALREADY_PENDING',
        applyStatus: 'pending',
        remain: mockCommunityQuotas.applyDaily.remain,
        message: '申请已发送，请等待对方回应'
      }
    })
  }

  if (current == 'accepted') {
    return request({
      url: '/user/apply',
      cloudFunctionName: 'user',
      action: 'apply',
      method: 'POST',
      data: { userId, message },
      mockData: {
        success: true,
        code: 'ALREADY_ACCEPTED',
        applyStatus: 'accepted',
        remain: mockCommunityQuotas.applyDaily.remain,
        message: '对方已同意，可在消息中继续沟通'
      }
    })
  }

  const quotas = mockCommunityQuotas as any
  const applyQ = quotas.applyDaily
  // 与 me.remainApply 对齐（取较小值，避免双源漂移）
  if (mockMeProfile != null && mockMeProfile.remainApply != null) {
    const meRemain = mockMeProfile.remainApply as number
    if (meRemain < applyQ.remain) {
      applyQ.remain = meRemain
      applyQ.used = Math.max(0, applyQ.total - meRemain)
    }
  }

  if (applyQ.remain <= 0) {
    if (mockMeProfile != null) {
      mockMeProfile.remainApply = 0
    }
    return request({
      url: '/user/apply',
      cloudFunctionName: 'user',
      action: 'apply',
      method: 'POST',
      data: { userId, message },
      mockData: {
        success: false,
        code: 'QUOTA_EXCEEDED',
        remain: 0,
        applyStatus: current,
        message: '今日免费申请次数已用完，可用积分加次'
      }
    })
  }

  applyQ.used = (applyQ.used as number) + 1
  applyQ.remain = (applyQ.remain as number) - 1
  if (mockMeProfile != null) {
    mockMeProfile.remainApply = applyQ.remain
  }

  states[key] = 'pending'
  __syncApplyStatus(userId, 'pending')

  return request({
    url: '/user/apply',
    cloudFunctionName: 'user',
    action: 'apply',
    method: 'POST',
    data: { userId, message },
    mockData: {
      success: true,
      remain: applyQ.remain,
      applyStatus: 'pending',
      message: '申请已发送，对方同意后才能开始聊天'
    }
  })
}

/**
 * 喜欢用户
 */
export async function likeUser(userId: number) {
  const ids = mockLikedUserIds as number[]
  let liked = false
  let found = -1
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) {
      found = i
      break
    }
  }
  if (found >= 0) {
    ids.splice(found, 1)
    liked = false
  } else {
    ids.push(userId)
    liked = true
  }
  return request({
    url: '/user/like',
    cloudFunctionName: 'user',
    action: 'like',
    method: 'POST',
    data: { userId },
    mockData: { success: true, liked, userId }
  })
}
