/**
 * 获取推荐用户（支持轮换 index）
 */
export async function getRecommendUser(index: number = 0) {
  const list = mockRecommendUsers as any[]
  const i = list.length > 0 ? (index % list.length) : 0
  const user = list.length > 0 ? list[i] : mockUserDetail
  return request({
    url: '/user/recommend',
    cloudFunctionName: 'user',
    action: 'getRecommend',
    method: 'GET',
    data: { index: i },
    mockData: user
  })
}

/**
 * 获取推荐用户列表（全量）
 */
export async function getRecommendUsers(internalMockScope: string = '') {
  if (internalMockScope != '') {
    const state = getInternalUserMockState(internalMockScope)
    return okRes(mockUserListWithLikes(mockRecommendUsers as any[], state.likedUserIds))
  }
  return request({
    url: '/user/recommend/list',
    cloudFunctionName: 'user',
    action: 'getRecommendList',
    method: 'GET',
    mockData: mockRecommendUsers
  })
}

