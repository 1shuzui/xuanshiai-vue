export async function getOwnProfile() {
  if (USE_MOCK) {
    return request({
      url: '/user/me',
      cloudFunctionName: 'user',
      action: 'getMeProfile',
      method: 'GET',
      mockData: mockMeProfile
    })
  }
  return request({ url: '/users/me/profile', method: 'GET' })
}

export async function updateOwnProfile(data: any) {
  if (USE_MOCK) {
    const keys = Object.keys(data != null ? data : {})
    for (let i = 0; i < keys.length; i++) {
      mockMeProfile[keys[i]] = data[keys[i]]
    }
    return request({
      url: '/user/me/profile',
      cloudFunctionName: 'user',
      action: 'updateProfile',
      method: 'PATCH',
      data,
      mockData: mockMeProfile
    })
  }
  return request({ url: '/users/me/profile', method: 'PATCH', data })
}

export async function getOwnPreferences() {
  return request({
    url: '/users/me/preferences',
    method: 'GET',
    mockData: defaultMockPreferences
  })
}

export async function updateOwnPreferences(data: any) {
  const keys = Object.keys(data != null ? data : {})
  for (let i = 0; i < keys.length; i++) {
    defaultMockPreferences[keys[i]] = data[keys[i]]
  }
  return request({
    url: '/users/me/preferences',
    method: 'PUT',
    data,
    mockData: defaultMockPreferences
  })
}

function profileMediaPath(kind: string): string {
  if (kind == 'avatar') return '/users/me/avatar'
  if (kind == 'background') return '/users/me/background'
  return '/users/me/photos'
}

export async function uploadUserProfileMedia(filePath: string, kind: string) {
  const normalizedKind = kind == 'avatar' || kind == 'background' ? kind : 'photo'
  if (USE_MOCK) {
    return request({
      url: '/user/me/' + normalizedKind,
      cloudFunctionName: 'user',
      action: 'uploadProfileMedia',
      method: 'POST',
      mockData: {
        id: 0,
        media_type: normalizedKind,
        file_url: filePath,
        thumbnail_url: filePath,
        sort_order: 0,
        is_primary: normalizedKind == 'avatar',
        duration_seconds: null
      }
    })
  }

  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl(profileMediaPath(normalizedKind)),
      filePath,
      name: 'file',
      header: getAccessToken() != '' ? { Authorization: 'Bearer ' + getAccessToken() } : {},
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, code: res.statusCode, message: '上传响应解析失败' })
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve({ success: true, data, code: res.statusCode, message: 'success' })
        } else {
          const detail = data != null && data.detail != null ? data.detail : '上传失败'
          resolve({ success: false, data, code: res.statusCode, message: '' + detail })
        }
      },
      fail: (err: any) => {
        const message = err != null && err.errMsg != null ? '' + err.errMsg : '上传失败，请检查网络'
        resolve({ success: false, data: null, code: -1, message })
      }
    })
  })
}

