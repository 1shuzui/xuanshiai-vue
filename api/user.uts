/** 获取用户级喜欢列表；父母内部审校通过 scope 与普通用户状态隔离。 */
export async function getLikedUsers(internalMockScope: string = '') {
  if (internalMockScope != '') {
    const state = getInternalUserMockState(internalMockScope)
    const source = (mockRecommendUsers as any[]).concat(mockSquareUsers as any[])
    const output: any[] = []
    const seen: number[] = []
    for (let i = 0; i < source.length; i++) {
      const id = Number(source[i].id)
      if (!userIsLiked(id, state.likedUserIds) || seen.indexOf(id) >= 0) continue
      seen.push(id)
      output.push({ ...source[i], liked: true })
    }
    return okRes(output)
  }

  if (USE_MOCK) {
    const source = (mockRecommendUsers as any[]).concat(mockSquareUsers as any[])
    const output: any[] = []
    const seen: number[] = []
    for (let i = 0; i < source.length; i++) {
      const id = Number(source[i].id)
      if (!userIsLiked(id, mockLikedUserIds as number[]) || seen.indexOf(id) >= 0) continue
      seen.push(id)
      output.push({ ...source[i], liked: true })
    }
    return okRes(output)
  }

  const output: any[] = []
  const seen: number[] = []
  let page = 1
  const pageSize = 50
  while (true) {
    const res = await request({
      url: '/relations/likes',
      method: 'GET',
      data: { page: page, page_size: pageSize }
    })
    if (res == null || res.success != true || res.data == null) return res
    const items = res.data.items != null
      ? res.data.items as any[]
      : res.data.list != null
        ? res.data.list as any[]
        : [] as any[]
    for (let i = 0; i < items.length; i++) {
      const raw = items[i] != null && items[i].user != null
        ? items[i].user
        : items[i] != null && items[i].target_user != null
          ? items[i].target_user
          : items[i]
      const id = raw != null && raw.id != null
        ? Number(raw.id)
        : items[i] != null && items[i].user_id != null
          ? Number(items[i].user_id)
          : 0
      if (id <= 0 || seen.indexOf(id) >= 0) continue
      seen.push(id)
      output.push({ ...raw, id: id, liked: true })
    }
    const hasMore = res.data.has_more == true || res.data.hasMore == true
    if (!hasMore && items.length < pageSize) break
    if (items.length == 0 || page >= 100) break
    page += 1
  }
  return okRes(output)
}
