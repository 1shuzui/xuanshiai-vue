type InternalUserMockState = {
  likedUserIds: number[]
  applyStates: any
  remainingApplications: number
}

const internalUserMockStates: any = {}

function getInternalUserMockState(scope: string): InternalUserMockState {
  const key = scope != null ? scope.trim() : ''
  const existing = internalUserMockStates[key]
  if (existing != null) return existing as InternalUserMockState
  const state = {
    likedUserIds: (mockLikedUserIds as number[]).slice(),
    applyStates: { ...mockApplyStates },
    remainingApplications: 2
  } as InternalUserMockState
  internalUserMockStates[key] = state
  return state
}

function userIsLiked(userId: number, ids: number[]): boolean {
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function mockUserListWithLikes(source: any[], ids: number[]): any[] {
  const output: any[] = []
  for (let i = 0; i < source.length; i++) {
    output.push({ ...source[i], liked: userIsLiked(Number(source[i].id), ids) })
  }
  return output
}

