/**
 * 发布动态
 * 新签名：publishDynamic({ content, media?, location?, topicId?, visibility?, declaration? })
 * 兼容：publishDynamic(content, photos, location, topicId, visibility)
 */
export async function publishDynamic(
  contentOrPayload: any,
  photosArg: string[] = [],
  locationArg: string = '',
  topicIdArg: number = 0,
  visibilityArg: number = 0
) {
  let content = ''
  let photos: string[] = []
  let videos: string[] = []
  let location = ''
  let topicId = 0
  let visibility = 0
  let declaration = ''

  if (contentOrPayload != null && typeof contentOrPayload === 'object' && !Array.isArray(contentOrPayload)) {
    content = contentOrPayload.content != null ? ('' + contentOrPayload.content).trim() : ''
    const media = contentOrPayload.media != null ? contentOrPayload.media : contentOrPayload.photos
    photos = media != null ? (media as string[]) : []
    const rawVideos = contentOrPayload.videos
    videos = rawVideos != null ? (rawVideos as string[]) : []
    location = contentOrPayload.location != null ? ('' + contentOrPayload.location) : ''
    topicId = contentOrPayload.topicId != null ? (contentOrPayload.topicId as number) : 0
    visibility = contentOrPayload.visibility != null ? (contentOrPayload.visibility as number) : 0
    declaration = contentOrPayload.declaration != null ? ('' + contentOrPayload.declaration) : ''
  } else {
    content = contentOrPayload != null ? ('' + contentOrPayload).trim() : ''
    photos = photosArg != null ? photosArg : []
    location = locationArg != null ? locationArg : ''
    topicId = topicIdArg
    visibility = visibilityArg
  }

  const hasPhotos = photos != null && photos.length > 0
  const hasVideos = videos != null && videos.length > 0
  if (content.length == 0 && !hasPhotos && !hasVideos) {
    return request({
      url: '/community/dynamic/publish',
      cloudFunctionName: 'community',
      action: 'publishDynamic',
      method: 'POST',
      data: {
        content: content,
        photos: photos,
        videos: videos,
        location: location,
        topicId: topicId,
        visibility: visibility,
        declaration: declaration
      },
      mockData: {
        success: false,
        code: 'EMPTY_CONTENT',
        message: '请添加正文或图片、视频后再发布'
      }
    })
  }

  // 图片与视频互斥：API 层强制，防止绕过页面 UI
  if (hasPhotos && hasVideos) {
    return request({
      url: '/community/dynamic/publish',
      cloudFunctionName: 'community',
      action: 'publishDynamic',
      method: 'POST',
      data: {
        content: content,
        photos: photos,
        videos: videos,
        location: location,
        topicId: topicId,
        visibility: visibility,
        declaration: declaration
      },
      mockData: {
        success: false,
        code: 'INVALID_MEDIA',
        message: '图片与视频不能同时发布，请只保留一种媒体'
      }
    })
  }

  // 视频最多 1 条
  if (hasVideos && videos.length > 1) {
    videos = [videos[0]]
  }
  // 图片最多 9 张
  if (hasPhotos && photos.length > 9) {
    photos = photos.slice(0, 9)
  }

  let topicTitle = ''
  let topic: any = null
  if (topicId > 0) {
    topic = findTopic(topicId)
    if (topic != null && topic.title != null) {
      topicTitle = '' + topic.title
    }
  }
  const mediaType = hasVideos ? 'video' : (hasPhotos ? 'image' : 'none')
  const finalPhotos: string[] = hasVideos ? [] : (photos != null ? photos : [])
  const finalVideos: string[] = hasVideos ? videos : []

  const dynamicId = Date.now()
  const cityName = location != '' ? ('' + location).split('·')[0].trim() : mockCurrentCity.name
  const item = {
    id: dynamicId,
    user: {
      id: 9001,
      avatar: '/static/portraits/profile-man-light.jpg',
      name: '顾言澄',
      age: 29,
      gender: '男',
      birthYear: 1997,
      ipLocation: '江苏',
      income: '',
      city: mockCurrentCity.name,
      height: '178cm',
      job: '产品经理',
      education: '本科',
      verified: true,
      realNameStatus: 'passed',
      educationStatus: 'missing'
    },
    content: content,
    photos: finalPhotos,
    media: finalPhotos,
    videos: finalVideos,
    mediaType: mediaType,
    location: location,
    cityTag: cityName == mockCurrentCity.name,
    city: cityName,
    topicId: topicId > 0 ? topicId : null,
    topicTitle: topicTitle,
    relationTags: [],
    tags: declaration != '' ? [declaration] : [],
    declaration: declaration,
    time: Date.now(),
    timeText: '刚刚',
    likeCount: 0,
    commentCount: 0,
    collectCount: 0,
    liked: false,
    collected: false,
    followed: false,
    applyStatus: 'none',
    tabs: ['discover', cityName == mockCurrentCity.name ? 'city' : 'discover'],
    tab: 'discover',
    comments: [],
    visibility: visibility
  }
  ;(mockDynamicList as any[]).unshift(item)
  if (topicId > 0 && topic != null) {
    topic.postCount = ((topic.postCount as number) || 0) + 1
    markTopicParticipation(topic)
  }
  return request({
    url: '/community/dynamic/publish',
    forceHttp: true,
    mockFallback: true,
    method: 'POST',
    data: {
      content: content,
      photos: finalPhotos,
      videos: finalVideos,
      mediaType: mediaType,
      topicTitle: topicTitle,
      location: location,
      topicId: topicId,
      visibility: visibility,
      declaration: declaration
    },
    mockData: { success: true, dynamicId: dynamicId, dynamic: item }
  })
}

export async function likeDynamic(dynamicId: number) {
  const item = findDynamic(dynamicId)
  if (item != null) {
    item.liked = !item.liked
    item.likeCount = (item.likeCount as number) + (item.liked ? 1 : -1)
  }
  return request({
    url: '/community/dynamic/like',
    forceHttp: true,
    mockFallback: true,
    method: 'POST',
    data: { dynamicId },
    mockData: {
      success: true,
      liked: item != null ? item.liked : true,
      likeCount: item != null ? item.likeCount : 0
    }
  })
}

export async function collectDynamic(dynamicId: number) {
  const item = findDynamic(dynamicId)
  if (item != null) {
    item.collected = !item.collected
    item.collectCount = (item.collectCount as number) + (item.collected ? 1 : -1)
  }
  return request({
    url: '/community/dynamic/collect',
    cloudFunctionName: 'community',
    action: 'collectDynamic',
    method: 'POST',
    data: { dynamicId },
    mockData: {
      success: true,
      collected: item != null ? item.collected : true,
      collectCount: item != null ? item.collectCount : 0
    }
  })
}

export async function followUserFromCommunity(userId: number) {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null && all[i].user.id == userId) {
      all[i].followed = true
      if (all[i].tabs != null && all[i].tabs.indexOf('follow') < 0) {
        ;(all[i].tabs as any[]).push('follow')
      }
    }
  }
  return request({
    url: '/community/follow',
    cloudFunctionName: 'community',
    action: 'followUser',
    method: 'POST',
    data: { userId },
    mockData: { success: true, followed: true }
  })
}

/**
 * 评论动态
 * 新签名：commentDynamic({ dynamicId, content, replyToCommentId? })
 * 兼容：commentDynamic(dynamicId, content, replyToId)
 */
export async function commentDynamic(
  dynamicIdOrPayload: any,
  contentArg: string = '',
  replyToIdArg: number = 0
) {
  let dynamicId = 0
  let content = ''
  let replyToCommentId = 0

  if (dynamicIdOrPayload != null && typeof dynamicIdOrPayload === 'object') {
    dynamicId = dynamicIdOrPayload.dynamicId != null ? (dynamicIdOrPayload.dynamicId as number) : 0
    content = dynamicIdOrPayload.content != null ? ('' + dynamicIdOrPayload.content).trim() : ''
    replyToCommentId =
      dynamicIdOrPayload.replyToCommentId != null
        ? (dynamicIdOrPayload.replyToCommentId as number)
        : dynamicIdOrPayload.replyToId != null
          ? (dynamicIdOrPayload.replyToId as number)
          : 0
  } else {
    dynamicId = dynamicIdOrPayload as number
    content = contentArg != null ? ('' + contentArg).trim() : ''
    replyToCommentId = replyToIdArg
  }

  if (content.length == 0) {
    return request({
      url: '/community/dynamic/comment',
      cloudFunctionName: 'community',
      action: 'commentDynamic',
      method: 'POST',
      data: { dynamicId, content, replyToCommentId },
      mockData: {
        success: false,
        code: 'EMPTY_CONTENT',
        message: '请输入评论内容'
      }
    })
  }

  const item = findDynamic(dynamicId)
  const comment = {
    id: Date.now(),
    user: {
      id: 9001,
      name: '顾言澄',
      avatar: '/static/portraits/profile-man-light.jpg',
      realNameStatus: 'passed'
    },
    content,
    timeText: '刚刚',
    likeCount: 0,
    liked: false,
    replyTo: replyToCommentId > 0 ? replyToCommentId : null,
    replyToCommentId: replyToCommentId > 0 ? replyToCommentId : null
  }
  if (item != null) {
    if (item.comments == null) item.comments = []
    ;(item.comments as any[]).push(comment)
    item.commentCount = (item.commentCount as number) + 1
  }

  const notes = mockCommunityNotifications as any[]
  notes.unshift({
    id: Date.now() + 1,
    type: 'comment',
    title: '有人评论了动态',
    content: content.length > 24 ? content.substring(0, 24) + '…' : content,
    timeText: '刚刚',
    read: false,
    targetType: 'post',
    targetId: dynamicId
  })

  return request({
    url: '/community/dynamic/comment',
    cloudFunctionName: 'community',
    action: 'commentDynamic',
    method: 'POST',
    data: { dynamicId, content, replyToCommentId },
    mockData: { success: true, comment }
  })
}

