  }
  return okRes(list)
}

/**
 * 分页话题列表
 * getTopicList({ sort, page, pageSize, excludeIds })
 * 返回 { list, page, pageSize, total, hasMore }
 */
export async function getTopicList(query: any = null) {
  const sort = query != null && query.sort != null ? ('' + query.sort) : 'hot'
  const page = query != null && query.page != null && (query.page as number) > 0 ? (query.page as number) : 1
  const pageSize = query != null && query.pageSize != null && (query.pageSize as number) > 0 ? (query.pageSize as number) : 10
  const excludeIds = query != null ? query.excludeIds : null


  const sortKey = sort == 'new' || sort == 'latest' ? 'latest' : 'hot'
  const params: any = { sort: sortKey, page: page, page_size: pageSize }
  if (excludeIds != null && Array.isArray(excludeIds) && excludeIds.length > 0) {
    params.exclude_ids = excludeIds
  }
  const res = await request({
    url: '/community/topics/page',
    method: 'GET',
    data: params
  })
  if (!res.success) return res
  const raw = res.data
  const items = raw != null && raw.items != null ? (raw.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapTopic(items[i]))
  }
  const total = raw != null && raw.total != null ? (raw.total as number) : list.length
  return okRes({
    list: list,
    page: page,
    pageSize: pageSize,
    total: total,
    hasMore: page * pageSize < total
  })
}

export async function getTopicDetail(topicId: number, sort: string = 'hot', page: number = 1, pageSize: number = 20) {

  const sortKey = sort == 'latest' || sort == 'new' ? 'latest' : 'hot'
  const res = await request({
    url: '/community/topics/' + topicId + '/detail',
    method: 'GET',
    data: { sort: sortKey, page: page, page_size: pageSize }
  })
  if (!res.success) return res
  const raw = res.data
  const topic = mapTopic(raw != null ? raw.topic : null)
  const postsPage = raw != null && raw.posts != null ? raw.posts : null
  const postsRaw = postsPage != null && postsPage.items != null ? (postsPage.items as any[]) : []
  const posts: any[] = []
  for (let i = 0; i < postsRaw.length; i++) {
    posts.push(mapPost(postsRaw[i]))
  }
  return okRes({
    topic: topic,
    posts: posts,
    sort: sortKey,
    page: postsPage != null && postsPage.page != null ? postsPage.page : page,
    pageSize: postsPage != null && postsPage.page_size != null ? postsPage.page_size : pageSize,
    total: postsPage != null && postsPage.total != null ? postsPage.total : posts.length,
    hasMore: postsPage != null && postsPage.total != null
      ? ((postsPage.page != null ? postsPage.page : page) * (postsPage.page_size != null ? postsPage.page_size : pageSize) < postsPage.total)
      : posts.length >= pageSize
  })
}

