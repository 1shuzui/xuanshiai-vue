}

export async function collectDynamic(dynamicId: number) {

  const detail = await request({
    url: '/community/posts/' + dynamicId,
    method: 'GET'
  })
  if (!detail.success || detail.data == null) {
    return failRes(extractHttpMessage(detail, '动态加载失败，无法收藏'), detail.code)
  }
  const currentlyCollected = detail.data.is_collected == true
  const method = currentlyCollected ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/posts/' + dynamicId + '/collect',
    method: method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    collected: raw != null && raw.is_collected == true,
    collectCount: raw != null && raw.collect_count != null ? raw.collect_count : 0
  })
}

