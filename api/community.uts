// ─── 发布 / 点赞 / 收藏 / 关注 / 评论 ───────────────────────

/**
 * 发布动态
 * 新签名：publishDynamic({ content, media?, location?, topicId?, visibility?, declaration? })
 * 兼容：publishDynamic(content, photos, location, topicId, visibility)
 */
export async function publishDynamic(
  contentOrPayload: any,
  photosArg: string[] = [],
  locationArg: string = '',
  topicIdArg: number = 0,
  visibilityArg: number = 0
) {
  let content = ''
  let photos: string[] = []
  let videos: string[] = []
  let location = ''
  let topicId = 0
  let visibility = 0
  let declaration = ''
  let suppliedCreateKey = ''

  if (contentOrPayload != null && typeof contentOrPayload === 'object' && !Array.isArray(contentOrPayload)) {
    content = contentOrPayload.content != null ? ('' + contentOrPayload.content).trim() : ''
    const media = contentOrPayload.media != null ? contentOrPayload.media : contentOrPayload.photos
    photos = media != null ? (media as string[]) : []
    const rawVideos = contentOrPayload.videos
    videos = rawVideos != null ? (rawVideos as string[]) : []
    location = contentOrPayload.location != null ? ('' + contentOrPayload.location) : ''
    topicId = contentOrPayload.topicId != null ? (contentOrPayload.topicId as number) : 0
    visibility = contentOrPayload.visibility != null ? (contentOrPayload.visibility as number) : 0
    declaration = contentOrPayload.declaration != null ? ('' + contentOrPayload.declaration) : ''
    suppliedCreateKey = contentOrPayload.idempotencyKey != null ? ('' + contentOrPayload.idempotencyKey) : ''
  } else {
    content = contentOrPayload != null ? ('' + contentOrPayload).trim() : ''
    photos = photosArg != null ? photosArg : []
    location = locationArg != null ? locationArg : ''
    topicId = topicIdArg
    visibility = visibilityArg
  }

  const hasPhotos = photos != null && photos.length > 0
  const hasVideos = videos != null && videos.length > 0
  if (content.length == 0 && !hasPhotos && !hasVideos) {
    return failRes('请添加正文或图片、视频后再发布', 'EMPTY_CONTENT')
  }
  if (hasPhotos && hasVideos) {
    return failRes('图片与视频不能同时发布，请只保留一种媒体', 'INVALID_MEDIA')
  }
  if (hasVideos && videos.length > 1) {
    videos = [videos[0]]
  }
  if (hasPhotos && photos.length > 9) {
    photos = photos.slice(0, 9)
  }

  if (USE_MOCK) {
    let topicTitle = ''
    let topic: any = null
    if (topicId > 0) {
      topic = findTopic(topicId)
      if (topic != null && topic.title != null) {
        topicTitle = '' + topic.title
      }
    }
    const mediaType = hasVideos ? 'video' : (hasPhotos ? 'image' : 'none')
    const finalPhotos: string[] = hasVideos ? [] : (photos != null ? photos : [])
    const finalVideos: string[] = hasVideos ? videos : []
    const dynamicId = Date.now()
    const cityName = location != '' ? ('' + location).split('·')[0].trim() : mockCurrentCity.name
    const item = {
      id: dynamicId,
      user: {
        id: 9001,
        avatar: '/static/portraits/profile-man-light.jpg',
        name: '顾言澄',
        age: 29,
        gender: '男',
        birthYear: 1997,
        ipLocation: '江苏',
        income: '',
        city: mockCurrentCity.name,
        height: '178cm',
        job: '产品经理',
        education: '本科',
        verified: true,
        realNameStatus: 'passed',
        educationStatus: 'missing'
      },
      content: content,
      photos: finalPhotos,
      media: finalPhotos,
      videos: finalVideos,
      mediaType: mediaType,
      location: location,
      cityTag: cityName == mockCurrentCity.name,
      city: cityName,
      topicId: topicId > 0 ? topicId : null,
      topicTitle: topicTitle,
      relationTags: [],
      tags: declaration != '' ? [declaration] : [],
      declaration: declaration,
      time: Date.now(),
      timeText: '刚刚',
      likeCount: 0,
      commentCount: 0,
      collectCount: 0,
      liked: false,
      collected: false,
      followed: false,
      applyStatus: 'none',
      tabs: ['discover', cityName == mockCurrentCity.name ? 'city' : 'discover'],
      tab: 'discover',
      comments: [],
      visibility: visibility
    }
    ;(mockDynamicList as any[]).unshift(item)
    if (topicId > 0 && topic != null) {
      topic.postCount = ((topic.postCount as number) || 0) + 1
      markTopicParticipation(topic)
    }
    return request({
      url: '/community/dynamic/publish',
      cloudFunctionName: 'community',
      action: 'publishDynamic',
      method: 'POST',
      data: {
        content: content,
        photos: finalPhotos,
        videos: finalVideos,
        mediaType: mediaType,
        topicTitle: topicTitle,
        location: location,
        topicId: topicId,
        visibility: visibility,
        declaration: declaration
      },
      mockData: { success: true, dynamicId: dynamicId, dynamic: item }
    })
  }

  const body: any = {
    content: content.length > 0 ? content : (hasVideos ? '[视频动态]' : '[图片动态]'),
    images: hasVideos ? [] : (photos != null ? photos : []),
    video: hasVideos && videos.length > 0 ? videos[0] : null,
    location: location != '' ? location : null,
    topic_id: topicId > 0 ? topicId : null,
    visibility: visibility,
    declaration: declaration
  }
  const selectedMedia = hasVideos ? videos : photos
  for (let i = 0; i < selectedMedia.length; i++) {
    if (isTemporaryMediaPath(selectedMedia[i])) {
      return failRes('图片和视频上传服务尚未接入，暂不能发布媒体动态', 'MEDIA_UPLOAD_REQUIRED')
    }
  }
  const key = idempotencyKey('post', suppliedCreateKey)
  const res = await request({
    url: '/community/posts',
    method: 'POST',
    data: body,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) {
    if (isConfirmedWriteRejection(res)) {
      return failRes(extractHttpMessage(res, '发布失败，请重试'), res.code, { idempotencyRejected: true })
    }
    return res
  }
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, idempotencyRejected: true, message: res.data.message != null ? res.data.message : '发布失败，请重试' })
  }
  const dynamic = mapPost(res.data)
  return okRes({
    success: true,
    dynamicId: dynamic != null ? dynamic.id : 0,
    dynamic: dynamic
  })
}

export async function likeDynamic(dynamicId: number) {
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item != null) {
      item.liked = !item.liked
      item.likeCount = (item.likeCount as number) + (item.liked ? 1 : -1)
    }
    return request({
      url: '/community/dynamic/like',
      cloudFunctionName: 'community',
      action: 'likeDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: {
        success: true,
        liked: item != null ? item.liked : true,
        likeCount: item != null ? item.likeCount : 0
      }
    })
  }

  // 先取当前状态再 toggle；详情预检失败不默认 PUT
  const detail = await request({
    url: '/community/posts/' + dynamicId,
    method: 'GET'
  })
  if (!detail.success || detail.data == null) {
    return failRes(extractHttpMessage(detail, '动态加载失败，无法点赞'), detail.code)
  }
  const currentlyLiked = detail.data.is_liked == true
  const method = currentlyLiked ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/posts/' + dynamicId + '/like',
    method: method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    liked: raw != null && raw.is_liked == true,
    likeCount: raw != null && raw.like_count != null ? raw.like_count : 0
  })
}

export async function collectDynamic(dynamicId: number) {
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item != null) {
