// ─── Real API adapters (snake_case → 页面 camelCase) ────────

function mapPost(row: any): any {
  if (row == null) return null
  const images = row.images != null ? row.images : []
  const video = row.video != null ? ('' + row.video) : ''
  const hasVideo = video != ''
  const photos: string[] = hasVideo ? [] : (images as string[])
  const videos: string[] = hasVideo ? [video] : []
  const created = row.created_at != null ? row.created_at : row.createdAt
  const city = row.residence != null ? ('' + row.residence) : (row.location != null ? ('' + row.location) : '')
  const realNameStatus = realNameStatusFrom(row.realname_status)
  return {
    id: row.id,
    user: {
      id: row.user_id != null ? row.user_id : row.userId,
      avatar: row.avatar != null ? row.avatar : '',
      name: row.nickname != null ? row.nickname : '用户',
      age: row.age != null ? row.age : 0,
      city: city,
      height: '',
      job: '',
      education: '',
      school: row.school != null ? row.school : '',
      mbti: row.mbti != null ? row.mbti : '',
      hometown: row.hometown != null ? row.hometown : '',
      gender: genderText(row.gender),
      verified: realNameStatus == 'passed',
      realNameStatus: realNameStatus,
      educationStatus: 'missing'
    },
    content: row.content != null ? row.content : '',
    photos: photos,
    media: photos,
    videos: videos,
    mediaType: hasVideo ? 'video' : (photos.length > 0 ? 'image' : 'none'),
    location: row.location != null ? row.location : '',
    cityTag: false,
    city: city,
    topicId: row.topic_id != null ? row.topic_id : null,
    topicTitle: row.topic_name != null ? row.topic_name : '',
    relationTags: [],
    tags: [],
    declaration: row.declaration != null ? row.declaration : '',
    time: toMs(created),
    timeText: timeTextFrom(created),
    likeCount: row.like_count != null ? row.like_count : 0,
    commentCount: row.comment_count != null ? row.comment_count : 0,
    collectCount: row.collect_count != null ? row.collect_count : 0,
    liked: row.is_liked == true,
    collected: row.is_collected == true,
    followed: row.is_followed == true,
    applyStatus: 'none',
    tabs: ['discover'],
    tab: 'discover',
    comments: [],
    visibility: row.visibility != null ? row.visibility : 0
  }
}

function mapComment(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    user: {
      id: row.user_id,
      name: row.nickname != null ? row.nickname : '用户',
      avatar: row.avatar != null ? row.avatar : '',
      realNameStatus: 'missing'
    },
    content: row.content != null ? row.content : '',
    timeText: timeTextFrom(row.created_at),
    likeCount: row.like_count != null ? row.like_count : 0,
    liked: row.is_liked == true,
    replyTo: row.parent_id != null ? row.parent_id : null,
    replyToCommentId: row.parent_id != null ? row.parent_id : null
  }
}

function mapTopic(row: any): any {
  if (row == null) return null
  const name = row.name != null ? ('' + row.name) : ''
  const title = name != '' ? name : '话题'
  return {
    id: row.id,
    tag: name.indexOf('#') == 0 ? name : '# ' + title,
    title: title,
    name: title,
    description: '',
    cover: row.icon != null ? row.icon : '',
    icon: row.icon != null ? row.icon : '',
    participantCount: row.participant_count != null ? row.participant_count : 0,
    postCount: row.post_count != null ? row.post_count : 0,
    viewCount: 0,
    heat: row.heat != null ? row.heat : 0,
    createdAt: toMs(row.created_at),
    isHot: (row.heat != null ? (row.heat as number) : 0) >= 5000,
    joined: row.joined == true,
    rules: [],
    sort: row.sort != null ? row.sort : 0
  }
}

function mapActivity(row: any): any {
  if (row == null) return null
  const start = row.start_time != null ? row.start_time : null
  const startMs = toMs(start)
  const d = new Date(startMs)
  const y = d.getFullYear()
  const m = (d.getMonth() + 1 < 10 ? '0' : '') + (d.getMonth() + 1)
  const day = (d.getDate() < 10 ? '0' : '') + d.getDate()
  const hh = (d.getHours() < 10 ? '0' : '') + d.getHours()
  const mm = (d.getMinutes() < 10 ? '0' : '') + d.getMinutes()
  const statusText = row.status_text != null ? ('' + row.status_text) : 'recruiting'
  const myStatusText = row.my_status_text != null ? ('' + row.my_status_text) : 'none'
  const city = row.city != null ? ('' + row.city) : ''
  const address = row.address != null ? ('' + row.address) : ''
  let location = city
  if (address != '') {
    location = city != '' ? city + ' · ' + address : address
  } else if (city != '') {
    location = city + '（审核通过后告知集合点）'
  }
  return {
    id: row.id,
    title: row.title != null ? row.title : '',
    description: row.description != null ? row.description : '',
    cover: row.cover != null ? row.cover : '',
    date: y + '-' + m + '-' + day,
    time: hh + ':' + mm,
    location: location,
    participantCount: row.current_people != null ? row.current_people : 0,
    maxParticipants: row.max_people != null ? row.max_people : 0,
    tags: row.type != null && ('' + row.type) != '' ? ['' + row.type] : [],
    organizer: { name: '宣誓爱活动组', avatar: '' },
    price: row.price != null ? row.price : 0,
    status: statusText,
    kicker: 'OFFLINE',
    safetyNotes: ['仅面向已实名用户报名', '集合点审核通过后告知'],
    myStatus: myStatusText == 'none' || myStatusText == '' ? 'none' : myStatusText
  }
}

function mapBanner(row: any): any {
  if (row == null) return null
  const linkType = row.link_type != null ? ('' + row.link_type) : 'topic'
  let type = 'topic'
  if (linkType == 'activity' || linkType == 'offline') type = 'activity'
  else if (linkType == 'plane' || linkType == 'paper_plane' || linkType == 'paper-plane') type = 'plane'
  else if (linkType == 'topic') type = 'topic'
  else type = linkType
  let targetId = 0
  const lv = row.link_value
  if (lv != null) {
    const n = parseInt('' + lv, 10)
    if (!isNaN(n)) targetId = n
  }
  return {
    id: row.id,
    type: type,
    title: row.title != null ? row.title : '',
    subtitle: '',
    description: '',
    cta: type == 'activity' ? '查看活动' : type == 'plane' ? '去放飞' : '进入话题',
    kicker: type == 'activity' ? 'OFFLINE' : type == 'plane' ? 'PLANE' : 'TOPIC',
    cover: row.image_url != null ? row.image_url : '',
    targetId: targetId
  }
}

function mapQuotaItem(row: any): any {
  if (row == null) {
    return { total: 0, used: 0, remain: 0, pointsAvailable: false, pointsCost: 0 }
  }
  return {
    total: row.total != null ? row.total : 0,
    used: row.used != null ? row.used : 0,
    remain: row.remain != null ? row.remain : 0,
    // fail-closed：缺字段不当可加次
    pointsAvailable: row.points_available != null ? row.points_available == true : false,
    pointsCost: row.points_cost != null ? row.points_cost : 0
  }
}

function mapQuotas(row: any): any {
  if (row == null) return null
  return {
    applyDaily: mapQuotaItem(row.apply_daily),
    paperPlaneDaily: mapQuotaItem(row.paper_plane_daily)
  }
}

function mapPaperPlane(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    content: row.content != null ? row.content : '',
    anonymous: row.is_anonymous == true,
    scope: 'city',
    gender: '',
    age: 0,
    city: row.city != null ? row.city : '',
    userId: null,
    time: toMs(row.created_at),
    timeText: timeTextFrom(row.created_at),
    replyCount: row.reply_count != null ? row.reply_count : 0,
    replied: false,
    images: row.images != null ? row.images : [],
    tags: row.tags != null ? row.tags : [],
    voiceUrl: row.voice_url != null ? row.voice_url : '',
    voiceDurationSec: row.voice_duration_sec != null ? row.voice_duration_sec : 0,
    conversationId: row.conversation_id != null ? row.conversation_id : 0
  }
}

function mapNotification(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    type: row.notification_type != null ? row.notification_type : 'system',
    title: row.title != null ? row.title : '',
    content: row.content != null ? row.content : '',
    timeText: timeTextFrom(row.created_at),
    read: row.is_read == true,
    targetType: 'post',
    targetId: row.related_id != null ? row.related_id : 0
  }
}

function feedModeFromTab(tab: string, filter: string): any {
  // 返回 { mode, filter, sort, mergeLiked? }
  // mergeLiked 恒 false：并集走 BE mode=following_and_liked，禁止客户端假分页
  if (tab == 'follow') {
    if (filter == 'following') return { mode: 'following', filter: null, sort: 'latest', mergeLiked: false }
    if (filter == 'likedUsers') return { mode: 'liked_users', filter: null, sort: 'latest', mergeLiked: false }
    // 全部：关注 ∪ 用户级喜欢（BE following_and_liked）
    return { mode: 'following_and_liked', filter: null, sort: 'latest', mergeLiked: false }
  }
  if (tab == 'city') {
    let sort = 'latest'
    if (filter == 'hot') sort = 'hot'
    return { mode: 'city', filter: null, sort: sort, mergeLiked: false }
  }
  // discover
  let f: any = null
  if (filter == 'mbti' || filter == 'alumni' || filter == 'hometown') f = filter
  return { mode: 'latest', filter: f, sort: 'latest', mergeLiked: false }
}

/** 真路径拉一页帖子并 map */
async function fetchPostPage(params: any): Promise<any> {
  const res = await request({
    url: '/community/posts',
    method: 'GET',
    data: params
  })
  if (!res.success) return res
  const raw = res.data
  const items = raw != null && raw.items != null ? (raw.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapPost(items[i]))
  }
  const total = raw != null && raw.total != null ? (raw.total as number) : list.length
  return okRes({
    list: list,
    page: params.page,
    pageSize: params.page_size,
    total: total,
    rawTotal: total
  })
}

/** following ∪ liked_users 去重后按 time 降序，再本地分页 */
function mergeFollowAndLikedLists(a: any[], b: any[]): any[] {
  const seen: any = {}
  const out: any[] = []
  for (let i = 0; i < a.length; i++) {
    const id = a[i] != null ? a[i].id : 0
    if (id > 0 && seen['' + id] != true) {
      seen['' + id] = true
      out.push(a[i])
    }
  }
  for (let j = 0; j < b.length; j++) {
    const id2 = b[j] != null ? b[j].id : 0
    if (id2 > 0 && seen['' + id2] != true) {
      seen['' + id2] = true
      out.push(b[j])
    }
  }
  out.sort((x: any, y: any) => {
    const tx = x != null && x.time != null ? (x.time as number) : 0
    const ty = y != null && y.time != null ? (y.time as number) : 0
    return ty - tx
  })
  return out
}

