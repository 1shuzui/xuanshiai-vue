/**
 * 放飞纸飞机
 * 新签名：sendPaperPlane({ content, scope?, anonymous? })
 * 兼容：sendPaperPlane(content, anonymous)
 */
export async function sendPaperPlane(contentOrPayload: any, anonymousArg: boolean = true) {
  let content = ''
  let anonymous = true
  let scope = 'city'
  let suppliedCreateKey = ''
  let voiceUrl = ''
  let voiceDurationSec = 0
  let imageMediaIds: number[] = []
  if (contentOrPayload != null && typeof contentOrPayload === 'object') {
    content = contentOrPayload.content != null ? ('' + contentOrPayload.content).trim() : ''
    anonymous = contentOrPayload.anonymous != null ? contentOrPayload.anonymous == true : true
    scope = contentOrPayload.scope != null ? contentOrPayload.scope : 'city'
    suppliedCreateKey = contentOrPayload.idempotencyKey != null ? ('' + contentOrPayload.idempotencyKey) : ''
    voiceUrl = contentOrPayload.voiceUrl != null ? ('' + contentOrPayload.voiceUrl) : ''
    voiceDurationSec = contentOrPayload.voiceDurationSec != null ? (contentOrPayload.voiceDurationSec as number) : 0
    const rawImageMediaIds = contentOrPayload.imageMediaIds != null ? contentOrPayload.imageMediaIds : contentOrPayload.image_media_ids
    if (rawImageMediaIds != null && Array.isArray(rawImageMediaIds)) {
      imageMediaIds = rawImageMediaIds as number[]
    }
  } else {
    content = contentOrPayload != null ? ('' + contentOrPayload).trim() : ''
    anonymous = anonymousArg
  }

  const hasImageMediaIds = imageMediaIds != null && imageMediaIds.length > 0
  if (content.length == 0 && voiceUrl == '' && !hasImageMediaIds) {
    return failRes('请写下内容或录制语音', 'EMPTY_CONTENT')
  }
  if (content.length > 120) {
    return failRes('纸飞机内容不能超过 120 字', 'CONTENT_TOO_LONG')
  }
  if (voiceUrl != '' && (voiceDurationSec < 1 || voiceDurationSec > 60)) {
    return failRes('语音时长需在 1-60 秒', 'INVALID_VOICE')
  }


  const key = idempotencyKey('paper-plane', suppliedCreateKey)
  const planeBody: any = {
    content: content,
    images: [],
    city: null,
    tags: [],
    is_anonymous: anonymous,
    voice_url: voiceUrl != '' ? voiceUrl : null,
    voice_duration_sec: voiceUrl != '' ? voiceDurationSec : null
  }
  if (hasImageMediaIds) {
    planeBody.image_media_ids = imageMediaIds
  }
  const res = await request({
    url: '/paper-planes',
    method: 'POST',
    data: planeBody,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) {
    if (res.code == 429) {
      return failRes(res.message != null ? res.message : '今日纸飞机次数已用完', 'QUOTA_EXCEEDED', { remain: 0 })
    }
    return res
  }
  if (res.data != null && res.data.success == false) {
    return okRes({
      success: false,
      message: res.data.message != null ? res.data.message : '放飞失败，请重试',
      remain: res.data.remain
    })
  }
  const plane = mapPaperPlane(res.data)
  // 刷新额度
  let quotaItem: any = null
  const qRes = await request({ url: '/community/quotas', method: 'GET' })
  if (qRes.success && qRes.data != null) {
    const q = mapQuotas(qRes.data)
    if (q != null) quotaItem = q.paperPlaneDaily
  }
  return okRes({ success: true, plane: plane, quotas: quotaItem })
}

export async function replyPaperPlane(planeId: number, content: string, suppliedCreateKey: string = '') {
  const replyContent = content != null ? ('' + content).trim() : ''
  if (replyContent.length == 0) {
    return failRes('请填写回复内容', 'EMPTY_CONTENT')
  }
  if (replyContent.length > 120) {
    return failRes('回复内容不能超过 120 字', 'CONTENT_TOO_LONG')
  }


  const key = idempotencyKey('paper-plane-reply', suppliedCreateKey)
  const res = await request({
    url: '/paper-planes/' + planeId + '/replies',
    method: 'POST',
    data: {
      content: replyContent,
      is_anonymous: true
    },
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, message: res.data.message != null ? res.data.message : '回复失败，请重试' })
  }
  const convId = res.data != null && res.data.conversation_id != null ? res.data.conversation_id : 0
  return okRes({
    success: true,
    replyCount: null,
    conversationId: convId,
    conversation_id: convId
  })
}

