export async function blockUser(userId: number) {
  const ids = mockBlockedUserIds as number[]
  let exists = false
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) {
      exists = true
      break
    }
  }
  if (!exists) {
    ids.push(userId)
  }
  return request({
    url: '/community/block',
    cloudFunctionName: 'community',
    action: 'blockUser',
    method: 'POST',
    data: { userId },
    mockData: {
      success: true,
      message: '已屏蔽该用户，其内容将不再展示'
    }
  })
}

