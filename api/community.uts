// ─── 媒体上传 / 纸飞机匿名会话 ───────────────────────────────

const mockPlaneConversations: any[] = []
const mockPlaneMessages: any = {}

function ensureMockPlaneConversation(conversationId: number, planeId: number, firstContent: string) {
  let found = false
  for (let i = 0; i < mockPlaneConversations.length; i++) {
    if (mockPlaneConversations[i].id == conversationId) {
      found = true
      mockPlaneConversations[i].lastMessage = firstContent
      mockPlaneConversations[i].unreadCount = 1
    }
  }
  if (!found) {
    mockPlaneConversations.unshift({
      id: conversationId,
      planeId: planeId,
      status: 1,
      lastMessage: firstContent,
      unreadCount: 1,
      peerLabel: '纸飞机主人',
      planeContent: ''
    })
  }
  const key = '' + conversationId
  if (mockPlaneMessages[key] == null) mockPlaneMessages[key] = []
  ;(mockPlaneMessages[key] as any[]).push({
    id: Date.now(),
    conversationId: conversationId,
    fromUserId: mockMeProfile.id,
    content: firstContent,
    type: 1,
    mediaUrl: '',
    voiceDurationSec: 0,
    mine: true,
    timeText: '刚刚'
  })
}

function paperPlaneTimeText(rawTime: any): string {
  const time = rawTime != null ? Number(rawTime) : 0
  if (time <= 0) return ''
  const diff = Math.max(0, Date.now() - time)
  const minute = Math.floor(diff / 60000)
  if (minute < 1) return '刚刚'
  if (minute < 60) return minute + ' 分钟前'
  const hour = Math.floor(minute / 60)
  if (hour < 24) return hour + ' 小时前'
  const day = Math.floor(hour / 24)
  if (day < 7) return day + ' 天前'
  return '更早'
}

function getPaperPlanePeerName(plane: any): string {
  if (plane != null && plane.name != null && ('' + plane.name).length > 0) {
    return '' + plane.name
  }
  if (plane != null && plane.gender == '男') return '一位认真生活的男生'
  return '一位认真生活的女生'
}

/** 回复纸飞机后，同步到「我的纸飞机」消息列表（PR 前端会话卡）。 */
function upsertPaperPlaneConversation(plane: any, content: string, conversationId: number = 0) {
  const list = mockPaperPlaneConversations as any[]
  let conversation: any = null
  for (let i = 0; i < list.length; i++) {
    if (list[i].planeId == plane.id) {
      conversation = list[i]
      break
    }
  }

  if (conversation == null) {
    conversation = {
      id: conversationId > 0 ? conversationId : Date.now(),
      planeId: plane.id,
      userId: plane.userId != null ? plane.userId : 0,
      name: getPaperPlanePeerName(plane),
      avatar: '/static/portraits/profile-woman-alt.jpg',
      planeType: plane.type == 'voice' || plane.voiceUrl != null ? '语音纸飞机' : '文字纸飞机',
      lastMessage: '',
      time: Date.now(),
      timeText: '刚刚',
      unreadCount: 0
    }
    list.unshift(conversation)
  }

  if (conversationId > 0) conversation.id = conversationId
  conversation.lastMessage = '我：' + content
  conversation.time = Date.now()
  conversation.timeText = '刚刚'
  conversation.unreadCount = 0
}

function mapPlaneConversation(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    planeId: row.plane_id != null ? row.plane_id : row.planeId,
    status: row.status != null ? row.status : 1,
    lastMessage: row.last_message != null ? row.last_message : (row.lastMessage != null ? row.lastMessage : ''),
    lastMessageAt: row.last_message_at != null ? row.last_message_at : null,
    unreadCount: row.unread_count != null ? row.unread_count : (row.unreadCount != null ? row.unreadCount : 0),
    peerLabel: row.peer_label != null ? row.peer_label : (row.peerLabel != null ? row.peerLabel : '匿名用户'),
    planeContent: row.plane_content != null ? row.plane_content : (row.planeContent != null ? row.planeContent : ''),
    createdAt: row.created_at != null ? row.created_at : null
  }
}

function mapPlaneMessage(row: any, myId: number = 0): any {
  if (row == null) return null
  const fromId = row.from_user_id != null ? row.from_user_id : row.fromUserId
  return {
    id: row.id,
    conversationId: row.conversation_id != null ? row.conversation_id : row.conversationId,
    fromUserId: fromId,
    content: row.content != null ? row.content : '',
    type: row.type != null ? row.type : 1,
    mediaUrl: row.media_url != null ? row.media_url : (row.mediaUrl != null ? row.mediaUrl : ''),
    voiceDurationSec: row.voice_duration_sec != null ? row.voice_duration_sec : (row.voiceDurationSec != null ? row.voiceDurationSec : 0),
    mine: myId > 0 ? fromId == myId : row.mine == true,
    timeText: row.created_at != null ? timeTextFrom(row.created_at) : (row.timeText != null ? row.timeText : '')
  }
}

function extractUploadDetail(data: any): string {
  if (data == null) return '上传失败'
  if (typeof data === 'string') return data
  if (data.detail != null) {
    if (typeof data.detail === 'string') return '' + data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) {
      const first = data.detail[0]
      if (first != null && first.msg != null) return '' + first.msg
      return JSON.stringify(data.detail)
    }
  }
  if (data.message != null) return '' + data.message
  return '上传失败'
}

function mapCommunityMedia(row: any): any {
  if (row == null) return null
  return {
    id: row.id != null ? row.id : 0,
    purpose: row.purpose != null ? row.purpose : '',
    mediaType: row.media_type != null ? row.media_type : (row.mediaType != null ? row.mediaType : ''),
    url: row.url != null ? row.url : '',
    thumbnailUrl: row.thumbnail_url != null ? row.thumbnail_url : (row.thumbnailUrl != null ? row.thumbnailUrl : ''),
    fileSize: row.file_size != null ? row.file_size : (row.fileSize != null ? row.fileSize : 0),
    durationSeconds: row.duration_seconds != null ? row.duration_seconds : (row.durationSeconds != null ? row.durationSeconds : null),
    status: row.status != null ? row.status : ''
  }
}

/**
 * 社区媒体上传（帖子图/视频、纸飞机图）
 * purpose: post | paper_plane
 */
export async function uploadCommunityMedia(filePath: string, purpose: string) {
  if (filePath == null || ('' + filePath).length == 0) {
    return failRes('请选择要上传的文件', 'EMPTY_FILE')
  }
  const purposeVal = purpose != null ? ('' + purpose) : 'post'
  if (USE_MOCK) {
    const id = Date.now() + Math.floor(Math.random() * 1000)
    const mediaType = guessMockMediaType(filePath)
    const url = '' + filePath
    mockCommunityMediaById['' + id] = {
      url: url,
      mediaType: mediaType,
      purpose: purposeVal
    }
    return okRes({
      id: id,
      purpose: purposeVal,
      mediaType: mediaType,
      url: url,
      thumbnailUrl: url,
      fileSize: 0,
      durationSeconds: null,
      status: 'ready'
    })
  }
  const token = getAccessToken()
  const url = buildApiUrl('/community/media/uploads')
  return await new Promise<any>((resolve) => {
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: 'file',
      formData: { purpose: purposeVal },
      header: token != '' ? { Authorization: 'Bearer ' + token } : {},
      success: (res) => {
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve(failRes('上传响应解析失败', res.statusCode))
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(okRes(mapCommunityMedia(data)))
        } else {
          resolve(failRes(extractUploadDetail(data), res.statusCode))
        }
      },
      fail: (_err) => {
        resolve(failRes('上传失败，请重试', 'UPLOAD_FAILED'))
      }
    })
  })
}

/** 删除未绑定的社区媒体 */
export async function deleteCommunityMedia(mediaId: number) {
  if (mediaId == null || mediaId <= 0) {
    return failRes('无效的媒体 ID', 'INVALID_MEDIA_ID')
  }
  if (USE_MOCK) {
    try {
      delete mockCommunityMediaById['' + mediaId]
    } catch (e) {}
    return okRes({ success: true })
  }
  return request({
    url: '/community/media/' + mediaId,
    method: 'DELETE'
  })
}

export async function uploadMedia(filePath: string, purpose: string = 'paper_plane_voice') {
  if (filePath == null || ('' + filePath).length == 0) {
    return failRes('请选择要上传的文件', 'EMPTY_FILE')
  }
  if (USE_MOCK) {
    return request({
      url: '/media/uploads',
      cloudFunctionName: 'community',
      action: 'uploadMedia',
      method: 'POST',
      data: { purpose },
      mockData: {
        url: 'mock://voice/' + Date.now() + '.mp3',
        content_type: 'audio/mpeg',
        size: 1024,
        purpose: purpose
      }
    })
  }
  return new Promise<any>((resolve) => {
    const token = getAccessTokenLocal()
    const url = buildApiUrlLocal('/media/uploads')
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: 'file',
      formData: { purpose: purpose },
      header: token != '' ? { Authorization: 'Bearer ' + token } : {},
      success: (res) => {
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve(failRes('上传响应解析失败', res.statusCode))
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(okRes(data))
        } else {
          const msg = data != null && data.detail != null ? ('' + data.detail) : '上传失败'
          resolve(failRes(msg, res.statusCode))
        }
      },
      fail: () => {
        resolve(failRes('上传失败，请检查网络', -1))
      }
    })
  })
}

function buildApiUrlLocal(path: string): string {
  return buildApiUrl(path)
}

function getAccessTokenLocal(): string {
  return getAccessToken()
}

/** 获取由纸飞机回复形成的聊天列表（PR 消息页形状）。 */
export async function getPaperPlaneConversations() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = cloneList(mockPaperPlaneConversations as any[])
    list.forEach((item: any) => {
      item.timeText = paperPlaneTimeText(item.time)
      item.unreadCount = item.unreadCount != null ? Math.max(0, item.unreadCount as number) : 0
    })
    list.sort((a: any, b: any) => Number(b.time) - Number(a.time))
    return request({
      url: '/community/paper-planes/conversations',
      cloudFunctionName: 'community',
      action: 'getPaperPlaneConversations',
      method: 'GET',
      mockData: list
    })
  }
  const res = await request({
    url: '/paper-plane-conversations',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  const list: any[] = []
  for (let i = 0; i < arr.length; i++) {
    const mapped = mapPlaneConversation(arr[i])
    if (mapped == null) continue
    list.push({
      id: mapped.id,
      planeId: mapped.planeId,
      userId: 0,
      name: mapped.peerLabel != null ? mapped.peerLabel : '匿名用户',
      avatar: '/static/portraits/profile-woman-alt.jpg',
      planeType: '文字纸飞机',
      lastMessage: mapped.lastMessage,
      time: Date.now(),
      timeText: '',
      unreadCount: mapped.unreadCount
    })
  }
  return okRes(list)
}

/** 获取当前用户最近五天扔出的纸飞机。 */
export async function getSentPaperPlanes() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const cutoff = Date.now() - 5 * 24 * 60 * 60 * 1000
    const list = (mockPaperPlanes as any[]).filter((plane: any) => {
      return plane.userId == mockMeProfile.id && Number(plane.time) >= cutoff
    })
    list.forEach((plane: any) => {
      plane.timeText = paperPlaneTimeText(plane.time)
    })
    list.sort((a: any, b: any) => Number(b.time) - Number(a.time))
    return request({
      url: '/community/paper-planes/sent',
      cloudFunctionName: 'community',
      action: 'getSentPaperPlanes',
      method: 'GET',
      mockData: cloneList(list)
    })
  }
  const res = await request({
    url: '/paper-planes/mine',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  return okRes(arr)
}

/** 获取纸飞机聊天列表的未读消息总数。 */
export async function getPaperPlaneUnreadCount() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = mockPaperPlaneConversations as any[]
    let count = 0
    for (let i = 0; i < list.length; i++) {
      count += list[i].unreadCount != null ? Math.max(0, list[i].unreadCount as number) : 0
    }
    return request({
      url: '/community/paper-planes/conversations/unread',
      cloudFunctionName: 'community',
      action: 'getPaperPlaneUnreadCount',
      method: 'GET',
      mockData: { count }
    })
  }
  const res = await getPaperPlaneConversations()
  if (!res.success || res.data == null || !Array.isArray(res.data)) {
    return okRes({ count: 0 })
  }
  let count = 0
  const list = res.data as any[]
  for (let i = 0; i < list.length; i++) {
    count += list[i].unreadCount != null ? Math.max(0, list[i].unreadCount as number) : 0
  }
  return okRes({ count })
}

/** 查看会话后清除该会话的未读数。 */
export async function markPaperPlaneConversationRead(conversationId: number) {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = mockPaperPlaneConversations as any[]
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == conversationId) {
        list[i].unreadCount = 0
        break
      }
    }
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) {
        mockPlaneConversations[i].unreadCount = 0
      }
    }
    savePaperPlaneState()
    return request({
      url: '/community/paper-planes/conversations/read',
      cloudFunctionName: 'community',
      action: 'markPaperPlaneConversationRead',
      method: 'POST',
      data: { conversationId },
      mockData: { success: true }
    })
  }
  return await readPaperPlaneConversation(conversationId)
}

export async function getPaperPlaneMessages(conversationId: number) {
  if (USE_MOCK) {
    const key = '' + conversationId
    const list = mockPlaneMessages[key] != null ? mockPlaneMessages[key] : []
    return request({
      url: '/paper-plane-conversations/' + conversationId + '/messages',
      method: 'GET',
      mockData: list
    })
  }
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/messages',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  const list: any[] = []
  for (let i = 0; i < arr.length; i++) list.push(mapPlaneMessage(arr[i]))
  list.reverse()
  return okRes(list)
}

export async function sendPaperPlaneMessage(conversationId: number, content: string, suppliedCreateKey: string = '') {
  const textContent = content != null ? ('' + content).trim() : ''
  if (textContent.length == 0) return failRes('请输入消息', 'EMPTY_CONTENT')
  if (USE_MOCK) {
    const key = '' + conversationId
    if (mockPlaneMessages[key] == null) mockPlaneMessages[key] = []
    const msg = {
      id: Date.now(),
      conversationId: conversationId,
      fromUserId: mockMeProfile.id,
      content: textContent,
      type: 1,
      mediaUrl: '',
      voiceDurationSec: 0,
      mine: true,
      timeText: '刚刚'
    }
    ;(mockPlaneMessages[key] as any[]).push(msg)
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) {
        mockPlaneConversations[i].lastMessage = textContent
      }
    }
    return request({
      url: '/paper-plane-conversations/' + conversationId + '/messages',
      method: 'POST',
      data: { content: textContent },
      mockData: msg
    })
  }
  const key = idempotencyKey('paper-plane-message', suppliedCreateKey)
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/messages',
    method: 'POST',
    data: { content: textContent, type: 1 },
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  return okRes(mapPlaneMessage(res.data))
}

export async function readPaperPlaneConversation(conversationId: number) {
  if (USE_MOCK) {
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) mockPlaneConversations[i].unreadCount = 0
    }
    return okRes({ success: true })
  }
  return await request({
    url: '/paper-plane-conversations/' + conversationId + '/read',
    method: 'POST',
    data: {}
  })
}

export async function endPaperPlaneConversation(conversationId: number) {
  if (USE_MOCK) {
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) mockPlaneConversations[i].status = 2
    }
    return okRes({ success: true, status: 2 })
  }
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/end',
    method: 'POST',
    data: {}
  })
  if (!res.success) return res
  return okRes(mapPlaneConversation(res.data))
}

/** 供 apply 同步动态卡状态 */
export function __syncApplyStatus(userId: number, status: string) {
  const map = mockApplyStates as any
  map['' + userId] = status
  syncApplyOnDynamics(userId, status)
}
