/** 删除自己的动态 */
export async function deleteDynamic(dynamicId: number) {
  if (USE_MOCK) {
    const all = mockDynamicList as any[]
    let idx = -1
    for (let i = 0; i < all.length; i++) {
      if (all[i].id == dynamicId) {
        idx = i
        break
      }
    }
    if (idx >= 0) {
      all.splice(idx, 1)
    }
    return request({
      url: '/community/dynamic/delete',
      cloudFunctionName: 'community',
      action: 'deleteDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: { success: true, dynamicId: dynamicId }
    })
  }

  const res = await request({
    url: '/community/posts/' + dynamicId,
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, dynamicId: dynamicId })
}

/** 删除自己的评论 */
export async function deleteComment(commentId: number, dynamicId: number = 0) {
  if (USE_MOCK) {
    if (dynamicId > 0) {
      const item = findDynamic(dynamicId)
      if (item != null && item.comments != null) {
        const comments = item.comments as any[]
        let cidx = -1
        for (let i = 0; i < comments.length; i++) {
          if (comments[i].id == commentId) {
            cidx = i
            break
          }
        }
        if (cidx >= 0) {
          comments.splice(cidx, 1)
          item.commentCount = Math.max(0, (item.commentCount as number) - 1)
        }
      }
    } else {
      const all = mockDynamicList as any[]
      for (let i = 0; i < all.length; i++) {
        const item = all[i]
        if (item.comments == null) continue
        const comments = item.comments as any[]
        for (let j = 0; j < comments.length; j++) {
          if (comments[j].id == commentId) {
            comments.splice(j, 1)
            item.commentCount = Math.max(0, (item.commentCount as number) - 1)
            break
          }
        }
      }
    }
    return request({
      url: '/community/comment/delete',
      cloudFunctionName: 'community',
      action: 'deleteComment',
      method: 'POST',
      data: { commentId, dynamicId },
      mockData: { success: true, commentId: commentId }
    })
  }

  const res = await request({
    url: '/community/comments/' + commentId,
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, commentId: commentId })
}

/**
 * 评论动态
 * 新签名：commentDynamic({ dynamicId, content, replyToCommentId? })
 * 兼容：commentDynamic(dynamicId, content, replyToId)
 */
export async function commentDynamic(
  dynamicIdOrPayload: any,
  contentArg: string = '',
  replyToIdArg: number = 0
) {
  let dynamicId = 0
  let content = ''
  let replyToCommentId = 0
  let suppliedCreateKey = ''

  if (dynamicIdOrPayload != null && typeof dynamicIdOrPayload === 'object') {
    dynamicId = dynamicIdOrPayload.dynamicId != null ? (dynamicIdOrPayload.dynamicId as number) : 0
    content = dynamicIdOrPayload.content != null ? ('' + dynamicIdOrPayload.content).trim() : ''
    replyToCommentId =
      dynamicIdOrPayload.replyToCommentId != null
        ? (dynamicIdOrPayload.replyToCommentId as number)
        : dynamicIdOrPayload.replyToId != null
          ? (dynamicIdOrPayload.replyToId as number)
          : 0
    suppliedCreateKey = dynamicIdOrPayload.idempotencyKey != null ? ('' + dynamicIdOrPayload.idempotencyKey) : ''
  } else {
    dynamicId = dynamicIdOrPayload as number
    content = contentArg != null ? ('' + contentArg).trim() : ''
    replyToCommentId = replyToIdArg
  }

  if (content.length == 0) {
    return failRes('请输入评论内容', 'EMPTY_CONTENT')
  }

  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    const comment = {
      id: Date.now(),
      user: {
        id: 9001,
        name: '顾言澄',
        avatar: '/static/portraits/profile-man-light.jpg',
        realNameStatus: 'passed'
      },
      content,
      timeText: '刚刚',
      likeCount: 0,
      liked: false,
      replyTo: replyToCommentId > 0 ? replyToCommentId : null,
      replyToCommentId: replyToCommentId > 0 ? replyToCommentId : null
    }
    if (item != null) {
      if (item.comments == null) item.comments = []
      ;(item.comments as any[]).push(comment)
      item.commentCount = (item.commentCount as number) + 1
    }

    const notes = mockCommunityNotifications as any[]
    notes.unshift({
      id: Date.now() + 1,
      type: 'comment',
      title: '有人评论了动态',
      content: content.length > 24 ? content.substring(0, 24) + '…' : content,
      timeText: '刚刚',
      read: false,
      targetType: 'post',
      targetId: dynamicId
    })

    return request({
      url: '/community/dynamic/comment',
      cloudFunctionName: 'community',
      action: 'commentDynamic',
      method: 'POST',
      data: { dynamicId, content, replyToCommentId },
      mockData: { success: true, comment }
    })
  }

  const body: any = { content: content }
  if (replyToCommentId > 0) {
    body.parent_id = replyToCommentId
  }
  const key = idempotencyKey('comment', suppliedCreateKey)
  const res = await request({
    url: '/community/posts/' + dynamicId + '/comments',
    method: 'POST',
    data: body,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, message: res.data.message != null ? res.data.message : '发送失败，请重试' })
  }
  return okRes({ success: true, comment: mapComment(res.data) })
}

// ─── 举报 / 屏蔽 / 城市 ─────────────────────────────────────

export async function reportContent(targetType: string, targetId: number, reasonId: string, detail: string = '') {
  if (USE_MOCK) {
    return request({
      url: '/community/report',
      cloudFunctionName: 'community',
      action: 'reportContent',
      method: 'POST',
      data: { targetType, targetId, reasonId, detail },
      mockData: {
        success: true,
        message: '举报已提交，我们会尽快处理'
      }
    })
  }

  // 后端 POST /security/reports/{target_id} 的 target 是用户 id
  // XsaReportSheet 已优先传作者 userId，targetType 固定为 user
  const res = await request({
    url: '/security/reports/' + targetId,
    method: 'POST',
    data: {
      type: reasonId != null && reasonId != '' ? reasonId : 'other',
      description: detail != null ? detail : '',
      images: []
    }
  })
  if (!res.success) return res
  return okRes({
    success: true,
    message: '举报已提交，我们会尽快处理'
  })
}

export async function blockUser(userId: number) {
  if (USE_MOCK) {
    const ids = mockBlockedUserIds as number[]
    let exists = false
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == userId) {
        exists = true
        break
      }
    }
    if (!exists) {
      ids.push(userId)
    }
    return request({
      url: '/community/block',
      cloudFunctionName: 'community',
      action: 'blockUser',
      method: 'POST',
      data: { userId },
      mockData: {
        success: true,
        message: '已屏蔽该用户，其内容将不再展示'
      }
    })
  }

  const res = await request({
    url: '/security/blocks/' + userId,
    method: 'PUT',
    data: {}
  })
  if (!res.success) return res
  return okRes({
    success: true,
    message: '已屏蔽该用户，其内容将不再展示'
  })
}

export async function getReportReasons() {
  if (USE_MOCK) {
    return request({
      url: '/community/report/reasons',
      cloudFunctionName: 'community',
      action: 'getReportReasons',
      method: 'GET',
      mockData: mockReportReasons
    })
  }

  const res = await request({
    url: '/community/report-reasons',
    method: 'GET'
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? (res.data as any[]) : []
  return okRes(arr)
}

export async function getCurrentCity() {
  if (USE_MOCK) {
    return request({
      url: '/community/city',
      cloudFunctionName: 'community',
      action: 'getCurrentCity',
      method: 'GET',
      mockData: mockCurrentCity
    })
  }

  const res = await request({
    url: '/community/city',
    method: 'GET'
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    name: raw != null && raw.name != null ? raw.name : '未设置',
    code: raw != null && raw.code != null ? raw.code : null
  })
}

/** Mock 同城偏好上次变更时间（ms）；对齐 BE 一周限改 */
		let mockCommunityCityUpdatedAt: number = 0
		const MOCK_CITY_COOLDOWN_MS: number = 7 * 24 * 60 * 60 * 1000

		/**
		 * 设置同城城市。code 可选；缺省时按 COMMUNITY_CITY_OPTIONS / 名称推断 6 位市码。
		 * 兼容旧调用 setCurrentCity(name)。Mock/真路径均拒空与「未设置」；一周内换城失败。
		 */
		export async function setCurrentCity(name: string, code: string = '') {
		  const cityName = normalizeCityName(name)
		  let cityCode = normalizeCityCode(code)
		  if (cityCode == '' && cityName != '') {
		    cityCode = cityCodeFromName(cityName)
		  }
		  if (USE_MOCK) {
		    if (cityName == '') {
		      return failRes('城市名称不能为空', 422)
		    }
		    const prevName = mockCurrentCity.name != null ? normalizeCityName(mockCurrentCity.name) : ''
		    const prevCode = mockCurrentCity.code != null ? normalizeCityCode(mockCurrentCity.code) : ''
		    const same =
		      prevName == cityName &&
		      (prevCode == cityCode || (prevCode == '' && cityCode == '') || prevCode == cityCode)
		    if (!same && mockCommunityCityUpdatedAt > 0) {
		      const elapsed = Date.now() - mockCommunityCityUpdatedAt
		      if (elapsed < MOCK_CITY_COOLDOWN_MS) {
		        return failRes('同城城市一周内仅可更换一次', 429)
		      }
		    }
		    if (!same || prevName == '') {
		      mockCurrentCity.name = cityName
		      if (cityCode != '') {
		        mockCurrentCity.code = cityCode
		      }
		      mockCommunityCityUpdatedAt = Date.now()
		    }
		    return request({
		      url: '/community/city/set',
		      cloudFunctionName: 'community',
		      action: 'setCurrentCity',
		      method: 'POST',
		      data: { name: cityName, code: cityCode },
		      mockData: { success: true, city: { name: mockCurrentCity.name, code: mockCurrentCity.code } }
		    })
		  }

		  if (cityName == '') {
		    return failRes('城市名称不能为空', 422)
		  }
		  const body: any = { name: cityName }
		  if (cityCode != '') {
		    body.code = cityCode
		  }
		  const res = await request({
		    url: '/community/city',
		    method: 'PUT',
		    data: body
		  })
		  if (!res.success) return res
		  const raw = res.data
		  return okRes({
		    success: true,
		    city: {
		      name: raw != null && raw.name != null ? raw.name : cityName,
		      code: raw != null && raw.code != null ? raw.code : (cityCode != '' ? cityCode : null)
		    }
		  })
		}

/** 供 apply 同步动态卡状态 */
export function __syncApplyStatus(userId: number, status: string) {
  const map = mockApplyStates as any
  map['' + userId] = status
  syncApplyOnDynamics(userId, status)
}
