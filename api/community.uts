/**
 * 社区相关 API
 * 主 Tab：follow / city / discover；二级 filter：
 * follow=all|following|likedUsers；city=all|hot|latest；discover=all|mbti|alumni|hometown
 * 互动门槛由页面侧 guardRealName 控制（仅实名）
 */

import { request } from './request.uts'
import {
  mockDynamicList,
  mockTopics,
  mockPaperPlanes,
  mockActivities,
  mockCommunityBanners,
  mockCommunityNotifications,
  mockCommunityQuotas,
  mockReportReasons,
  mockBlockedUserIds,
  mockApplyStates,
  mockLikedUserIds,
  mockCurrentCity,
  mockMeProfile
} from '@/mock'

const PAPER_PLANE_STORAGE_KEY = 'xsa_paper_plane_state_v1'
let paperPlaneStateLoaded = false
let paperPlaneStateDateKey = ''

function currentDateKey(): string {
  const now = new Date()
  const month = now.getMonth() + 1
  const day = now.getDate()
  const monthText = month < 10 ? '0' + month : '' + month
  const dayText = day < 10 ? '0' + day : '' + day
  return now.getFullYear() + '-' + monthText + '-' + dayText
}

function savePaperPlaneState() {
  const quotas = mockCommunityQuotas as any
  uni.setStorageSync(PAPER_PLANE_STORAGE_KEY, {
    dateKey: currentDateKey(),
    planes: mockPaperPlanes,
    paperPlaneDaily: quotas.paperPlaneDaily
  })
}

function restorePaperPlaneState() {
  const today = currentDateKey()
  if (paperPlaneStateLoaded) {
    if (paperPlaneStateDateKey != today) {
      const quotas = mockCommunityQuotas as any
      quotas.paperPlaneDaily.used = 0
      quotas.paperPlaneDaily.remain = quotas.paperPlaneDaily.total
      paperPlaneStateDateKey = today
      savePaperPlaneState()
    }
    return
  }
  paperPlaneStateLoaded = true
  paperPlaneStateDateKey = today

  try {
    const saved = uni.getStorageSync(PAPER_PLANE_STORAGE_KEY) as any
    if (saved == null || typeof saved !== 'object') return

    if (saved.planes != null && Array.isArray(saved.planes)) {
      const target = mockPaperPlanes as any[]
      target.splice(0, target.length)
      ;(saved.planes as any[]).forEach((item: any) => target.push(item))
    }

    const quotas = mockCommunityQuotas as any
    if (saved.dateKey == today && saved.paperPlaneDaily != null) {
      const daily = saved.paperPlaneDaily as any
      quotas.paperPlaneDaily.remain = daily.remain != null
        ? Math.max(0, Math.min(quotas.paperPlaneDaily.total, daily.remain))
        : quotas.paperPlaneDaily.total
      quotas.paperPlaneDaily.used = quotas.paperPlaneDaily.total - quotas.paperPlaneDaily.remain
    } else {
      quotas.paperPlaneDaily.used = 0
      quotas.paperPlaneDaily.remain = quotas.paperPlaneDaily.total
      savePaperPlaneState()
    }
  } catch (e) {
    console.error('恢复纸飞机本地状态失败', e)
  }
}

function paperPlaneTimeText(rawTime: any): string {
  const time = rawTime != null ? Number(rawTime) : 0
  if (time <= 0) return ''
  const diff = Math.max(0, Date.now() - time)
  const minute = 60 * 1000
  const hour = 60 * minute
  const day = 24 * hour
  if (diff < minute) return '刚刚'
  if (diff < hour) return Math.floor(diff / minute) + ' 分钟前'
  if (diff < day) return Math.floor(diff / hour) + ' 小时前'
  if (diff < 7 * day) return Math.floor(diff / day) + ' 天前'
  const date = new Date(time)
  return (date.getMonth() + 1) + ' 月 ' + date.getDate() + ' 日'
}

function cloneList(list: any[]): any[] {
  const out: any[] = []
  for (let i = 0; i < list.length; i++) {
    out.push(list[i])
  }
  return out
}

function findDynamic(dynamicId: number): any {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == dynamicId) return all[i]
  }
  return null
}

function findTopic(topicId: number): any {
  const all = mockTopics as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == topicId) return all[i]
  }
  return null
}
function markTopicParticipation(topic: any): void {
  if (topic == null || topic.joined == true) return
  topic.joined = true
  topic.participantCount = ((topic.participantCount as number) || 0) + 1
}


function findActivity(activityId: number): any {
  const all = mockActivities as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == activityId) return all[i]
  }
  return null
}

function isBlocked(userId: number): boolean {
  const ids = mockBlockedUserIds as number[]
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function applyStatusForUser(userId: number, fallback: string = 'none'): string {
  const key = '' + userId
  const map = mockApplyStates as any
  if (map[key] != null) return map[key] as string
  return fallback
}

function syncApplyOnDynamics(userId: number, status: string) {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null && all[i].user.id == userId) {
      all[i].applyStatus = status
    }
  }
}

function notBlockedDynamic(d: any): boolean {
  if (d == null || d.user == null) return true
  return !isBlocked(d.user.id as number)
}


function isLikedUser(userId: number): boolean {
  const ids = mockLikedUserIds as number[]
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function schoolKey(raw: any): string {
  if (raw == null) return ''
  let s = '' + raw
  const cut = s.indexOf(' · ')
  if (cut >= 0) s = s.substring(0, cut)
  return s.trim()
}

function hometownKey(raw: any): string {
  if (raw == null) return ''
  return ('' + raw).trim()
}

function meProfile(): any {
  return mockMeProfile as any
}

function sortTopicsByHeat(list: any[]): any[] {
  return list.slice().sort((a: any, b: any) => {
    const ha = a.heat != null ? (a.heat as number) : ((a.participantCount as number) || 0) * 10 + ((a.postCount as number) || 0)
    const hb = b.heat != null ? (b.heat as number) : ((b.participantCount as number) || 0) * 10 + ((b.postCount as number) || 0)
    return hb - ha
  })
}

function sortTopicsByCreated(list: any[]): any[] {
  return list.slice().sort((a: any, b: any) => {
    return ((b.createdAt as number) || 0) - ((a.createdAt as number) || 0)
  })
}

function excludeTopicIds(list: any[], excludeIds: any): any[] {
  if (excludeIds == null || !Array.isArray(excludeIds) || excludeIds.length == 0) return list
  const ban: any = {}
  for (let i = 0; i < excludeIds.length; i++) {
    ban['' + excludeIds[i]] = true
  }
  return list.filter((t: any) => ban['' + t.id] != true)
}

function resolveTabValue(raw: any): string {
  // 单独拆出 tab 解析，避免 UTS 编译对象简写时丢掉局部变量
  if (typeof raw === 'number') {
    if (raw == 2) return 'city'
    if (raw == 3) return 'follow'
    if (raw == 1) return 'liked'
    return 'discover'
  }
  if (typeof raw === 'string' && raw != '') {
    return raw
  }
  return 'discover'
}

function normalizeListQuery(input: any, pageArg: number = 1): any {
  // 兼容旧签名 getDynamicList(tabNumber, page) 与新签名 getDynamicList({ tab, filter, page, pageSize })
  if (input != null && typeof input === 'object' && !Array.isArray(input)) {
    const tabName = resolveTabValue(input.tab)
    const filterName = input.filter != null ? ('' + input.filter) : 'all'
    const pageNum = input.page != null ? (input.page as number) : 1
    const sizeNum = input.pageSize != null ? (input.pageSize as number) : 10
    const cityName = input.city != null ? ('' + input.city) : mockCurrentCity.name
    return {
      tab: tabName,
      filter: filterName,
      page: pageNum,
      pageSize: sizeNum,
      city: cityName
    }
  }
  const tabName = resolveTabValue(input)
  return {
    tab: tabName,
    filter: 'all',
    page: pageArg > 0 ? pageArg : 1,
    pageSize: 10,
    city: mockCurrentCity.name
  }
}

function filterDynamics(tab: string, filter: string, city: string): any[] {
  const all = (mockDynamicList as any[]).filter(notBlockedDynamic)
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null) {
      all[i].applyStatus = applyStatusForUser(all[i].user.id as number, all[i].applyStatus || 'none')
    }
  }

  const me = meProfile()
  const meSchool = schoolKey(me != null ? me.school : '')
  const meHometown = hometownKey(me != null ? me.hometown : '')

  let filtered: any[] = all
  if (tab == 'follow') {
    // 关注页：all = 已关注 ∪ 喜欢用户；following = 仅关注；likedUsers = 仅喜欢用户
    if (filter == 'following') {
      filtered = all.filter((d: any) => {
        return d.followed == true || (d.tabs != null && d.tabs.indexOf('follow') >= 0)
      })
    } else if (filter == 'likedUsers') {
      filtered = all.filter((d: any) => {
        return d.user != null && isLikedUser(d.user.id as number)
      })
    } else {
      // all
      const map: any = {}
      const out: any[] = []
      for (let i = 0; i < all.length; i++) {
        const d = all[i]
        const followed = d.followed == true || (d.tabs != null && d.tabs.indexOf('follow') >= 0)
        const likedU = d.user != null && isLikedUser(d.user.id as number)
        if (!followed && !likedU) continue
        const key = '' + d.id
        if (map[key] == true) continue
        map[key] = true
        out.push(d)
      }
      filtered = out
    }
  } else if (tab == 'city') {
    filtered = all.filter((d: any) => {
      const sameCity =
        d.city == city ||
        d.location == city ||
        (d.location != null && ('' + d.location).indexOf(city) >= 0) ||
        d.cityTag == true ||
        (d.tabs != null && d.tabs.indexOf('city') >= 0)
      return sameCity
    })
    if (filter == 'hot') {
      filtered = filtered.slice().sort((a: any, b: any) => {
        return ((b.likeCount as number) || 0) - ((a.likeCount as number) || 0)
      })
    } else if (filter == 'latest') {
      filtered = filtered.slice().sort((a: any, b: any) => {
        return ((b.time as number) || 0) - ((a.time as number) || 0)
      })
    }
  } else {
    // discover
    filtered = all.filter((d: any) => {
      return (
        d.tab == 'discover' ||
        d.tab == null ||
        (d.tabs != null && d.tabs.indexOf('discover') >= 0)
      )
    })
    if (filtered.length == 0) filtered = all

    if (filter == 'mbti') {
      filtered = filtered.filter((d: any) => d.user != null && d.user.mbti != null && ('' + d.user.mbti) != '')
    } else if (filter == 'alumni') {
      filtered = filtered.filter((d: any) => {
        if (d.user == null) return false
        const s = schoolKey(d.user.school)
        return s != '' && meSchool != '' && s == meSchool
      })
    } else if (filter == 'hometown') {
      filtered = filtered.filter((d: any) => {
        if (d.user == null) return false
        const h = hometownKey(d.user.hometown)
        if (h == '' || meHometown == '') return false
        return h == meHometown || h.indexOf(meHometown) >= 0 || meHometown.indexOf(h) >= 0
      })
    }
  }

  return filtered
}

/**
 * 获取动态列表
 * 新签名：getDynamicList({ tab, filter, page, pageSize, city? })
 * 兼容：getDynamicList(tabNumber, page)
 * 返回 data: { list, page, pageSize, hasMore, total }
 */
export async function getDynamicList(queryOrTab: any = 'discover', pageArg: number = 1) {
  const q = normalizeListQuery(queryOrTab, pageArg)
  const filtered = filterDynamics(q.tab, q.filter, q.city)
  const page = q.page > 0 ? q.page : 1
  const pageSize = q.pageSize > 0 ? q.pageSize : 10
  const start = (page - 1) * pageSize
  const end = start + pageSize
  const slice = filtered.slice(start, end)
  const hasMore = end < filtered.length

  return request({
    url: '/community/dynamic/list',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    data: q,
    mockData: {
      list: cloneList(slice),
      page,
      pageSize,
      hasMore,
      total: filtered.length,
      tab: q.tab,
      filter: q.filter
    }
  })
}

export async function getDynamicDetail(dynamicId: number) {
  const item = findDynamic(dynamicId)
  if (item != null && item.user != null && isBlocked(item.user.id as number)) {
    return request({
      url: '/community/dynamic/detail',
      cloudFunctionName: 'community',
      action: 'getDynamicDetail',
      method: 'GET',
      data: { dynamicId },
      mockData: null
    })
  }
  if (item != null && item.user != null) {
    item.applyStatus = applyStatusForUser(item.user.id as number, item.applyStatus || 'none')
  }
  return request({
    url: '/community/dynamic/detail',
    cloudFunctionName: 'community',
    action: 'getDynamicDetail',
    method: 'GET',
    data: { dynamicId },
    mockData: item != null ? item : null
  })
}

export async function getTopics(sort: string = 'hot') {
  let list = cloneList(mockTopics as any[])
  if (sort == 'new' || sort == 'latest') {
    list = sortTopicsByCreated(list)
  } else {
    list = sortTopicsByHeat(list)
  }
  return request({
    url: '/community/topics',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    data: { sort },
    mockData: list
  })
}

/**
 * 分页话题列表
 * getTopicList({ sort, page, pageSize, excludeIds })
 * 返回 { list, page, pageSize, total, hasMore }
 */
export async function getTopicList(query: any = null) {
  const sort = query != null && query.sort != null ? ('' + query.sort) : 'hot'
  const page = query != null && query.page != null && (query.page as number) > 0 ? (query.page as number) : 1
  const pageSize = query != null && query.pageSize != null && (query.pageSize as number) > 0 ? (query.pageSize as number) : 10
  const excludeIds = query != null ? query.excludeIds : null

  let list = cloneList(mockTopics as any[])
  if (sort == 'new' || sort == 'latest') {
    list = sortTopicsByCreated(list)
  } else {
    list = sortTopicsByHeat(list)
  }
  list = excludeTopicIds(list, excludeIds)
  const total = list.length
  const start = (page - 1) * pageSize
  const end = start + pageSize
  const slice = list.slice(start, end)
  const hasMore = end < total

  return request({
    url: '/community/topics/list',
    cloudFunctionName: 'community',
    action: 'getTopicList',
    method: 'GET',
    data: { sort, page, pageSize, excludeIds },
    mockData: {
      list: slice,
      page,
      pageSize,
      total,
      hasMore
    }
  })
}

export async function getTopicDetail(topicId: number, sort: string = 'hot') {
  const topic = findTopic(topicId)
  let posts = (mockDynamicList as any[]).filter((d: any) => {
    return d.topicId == topicId && notBlockedDynamic(d)
  })
  if (sort == 'latest' || sort == 'new') {
    posts = posts.slice().sort((a: any, b: any) => {
      return ((b.time as number) || 0) - ((a.time as number) || 0)
    })
  } else {
    posts = posts.slice().sort((a: any, b: any) => {
      return ((b.likeCount as number) || 0) - ((a.likeCount as number) || 0)
    })
  }
  return request({
    url: '/community/topic/detail',
    cloudFunctionName: 'community',
    action: 'getTopicDetail',
    method: 'GET',
    data: { topicId, sort },
    mockData: {
      topic,
      posts: cloneList(posts),
      sort
    }
  })
}

export async function joinTopic(topicId: number) {
  const topic = findTopic(topicId)
  if (topic != null) {
    markTopicParticipation(topic)
  }
  return request({
    url: '/community/topic/join',
    cloudFunctionName: 'community',
    action: 'joinTopic',
    method: 'POST',
    data: { topicId },
    mockData: { success: true, joined: true }
  })
}

export async function getPaperPlanes() {
  restorePaperPlaneState()
  const list = (mockPaperPlanes as any[]).filter((p: any) => {
    if (p.userId == null) return true
    return !isBlocked(p.userId as number)
  })
  list.forEach((p: any) => {
    p.timeText = paperPlaneTimeText(p.time)
    if (p.userId == mockMeProfile.id && (p.gender == null || p.gender == '我')) {
      p.gender = mockMeProfile.gender == 1 ? '男' : '女'
    }
  })
  return request({
    url: '/community/paper-planes',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    mockData: cloneList(list)
  })
}

/**
 * 放飞纸飞机
 * 新签名：sendPaperPlane({ content, scope?, anonymous? })
 * 兼容：sendPaperPlane(content, anonymous)
 */
export async function sendPaperPlane(contentOrPayload: any, anonymousArg: boolean = true) {
  restorePaperPlaneState()
  let content = ''
  let anonymous = true
  let scope = 'city'
  if (contentOrPayload != null && typeof contentOrPayload === 'object') {
    content = contentOrPayload.content != null ? ('' + contentOrPayload.content).trim() : ''
    anonymous = contentOrPayload.anonymous != null ? contentOrPayload.anonymous == true : true
    scope = contentOrPayload.scope != null ? contentOrPayload.scope : 'city'
  } else {
    content = contentOrPayload != null ? ('' + contentOrPayload).trim() : ''
    anonymous = anonymousArg
  }

  if (content.length == 0) {
    return request({
      url: '/community/paper-planes/send',
      cloudFunctionName: 'community',
      action: 'sendPaperPlane',
      method: 'POST',
      data: { content, anonymous, scope },
      mockData: {
        success: false,
        code: 'EMPTY_CONTENT',
        message: '请写下你想表达的内容'
      }
    })
  }

  if (content.length > 120) {
    return request({
      url: '/community/paper-planes/send',
      cloudFunctionName: 'community',
      action: 'sendPaperPlane',
      method: 'POST',
      data: { content, anonymous, scope },
      mockData: {
        success: false,
        code: 'CONTENT_TOO_LONG',
        message: '纸飞机内容不能超过 120 字'
      }
    })
  }

  const quotas = mockCommunityQuotas as any
  if (quotas.paperPlaneDaily.remain <= 0) {
    return request({
      url: '/community/paper-planes/send',
      cloudFunctionName: 'community',
      action: 'sendPaperPlane',
      method: 'POST',
      data: { content, anonymous, scope },
      mockData: {
        success: false,
        code: 'QUOTA_EXCEEDED',
        remain: 0,
        message: '今日免费纸飞机次数已用完，可用积分加次'
      }
    })
  }
  quotas.paperPlaneDaily.used += 1
  quotas.paperPlaneDaily.remain -= 1
  const plane = {
    id: Date.now(),
    content,
    anonymous,
    scope,
    gender: mockMeProfile.gender == 1 ? '男' : '女',
    age: mockMeProfile.age,
    city: mockMeProfile.city != null ? mockMeProfile.city : mockCurrentCity.name,
    userId: mockMeProfile.id,
    time: Date.now(),
    timeText: '刚刚',
    replyCount: 0,
    replied: false
  }
  ;(mockPaperPlanes as any[]).unshift(plane)
  savePaperPlaneState()
  return request({
    url: '/community/paper-planes/send',
    cloudFunctionName: 'community',
    action: 'sendPaperPlane',
    method: 'POST',
    data: { content, anonymous, scope },
    mockData: { success: true, plane, quotas: quotas.paperPlaneDaily }
  })
}

export async function replyPaperPlane(planeId: number, content: string) {
  restorePaperPlaneState()
  const replyContent = content.trim()
  if (replyContent.length == 0) {
    return request({
      url: '/community/paper-planes/reply',
      cloudFunctionName: 'community',
      action: 'replyPaperPlane',
      method: 'POST',
      data: { planeId, content: replyContent },
      mockData: {
        success: false,
        code: 'EMPTY_CONTENT',
        message: '请填写回复内容'
      }
    })
  }
  if (replyContent.length > 120) {
    return request({
      url: '/community/paper-planes/reply',
      cloudFunctionName: 'community',
      action: 'replyPaperPlane',
      method: 'POST',
      data: { planeId, content: replyContent },
      mockData: {
        success: false,
        code: 'CONTENT_TOO_LONG',
        message: '回复内容不能超过 120 字'
      }
    })
  }

  const list = mockPaperPlanes as any[]
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == planeId) {
      if (list[i].replied == true) {
        return request({
          url: '/community/paper-planes/reply',
          cloudFunctionName: 'community',
          action: 'replyPaperPlane',
          method: 'POST',
          data: { planeId, content: replyContent },
          mockData: {
            success: false,
            code: 'ALREADY_REPLIED',
            message: '这架纸飞机已经回复过了'
          }
        })
      }
      list[i].replied = true
      list[i].replyCount = (list[i].replyCount as number) + 1
      savePaperPlaneState()
      return request({
        url: '/community/paper-planes/reply',
        cloudFunctionName: 'community',
        action: 'replyPaperPlane',
        method: 'POST',
        data: { planeId, content: replyContent },
        mockData: {
          success: true,
          replyCount: list[i].replyCount
        }
      })
    }
  }
  return request({
    url: '/community/paper-planes/reply',
    cloudFunctionName: 'community',
    action: 'replyPaperPlane',
    method: 'POST',
    data: { planeId, content: replyContent },
    mockData: {
      success: false,
      code: 'NOT_FOUND',
      message: '这架纸飞机已不存在'
    }
  })
}

export async function getActivities(filter: string = 'all') {
  let list = cloneList(mockActivities as any[])
  if (filter == 'recruiting') {
    list = list.filter((a: any) => a.status == 'recruiting')
  } else if (filter == 'mine') {
    list = list.filter((a: any) => a.myStatus == 'joined' || a.myStatus == 'pending')
  }
  return request({
    url: '/community/activities',
    forceHttp: true,
    mockFallback: true,
    method: 'GET',
    data: { filter },
    mockData: list
  })
}

export async function getActivityDetail(activityId: number) {
  const item = findActivity(activityId)
  return request({
    url: '/community/activity/detail',
    cloudFunctionName: 'community',
    action: 'getActivityDetail',
    method: 'GET',
    data: { activityId },
    mockData: item
  })
}

export async function signupActivity(activityId: number) {
  const item = findActivity(activityId)
  if (item != null) {
    if (item.myStatus == 'none' || item.myStatus == null) {
      item.myStatus = 'pending'
      item.participantCount = (item.participantCount as number) + 1
    }
  }
  const notes = mockCommunityNotifications as any[]
  notes.unshift({
    id: Date.now(),
    type: 'activity',
    title: '活动报名已提交',
    content: item != null ? item.title : '报名审核中',
    timeText: '刚刚',
    read: false,
    targetType: 'activity',
    targetId: activityId
  })
  return request({
    url: '/community/activity/signup',
    cloudFunctionName: 'community',
    action: 'signupActivity',
    method: 'POST',
    data: { activityId },
    mockData: {
      success: true,
      myStatus: item != null ? item.myStatus : 'pending',
      message: '报名已提交，审核通过后告知集合信息'
    }
  })
}

export async function getMyActivities(filter: string = 'all') {
  let list = (mockActivities as any[]).filter((a: any) => {
    return a.myStatus == 'joined' || a.myStatus == 'pending'
  })
  if (filter == 'pending') {
    list = list.filter((a: any) => a.myStatus == 'pending')
  } else if (filter == 'joined') {
    list = list.filter((a: any) => a.myStatus == 'joined')
  } else if (filter == 'ended') {
    list = list.filter((a: any) => a.status == 'ended')
  }
  return request({
    url: '/community/activities/mine',
    cloudFunctionName: 'community',
    action: 'getMyActivities',
    method: 'GET',
    data: { filter },
    mockData: cloneList(list)
  })
}

