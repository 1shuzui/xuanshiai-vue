  const item = findActivity(activityId)
  return request({
    url: '/community/activity/detail',
    cloudFunctionName: 'community',
    action: 'getActivityDetail',
    method: 'GET',
    data: { activityId },
    mockData: item
  })
}

export async function signupActivity(activityId: number) {
  const item = findActivity(activityId)
  if (item != null) {
    if (item.myStatus == 'none' || item.myStatus == null) {
      item.myStatus = 'pending'
      item.participantCount = (item.participantCount as number) + 1
    }
  }
  const notes = mockCommunityNotifications as any[]
  notes.unshift({
    id: Date.now(),
    type: 'activity',
    title: '活动报名已提交',
    content: item != null ? item.title : '报名审核中',
    timeText: '刚刚',
    read: false,
    targetType: 'activity',
    targetId: activityId
  })
  return request({
    url: '/community/activity/signup',
    cloudFunctionName: 'community',
    action: 'signupActivity',
    method: 'POST',
    data: { activityId },
    mockData: {
      success: true,
      myStatus: item != null ? item.myStatus : 'pending',
      message: '报名已提交，审核通过后告知集合信息'
    }
  })
}

export async function getMyActivities(filter: string = 'all') {
  let list = (mockActivities as any[]).filter((a: any) => {
    return a.myStatus == 'joined' || a.myStatus == 'pending'
  })
  if (filter == 'pending') {
    list = list.filter((a: any) => a.myStatus == 'pending')
  } else if (filter == 'joined') {
    list = list.filter((a: any) => a.myStatus == 'joined')
  } else if (filter == 'ended') {
    list = list.filter((a: any) => a.status == 'ended')
  }
  return request({
    url: '/community/activities/mine',
    cloudFunctionName: 'community',
    action: 'getMyActivities',
    method: 'GET',
    data: { filter },
    mockData: cloneList(list)
  })
}

export async function getCommunityBanners() {
  return request({
    url: '/community/banners',
    cloudFunctionName: 'community',
    action: 'getBanners',
    method: 'GET',
    mockData: cloneList(mockCommunityBanners as any[])
  })
}

export async function getCommunityNotifications() {
  return request({
    url: '/community/notifications',
    cloudFunctionName: 'community',
    action: 'getNotifications',
    method: 'GET',
    mockData: cloneList(mockCommunityNotifications as any[])
  })
}

export async function getUnreadNotificationCount() {
  const list = mockCommunityNotifications as any[]
  let count = 0
  for (let i = 0; i < list.length; i++) {
    if (list[i].read != true) count += 1
  }
  return request({
    url: '/community/notifications/unread',
    cloudFunctionName: 'community',
    action: 'getUnreadCount',
    method: 'GET',
    mockData: { count }
  })
}

export async function markNotificationRead(notificationId: number) {
  const list = mockCommunityNotifications as any[]
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == notificationId) {
      list[i].read = true
      break
    }
  }
  return request({
    url: '/community/notifications/read',
    cloudFunctionName: 'community',
    action: 'markRead',
    method: 'POST',
    data: { notificationId },
    mockData: { success: true }
  })
}

export async function markAllNotificationsRead() {
  const list = mockCommunityNotifications as any[]
  for (let i = 0; i < list.length; i++) {
    list[i].read = true
  }
  return request({
    url: '/community/notifications/read-all',
    cloudFunctionName: 'community',
    action: 'markAllRead',
    method: 'POST',
    mockData: { success: true }
  })
}

