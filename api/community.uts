export async function likeDynamic(dynamicId: number) {
  const item = findDynamic(dynamicId)
  if (item != null) {
    item.liked = !item.liked
    item.likeCount = (item.likeCount as number) + (item.liked ? 1 : -1)
  }
  return request({
    url: '/community/dynamic/like',
    cloudFunctionName: 'community',
    action: 'likeDynamic',
    method: 'POST',
    data: { dynamicId },
    mockData: {
      success: true,
      liked: item != null ? item.liked : true,
      likeCount: item != null ? item.likeCount : 0
    }
  })
}

export async function likeComment(commentId: number, currentlyLiked: boolean = false) {
  if (USE_MOCK) {
    const all = mockDynamics as any[]
    let liked = !currentlyLiked
    let likeCount = currentlyLiked ? 0 : 1
    for (let i = 0; i < all.length; i++) {
      const comments = all[i].comments as any[]
      if (comments == null) continue
      for (let j = 0; j < comments.length; j++) {
        if (comments[j].id == commentId) {
          comments[j].liked = !comments[j].liked
          comments[j].likeCount = (comments[j].likeCount as number) + (comments[j].liked ? 1 : -1)
          if ((comments[j].likeCount as number) < 0) comments[j].likeCount = 0
          liked = comments[j].liked == true
          likeCount = comments[j].likeCount as number
        }
      }
    }
    return request({
      url: '/community/comments/' + commentId + '/like',
      cloudFunctionName: 'community',
      action: 'likeComment',
      method: currentlyLiked ? 'DELETE' : 'PUT',
      data: { commentId },
      mockData: { success: true, liked: liked, likeCount: likeCount, is_liked: liked, like_count: likeCount }
    })
  }

  const method = currentlyLiked ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/comments/' + commentId + '/like',
    method: method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    liked: raw != null && raw.is_liked == true,
    likeCount: raw != null && raw.like_count != null ? raw.like_count : 0,
    comment: raw != null ? mapComment(raw) : null
  })
}

export async function collectDynamic(dynamicId: number) {
  const item = findDynamic(dynamicId)
  if (item != null) {
    item.collected = !item.collected
    item.collectCount = (item.collectCount as number) + (item.collected ? 1 : -1)
  }
  return request({
    url: '/community/dynamic/collect',
    cloudFunctionName: 'community',
    action: 'collectDynamic',
    method: 'POST',
    data: { dynamicId },
    mockData: {
      success: true,
      collected: item != null ? item.collected : true,
      collectCount: item != null ? item.collectCount : 0
    }
  })
}

export async function followUserFromCommunity(userId: number) {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null && all[i].user.id == userId) {
      all[i].followed = true
      if (all[i].tabs != null && all[i].tabs.indexOf('follow') < 0) {
        ;(all[i].tabs as any[]).push('follow')
      }
    }
  }
  return request({
    url: '/community/follow',
    cloudFunctionName: 'community',
    action: 'followUser',
    method: 'POST',
    data: { userId },
    mockData: { success: true, followed: true }
  })
}

/**
 * 评论动态
 * 新签名：commentDynamic({ dynamicId, content, replyToCommentId? })
 * 兼容：commentDynamic(dynamicId, content, replyToId)
 */
export async function commentDynamic(
  dynamicIdOrPayload: any,
  contentArg: string = '',
  replyToIdArg: number = 0
) {
  let dynamicId = 0
  let content = ''
  let replyToCommentId = 0

  if (dynamicIdOrPayload != null && typeof dynamicIdOrPayload === 'object') {
    dynamicId = dynamicIdOrPayload.dynamicId != null ? (dynamicIdOrPayload.dynamicId as number) : 0
    content = dynamicIdOrPayload.content != null ? ('' + dynamicIdOrPayload.content).trim() : ''
    replyToCommentId =
      dynamicIdOrPayload.replyToCommentId != null
        ? (dynamicIdOrPayload.replyToCommentId as number)
        : dynamicIdOrPayload.replyToId != null
          ? (dynamicIdOrPayload.replyToId as number)
          : 0
  } else {
    dynamicId = dynamicIdOrPayload as number
    content = contentArg != null ? ('' + contentArg).trim() : ''
    replyToCommentId = replyToIdArg
  }

  if (content.length == 0) {
    return request({
      url: '/community/dynamic/comment',
      cloudFunctionName: 'community',
      action: 'commentDynamic',
      method: 'POST',
      data: { dynamicId, content, replyToCommentId },
<<<<<<< HEAD
=======
      mockData: { success: true, comment }
    })
  }

  const body: any = { content: content }
  if (replyToCommentId > 0) {
    body.parent_id = replyToCommentId
  }
  const key = idempotencyKey('comment', suppliedCreateKey)
  const res = await request({
    url: '/community/posts/' + dynamicId + '/comments',
    method: 'POST',
    data: body,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, message: res.data.message != null ? res.data.message : '发送失败，请重试' })
  }
  return okRes({ success: true, comment: mapComment(res.data) })
}

// ─── 举报 / 屏蔽 / 城市 ─────────────────────────────────────

export async function reportContent(targetType: string, targetId: number, reasonId: string, detail: string = '') {
  // 统一命名：历史 UI 可能传 paperPlane
  let normalizedType = targetType != null ? targetType : 'user'
