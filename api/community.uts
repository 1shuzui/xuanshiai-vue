/**
 * 社区相关 API
 * Mock 对齐高保真：喜欢 / 同城 / 发现
 */

import { request } from './request.uts'
import {
  mockDynamicList,
  mockTopics,
  mockPaperPlanes,
  mockActivities,
  mockCommunityBanners
} from '@/mock'

/**
 * 获取动态列表
 * @param tab 0 发现(discover) / 1 喜欢(liked) / 2 同城(city)
 */
export async function getDynamicList(tab: number = 0, page: number = 1) {
  const all = mockDynamicList as any[]
  let filtered = all
  if (tab == 1) {
    filtered = all.filter((d: any) => d.tab == 'liked' || d.liked == true)
  } else if (tab == 2) {
    filtered = all.filter((d: any) => d.tab == 'city' || d.location == '南京')
  } else {
    filtered = all.filter((d: any) => d.tab == 'discover' || d.tab == null)
    if (filtered.length == 0) filtered = all
  }
  return request({
    url: '/community/dynamic/list',
    cloudFunctionName: 'community',
    action: 'getDynamicList',
    method: 'GET',
    data: { tab, page },
    mockData: filtered
  })
}

